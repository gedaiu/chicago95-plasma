screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
unit = Math.Min(screen_width / 640, screen_height / 480);
layout_y = (screen_height - 480 * unit) / 2;
layout_x = (screen_width - 640 * unit) / 2;
asset_scale = 1;
if (screen_height >= 960)
  asset_scale = 2;
fit = unit / asset_scale;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

if (asset_scale == 2)
  {
    logo_image = Image("logo@2x.png");
    trough_image = Image("trough@2x.png");
    block_image = Image("block@2x.png");
  }
else
  {
    logo_image = Image("logo.png");
    trough_image = Image("trough.png");
    block_image = Image("block.png");
  }

logo = Sprite(logo_image.Scale(Math.Int(logo_image.GetWidth() * fit), Math.Int(logo_image.GetHeight() * fit)));
# Centred on the XP wordmark's centre: the 244 pixel wordmark lands at x 209; a branded logo, wider, around it.
logo.SetPosition(Math.Int(layout_x + 331 * unit - logo_image.GetWidth() * fit / 2), Math.Int(layout_y + 123 * unit), 1);

trough = Sprite(trough_image.Scale(Math.Int(trough_image.GetWidth() * fit), Math.Int(trough_image.GetHeight() * fit)));
trough.SetPosition(Math.Int(layout_x + 255 * unit), Math.Int(layout_y + 351 * unit), 1);

# The native SP3 sweep repeats after 18 steps (about 1.69 seconds).
tick = 0;
for (i = 0; i < 3; i++)
  {
    block = block_image.Crop(i * 8 * asset_scale, 0, 6 * asset_scale, 9 * asset_scale);
    blocks[i] = Sprite(block.Scale(Math.Max(1, Math.Int(6 * unit)), Math.Max(1, Math.Int(9 * unit))));
    blocks[i].SetOpacity(0);
  }

fun refresh_callback()
  {
    step = Math.Int(tick / 3);
    for (i = 0; i < 3; i++)
      {
        slot = step - 3 + i;
        blocks[i].SetPosition(Math.Int(layout_x + (259 + slot * 8) * unit), Math.Int(layout_y + 354 * unit), 2);
        blocks[i].SetOpacity(slot >= 0 && slot < 15);
      }
    tick = (tick + 1) % 54;
  }
Plymouth.SetRefreshRate(32);
Plymouth.SetRefreshFunction(refresh_callback);
