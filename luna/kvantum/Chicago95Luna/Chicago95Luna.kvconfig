[%General]
author=Chicago95 Plasma
comment=Windows XP Luna
x11drag=all
alt_mnemonic=true
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=false
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
scroll_min_extent=36
button_contents_shift=true
fill_rubberband=true
tree_branch_line=true
layout_spacing=6
layout_margin=9
submenu_overlap=0
no_window_pattern=true
respect_DE=true
scroll_width=17
slider_width=4
slider_handle_width=11
slider_handle_length=21
spin_button_width=17
splitter_width=5

[GeneralColors]
window.color=#ECE9D8
base.color=#FFFFFF
alt.base.color=#F5F4EA
button.color=#ECE9D8
light.color=#FFFFFF
mid.light.color=#F1EFE2
dark.color=#ACA899
mid.color=#D6D2C2
highlight.color=#316AC5
inactive.highlight.color=#316AC5
text.color=#000000
window.text.color=#000000
button.text.color=#000000
disabled.text.color=#A1A192
tooltip.base.color=#FFFFE1
tooltip.text.color=#000000
highlight.text.color=#FFFFFF
link.color=#0000FF
link.visited.color=#800080

[PanelButtonCommand]
frame=true
frame.element=button
interior=true
interior.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.size=9
indicator.element=arrow
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.shadow=false
text.margin=1
text.iconspacing=4
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
min_height=23

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
min_height=0

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=dock
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=spin
interior.element=spin
indicator.element=arrow
indicator.size=7
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
indicator.size=13
min_height=0
text.margin.left=3

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
indicator.size=13
min_height=0
text.margin.left=3

[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=20

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=21

[ComboBox]
inherits=PanelButtonCommand
frame.element=combo
interior.element=combo
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=21

[DropDownButton]
inherits=PanelButtonCommand
frame.element=dropdown
interior.element=dropdown
indicator.element=arrow-down
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
frame.top=3
frame.bottom=0
frame.left=3
frame.right=3
text.margin.left=8
text.margin.right=8
text.toggle.color=#000000
min_height=21

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabpage
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=6
min_height=20

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=6
frame.element=toolbar
interior.element=toolbar
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.focus.color=#000000
min_height=0

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=progress-pattern
interior.x.patternsize=10
min_height=0

[ItemView]
inherits=PanelButtonCommand
text.margin=0
frame=false
interior.element=itemview
interior=true
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
min_height=0

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
min_height=0

[Scrollbar]
inherits=PanelButtonCommand
frame=true
interior=true
indicator.element=arrow
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.element=scrollbarbutton
interior.element=scrollbarbutton
indicator.size=7
min_height=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.element=grip
indicator.size=13
min_height=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame=false
min_height=0

[MenuItem]
inherits=PanelButtonCommand
interior.element=menuitem
indicator.element=menuitem
min_height=23
text.margin.left=4
frame=false
interior=true
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
min_height=0
frame=false
interior=true
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false
min_height=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
text.normal.color=#D8E4F8
text.focus.color=#FFFFFF
text.bold=true
text.shadow=true
text.shadow.color=#0A246A
min_height=0

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
min_height=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=false
text.margin=0
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color=#0046D5
text.focus.color=#0046D5
text.bold=false

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin=2

[Window]
interior=false
