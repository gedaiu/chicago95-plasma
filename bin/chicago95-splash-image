#!/usr/bin/env python3
"""The loading screen (splash/Splash.qml with its settings.js) as a picture, for the boot screen: Plymouth
shows pictures, so Setup renders the 2000 screen at the monitor's size and the Plymouth script draws the
progress blocks over it. Run with QT_QPA_PLATFORM=offscreen; nothing is shown."""

import argparse
import sys
from pathlib import Path

from PySide6.QtCore import QTimer, QUrl
from PySide6.QtGui import QGuiApplication
from PySide6.QtQuick import QQuickView

SPLASH = Path.home() / ".local/share/plasma/look-and-feel/chicago95.splashscreen/contents/splash"


def render(splash, size, stage, out):
    app = QGuiApplication(sys.argv[:1])
    view = QQuickView()
    view.setResizeMode(QQuickView.SizeRootObjectToView)
    view.resize(*size)
    view.setSource(QUrl.fromLocalFile(str(Path(splash) / "Splash.qml")))
    if view.errors():
        raise SystemExit("\n".join(error.toString() for error in view.errors()))
    view.rootObject().setProperty("stage", stage)
    view.rootObject().setProperty("booting", True)
    view.show()
    QTimer.singleShot(300, app.quit)
    app.exec()
    image = view.grabWindow()
    view.close()
    if not image.save(str(out)):
        raise SystemExit(f"could not write {out}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--splash", default=str(SPLASH), help="the folder with Splash.qml and settings.js")
    parser.add_argument("--size", default="1920x1080", help="WIDTHxHEIGHT, the logical screen size")
    parser.add_argument("--scale", type=float, default=1, help="the screen's scale: the picture is size times scale")
    parser.add_argument("--stage", type=int, default=0, help="how many of Plasma's start-up stages the bar shows done")
    parser.add_argument("--out", required=True, help="the PNG to write")
    arguments = parser.parse_args()
    width, height = (int(part) for part in arguments.size.lower().split("x"))
    render(
        arguments.splash,
        (round(width * arguments.scale), round(height * arguments.scale)),
        arguments.stage,
        arguments.out,
    )


if __name__ == "__main__":
    main()
