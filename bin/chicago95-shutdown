#!/usr/bin/env python3
import os, sys; sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"), os.path.expanduser("~/.local/lib/chicago95")]; import chicago95ui  # noqa: E401,E702

import argparse
import glob
import shutil
import subprocess

import getpass
import re

from PySide6.QtCore import QRect, Qt, QTimer
from PySide6.QtGui import QColor, QFont, QFontDatabase, QFontMetrics, QIcon, QLinearGradient, QPainter, QPalette, QPixmap
from PySide6.QtWidgets import (
    QComboBox, QDialog, QHBoxLayout, QLabel, QPushButton, QRadioButton, QVBoxLayout, QWidget,
)

SHUT_DOWN, RESTART, DOS_MODE, LOG_OFF, STAND_BY = range(5)

# Choices per style, in the order each original lists them; the first in DEFAULT_CHOICE is preselected.
CHOICES = {
    "1995": [(SHUT_DOWN, "&Shut down the computer?"), (RESTART, "&Restart the computer?"),
             (DOS_MODE, "Restart the computer in &DOS mode?"), (LOG_OFF, "&Close all programs and log on as a different user?")],
    "1998": [(STAND_BY, "S&tand by"), (SHUT_DOWN, "&Shut down"), (RESTART, "&Restart"), (DOS_MODE, "Restart in &DOS mode")],
    "2000": [(LOG_OFF, "Log off {user}"), (SHUT_DOWN, "Shut down"), (RESTART, "Restart"), (STAND_BY, "Stand by")],
}
CHOICE_LABELS = tuple(label for _, label in CHOICES["1995"])
QUESTIONS = {"1995": "Are you sure you want to:", "1998": "What do you want the computer to do?",
             "2000": "What do you want the computer to do?"}
DESCRIPTIONS = {
    LOG_OFF: "Ends your session, leaving the computer running on full power.",
    SHUT_DOWN: "Ends your session and shuts down the computer so that you can safely turn off power.",
    RESTART: "Ends your session, shuts down the computer and starts it again.",
    STAND_BY: "Keeps your session in memory and puts the computer in a low-power state.",
}
START_LOGO_GLOB = os.path.expanduser("~/.local/share/chicago95/start-logo.*")

KDE_SHUTDOWN_METHODS = {
    SHUT_DOWN: "org.kde.Shutdown.logoutAndShutdown",
    RESTART: "org.kde.Shutdown.logoutAndReboot",
    LOG_OFF: "org.kde.Shutdown.logout",
}

SYSTEMCTL_FALLBACKS = {
    SHUT_DOWN: ["systemctl", "poweroff"],
    RESTART: ["systemctl", "reboot"],
    LOG_OFF: ["loginctl", "terminate-session", os.environ.get("XDG_SESSION_ID", "self")],
}

SAFE_TEXT = "It's now safe to turn off\nyour computer."
SAFE_ORANGE = QColor("#FFA500")
SAFE_FONT_PREFERENCES = (
    "Fixedsys Excelsior", "IBM VGA 8x16", "Px437 IBM VGA8",
    "More Perfect DOS VGA", "Less Perfect DOS VGA", "Monospace",
)
SAFE_SCREEN_DELAY_MS = 2500

ICON_DIRS = (
    os.path.expanduser("~/.local/share/icons"),
    "/usr/share/icons",
)

SOUND_DIRS = (
    os.path.expanduser("~/.local/share/sounds/Chicago95/stereo"),
    "/usr/share/sounds/Chicago95/stereo",
)


def dbus_caller():
    if shutil.which("gdbus"):
        return ["gdbus", "call", "--session", "--dest", "org.kde.Shutdown", "--object-path", "/Shutdown", "--method"]
    qdbus = shutil.which("qdbus6") or shutil.which("qdbus")
    if qdbus:
        return [os.path.basename(qdbus), "org.kde.Shutdown", "/Shutdown"]
    return None


def shutdown_command(choice, dbus_prefix=None):
    if choice == DOS_MODE:
        return ["konsole"]
    if choice == STAND_BY:
        return ["systemctl", "suspend"]
    if dbus_prefix:
        return dbus_prefix + [KDE_SHUTDOWN_METHODS[choice]]
    return SYSTEMCTL_FALLBACKS[choice]


def shutdown_sound_file():
    for sound_dir in SOUND_DIRS:
        enabled = [path for path in glob.glob(os.path.join(sound_dir, "system-shutdown.*"))
                   if not path.endswith(".disabled")]
        if enabled:
            return enabled[0]
    return None


def sound_player():
    return shutil.which("pw-play") or shutil.which("paplay")


def pick_safe_font_family():
    installed = set(QFontDatabase.families())
    return next((family for family in SAFE_FONT_PREFERENCES if family in installed), "Monospace")


def fit_safe_font(family, screen_width):
    font = QFont(family, 36)
    widest_line = max(SAFE_TEXT.splitlines(), key=len)
    measured = QFontMetrics(font).horizontalAdvance(widest_line)
    font.setPointSizeF(36 * (screen_width / 3) / measured)
    return font


def virtual_screen_geometry(app):
    geometry = QRect()
    for screen in app.screens():
        geometry = geometry.united(screen.geometry())
    return geometry


class SafeScreen(QWidget):
    def __init__(self, geometry, hold_until_input):
        super().__init__()
        self.hold_until_input = hold_until_input
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setAttribute(Qt.WA_DeleteOnClose)
        self.setCursor(Qt.BlankCursor)
        self.setGeometry(geometry)
        self.setAutoFillBackground(True)
        palette = self.palette()
        palette.setColor(QPalette.Window, Qt.black)
        self.setPalette(palette)

        label = QLabel(SAFE_TEXT, self)
        label.setAlignment(Qt.AlignCenter)
        label.setFont(fit_safe_font(pick_safe_font_family(), geometry.width()))
        label_palette = label.palette()
        label_palette.setColor(QPalette.WindowText, SAFE_ORANGE)
        label.setPalette(label_palette)
        layout = QVBoxLayout(self)
        layout.addWidget(label)

    def keyPressEvent(self, event):
        if self.hold_until_input:
            self.close()

    def mousePressEvent(self, event):
        if self.hold_until_input:
            self.close()


def yes_no_buttons(dialog):
    yes_button = QPushButton("&Yes")
    yes_button.setDefault(True)
    no_button = QPushButton("&No")
    help_button = QPushButton("&Help")
    help_button.setEnabled(False)
    buttons = QHBoxLayout()
    buttons.setSpacing(6)
    buttons.addStretch()
    for button in (yes_button, no_button, help_button):
        button.setFixedSize(75, 23)
        buttons.addWidget(button)
    yes_button.clicked.connect(dialog.accept)
    no_button.clicked.connect(dialog.reject)
    return buttons


def dialog_icon(name):
    icon_label = QLabel()
    icon_label.setPixmap(QIcon.fromTheme(name).pixmap(32, 32))
    icon_label.setAlignment(Qt.AlignTop)
    icon_label.setFixedWidth(32)
    return icon_label


def centre_on_screen(dialog):
    screen_geometry = dialog.screen().availableGeometry()
    dialog.move(screen_geometry.center() - dialog.rect().center())


class LogOffDialog(QDialog):
    QUESTION = "Are you sure you want to log off?"

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Log Off")
        self.setWindowFlags(Qt.Dialog | Qt.WindowTitleHint | Qt.WindowCloseButtonHint)
        self.setFixedSize(300, 110)

        upper = QHBoxLayout()
        upper.setSpacing(12)
        upper.addWidget(dialog_icon("system-log-out"))
        upper.addWidget(QLabel(self.QUESTION), 1)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.addLayout(upper)
        layout.addLayout(yes_no_buttons(self))


def dialog_buttons(dialog, labels):
    """A row of 75x23 buttons, right-aligned; the first accepts, the second rejects, Help is disabled."""
    buttons = QHBoxLayout()
    buttons.setSpacing(6)
    buttons.addStretch()
    made = []
    for label in labels:
        button = QPushButton(label)
        button.setFixedSize(75, 23)
        buttons.addWidget(button)
        made.append(button)
    made[0].setDefault(True)
    made[0].clicked.connect(dialog.accept)
    made[1].clicked.connect(dialog.reject)
    made[-1].setEnabled(False)
    return buttons, made


class BrandBanner(QWidget):
    """The 2000 dialogs' banner: white, with the Start logo and the name, over a glowing strip."""

    STRIP = ((0.0, "#003152"), (0.45, "#9cc6de"), (0.7, "#63adde"), (0.95, "#003152"), (1.0, "#003152"))

    def __init__(self, look, parent=None):
        super().__init__(parent)
        self.look = look
        logos = sorted(glob.glob(START_LOGO_GLOB))
        self.logo = QIcon(str(logos[0])).pixmap(48, 48) if logos else QPixmap()

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(0, 0, self.width(), 72, Qt.white)
        strip = QLinearGradient(0, 0, self.width(), 0)
        for position, colour in self.STRIP:
            strip.setColorAt(position, QColor(colour))
        painter.fillRect(0, 72, self.width(), 5, strip)
        x = 20
        if not self.logo.isNull():
            painter.drawPixmap(x, 12, self.logo)
            x += 60
        painter.setPen(Qt.black)
        for part in re.findall(r"\s*\d+|\s*[^\d]+", self.look["bannerText"]):
            font = QFont("Arial")
            font.setPixelSize(30)
            font.setBold(not part.strip().isdigit())
            painter.setFont(font)
            painter.drawText(x, 40, part)
            x += painter.fontMetrics().horizontalAdvance(part)
        font = QFont("Arial")
        font.setPixelSize(18)
        font.setBold(True)
        painter.setFont(font)
        painter.drawText(x + 6, 40, self.look["edition"])
        painter.end()


class ShutDownDialog(QDialog):
    """Shut Down dialog of the chosen style: 1995 and 1998 list radio buttons, 2000 a dropdown under a banner."""

    def __init__(self, look=None):
        super().__init__()
        self.look = look or chicago95ui.look_settings()
        self.style = self.look["style"] if self.look["style"] in CHOICES else "1995"
        self.setWindowTitle("Shut Down")
        self.setWindowFlags(Qt.Dialog | Qt.WindowTitleHint | Qt.WindowCloseButtonHint)
        self.choices = CHOICES[self.style]
        self.choice = None
        if self.style == "2000":
            self.build_2000()
        else:
            self.build_radio_list()

    def build_radio_list(self):
        self.setFixedSize(340, 180)
        self.radios = [QRadioButton(label) for _, label in self.choices]
        self.radios[[choice for choice, _ in self.choices].index(SHUT_DOWN)].setChecked(True)
        options = QVBoxLayout()
        options.setSpacing(2)
        options.addWidget(QLabel(QUESTIONS[self.style]))
        options.addSpacing(6)
        for radio in self.radios:
            options.addWidget(radio)
        options.addStretch()

        upper = QHBoxLayout()
        upper.setSpacing(12)
        upper.addWidget(dialog_icon("system-shutdown"))
        upper.addLayout(options)

        labels = ("&Yes", "&No", "&Help") if self.style == "1995" else ("OK", "Cancel", "&Help")
        buttons, _ = dialog_buttons(self, labels)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.addLayout(upper)
        layout.addLayout(buttons)

    def build_2000(self):
        # Positions measured on the original (tests/test_shutdown_reference.py): client 409x246.
        self.setFixedSize(409, 246)
        BrandBanner(self.look, self).setGeometry(0, 1, 409, 77)
        icon = dialog_icon("system-shutdown")
        icon.setParent(self)
        icon.move(22, 89)
        QLabel(QUESTIONS["2000"], self).move(65, 91)
        self.combo = QComboBox(self)
        self.combo.setGeometry(65, 111, 262, 20)
        for choice, label in self.choices:
            self.combo.addItem(label.format(user=getpass.getuser()), choice)
        self.combo.setCurrentIndex([choice for choice, _ in self.choices].index(SHUT_DOWN))
        self.description = QLabel(self)
        self.description.setWordWrap(True)
        self.description.setGeometry(65, 135, 280, 34)
        self.combo.currentIndexChanged.connect(self.describe)
        self.describe()
        for x, label in zip((163, 244, 325), ("OK", "Cancel", "Help")):
            button = QPushButton(label, self)
            button.setGeometry(x, 211, 75, 23)
            if label == "OK":
                button.setDefault(True)
                button.clicked.connect(self.accept)
            elif label == "Cancel":
                button.clicked.connect(self.reject)
            else:
                button.setEnabled(False)

    def describe(self):
        self.description.setText(DESCRIPTIONS[self.combo.currentData()])

    def accept(self):
        if self.style == "2000":
            self.choice = self.combo.currentData()
        else:
            self.choice = self.choices[next(index for index, radio in enumerate(self.radios) if radio.isChecked())][0]
        super().accept()


def run_command(argv, dry_run):
    if dry_run:
        print("dry-run, would run:", " ".join(argv))
        return
    subprocess.Popen(argv)


def ask(dialog):
    dialog.show()
    centre_on_screen(dialog)
    return dialog.exec() == QDialog.Accepted


def log_off(confirmed, dry_run, dbus_prefix):
    if confirmed:
        run_command(shutdown_command(LOG_OFF, dbus_prefix), dry_run)


def play_shutdown_sound(dry_run):
    sound_file, player = shutdown_sound_file(), sound_player()
    if sound_file and player:
        run_command([player, sound_file], dry_run)


def grab_widget(widget, path):
    widget.show()
    widget.grab().save(path)
    print("saved", path)


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Shut Down dialog for KDE")
    parser.add_argument("--log-off", action="store_true", help="ask to log off instead of the Shut Down choices")
    parser.add_argument("--dry-run", action="store_true", help="print commands instead of running them")
    parser.add_argument("--screenshot", metavar="PATH", help="save the dialog as PNG and exit")
    parser.add_argument("--screenshot-safe", metavar="PATH", help="save the safe screen at 1280x720 and exit")
    args = parser.parse_args()

    app = chicago95ui.make_app("chicago95-shutdown")
    QIcon.setThemeSearchPaths(list(ICON_DIRS) + QIcon.themeSearchPaths())

    if args.screenshot:
        grab_widget(LogOffDialog() if args.log_off else ShutDownDialog(), args.screenshot)
        return 0
    if args.screenshot_safe:
        grab_widget(SafeScreen(QRect(0, 0, 1280, 720), hold_until_input=False), args.screenshot_safe)
        return 0

    if args.log_off:
        log_off(ask(LogOffDialog()), args.dry_run, dbus_caller())
        return 0

    dialog = ShutDownDialog()
    if not ask(dialog):
        return 0

    command = shutdown_command(dialog.choice, dbus_caller())
    if dialog.choice in (DOS_MODE, LOG_OFF, STAND_BY):
        run_command(command, args.dry_run)
        return 0

    safe_screen = SafeScreen(virtual_screen_geometry(app), hold_until_input=args.dry_run)
    safe_screen.showFullScreen()
    play_shutdown_sound(args.dry_run)

    def power_off():
        run_command(command, args.dry_run)
        if not args.dry_run:
            app.quit()

    QTimer.singleShot(SAFE_SCREEN_DELAY_MS, power_off)
    if args.dry_run:
        safe_screen.destroyed.connect(app.quit)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
