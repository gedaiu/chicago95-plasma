LAYOUT = {"1995": "radio", "1998": "radio", "2000": "combo", "2001": "combo"}


def os_name(look):
    """The OS name used in messages: osName up to its first digit ("Windows2026" -> "Windows")."""
    return chicago95ui.short_os_name(look.get("osName", look.get("bannerText", "")))


KDE_SHUTDOWN_METHODS = {
    SHUT_DOWN: "org.kde.Shutdown.logoutAndShutdown",
    RESTART: "org.kde.Shutdown.logoutAndReboot",
    LOG_OFF: "org.kde.Shutdown.logout",
}

SYSTEMCTL_FALLBACKS = {
    SHUT_DOWN: ["systemctl", "poweroff"],
    RESTART: ["systemctl", "reboot"],
    LOG_OFF: ["loginctl", "terminate-session", os.environ.get("XDG_SESSION_ID", "self")],
}

# Log off, shut down and restart announce themselves at the screen's corner, with Cancel (SessionEndNotice).
SESSION_END_SUMMARIES = {
    LOG_OFF: "Logging off...",
    SHUT_DOWN: "{os} is shutting down...",
    RESTART: "{os} is restarting...",
}
SESSION_END_BODY = "Waiting for your programs to close."
NOTIFICATIONS = "org.freedesktop.Notifications"
NOTIFICATIONS_PATH = "/org/freedesktop/Notifications"
# Outlasts KWin's two minutes before it logs out anyway; the daemon closes it sooner when the logout is cancelled.
NOTICE_TIMEOUT_MS = 180_000

SAFE_TEXT = "It's now safe to turn off\nyour computer."
SAFE_ORANGE = QColor("#FFA500")
SAFE_FONT_PREFERENCES = (
    "Fixedsys Excelsior",
    "IBM VGA 8x16",
    "Px437 IBM VGA8",
    "More Perfect DOS VGA",
    "Less Perfect DOS VGA",
    "Monospace",
)
SAFE_SCREEN_DELAY_MS = 2500

ICON_DIRS = (
    os.path.expanduser("~/.local/share/icons"),
    "/usr/share/icons",
)

SOUND_ROOTS = (
    os.path.expanduser("~/.local/share/sounds"),
    "/usr/share/sounds",
)
KDEGLOBALS = os.path.expanduser("~/.config/kdeglobals")


def dbus_caller():
    if shutil.which("gdbus"):
        return ["gdbus", "call", "--session", "--dest", "org.kde.Shutdown", "--object-path", "/Shutdown", "--method"]
    qdbus = shutil.which("qdbus6") or shutil.which("qdbus")
    if qdbus:
        return [os.path.basename(qdbus), "org.kde.Shutdown", "/Shutdown"]
    return None


def shutdown_command(choice, dbus_prefix=None):
    if choice == DOS_MODE:
        return ["konsole"]
    if choice == STAND_BY:
        return ["systemctl", "suspend"]
    if choice == HIBERNATE:
        return ["systemctl", "hibernate"]
    if dbus_prefix:
        return dbus_prefix + [KDE_SHUTDOWN_METHODS[choice]]
    return SYSTEMCTL_FALLBACKS[choice]


def switch_user_commands():
    """Lock this session first so it is not left open behind the greeter the other user logs in from."""
    seat = os.environ.get("XDG_SEAT_PATH", "/org/freedesktop/DisplayManager/Seat0")
    return [
        ["loginctl", "lock-session"],
        [
            "gdbus",
            "call",
            "--system",
            "--dest",
            "org.freedesktop.DisplayManager",
            "--object-path",
            seat,
            "--method",
            "org.freedesktop.DisplayManager.Seat.SwitchToGreeter",
        ],
    ]


def chosen_sound_theme(kdeglobals_path=KDEGLOBALS):
    try:
        with open(kdeglobals_path) as kdeglobals:
            text = kdeglobals.read()
    except OSError:
        return "Chicago95"
    sounds_group = re.search(r"^\[Sounds\]\n((?:[^\[].*\n?)*)", text, re.MULTILINE)
    theme = sounds_group and re.search(r"^Theme=(.+)$", sounds_group.group(1), re.MULTILINE)
    return theme.group(1).strip() if theme else "Chicago95"


def shutdown_sound_file(theme=None):
    return chicago95ui.sound_file(theme or chosen_sound_theme(), "system-shutdown", SOUND_ROOTS)


def sound_player():
    return shutil.which("pw-play") or shutil.which("paplay")


def pick_safe_font_family():
    installed = set(QFontDatabase.families())
    return next((family for family in SAFE_FONT_PREFERENCES if family in installed), "Monospace")


def fit_safe_font(family, screen_width):
    font = QFont(family, 36)
    widest_line = max(SAFE_TEXT.splitlines(), key=len)
    measured = QFontMetrics(font).horizontalAdvance(widest_line)
    font.setPointSizeF(36 * (screen_width / 3) / measured)
    return font


def virtual_screen_geometry(app):
    geometry = QRect()
    for screen in app.screens():
        geometry = geometry.united(screen.geometry())
    return geometry


class SafeScreen(QWidget):
    def __init__(self, geometry, hold_until_input):
        super().__init__()
        self.hold_until_input = hold_until_input
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setAttribute(Qt.WA_DeleteOnClose)
        self.setCursor(Qt.BlankCursor)
        self.setGeometry(geometry)
        self.setAutoFillBackground(True)
        palette = self.palette()
        palette.setColor(QPalette.Window, Qt.black)
        self.setPalette(palette)

        label = QLabel(SAFE_TEXT, self)
        label.setAlignment(Qt.AlignCenter)
        label.setFont(fit_safe_font(pick_safe_font_family(), geometry.width()))
        label_palette = label.palette()
        label_palette.setColor(QPalette.WindowText, SAFE_ORANGE)
        label.setPalette(label_palette)
        layout = QVBoxLayout(self)
        layout.addWidget(label)

    def keyPressEvent(self, event):
        if self.hold_until_input:
            self.close()

    def mousePressEvent(self, event):
        if self.hold_until_input:
            self.close()


def yes_no_buttons(dialog):
    yes_button = QPushButton("&Yes")
    yes_button.setDefault(True)
    yes_button.setToolTip("Closes your programs and ends your session.")
    no_button = QPushButton("&No")
    no_button.setToolTip("Closes this dialog without logging off.")
    help_button = QPushButton("&Help")
    help_button.setEnabled(False)
    buttons = QHBoxLayout()
    buttons.setSpacing(6)
    buttons.addStretch()
    for button in (yes_button, no_button, help_button):
        button.setFixedSize(75, 23)
        buttons.addWidget(button)
    yes_button.clicked.connect(dialog.accept)
    no_button.clicked.connect(dialog.reject)
    return buttons


def dialog_icon(name):
    icon_label = QLabel()
    icon_label.setPixmap(QIcon.fromTheme(name).pixmap(32, 32))
    icon_label.setAlignment(Qt.AlignTop)
    icon_label.setFixedWidth(32)
    return icon_label


def centre_on_screen(dialog):
    screen_geometry = dialog.screen().availableGeometry()
    dialog.move(screen_geometry.center() - dialog.rect().center())


class LogOffDialog(chicago95ui.ClassicDialog):
    QUESTION = "Are you sure you want to log off?"

    def __init__(self, look=None):
        look = {**chicago95ui.look_settings(), **(look or {})}
        super().__init__(f"Log Off {chicago95ui.short_os_name(look['osName'])}", look["style"], (300, 110))
        self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)

        upper = QHBoxLayout()
        upper.setSpacing(12)
        upper.addWidget(dialog_icon("system-log-out"))
        upper.addWidget(QLabel(self.QUESTION), 1)

        layout = QVBoxLayout(self.body)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.addLayout(upper)
        layout.addLayout(yes_no_buttons(self))


def dialog_buttons(dialog, labels):
    """A row of 75x23 buttons, right-aligned; the first accepts, the second rejects, Help is disabled."""
    buttons = QHBoxLayout()
    buttons.setSpacing(6)
    buttons.addStretch()
    made = []
    for label in labels:
        button = QPushButton(label)
        button.setFixedSize(75, 23)
        buttons.addWidget(button)
        made.append(button)
        button.setToolTip(
            "Performs the selected action."
            if len(made) == 1
            else "Closes this dialog without changing your session."
            if len(made) == 2
            else "Help is not available."
        )
    made[0].setDefault(True)
    made[0].clicked.connect(dialog.accept)
    made[1].clicked.connect(dialog.reject)
    made[-1].setEnabled(False)
    return buttons, made


class BrandBanner(QWidget):
    """The 2000 dialogs' banner: white, with the layered mark and the name, over a glowing strip.

    Positions and sizes are the original's, measured from tests/references/w2kshutdown.png
    (tests/test_shutdown_reference.py); the lettering is the loading screen's scaled to fit. The login
    banner (login=True, tests/test_login_reference.py) is taller, its content 1px right and 3px lower,
    with the tagline under the edition."""

    # Sampled across the original's strip: dark teal at the ends, glowing light blue in the middle.
    STRIP = (
        (0.0, "#003355"),
        (0.049, "#00436c"),
        (0.098, "#005889"),
        (0.147, "#005a8c"),
        (0.196, "#2f76a1"),
        (0.245, "#5497c2"),
        (0.294, "#64abda"),
        (0.343, "#75b5de"),
        (0.392, "#89bede"),
        (0.441, "#98c4de"),
        (0.49, "#9cc6de"),
        (0.539, "#98c4de"),
        (0.588, "#89bede"),
        (0.637, "#75b5de"),
        (0.686, "#64abda"),
        (0.735, "#5497c2"),
        (0.784, "#2f76a1"),
        (0.833, "#005a8c"),
        (0.882, "#005788"),
        (0.931, "#00436c"),
        (1.0, "#003355"),
    )
    MARK = (40, 6)  # the banner sits 1px into the dialog, so this is the original's (40, 7)
    NAME_X, NAME_BASELINE, NUMBER_BASELINE, NAME_GAP = 111, 43, 44, 8
    WORD = dict(size=35, embolden=1.4, spacing=0)
    NUMBER = dict(size=31, spacing=-2.3)
    EDITION = dict(size=25, embolden=1.2, spacing=-0.2, baseline=64, right_offset=-1)
    COMPANY = dict(x=101, baseline=15, size=11, spacing=1.3)
    CORNER = dict(right=399, baseline=17, size=12, embolden=0.7)
    TAGLINE = dict(size=13, baseline=77)
    WHITE_HEIGHT, LOGIN_WHITE_HEIGHT, LOGIN_OFFSET, STRIP_HEIGHT = 72, 88, (1, 3), 5

    def __init__(self, look, parent=None, login=False):
        super().__init__(parent)
        self.look = look
        self.login = login
        self.white_height = self.LOGIN_WHITE_HEIGHT if login else self.WHITE_HEIGHT
        self.logo = self.load(look["osLogo"], 74)
        self.company_logo = self.load(look["companyLogo"], 20)

    @staticmethod
    def load(path, size):
        """A logo scaled to the size: pixel-art PNGs with hard edges, SVGs rendered smooth."""
        if not path or not os.path.exists(path):
            return QPixmap()
        sharp = path.endswith(".png")
        source = QPixmap(path) if sharp else QIcon(path).pixmap(size * 4, size * 4)
        return source.scaled(
            size * 4, size, Qt.KeepAspectRatio, Qt.FastTransformation if sharp else Qt.SmoothTransformation
        )

    @staticmethod
    def font(size, bold=False, italic=False, spacing=0):
        font = QFont("Arial")
        font.setPixelSize(size)
        font.setBold(bold)
        font.setItalic(italic)
        font.setStyleStrategy(
            QFont.StyleStrategy(QFont.PreferAntialias | QFont.NoSubpixelAntialias)
        )  # grey edges, no colour fringes
        font.setHintingPreference(QFont.PreferNoHinting)  # the same widths at 1x and in the 4x login banner
        if spacing:
            font.setLetterSpacing(QFont.AbsoluteSpacing, spacing)
        return font

    def paint_name(self, painter):
        """Words heavy, numbers thin, from NAME_X; returns where the name ends."""
        x = self.NAME_X
        for raw_part in re.findall(r"\d+|[^\d]+", self.look["osName"]):
            part = raw_part.strip()
            if not part:
                continue
            if part.isdigit():
                font = self.font(self.NUMBER["size"], spacing=self.NUMBER["spacing"])
                painter.setFont(font)
                painter.drawText(QPointF(x, self.NUMBER_BASELINE), part)
            else:
                font = self.font(self.WORD["size"], bold=True, spacing=self.WORD["spacing"])
                chicago95ui.draw_heavy_text(
                    painter, x, self.NAME_BASELINE, font, part, QColor(Qt.black), self.WORD["embolden"]
                )
            x += QFontMetricsF(font).horizontalAdvance(part) + self.NAME_GAP
        return x - self.NAME_GAP

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(0, 0, self.width(), self.white_height, Qt.white)
        strip = QLinearGradient(0, 0, self.width(), 0)
        for position, colour in self.STRIP:
            strip.setColorAt(position, QColor(colour))
        painter.fillRect(0, self.white_height, self.width(), self.STRIP_HEIGHT, strip)
        if self.login:
            painter.translate(*self.LOGIN_OFFSET)
        chicago95ui.paint_banner_mark(painter, *self.MARK, self.logo)
        painter.setPen(Qt.black)
        if self.look["osCompany"]:
            painter.setFont(self.font(self.COMPANY["size"], spacing=self.COMPANY["spacing"]))
            painter.drawText(QPointF(self.COMPANY["x"], self.COMPANY["baseline"]), self.look["osCompany"])
        name_end = self.paint_name(painter)
        edition = self.font(self.EDITION["size"], bold=True, spacing=self.EDITION["spacing"])
        edition_x = (
            name_end - QFontMetricsF(edition).horizontalAdvance(self.look["edition"]) + self.EDITION["right_offset"]
        )
        chicago95ui.draw_heavy_text(
            painter,
            edition_x,
            self.EDITION["baseline"],
            edition,
            self.look["edition"],
            QColor(Qt.black),
            self.EDITION["embolden"],
        )
        if self.login:
            painter.setFont(self.font(self.TAGLINE["size"]))
            painter.drawText(QPointF(edition_x, self.TAGLINE["baseline"]), self.look["tagline"])
        if not self.company_logo.isNull():
            painter.drawPixmap(self.width() - self.company_logo.width() - 8, 6, self.company_logo)
        elif self.look["osCompany"]:
            # No company logo: the company's name in heavy italics takes its place, like the original's wordmark.
            corner = self.font(self.CORNER["size"], bold=True, italic=True)
            x = self.CORNER["right"] - QFontMetricsF(corner).horizontalAdvance(self.look["osCompany"])
            chicago95ui.draw_heavy_text(
                painter,
                x,
                self.CORNER["baseline"],
                corner,
                self.look["osCompany"],
                QColor(Qt.black),
                self.CORNER["embolden"],
            )
        painter.end()


class ShutDownDialog(chicago95ui.ClassicDialog):
    """Shut Down dialog of the chosen style: 1995 and 1998 list radio buttons, 2000 a dropdown under a banner.
    The client sizes, with the 3px frame and 18px title around them, are the originals' dialogs'
    (tests/test_shutdown_reference.py); 2000's client area starts a pixel further in."""

    BODIES = {"1995": ((340, 200), 3), "1998": ((318, 172), 3), "2000": ((409, 245), 4), "2001": ((409, 245), 4)}

    def __init__(self, look=None):
        self.look = {**chicago95ui.look_settings(), **(look or {})}
        self.style = self.look["style"] if self.look["style"] in CHOICES else "1995"
        body, inset = self.BODIES[self.style]
        super().__init__(f"Shut Down {chicago95ui.short_os_name(self.look['osName'])}", self.style, body, inset)
        self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.choices = CHOICES[self.style]
        self.choice = None
        {"combo": self.build_combo_list, "radio": self.build_radio_list}[LAYOUT[self.style]]()

    def build_radio_list(self):
        # Measured on the originals (tests/test_shutdown_reference.py): the question's top margin, the gap
        # under it, the options' spacing and the buttons' bottom margin.
        top, gap, spacing, bottom = {"1995": (22, 12, 5, 12), "1998": (22, 12, 3, 10)}[self.style]
        self.radios = [QRadioButton(label) for _, label in self.choices]
        chosen = self.radios[[choice for choice, _ in self.choices].index(SHUT_DOWN)]
        chosen.setChecked(True)
        options = QVBoxLayout()
        options.setSpacing(spacing)
        options.addWidget(QLabel(QUESTIONS[self.style]))
        options.addSpacing(gap)
        for radio, (choice, _) in zip(self.radios, self.choices, strict=True):
            radio.setToolTip(chicago95ui.fill_placeholders(DESCRIPTIONS[choice], self.look))
            options.addWidget(radio)
        options.addStretch()

        upper = QHBoxLayout()
        upper.setSpacing(12)
        upper.addWidget(dialog_icon("system-shutdown"))
        upper.addLayout(options)

        labels = ("&Yes", "&No", "&Help") if self.style == "1995" else ("OK", "Cancel", "&Help")
        buttons, _ = dialog_buttons(self, labels)
        layout = QVBoxLayout(self.body)
        layout.setContentsMargins(12, top, 12, bottom)
        layout.addLayout(upper)
        layout.addLayout(buttons)
        chosen.setFocus()  # the originals open with the chosen option focused

    def build_combo_list(self):
        # Positions measured on the original's client area (tests/test_shutdown_reference.py).
        body = self.body
        BrandBanner(self.look, body).setGeometry(0, 1, 409, 77)
        icon = dialog_icon("system-shutdown")
        icon.setParent(body)
        icon.move(22, 89)
        QLabel(QUESTIONS[self.style], body).move(65, 91)
        self.combo = QComboBox(body)
        self.combo.setGeometry(65, 111, 260, 21)
        for choice, label in self.choices:
            self.combo.addItem(chicago95ui.fill_placeholders(label, self.look), choice)
            description = DESCRIPTIONS_BY_STYLE.get(self.style, DESCRIPTIONS)[choice]
            self.combo.setItemData(
                self.combo.count() - 1, chicago95ui.fill_placeholders(description, self.look), Qt.ToolTipRole
            )
        self.combo.setCurrentIndex([choice for choice, _ in self.choices].index(SHUT_DOWN))
        self.description = QLabel(body)
        self.description.setWordWrap(True)
        self.description.setGeometry(65, 135, 280, 34)
        self.combo.currentIndexChanged.connect(self.describe)
        self.describe()
        self.combo.setFocus()  # the original opens with the choice focused
        # The original's buttons are 75x23 at x 163, 244 and 325. Qt draws a button's bottom and right edges
        # 1px inside its rectangle, and a non-default button's left edge too, so the rectangles grow to match.
        for x, label in zip((163, 244, 325), ("OK", "Cancel", "Help"), strict=False):
            button = QPushButton(label, body)
            button.setGeometry(x if label == "OK" else x - 1, 211, 76 if label == "OK" else 77, 24)
            button.setToolTip(
                {
                    "OK": "Performs the selected action.",
                    "Cancel": "Closes this dialog without changing your session.",
                    "Help": "Help is not available.",
                }[label]
            )
            if label == "OK":
                button.setDefault(True)
                button.clicked.connect(self.accept)
            elif label == "Cancel":
                button.clicked.connect(self.reject)
            else:
                button.setEnabled(False)

    def describe(self):
        descriptions = DESCRIPTIONS_BY_STYLE.get(self.style, DESCRIPTIONS)
        text = chicago95ui.fill_placeholders(descriptions[self.combo.currentData()], self.look)
        self.description.setText(text)
        self.combo.setToolTip(text)

    def accept(self):
        if LAYOUT[self.style] == "combo":
            self.choice = self.combo.currentData()
        else:
            self.choice = self.choices[next(index for index, radio in enumerate(self.radios) if radio.isChecked())][0]
        super().accept()


def run_command(argv, dry_run):
    if dry_run:
        print("dry-run, would run:", " ".join(argv))
        return
    subprocess.Popen(argv)


class ShutdownStipple(QWidget):
    """9x dims the desktop with alternating black pixels, preserving its colours."""

    def __init__(self, screen):
        super().__init__(None, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.WindowDoesNotAcceptFocus)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setAttribute(Qt.WA_ShowWithoutActivating)
        self.setWindowTitle("Chicago95 shutdown backdrop")
        self.winId()
        self.windowHandle().setScreen(screen)
        self.setGeometry(screen.geometry())
        tile = QImage(2, 2, QImage.Format_ARGB32_Premultiplied)
        tile.fill(Qt.transparent)
        tile.setPixelColor(0, 0, QColor(Qt.black))
        tile.setPixelColor(1, 1, QColor(Qt.black))
        self.pattern = QBrush(QPixmap.fromImage(tile))

    def paintEvent(self, _event):
        painter = QPainter(self)
        # A dot is one physical pixel, including at fractional desktop scaling.
        ratio = self.devicePixelRatioF()
        painter.scale(1 / ratio, 1 / ratio)
        painter.fillRect(QRect(0, 0, round(self.width() * ratio), round(self.height() * ratio)), self.pattern)


def shutdown_backdrops(dialog):
    if not isinstance(dialog, ShutDownDialog) or dialog.style not in ("1995", "1998"):
        return []
    ensure_luna_grayscale_effect()  # also owns the backdrop animation exclusion
    overlays = [ShutdownStipple(screen) for screen in QGuiApplication.screens()]
    for overlay in overlays:
        overlay.showFullScreen()
    dialog.winId()
    for overlay in overlays:
        if overlay.screen() == dialog.screen():
            dialog.windowHandle().setTransientParent(overlay.windowHandle())
            break
    return overlays


def ask(dialog):
    overlays = shutdown_backdrops(dialog)
    try:
        dialog.show()
        centre_on_screen(dialog)
        dialog.raise_()
        return dialog.exec() == QDialog.Accepted
    finally:
        if overlays:
            dialog.windowHandle().setTransientParent(None)
        for overlay in overlays:
            overlay.close()
            overlay.deleteLater()


def ensure_luna_grayscale_effect():
    """Recover an enabled but unloaded effect before the compositor sees the dialog."""
    try:
        subprocess.run(
            [
                "gdbus",
                "call",
                "--session",
                "--dest",
                "org.kde.KWin",
                "--object-path",
                "/Effects",
                "--method",
                "org.kde.kwin.Effects.loadEffect",
                "chicago95shutdown",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        # The chooser remains usable outside KWin or without a session bus.
        pass


def luna_branding():
    """What the XP dialogs name: the branded system's short name ("Log Off Fedora Linux") and its logo."""
    look = chicago95ui.look_settings()
    return {"logo": look["osLogo"], "name": chicago95ui.short_os_name(look["osName"])}


def ask_luna_choice(dialog_class, choices_by_command):
    """The choice a Luna dialog's button stands for, or None when it was cancelled."""
    chosen = []
    commands = {name: (lambda choice=choice: chosen.append(choice)) for name, choice in choices_by_command.items()}
    commands["cancel"] = lambda: None
    ensure_luna_grayscale_effect()
    return chosen[0] if ask(dialog_class(commands, **luna_branding())) else None


def luna_turn_off_choice():
    import chicago95lunadialogs

    return ask_luna_choice(
        chicago95lunadialogs.TurnOffDialog, {"turn_off": SHUT_DOWN, "restart": RESTART, "stand_by": STAND_BY}
    )


def luna_log_off_choice():
    import chicago95lunadialogs

    return ask_luna_choice(chicago95lunadialogs.LogOffDialog, {"log_off": LOG_OFF, "switch_user": SWITCH_USER})


def luna_dialogs_wanted():
    return chicago95ui.look_settings()["widgetStyle"] == "luna"


def screenshot_dialog(log_off):
    if luna_dialogs_wanted():
        import chicago95lunadialogs

        names = ("turn_off", "restart", "stand_by", "hibernate", "cancel", "log_off", "switch_user")
        dialog_class = chicago95lunadialogs.LogOffDialog if log_off else chicago95lunadialogs.TurnOffDialog
        return dialog_class({name: (lambda: None) for name in names}, **luna_branding())
    return LogOffDialog() if log_off else ShutDownDialog()


def shutting_down_screen(geometry, hold_until_input):
    if not luna_dialogs_wanted():
        return SafeScreen(geometry, hold_until_input)
    import chicago95lunashutdown

    return chicago95lunashutdown.ShuttingDownScreen(geometry, hold_until_input)


def turn_off_choice():
    """What the user picked in the Shut Down dialog of the look, or None when it was cancelled."""
    if luna_dialogs_wanted():
        return luna_turn_off_choice()
    dialog = ShutDownDialog()
    return dialog.choice if ask(dialog) else None


def log_off_choice():
    """LOG_OFF or SWITCH_USER as picked in the Log Off dialog of the look, or None when it was cancelled."""
    if luna_dialogs_wanted():
        return luna_log_off_choice()
    return LOG_OFF if ask(LogOffDialog()) else None


def log_off(choice, dry_run, dbus_prefix):
    commands = {
        LOG_OFF: lambda: [shutdown_command(LOG_OFF, dbus_prefix)],
        SWITCH_USER: switch_user_commands,
        None: list,
    }[choice]()
    for command in commands:
        run_command(command, dry_run)


def session_end_text(choice, look):
    return SESSION_END_SUMMARIES[choice].format(os=os_name(look)), SESSION_END_BODY


class SessionEndNotice(QObject):
    """A notification saying the session is ending, with Cancel, that runs the action after delay_ms unless Cancel
    came first. Cancel later is the notification daemon's: it answers KWin's Cancel Logout prompt for the user.
    Finishes once the action ran, was cancelled, or its notification closed."""

    finished = Signal()

    def __init__(self, bus, choice, look, action, delay_ms=0):
        super().__init__()
        self.bus, self.choice, self.look, self.action, self.delay_ms = bus, choice, look, action, delay_ms
        self.notification_id = None
        self.cancelled = False

    def start(self):
        summary, body = session_end_text(self.choice, self.look)
        self.bus.add_signal_receiver(self.action_invoked, "ActionInvoked", NOTIFICATIONS)
        self.bus.add_signal_receiver(self.notification_closed, "NotificationClosed", NOTIFICATIONS)
        hints = dbus.Dictionary({chicago95ui.SESSION_END_HINT: dbus.Boolean(True)}, signature="sv")
        dbus.Interface(self.bus.get_object(NOTIFICATIONS, NOTIFICATIONS_PATH), NOTIFICATIONS).Notify(
            "Chicago95",
            dbus.UInt32(0),
            "system-shutdown",
            summary,
            body,
            ["cancel", "Cancel"],
            hints,
            dbus.Int32(NOTICE_TIMEOUT_MS),
            reply_handler=self.shown,
            error_handler=lambda _error: None,
        )
        QTimer.singleShot(self.delay_ms, self.run)

    def shown(self, notification_id):
        self.notification_id = int(notification_id)

    def run(self):
        if not self.cancelled:
            self.action()
        self.finished.emit()

    def action_invoked(self, notification_id, key):
        if int(notification_id) == self.notification_id and key == "cancel":
            self.cancelled = True

    def notification_closed(self, notification_id, _reason):
        if int(notification_id) == self.notification_id:
            self.finished.emit()


def end_session(app, bus, choice, look, action, delay_ms=0):
    """Announces the choice (SessionEndNotice), runs action after delay_ms unless cancelled, then returns."""
    notice = SessionEndNotice(bus, choice, look, action, delay_ms)
    notice.finished.connect(app.quit)
    notice.start()
    return app.exec()


def play_shutdown_sound(dry_run):
    sound_file, player = shutdown_sound_file(), sound_player()
    if sound_file and player:
        run_command([player, sound_file], dry_run)


LOGIN_BANNER_SIZE = (411, 93)


def render_login_banner(look, path, scale=4):
    """The login screen's 2000 banner as a PNG, scale times the original's pixels: the login theme can't
    run this code, so Setup draws the banner here and copies the picture next to the theme."""
    original = {"2000": ("Windows 2000", "2000-logon-banner.png"), "2001": ("Windows XP", "xp-logon-banner.png")}.get(
        look.get("style")
    )
    default_logos = ("", "waving-flag.png", "logo-flag-16.png", "logo-xp-16.png")
    if (
        original
        and look.get("osName", "").startswith(original[0])
        and look.get("osCompany", "Microsoft") == "Microsoft"
        and os.path.basename(look.get("osLogo", "")) in default_logos
    ):
        # Original static banner artwork; custom branding still uses the drawn layout.
        candidates = [
            os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "data", original[1]),
            os.path.expanduser("~/.local/share/chicago95/" + original[1]),
        ]
        for candidate in candidates:
            image = QImage(candidate)
            if not image.isNull():
                return image.scaled(
                    image.width() * scale, image.height() * scale, Qt.IgnoreAspectRatio, Qt.FastTransformation
                ).save(str(path))
    banner = BrandBanner(look, login=True)
    banner.resize(*LOGIN_BANNER_SIZE)
    image = QImage(LOGIN_BANNER_SIZE[0] * scale, LOGIN_BANNER_SIZE[1] * scale, QImage.Format_ARGB32)
    image.fill(Qt.white)
    painter = QPainter(image)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.scale(scale, scale)
    banner.render(painter, QPoint())
    painter.end()
    return image.save(str(path))


def grab_widget(widget, path):
    widget.show()
    widget.grab().save(path)
    print("saved", path)


def luna_screen(app, hold_until_input, status, later_status=None):
    """The Luna look's full-screen "Logging off..." screen, its status turning to later_status halfway through the
    wait; None in the classic looks, which have none."""
    if not luna_dialogs_wanted():
        return None
    screen = shutting_down_screen(virtual_screen_geometry(app), hold_until_input=hold_until_input)
    screen.set_status(status)
    if later_status:
        QTimer.singleShot(SAFE_SCREEN_DELAY_MS // 2, lambda: screen.set_status(later_status))
    screen.showFullScreen()
    return screen


def screen_delay(screen):
    return SAFE_SCREEN_DELAY_MS if screen else 0


def session_bus():
    from dbus.mainloop.glib import DBusGMainLoop

    return dbus.SessionBus(mainloop=DBusGMainLoop())


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Shut Down dialog for KDE")
    parser.add_argument("--log-off", action="store_true", help="ask to log off instead of the Shut Down choices")
    parser.add_argument("--dry-run", action="store_true", help="print commands instead of running them")
    parser.add_argument("--screenshot", metavar="PATH", help="save the dialog as PNG and exit")
    parser.add_argument("--screenshot-safe", metavar="PATH", help="save the safe screen at 1280x720 and exit")
    parser.add_argument("--login-banner", metavar="PATH", help="save the login screen's 2000 banner as PNG and exit")
    args = parser.parse_args()

    app = chicago95ui.make_app("chicago95-shutdown")
    QIcon.setThemeSearchPaths(list(ICON_DIRS) + QIcon.themeSearchPaths())

    if args.screenshot:
        grab_widget(screenshot_dialog(args.log_off), args.screenshot)
        return 0
    if args.login_banner:
        return 0 if render_login_banner(chicago95ui.look_settings(), args.login_banner) else 1
    if args.screenshot_safe:
        grab_widget(shutting_down_screen(QRect(0, 0, 1280, 720), hold_until_input=False), args.screenshot_safe)
        return 0

    if args.log_off:
        choice = log_off_choice()
        if choice == LOG_OFF and not args.dry_run:
            screen = luna_screen(app, False, "Logging off...")
            action = functools.partial(log_off, choice, False, dbus_caller())
            return end_session(app, session_bus(), choice, chicago95ui.look_settings(), action, screen_delay(screen))
        if choice == LOG_OFF and luna_dialogs_wanted():
            screen = luna_screen(app, True, "Logging off...")

            def finish_logoff():
                log_off(choice, args.dry_run, dbus_caller())

            QTimer.singleShot(SAFE_SCREEN_DELAY_MS, finish_logoff)
            screen.destroyed.connect(app.quit)
            return app.exec()
        log_off(choice, args.dry_run, dbus_caller())
        return 0

    choice = turn_off_choice()
    if choice is None:
        return 0

    command = shutdown_command(choice, dbus_caller())
    if choice in (DOS_MODE, STAND_BY, HIBERNATE) or (choice == LOG_OFF and args.dry_run):
        run_command(command, args.dry_run)
        return 0

    # This process runs inside the user's session. It cannot know when all
    # services have stopped, and must never announce that power is safe to cut.
    if not args.dry_run:
        screen = luna_screen(app, False, "Logging off...", "Windows is shutting down...") if choice != LOG_OFF else None
        if choice != LOG_OFF:
            play_shutdown_sound(False)
        action = functools.partial(run_command, command, False)
        return end_session(app, session_bus(), choice, chicago95ui.look_settings(), action, screen_delay(screen))
    if not luna_dialogs_wanted():
        play_shutdown_sound(args.dry_run)
        run_command(command, args.dry_run)
        return 0

    safe_screen = luna_screen(app, True, "Logging off...", "Windows is shutting down...")
    play_shutdown_sound(args.dry_run)
    QTimer.singleShot(SAFE_SCREEN_DELAY_MS, lambda: run_command(command, args.dry_run))
    safe_screen.destroyed.connect(app.quit)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
