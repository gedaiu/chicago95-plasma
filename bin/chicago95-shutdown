def os_name(look):
    """The OS name used in messages: osName up to its first digit ("Windows2026" -> "Windows")."""
    return chicago95ui.short_os_name(look.get("osName", look.get("bannerText", "")))


KDE_SHUTDOWN_METHODS = {
    SHUT_DOWN: "org.kde.Shutdown.logoutAndShutdown",
    RESTART: "org.kde.Shutdown.logoutAndReboot",
    LOG_OFF: "org.kde.Shutdown.logout",
}

SYSTEMCTL_FALLBACKS = {
    SHUT_DOWN: ["systemctl", "poweroff"],
    RESTART: ["systemctl", "reboot"],
    LOG_OFF: ["loginctl", "terminate-session", os.environ.get("XDG_SESSION_ID", "self")],
}

# Log off, shut down and restart announce themselves at the screen's corner, with Cancel (SessionEndNotice).
SESSION_END_SUMMARIES = {
    LOG_OFF: "Logging off...",
    SHUT_DOWN: "{os} is shutting down...",
    RESTART: "{os} is restarting...",
}
SESSION_END_BODY = "Waiting for your programs to close."
NOTIFICATIONS = "org.freedesktop.Notifications"
NOTIFICATIONS_PATH = "/org/freedesktop/Notifications"
# Outlasts KWin's two minutes before it logs out anyway; the daemon closes it sooner when the logout is cancelled.
NOTICE_TIMEOUT_MS = 180_000

SAFE_TEXT = "It's now safe to turn off\nyour computer."
SAFE_ORANGE = QColor("#FFA500")
SAFE_FONT_PREFERENCES = (
    "Fixedsys Excelsior",
    "IBM VGA 8x16",
    "Px437 IBM VGA8",
    "More Perfect DOS VGA",
    "Less Perfect DOS VGA",
    "Monospace",
)
SAFE_SCREEN_DELAY_MS = 2500

ICON_DIRS = (
    os.path.expanduser("~/.local/share/icons"),
    "/usr/share/icons",
)

SOUND_ROOTS = (
    os.path.expanduser("~/.local/share/sounds"),
    "/usr/share/sounds",
)
KDEGLOBALS = os.path.expanduser("~/.config/kdeglobals")


def dbus_caller():
    if shutil.which("gdbus"):
        return ["gdbus", "call", "--session", "--dest", "org.kde.Shutdown", "--object-path", "/Shutdown", "--method"]
    qdbus = shutil.which("qdbus6") or shutil.which("qdbus")
    if qdbus:
        return [os.path.basename(qdbus), "org.kde.Shutdown", "/Shutdown"]
    return None


def shutdown_command(choice, dbus_prefix=None):
    if choice == DOS_MODE:
        return ["konsole"]
    if choice == STAND_BY:
        return ["systemctl", "suspend"]
    if choice == HIBERNATE:
        return ["systemctl", "hibernate"]
    if dbus_prefix:
        return dbus_prefix + [KDE_SHUTDOWN_METHODS[choice]]
    return SYSTEMCTL_FALLBACKS[choice]


def switch_user_commands():
    """Lock this session first so it is not left open behind the greeter the other user logs in from."""
    seat = os.environ.get("XDG_SEAT_PATH", "/org/freedesktop/DisplayManager/Seat0")
    return [
        ["loginctl", "lock-session"],
        [
            "gdbus",
            "call",
            "--system",
            "--dest",
            "org.freedesktop.DisplayManager",
            "--object-path",
            seat,
            "--method",
            "org.freedesktop.DisplayManager.Seat.SwitchToGreeter",
        ],
    ]


def chosen_sound_theme(kdeglobals_path=KDEGLOBALS):
    try:
        with open(kdeglobals_path) as kdeglobals:
            text = kdeglobals.read()
    except OSError:
        return "Chicago95"
    sounds_group = re.search(r"^\[Sounds\]\n((?:[^\[].*\n?)*)", text, re.MULTILINE)
    theme = sounds_group and re.search(r"^Theme=(.+)$", sounds_group.group(1), re.MULTILINE)
    return theme.group(1).strip() if theme else "Chicago95"


def shutdown_sound_file(theme=None):
    return chicago95ui.sound_file(theme or chosen_sound_theme(), "system-shutdown", SOUND_ROOTS)


def sound_player():
    return shutil.which("pw-play") or shutil.which("paplay")


def pick_safe_font_family():
    installed = set(QFontDatabase.families())
    return next((family for family in SAFE_FONT_PREFERENCES if family in installed), "Monospace")


def fit_safe_font(family, screen_width):
    font = QFont(family, 36)
    widest_line = max(SAFE_TEXT.splitlines(), key=len)
    measured = QFontMetrics(font).horizontalAdvance(widest_line)
    font.setPointSizeF(36 * (screen_width / 3) / measured)
    return font


def virtual_screen_geometry(app):
    geometry = QRect()
    for screen in app.screens():
        geometry = geometry.united(screen.geometry())
    return geometry


class SafeScreen(QWidget):
    def __init__(self, geometry, hold_until_input):
        super().__init__()
        self.hold_until_input = hold_until_input
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.setAttribute(Qt.WA_DeleteOnClose)
        self.setCursor(Qt.BlankCursor)
        self.setGeometry(geometry)
        self.setAutoFillBackground(True)
        palette = self.palette()
        palette.setColor(QPalette.Window, Qt.black)
        self.setPalette(palette)

        label = QLabel(SAFE_TEXT, self)
        label.setAlignment(Qt.AlignCenter)
        label.setFont(fit_safe_font(pick_safe_font_family(), geometry.width()))
        label_palette = label.palette()
        label_palette.setColor(QPalette.WindowText, SAFE_ORANGE)
        label.setPalette(label_palette)
        layout = QVBoxLayout(self)
        layout.addWidget(label)

    def keyPressEvent(self, event):
        if self.hold_until_input:
            self.close()

    def mousePressEvent(self, event):
        if self.hold_until_input:
            self.close()


def yes_no_buttons(dialog):
    yes_button = QPushButton("&Yes")
    yes_button.setDefault(True)
    yes_button.setToolTip("Closes your programs and ends your session.")
    no_button = QPushButton("&No")
    no_button.setToolTip("Closes this dialog without logging off.")
    help_button = QPushButton("&Help")
    help_button.setEnabled(False)
    buttons = QHBoxLayout()
    buttons.setSpacing(6)
    buttons.addStretch()
    for button in (yes_button, no_button, help_button):
        button.setFixedSize(75, 23)
        buttons.addWidget(button)
    yes_button.clicked.connect(dialog.accept)
    no_button.clicked.connect(dialog.reject)
    return buttons


def dialog_icon(name):
    icon_label = QLabel()
    icon_label.setPixmap(QIcon.fromTheme(name).pixmap(32, 32))
    icon_label.setAlignment(Qt.AlignTop)
    icon_label.setFixedWidth(32)
    return icon_label


def classic_shutdown_icon(parent, size):
    import chicago95lunadialogs

    label = QLabel(parent)
    artwork = Path(chicago95lunadialogs.__file__).with_name("images") / "xp-classic-shutdown-computer.svg"
    label.setPixmap(QIcon(str(artwork)).pixmap(size, label.devicePixelRatioF()))
    return label


def centre_on_screen(dialog):
    screen_geometry = dialog.screen().availableGeometry()
    dialog.move(screen_geometry.center() - dialog.rect().center())


class LogOffDialog(chicago95ui.ClassicDialog):
    QUESTION = "Are you sure you want to log off?"

    def __init__(self, look=None):
        look = {**chicago95ui.look_settings(), **(look or {})}
        super().__init__(f"Log Off {chicago95ui.short_os_name(look['osName'])}", look["style"], (300, 110))
        self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)

        upper = QHBoxLayout()
        upper.setSpacing(12)
        upper.addWidget(dialog_icon("system-log-out"))
        upper.addWidget(QLabel(self.QUESTION), 1)

        layout = QVBoxLayout(self.body)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.addLayout(upper)
        layout.addLayout(yes_no_buttons(self))


def optional_radio_available(style):
    """Check whether the desktop has the additional action shown in the four-choice dialog."""
    if style == "1998":
        return sleep_action_available(STAND_BY, fallback=True)
    try:
        bus = dbus.SystemBus()
        service = "org.freedesktop.Accounts"
        accounts = bus.get_object(service, "/org/freedesktop/Accounts", introspect=False)
        return len(accounts.ListCachedUsers(dbus_interface=service, timeout=0.5)) > 1
    except dbus.DBusException:
        # When the desktop cannot report capability, keep the existing action visible.
        return True


def sleep_action_available(action, *, fallback=False):
    try:
        service = "org.freedesktop.login1"
        login = dbus.SystemBus().get_object(service, "/org/freedesktop/login1", introspect=False)
        method = login.CanSuspend if action == STAND_BY else login.CanHibernate
        return method(dbus_interface=f"{service}.Manager", timeout=0.5) in ("yes", "challenge")
    except dbus.DBusException:
        return fallback


class ClassicShutdownButton(QPushButton):
    def __init__(self, label, parent, *, leading_inset, dotted_frame=False):
        super().__init__(label, parent)
        self.leading_inset = leading_inset
        self.dotted_frame = dotted_frame

    def paintEvent(self, event):
        if not self.isDown() and not self.dotted_frame:
            super().paintEvent(event)
            return
        option = QStyleOptionButton()
        self.initStyleOption(option)
        painter = QStylePainter(self)
        palette = option.palette
        # The pressed outline stays one device pixel wide at the guest's larger font settings.
        scale = self.devicePixelRatioF()
        origin_x = self.leading_inset if scale == 1 else 0
        bounds = QRectF(origin_x, 0, self.width() - 1 - self.leading_inset, self.height() - 1)
        transform = painter.deviceTransform()
        device = transform.mapRect(bounds)
        outer = QRectF(*(floor(value + 0.5) for value in (device.x(), device.y(), device.width(), device.height())))
        to_logical, _ = transform.inverted()
        if self.isDown():
            rings = [(0, palette.windowText()), (1, palette.dark()), (2, palette.button())]
            if not self.dotted_frame:
                rings.extend(((4, palette.windowText()), (5, palette.button())))
            for inset, brush in rings:
                painter.fillRect(to_logical.mapRect(outer.adjusted(inset, inset, -inset, -inset)), brush)
        else:
            frame = QRectF(outer)
            if self.isDefault():
                painter.fillRect(to_logical.mapRect(frame), palette.windowText())
                frame.adjust(1, 1, -1, -1)
            bevel = ((palette.light(), palette.shadow()), (palette.button(), palette.dark()))
            for light, dark in bevel:
                painter.fillRect(to_logical.mapRect(frame), dark)
                painter.fillRect(to_logical.mapRect(frame.adjusted(0, 0, -1, -1)), light)
                frame.adjust(1, 1, -1, -1)
            painter.fillRect(to_logical.mapRect(frame), palette.button())
        if self.dotted_frame and (self.isDown() or option.state & QStyle.State_HasFocus):
            pen = QPen(palette.windowText(), 0)
            pen.setCapStyle(Qt.FlatCap)
            pen.setDashPattern([1, 1])
            painter.setPen(pen)
            painter.setBrush(Qt.NoBrush)
            painter.drawRect(to_logical.mapRect(outer.adjusted(4, 4, -5, -5)))
        painter.drawControl(QStyle.CE_PushButtonLabel, option)


class ClassicShutdownChoices(QStyledItemDelegate):
    def paint(self, painter, option, index):
        super().paint(painter, option, index)
        if not option.state & QStyle.State_Selected:
            return
        background = option.palette.highlight().color()
        colour = QColor(255 - background.red(), 255 - background.green(), 255 - background.blue())
        pen = QPen(colour, 0)
        pen.setCapStyle(Qt.FlatCap)
        pen.setDashPattern([1, 1])
        painter.save()
        painter.setPen(pen)
        painter.setBrush(Qt.NoBrush)
        painter.drawRect(option.rect.adjusted(0, 0, -1, -1))
        painter.restore()


class Windows98ShutdownRadioStyle(chicago95ui.ClassicStyle):
    def drawPrimitive(self, element, option, painter, widget=None):
        if element == QStyle.PE_FrameFocusRect:
            painter.save()
            pen = QPen(option.palette.windowText(), 1)
            pen.setCosmetic(True)
            painter.setPen(pen)
            painter.setBrush(Qt.NoBrush)
            painter.drawRect(option.rect.adjusted(-1, 0, -1, 1))
            painter.restore()
            return
        if element != QStyle.PE_IndicatorRadioButton:
            super().drawPrimitive(element, option, painter, widget)
            return
        # The guest keeps a 12-pixel indicator even when its text and spacing grow.
        transform = painter.deviceTransform()
        bounds = transform.mapRect(QRectF(option.rect))
        origin = QPointF(floor(bounds.x() + 0.5), floor(bounds.bottom() + 0.5) - 12)
        to_logical, _ = transform.inverted()
        painter.save()
        painter.translate(to_logical.map(origin))
        painter.scale(1 / transform.m11(), 1 / transform.m22())
        painter.setRenderHint(QPainter.Antialiasing, False)
        palette = option.palette
        enabled = bool(option.state & QStyle.State_Enabled)
        painter.setPen(Qt.NoPen)
        painter.setBrush(palette.base() if enabled else palette.window())
        painter.drawEllipse(QRectF(1, 1, 10, 10))
        painter.setBrush(Qt.NoBrush)
        arcs = ((0.5, palette.dark(), palette.light()), (1.5, palette.shadow(), palette.midlight()))
        for inset, dark, light in arcs:
            circle = QRectF(inset, inset, 12 - 2 * inset, 12 - 2 * inset)
            painter.setPen(QPen(dark, 1))
            painter.drawArc(circle, 45 * 16, 180 * 16)
            painter.setPen(QPen(light, 1))
            painter.drawArc(circle, 225 * 16, 180 * 16)
        if option.state & QStyle.State_On:
            painter.setPen(Qt.NoPen)
            painter.setBrush(palette.text() if enabled else palette.dark())
            painter.drawEllipse(QRectF(4, 4, 4, 4))
        painter.restore()


class BrandBanner(QWidget):
    """The 2000 dialogs' banner: white, with the layered mark and the name, over a glowing strip.

    Positions and sizes are the original's, measured from tests/references/w2kshutdown.png
    (tests/test_shutdown_reference.py); the lettering is the loading screen's scaled to fit. The login
    banner (login=True, tests/test_login_reference.py) is taller, its content 1px right and 3px lower,
    with the tagline under the edition."""

    # Sampled across the original's strip: dark teal at the ends, glowing light blue in the middle.
    STRIP = (
        (0.0, "#003355"),
        (0.049, "#00436c"),
        (0.098, "#005889"),
        (0.147, "#005a8c"),
        (0.196, "#2f76a1"),
        (0.245, "#5497c2"),
        (0.294, "#64abda"),
        (0.343, "#75b5de"),
        (0.392, "#89bede"),
        (0.441, "#98c4de"),
        (0.49, "#9cc6de"),
        (0.539, "#98c4de"),
        (0.588, "#89bede"),
        (0.637, "#75b5de"),
        (0.686, "#64abda"),
        (0.735, "#5497c2"),
        (0.784, "#2f76a1"),
        (0.833, "#005a8c"),
        (0.882, "#005788"),
        (0.931, "#00436c"),
        (1.0, "#003355"),
    )
    MARK = (40, 6)  # the banner sits 1px into the dialog, so this is the original's (40, 7)
    NAME_X, NAME_BASELINE, NUMBER_BASELINE, NAME_GAP = 111, 43, 44, 8
    WORD = dict(size=35, embolden=1.4, spacing=0)
    NUMBER = dict(size=31, spacing=-2.3)
    EDITION = dict(size=25, embolden=1.2, spacing=-0.2, baseline=64, right_offset=-1)
    COMPANY = dict(x=101, baseline=15, size=11, spacing=1.3)
    CORNER = dict(right=399, baseline=17, size=12, embolden=0.7)
    TAGLINE = dict(size=13, baseline=77)
    WHITE_HEIGHT, LOGIN_WHITE_HEIGHT, LOGIN_OFFSET, STRIP_HEIGHT = 72, 88, (1, 3), 5

    def __init__(self, look, parent=None, login=False):
        super().__init__(parent)
        self.look = look
        self.login = login
        self.white_height = self.LOGIN_WHITE_HEIGHT if login else self.WHITE_HEIGHT
        self.logo = self.load(look["osLogo"], 74)
        self.company_logo = self.load(look["companyLogo"], 20)

    @staticmethod
    def load(path, size):
        """A logo scaled to the size: pixel-art PNGs with hard edges, SVGs rendered smooth."""
        if not path or not os.path.exists(path):
            return QPixmap()
        sharp = path.endswith(".png")
        source = QPixmap(path) if sharp else QIcon(path).pixmap(size * 4, size * 4)
        return source.scaled(
            size * 4, size, Qt.KeepAspectRatio, Qt.FastTransformation if sharp else Qt.SmoothTransformation
        )

    @staticmethod
    def font(size, bold=False, italic=False, spacing=0):
        font = QFont("Arial")
        font.setPixelSize(size)
        font.setBold(bold)
        font.setItalic(italic)
        font.setStyleStrategy(
            QFont.StyleStrategy(QFont.PreferAntialias | QFont.NoSubpixelAntialias)
        )  # grey edges, no colour fringes
        font.setHintingPreference(QFont.PreferNoHinting)  # the same widths at 1x and in the 4x login banner
        if spacing:
            font.setLetterSpacing(QFont.AbsoluteSpacing, spacing)
        return font

    def paint_name(self, painter):
        """Words heavy, numbers thin, from NAME_X; returns where the name ends."""
        x = self.NAME_X
        for raw_part in re.findall(r"\d+|[^\d]+", self.look["osName"]):
            part = raw_part.strip()
            if not part:
                continue
            if part.isdigit():
                font = self.font(self.NUMBER["size"], spacing=self.NUMBER["spacing"])
                painter.setFont(font)
                painter.drawText(QPointF(x, self.NUMBER_BASELINE), part)
            else:
                font = self.font(self.WORD["size"], bold=True, spacing=self.WORD["spacing"])
                chicago95ui.draw_heavy_text(
                    painter, x, self.NAME_BASELINE, font, part, QColor(Qt.black), self.WORD["embolden"]
                )
            x += QFontMetricsF(font).horizontalAdvance(part) + self.NAME_GAP
        return x - self.NAME_GAP

    def paintEvent(self, _event):
        painter = QPainter(self)
        scale = min(1, self.height() / (self.white_height + self.STRIP_HEIGHT))
        painter.scale(scale, scale)
        width = self.width() / scale
        painter.fillRect(QRectF(0, 0, width, self.white_height), Qt.white)
        strip = QLinearGradient(0, 0, width, 0)
        for position, colour in self.STRIP:
            strip.setColorAt(position, QColor(colour))
        painter.fillRect(QRectF(0, self.white_height, width, self.STRIP_HEIGHT), strip)
        if self.login:
            painter.translate(*self.LOGIN_OFFSET)
        chicago95ui.paint_banner_mark(painter, *self.MARK, self.logo)
        painter.setPen(Qt.black)
        if self.look["osCompany"]:
            painter.setFont(self.font(self.COMPANY["size"], spacing=self.COMPANY["spacing"]))
            painter.drawText(QPointF(self.COMPANY["x"], self.COMPANY["baseline"]), self.look["osCompany"])
        name_end = self.paint_name(painter)
        edition = self.font(self.EDITION["size"], bold=True, spacing=self.EDITION["spacing"])
        edition_x = (
            name_end - QFontMetricsF(edition).horizontalAdvance(self.look["edition"]) + self.EDITION["right_offset"]
        )
        chicago95ui.draw_heavy_text(
            painter,
            edition_x,
            self.EDITION["baseline"],
            edition,
            self.look["edition"],
            QColor(Qt.black),
            self.EDITION["embolden"],
        )
        if self.login:
            painter.setFont(self.font(self.TAGLINE["size"]))
            painter.drawText(QPointF(edition_x, self.TAGLINE["baseline"]), self.look["tagline"])
        if not self.company_logo.isNull():
            x = round(width) - self.company_logo.width() - 8
            painter.drawPixmap(x, 6, self.company_logo)
        elif self.look["osCompany"]:
            # No company logo: the company's name in heavy italics takes its place, like the original's wordmark.
            corner = self.font(self.CORNER["size"], bold=True, italic=True)
            x = self.CORNER["right"] - QFontMetricsF(corner).horizontalAdvance(self.look["osCompany"])
            chicago95ui.draw_heavy_text(
                painter,
                x,
                self.CORNER["baseline"],
                corner,
                self.look["osCompany"],
                QColor(Qt.black),
                self.CORNER["embolden"],
            )
        painter.end()


class XPShutdownBanner(QWidget):
    def __init__(self, look, parent):
        super().__init__(parent)
        import chicago95lunadialogs

        self.look = look
        artwork = Path(chicago95lunadialogs.__file__).with_name("images")
        self.art = QSvgRenderer(str(artwork / "xp-classic-shutdown-banner.svg"))
        self.logo = chicago95lunadialogs.logo_picture(look["osLogo"])

    def paintEvent(self, _event):
        painter = QPainter(self)
        # XP keeps the wide banner artwork centred and crops its sides in the narrower 96-DPI window.
        scale = self.height() / 62
        painter.translate((self.width() - 384 * scale) / 2, 0)
        painter.scale(scale, scale)
        self.art.render(painter, QRectF(0, 0, 384, 62))
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setRenderHint(QPainter.SmoothPixmapTransform)
        flag_slot = QRectF(115, 6, 46, 43)
        if isinstance(self.logo, QSvgRenderer):
            self.logo.render(painter, flag_slot)
        else:
            size = self.logo.size().scaled(flag_slot.size().toSize(), Qt.KeepAspectRatio)
            target = QRectF(0, 0, size.width(), size.height())
            target.moveCenter(flag_slot.center())
            painter.drawImage(target, self.logo)

        company = self.look["osCompany"]
        name = self.look["osName"]
        painter.setPen(Qt.white)
        painter.setFont(BrandBanner.font(8))
        painter.drawText(QPointF(167, 15), company)
        suffix = name.endswith(" XP")
        name = name[:-3] if suffix else name
        title_font = BrandBanner.font(23, bold=True, spacing=-1.25)
        painter.setFont(title_font)
        name = QFontMetrics(title_font).elidedText(name, Qt.ElideRight, 178)
        painter.drawText(QPointF(167, 32), name)
        if suffix:
            painter.setPen(QColor("#f45026"))
            painter.setFont(BrandBanner.font(13, bold=True))
            painter.drawText(QPointF(167 + QFontMetricsF(title_font).horizontalAdvance(name) + 2, 24), "xp")

        painter.setPen(Qt.white)
        edition_font = BrandBanner.font(13)
        painter.setFont(edition_font)
        edition = QFontMetrics(edition_font).elidedText(self.look["edition"], Qt.ElideRight, 178)
        painter.drawText(QPointF(171, 44), edition)
        if company == "Microsoft":
            painter.setFont(BrandBanner.font(8))
            painter.drawText(QPointF(31, 45), "Copyright © 1985–2001")
            painter.drawText(QPointF(31, 53), "Microsoft Corporation")
        if company:
            font = BrandBanner.font(9, bold=True, italic=True)
            painter.setFont(font)
            painter.drawText(QPointF(353 - QFontMetricsF(font).horizontalAdvance(company), 54), company)
        painter.end()


class ShutDownDialog(chicago95ui.ClassicDialog):
    """Shut Down dialog of the chosen style: 1995 and 1998 list radio buttons, 2000 a dropdown under a banner.
    The client sizes, with the 3px frame and 18px title around them, are the originals' dialogs'
    (tests/test_shutdown_reference.py); 2000's client area starts a pixel further in."""

    BODIES = {"1995": ((340, 200), 3), "1998": ((318, 172), 3), "2000": ((409, 245), 4), "2001": ((411, 223), 3)}

    def __init__(self, look=None, *, include_optional_radio=None):
        self.look = {**chicago95ui.look_settings(), **(look or {})}
        self.style = self.look["style"] if self.look["style"] in CHOICES else "1995"
        body, inset = self.BODIES[self.style]
        super().__init__(f"Shut Down {chicago95ui.short_os_name(self.look['osName'])}", self.style, body, inset)
        self.setWindowFlags(Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        optional = OPTIONAL_RADIO_ACTION.get(self.style)
        if optional is not None and include_optional_radio is None:
            include_optional_radio = optional_radio_available(self.style)
        self.choices = [entry for entry in CHOICES[self.style] if entry[0] != optional or include_optional_radio]
        self.choice = None
        {"combo": self.build_combo_list, "radio": self.build_radio_list}[LAYOUT[self.style]]()

    def build_radio_list(self):
        self.radios = [QRadioButton(label, self.body) for _, label in self.choices]
        chosen = self.radios[[choice for choice, _ in self.choices].index(SHUT_DOWN)]
        chosen.setChecked(True)
        for radio, (choice, _) in zip(self.radios, self.choices, strict=True):
            radio.setToolTip(chicago95ui.fill_placeholders(DESCRIPTIONS[choice], self.look))
        labels = ("&Yes", "&No", "&Help") if self.style == "1995" else ("OK", "Cancel", "&Help")
        buttons = [
            ClassicShutdownButton(label, self.body, leading_inset=int(index != 0)) for index, label in enumerate(labels)
        ]
        confirm, cancel, help_button = buttons
        self.buttons = {"confirm": confirm, "cancel": cancel, "help": help_button}
        confirm.setDefault(True)
        confirm.clicked.connect(self.accept)
        cancel.clicked.connect(self.reject)
        help_button.clicked.connect(self.show_radio_help)
        confirm.setToolTip("Performs the selected action.")
        cancel.setToolTip("Closes this dialog without changing your session.")
        help_button.setToolTip("Describes the selected action.")
        if len(self.choices) == 3:
            self.place_compact_radios(buttons)
        else:
            self.layout_expanded_radios(buttons)
        chosen.setFocus()

    def show_radio_help(self):
        radio = next(radio for radio in self.radios if radio.isChecked())
        QMessageBox.information(self, self.windowTitle(), radio.toolTip())

    def place_compact_radios(self, buttons):
        # The guest dialog templates use different logical metrics at 96 and 120 DPI.
        large_fonts = self.devicePixelRatioF() >= 1.125
        win98_large = self.style == "1998" and large_fonts
        if self.style == "1995" and large_fonts:
            size, icon_size, icon_pos, question_pos = (362, 173), QSize(22, 26), (12, 18), (60, 20)
            radio_x, radio_top, pitch = 61, 43, 21
            button_x, button_y, button_pitch, button_width = 89, 138, 90, 84
        elif win98_large:
            size, icon_size, icon_pos, question_pos = (336, 146), QSize(22, 26), (12, 18), (60, 20)
            radio_x, radio_top, pitch = 61, 43, 19
            button_x, button_y, button_pitch, button_width = 62, 116, 90, 84
        elif self.style == "1995":
            size, icon_size, icon_pos, question_pos = (341, 177), QSize(27, 32), (14, 19), (56, 21)
            radio_x, radio_top, pitch = 58, 44, 21
            button_x, button_y, button_pitch, button_width = 84, 141, 84, 79
        else:
            size, icon_size, icon_pos, question_pos = (317, 149), QSize(27, 32), (14, 19), (56, 21)
            radio_x, radio_top, pitch = 58, 44, 20
            button_x, button_y, button_pitch, button_width = 59, 118, 84, 79
        self.resize_body(*size)
        classic_shutdown_icon(self.body, icon_size).move(*icon_pos)
        QLabel(QUESTIONS[self.style], self.body).move(*question_pos)
        for index, radio in enumerate(self.radios):
            radio.setGeometry(radio_x, radio_top + index * pitch, self.body.width() - radio_x - 12, 15)
        if win98_large:
            radio_style = Windows98ShutdownRadioStyle("Windows")
            radio_style.setParent(self)
            for radio in self.radios:
                radio.setProperty("captionGap", 14)
                radio.setStyle(radio_style)
        button_height = 23 if win98_large else 24
        for index, button in enumerate(buttons):
            x = button_x + index * button_pitch
            button.setGeometry(x if index == 0 else x - 1, button_y, button_width + (index != 0), button_height)

    def layout_expanded_radios(self, buttons):
        top, spacing, bottom = (22, 5, 12) if self.style == "1995" else (22, 3, 10)
        options = QVBoxLayout()
        options.setSpacing(spacing)
        options.addWidget(QLabel(QUESTIONS[self.style]))
        options.addSpacing(12)
        for radio in self.radios:
            options.addWidget(radio)
        options.addStretch()

        upper = QHBoxLayout()
        upper.setSpacing(12)
        upper.addWidget(dialog_icon("system-shutdown"))
        upper.addLayout(options)

        row = QHBoxLayout()
        row.setSpacing(6)
        row.addStretch()
        for button in buttons:
            button.setFixedSize(75, 23)
            row.addWidget(button)
        layout = QVBoxLayout(self.body)
        layout.setContentsMargins(12, top, 12, bottom)
        layout.addLayout(upper)
        layout.addLayout(row)

    def build_combo_list(self):
        # Positions measured on the original's client area (tests/test_shutdown_reference.py).
        body = self.body
        xp = self.style == "2001"
        # Both guests use different effective dialog units at 96 and 120 DPI.
        large_fonts = self.devicePixelRatioF() >= 1.125
        if large_fonts:
            self.resize_body(*((383, 204) if xp else (381, 226)))
        if xp or large_fonts:
            from chicago95luna import luna_font

            font = luna_font()
            if large_fonts:
                font.setFamilies(["Tahoma", "Liberation Sans", "Noto Sans"])
                font.setStyleStrategy(QFont.NoAntialias)
            body.setFont(font)
        if xp:
            banner = XPShutdownBanner(self.look, body)
            banner.setGeometry(0, 1, body.width(), 62 if large_fonts else 77)
            size = QSize(23, 26) if large_fonts else QSize(27, 32)
            icon = classic_shutdown_icon(body, size)
        elif large_fonts:
            BrandBanner(self.look, body).setGeometry(0, 1, body.width(), 62)
            icon = classic_shutdown_icon(body, QSize(23, 26))
        else:
            BrandBanner(self.look, body).setGeometry(0, 1, body.width(), 77)
            icon = dialog_icon("system-shutdown")
            icon.setParent(body)
        icon.move(*((19, 73) if large_fonts else (22, 89)))
        if xp and large_fonts:
            question_pos = (61, 74)
            combo_rect = (61, 94, 242, 19)
            description_rect = (61, 127, 256, 42)
            x_positions, y, width, height = (152, 227, 303), 169, 70, 23
        elif large_fonts:
            question_pos = (60, 75)
            combo_rect = (60, 94, 242, 19)
            description_rect = (60, 123, 256, 35)
            x_positions, y, width, height = (151, 226, 302), 193, 70, 23
        elif xp:
            question_pos = (66, 89)
            combo_rect = (66, 111, 260, 21)
            description_rect = (66, 141, 258, 34)
            x_positions, y, width, height = (164, 245, 326), 187, 75, 24
        else:
            question_pos = (65, 91)
            combo_rect = (65, 111, 260, 21)
            description_rect = (65, 135, 280, 34)
            x_positions, y, width, height = (163, 244, 325), 211, 75, 24
        question = QLabel(QUESTIONS[self.style], body)
        question.move(*question_pos)
        self.combo = QComboBox(body)
        self.combo.setGeometry(*combo_rect)
        if large_fonts:
            self.combo.view().window().setFrameStyle(QFrame.Box | QFrame.Plain)
            self.combo.setItemDelegate(ClassicShutdownChoices(self.combo))
        if xp:
            question.setText("&" + question.text())
            question.setBuddy(self.combo)
        for choice, label in self.choices:
            self.combo.addItem(chicago95ui.fill_placeholders(label, self.look), choice)
            self.combo.setItemData(
                self.combo.count() - 1, chicago95ui.fill_placeholders(DESCRIPTIONS[choice], self.look), Qt.ToolTipRole
            )
            if large_fonts:
                row_height = 12 if self.combo.count() == 1 else 13
                self.combo.setItemData(self.combo.count() - 1, QSize(0, row_height), Qt.SizeHintRole)
        self.combo.setCurrentIndex([choice for choice, _ in self.choices].index(SHUT_DOWN))
        self.description = QLabel(body)
        self.description.setWordWrap(True)
        if xp and large_fonts:
            self.description.setAlignment(Qt.AlignTop)
        self.description.setGeometry(*description_rect)
        self.combo.currentIndexChanged.connect(self.describe)
        self.describe()
        self.combo.setFocus()  # the original opens with the choice focused
        # Qt paints the bottom and right edges inside the rectangle, and the left edge too for ordinary buttons.
        self.buttons = {}
        labels = ("OK", "Cancel", "&Help")
        for x, role, label in zip(x_positions, ("confirm", "cancel", "help"), labels, strict=True):
            start, painted_width = (x, width + 1) if role == "confirm" else (x - 1, width + 2)
            if large_fonts:
                button = ClassicShutdownButton(label, body, leading_inset=0, dotted_frame=True)
                start, painted_width = x, width + 1
            else:
                button = QPushButton(label, body)
            self.buttons[role] = button
            button.setGeometry(start, y, painted_width, height)
            button.setToolTip(
                {
                    "confirm": "Performs the selected action.",
                    "cancel": "Closes this dialog without changing your session.",
                    "help": "Describes the selected action.",
                }[role]
            )
            if role == "confirm":
                button.setDefault(True)
                button.clicked.connect(self.accept)
            elif role == "cancel":
                button.clicked.connect(self.reject)
            else:
                button.clicked.connect(
                    lambda: QMessageBox.information(self, self.windowTitle(), self.description.text())
                )

    def describe(self):
        text = chicago95ui.fill_placeholders(DESCRIPTIONS[self.combo.currentData()], self.look)
        self.description.setText(text)
        self.combo.setToolTip(text)

    def accept(self):
        if LAYOUT[self.style] == "combo":
            self.choice = self.combo.currentData()
        else:
            self.choice = self.choices[next(index for index, radio in enumerate(self.radios) if radio.isChecked())][0]
        super().accept()


def run_command(argv, dry_run):
    if dry_run:
        print("dry-run, would run:", " ".join(argv))
        return
    subprocess.Popen(argv)


class ShutdownStipple(QWidget):
    """9x dims the desktop with alternating black pixels, preserving its colours."""

    def __init__(self, screen):
        super().__init__(None, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.WindowDoesNotAcceptFocus)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setAttribute(Qt.WA_ShowWithoutActivating)
        self.setWindowTitle("Chicago95 shutdown backdrop")
        self.winId()
        self.windowHandle().setScreen(screen)
        self.setGeometry(screen.geometry())
        tile = QImage(2, 2, QImage.Format_ARGB32_Premultiplied)
        tile.fill(Qt.transparent)
        tile.setPixelColor(0, 0, QColor(Qt.black))
        tile.setPixelColor(1, 1, QColor(Qt.black))
        self.pattern = QBrush(QPixmap.fromImage(tile))

    def paintEvent(self, _event):
        painter = QPainter(self)
        # A dot is one physical pixel, including at fractional desktop scaling.
        ratio = self.devicePixelRatioF()
        painter.scale(1 / ratio, 1 / ratio)
        painter.fillRect(QRect(0, 0, round(self.width() * ratio), round(self.height() * ratio)), self.pattern)


def shutdown_backdrops(dialog):
    if not isinstance(dialog, ShutDownDialog) or dialog.style not in ("1995", "1998"):
        return []
    ensure_luna_grayscale_effect()  # also owns the backdrop animation exclusion
    overlays = [ShutdownStipple(screen) for screen in QGuiApplication.screens()]
    for overlay in overlays:
        overlay.showFullScreen()
    dialog.winId()
    for overlay in overlays:
        if overlay.screen() == dialog.screen():
            dialog.windowHandle().setTransientParent(overlay.windowHandle())
            break
    return overlays


def ask(dialog):
    overlays = shutdown_backdrops(dialog)
    try:
        dialog.show()
        centre_on_screen(dialog)
        dialog.raise_()
        return dialog.exec() == QDialog.Accepted
    finally:
        if overlays:
            dialog.windowHandle().setTransientParent(None)
        for overlay in overlays:
            overlay.close()
            overlay.deleteLater()


def ensure_luna_grayscale_effect():
    """Recover an enabled but unloaded effect before the compositor sees the dialog."""
    try:
        subprocess.run(
            [
                "gdbus",
                "call",
                "--session",
                "--dest",
                "org.kde.KWin",
                "--object-path",
                "/Effects",
                "--method",
                "org.kde.kwin.Effects.loadEffect",
                "chicago95shutdown",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        # The chooser remains usable outside KWin or without a session bus.
        pass


def luna_branding():
    """What the XP dialogs name: the branded system's short name ("Log Off Fedora Linux") and its logo."""
    look = chicago95ui.look_settings()
    return {"logo": look["osLogo"], "name": chicago95ui.short_os_name(look["osName"])}


def ask_luna_choice(dialog_class, choices_by_command):
    """The choice a Luna dialog's button stands for, or None when it was cancelled."""
    chosen = []
    commands = {name: (lambda choice=choice: chosen.append(choice)) for name, choice in choices_by_command.items()}
    commands["cancel"] = lambda: None
    ensure_luna_grayscale_effect()
    return chosen[0] if ask(dialog_class(commands, **luna_branding())) else None


def luna_turn_off_choice():
    import chicago95lunadialogs

    return ask_luna_choice(
        chicago95lunadialogs.TurnOffDialog, {"turn_off": SHUT_DOWN, "restart": RESTART, "stand_by": STAND_BY}
    )


def luna_log_off_choice():
    import chicago95lunadialogs

    return ask_luna_choice(chicago95lunadialogs.LogOffDialog, {"log_off": LOG_OFF, "switch_user": SWITCH_USER})


def luna_dialogs_wanted():
    return chicago95ui.look_settings()["widgetStyle"] == "luna"


class AeroShutdownChoices(QStyledItemDelegate):
    def sizeHint(self, option, index):
        return QSize(super().sizeHint(option, index).width(), 13)

    def paint(self, painter, option, index):
        selected = bool(option.state & QStyle.State_Selected)
        palette = option.palette
        painter.save()
        painter.fillRect(option.rect, palette.highlight() if selected else palette.base())
        painter.setFont(option.font)
        painter.setPen(palette.highlightedText().color() if selected else palette.text().color())
        painter.drawText(option.rect.adjusted(1, 0, -1, 0), Qt.AlignLeft | Qt.AlignVCenter, index.data())
        painter.restore()


class AeroShutdownComboFace(QWidget):
    """Keep the native combo box interaction while drawing the Aero selector face."""

    def __init__(self, combo, artwork):
        super().__init__(combo)
        self.combo = combo
        self.artwork = artwork
        self.setAttribute(Qt.WA_TransparentForMouseEvents)
        self.setGeometry(combo.rect())
        combo.currentIndexChanged.connect(self.update)

    def paintEvent(self, _event):
        option = QStyleOptionComboBox()
        self.combo.initStyleOption(option)
        painter = QStylePainter(self, self.combo)
        option.subControls &= ~QStyle.SC_ComboBoxArrow
        option.state &= ~QStyle.State_HasFocus
        painter.drawComplexControl(QStyle.CC_ComboBox, option)

        label = QStyle.visualRect(option.direction, self.rect(), self.rect().adjusted(3, 3, -20, -3))
        painter.setPen(option.palette.buttonText().color())
        text = option.fontMetrics.elidedText(option.currentText, Qt.ElideRight, label.width())
        painter.drawText(label, Qt.AlignLeading | Qt.AlignVCenter, text)

        arrow = QRect(self.width() - 12, (self.height() - 4 + 1) // 2, 7, 4)
        arrow = QStyle.visualRect(option.direction, self.rect(), arrow)
        self.artwork.render(painter, "choice-arrow", QRectF(arrow))
        if self.combo.hasFocus():
            painter.setCompositionMode(QPainter.CompositionMode_Difference)
            pen = QPen(Qt.white, 0)
            pen.setCapStyle(Qt.FlatCap)
            pen.setDashPattern([1, 1])
            painter.setPen(pen)
            painter.setBrush(Qt.NoBrush)
            painter.drawRect(label.adjusted(0, 0, -1, -1))


class AeroSessionDialog(QDialog):
    """A native decorated session dialog using the current Qt controls and KWin frame."""

    actions = {
        SHUT_DOWN: ("Shut down", "Closes all open programs and turns off the computer.", "system-shutdown"),
        RESTART: ("Restart", "Closes all open programs and restarts the computer.", "system-reboot"),
        LOG_OFF: ("Log off", "Closes your programs and ends your session.", "system-log-out"),
    }

    def __init__(self, choice=None):
        super().__init__()
        self.choice = SHUT_DOWN if choice is None else choice
        label, description, icon = self.actions[self.choice]
        self.setWindowFlags(Qt.Dialog | Qt.CustomizeWindowHint | Qt.WindowTitleHint | Qt.WindowCloseButtonHint)
        if choice is None:
            self.build_chooser(chicago95ui.look_settings())
            return

        self.setWindowIcon(QIcon.fromTheme(icon))
        self.setWindowTitle(label)
        self.setMinimumWidth(350)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        panel = QWidget()
        panel.setObjectName("sessionContent")
        panel.setStyleSheet("#sessionContent { background: white; border-bottom: 1px solid #dadada; }")
        content = QHBoxLayout(panel)
        content.setContentsMargins(18, 16, 18, 16)
        content.setSpacing(14)
        content.addWidget(dialog_icon(icon), 0, Qt.AlignTop)
        fields = QVBoxLayout()
        heading = QLabel(f"Are you sure you want to {label.lower()}?")
        heading.setStyleSheet("color: #003399; font-size: 15px;")
        fields.addWidget(heading)
        detail = QLabel(description)
        detail.setWordWrap(True)
        fields.addWidget(detail)
        content.addLayout(fields)
        layout.addWidget(panel)
        buttons = QDialogButtonBox(QDialogButtonBox.Cancel)
        confirm = buttons.addButton(label, QDialogButtonBox.AcceptRole)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        buttons.button(QDialogButtonBox.Cancel).setDefault(True)
        confirm.setAutoDefault(False)
        buttons.setContentsMargins(10, 8, 10, 8)
        layout.addWidget(buttons)

    def build_chooser(self, look):
        self.setWindowTitle(f"Shut Down {os_name(look)}")
        self.setWindowIcon(QIcon.fromTheme("computer"))
        self.setFixedSize(458, 223)
        font = chicago95ui.ui_font()
        font.setFamilies(["Segoe UI", "Selawik", "Noto Sans"])
        self.setFont(font)
        self.setObjectName("aeroShutdownChooser")
        self.setStyleSheet("#aeroShutdownChooser { background-color: #f0f0f0; }")

        logo = QLabel(self)
        logo.setAlignment(Qt.AlignCenter)
        logo.setGeometry(48, 17, 39, 37)
        logo.setPixmap(QIcon(look["osLogo"]).pixmap(QSize(39, 37), self.devicePixelRatioF()))
        name, edition = escape(look["osName"]), escape(look["edition"])
        title = QLabel(self)
        title.setGeometry(94, 12, 354, 50)
        heading = (
            '<span style="font-size:{name_size}px">{name}</span> '
            '<span style="font-size:{edition_size}px">{edition}</span>'
        )
        title.setText(heading.format(name_size=34, edition_size=26, name=name, edition=edition))
        if title.sizeHint().width() > title.width():
            scale = title.width() / title.sizeHint().width()
            title.setText(
                heading.format(
                    name_size=max(1, int(34 * scale)), edition_size=max(1, int(26 * scale)), name=name, edition=edition
                )
            )

        icon = dialog_icon("computer")
        icon.setParent(self)
        icon.move(20, 85)
        question = QLabel("&What do you want the computer to do?", self)
        question.setGeometry(66, 79, 317, 20)
        artwork = aero_button_artwork()
        self.combo = QComboBox(self)
        self.combo.setGeometry(66, 105, 317, 21)
        if artwork.elementExists("choice-arrow"):
            self.combo_face = AeroShutdownComboFace(self.combo, artwork)
        question.setBuddy(self.combo)
        popup = self.combo.view().window()
        popup.setFrameStyle(QFrame.Box | QFrame.Plain)
        popup.setObjectName("aeroShutdownDropdown")
        popup.setStyleSheet("#aeroShutdownDropdown { border: 1px solid #646464; }")
        palette = popup.palette()
        palette.setColor(QPalette.Highlight, QColor("#3399ff"))
        palette.setColor(QPalette.HighlightedText, Qt.white)
        popup.setPalette(palette)
        self.combo.view().setPalette(palette)
        self.combo.setItemDelegate(AeroShutdownChoices(self.combo))
        system = os_name(look)
        options = [
            (SWITCH_USER, "Switch user", "Switch users without closing programs."),
            (LOG_OFF, "Log off", "Close programs and log off."),
            (RESTART, "Restart", f"Closes all open programs, shuts down {system}, and then starts {system} again."),
        ]
        if sleep_action_available(STAND_BY):
            options.append((STAND_BY, "Sleep", "Keeps your session in memory while the computer uses less power."))
        if sleep_action_available(HIBERNATE):
            options.append(
                (
                    HIBERNATE,
                    "Hibernate",
                    f"Saves your session and turns off the computer. When you turn on the "
                    f"computer, {system} restores your session.",
                )
            )
        options.append(
            (
                SHUT_DOWN,
                "Shut down",
                f"Closes all open programs, shuts down {system}, and then turns off your computer.",
            )
        )
        descriptions = {}
        for action, name, description in options:
            self.combo.addItem(name, action)
            descriptions[action] = description
        self.combo.setCurrentIndex(self.combo.findData(SHUT_DOWN))
        self.description = QLabel(self)
        self.description.setWordWrap(True)
        self.description.setAlignment(Qt.AlignTop)
        self.description.setGeometry(66, 137, 317, 35)

        def select_action():
            self.choice = self.combo.currentData()
            self.description.setText(descriptions[self.choice])

        self.combo.currentIndexChanged.connect(select_action)
        select_action()
        confirm = AeroDialogButton("OK", artwork, self)
        confirm.setGeometry(210, 187, 73, 21)
        confirm.clicked.connect(self.accept)
        confirm.setDefault(True)
        cancel = AeroDialogButton("Cancel", artwork, self)
        cancel.setGeometry(291, 187, 73, 21)
        cancel.clicked.connect(self.reject)
        help_button = AeroDialogButton("&Help", artwork, self)
        help_button.setGeometry(372, 187, 73, 21)
        help_button.clicked.connect(lambda: QMessageBox.information(self, self.windowTitle(), self.description.text()))
        self.buttons = {"confirm": confirm, "cancel": cancel, "help": help_button}
        self.combo.setFocus()


def screenshot_dialog(log_off, action=None, *, include_optional_radio=None):
    if action is not None or chicago95ui.widget_style() == "aero":
        return AeroSessionDialog(LOG_OFF if log_off else action)
    if luna_dialogs_wanted():
        import chicago95lunadialogs

        names = ("turn_off", "restart", "stand_by", "hibernate", "cancel", "log_off", "switch_user")
        dialog_class = chicago95lunadialogs.LogOffDialog if log_off else chicago95lunadialogs.TurnOffDialog
        return dialog_class({name: (lambda: None) for name in names}, **luna_branding())
    return LogOffDialog() if log_off else ShutDownDialog(include_optional_radio=include_optional_radio)


def shutting_down_screen(geometry, hold_until_input):
    if not luna_dialogs_wanted():
        return SafeScreen(geometry, hold_until_input)
    import chicago95lunashutdown

    return chicago95lunashutdown.ShuttingDownScreen(geometry, hold_until_input)


def turn_off_choice():
    """What the user picked in the Shut Down dialog of the look, or None when it was cancelled."""
    if luna_dialogs_wanted():
        return luna_turn_off_choice()
    dialog = AeroSessionDialog() if chicago95ui.widget_style() == "aero" else ShutDownDialog()
    return dialog.choice if ask(dialog) else None


def log_off_choice():
    """LOG_OFF or SWITCH_USER as picked in the Log Off dialog of the look, or None when it was cancelled."""
    if luna_dialogs_wanted():
        return luna_log_off_choice()
    dialog = AeroSessionDialog(LOG_OFF) if chicago95ui.widget_style() == "aero" else LogOffDialog()
    return LOG_OFF if ask(dialog) else None


def log_off(choice, dry_run, dbus_prefix):
    commands = {
        LOG_OFF: lambda: [shutdown_command(LOG_OFF, dbus_prefix)],
        SWITCH_USER: switch_user_commands,
        None: list,
    }[choice]()
    for command in commands:
        run_command(command, dry_run)


def session_end_text(choice, look):
    return SESSION_END_SUMMARIES[choice].format(os=os_name(look)), SESSION_END_BODY


class SessionEndNotice(QObject):
    """A notification saying the session is ending, with Cancel, that runs the action after delay_ms unless Cancel
    came first. Cancel later is the notification daemon's: it answers KWin's Cancel Logout prompt for the user.
    Finishes once the action ran, was cancelled, or its notification closed."""

    finished = Signal()

    def __init__(self, bus, choice, look, action, delay_ms=0):
        super().__init__()
        self.bus, self.choice, self.look, self.action, self.delay_ms = bus, choice, look, action, delay_ms
        self.notification_id = None
        self.cancelled = False

    def start(self):
        summary, body = session_end_text(self.choice, self.look)
        self.bus.add_signal_receiver(self.action_invoked, "ActionInvoked", NOTIFICATIONS)
        self.bus.add_signal_receiver(self.notification_closed, "NotificationClosed", NOTIFICATIONS)
        hints = dbus.Dictionary({chicago95ui.SESSION_END_HINT: dbus.Boolean(True)}, signature="sv")
        dbus.Interface(self.bus.get_object(NOTIFICATIONS, NOTIFICATIONS_PATH), NOTIFICATIONS).Notify(
            "Chicago95",
            dbus.UInt32(0),
            "system-shutdown",
            summary,
            body,
            ["cancel", "Cancel"],
            hints,
            dbus.Int32(NOTICE_TIMEOUT_MS),
            reply_handler=self.shown,
            error_handler=lambda _error: None,
        )
        QTimer.singleShot(self.delay_ms, self.run)

    def shown(self, notification_id):
        self.notification_id = int(notification_id)

    def run(self):
        if not self.cancelled:
            self.action()
        self.finished.emit()

    def action_invoked(self, notification_id, key):
        if int(notification_id) == self.notification_id and key == "cancel":
            self.cancelled = True

    def notification_closed(self, notification_id, _reason):
        if int(notification_id) == self.notification_id:
            self.finished.emit()


def end_session(app, bus, choice, look, action, delay_ms=0):
    """Announces the choice (SessionEndNotice), runs action after delay_ms unless cancelled, then returns."""
    notice = SessionEndNotice(bus, choice, look, action, delay_ms)
    notice.finished.connect(app.quit)
    notice.start()
    return app.exec()


def play_shutdown_sound(dry_run):
    sound_file, player = shutdown_sound_file(), sound_player()
    if sound_file and player:
        run_command([player, sound_file], dry_run)


LOGIN_BANNER_SIZE = (411, 93)


def render_login_banner(look, path, scale=4):
    """The login screen's 2000 banner as a PNG, scale times the original's pixels: the login theme can't
    run this code, so Setup draws the banner here and copies the picture next to the theme."""
    original = {"2000": ("Windows 2000", "2000-logon-banner.png"), "2001": ("Windows XP", "xp-logon-banner.png")}.get(
        look.get("style")
    )
    default_logos = ("", "waving-flag.png", "logo-flag-16.png", "logo-xp-16.png")
    if (
        original
        and look.get("osName", "").startswith(original[0])
        and look.get("osCompany", "Microsoft") == "Microsoft"
        and os.path.basename(look.get("osLogo", "")) in default_logos
    ):
        # Original static banner artwork; custom branding still uses the drawn layout.
        candidates = [
            os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "data", original[1]),
            os.path.expanduser("~/.local/share/chicago95/" + original[1]),
        ]
        for candidate in candidates:
            image = QImage(candidate)
            if not image.isNull():
                return image.scaled(
                    image.width() * scale, image.height() * scale, Qt.IgnoreAspectRatio, Qt.FastTransformation
                ).save(str(path))
    banner = BrandBanner(look, login=True)
    banner.resize(*LOGIN_BANNER_SIZE)
    image = QImage(LOGIN_BANNER_SIZE[0] * scale, LOGIN_BANNER_SIZE[1] * scale, QImage.Format_ARGB32)
    image.fill(Qt.white)
    painter = QPainter(image)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.scale(scale, scale)
    banner.render(painter, QPoint())
    painter.end()
    return image.save(str(path))


def grab_widget(widget, path):
    widget.show()
    widget.grab().save(path)
    print("saved", path)


def luna_screen(app, hold_until_input, status, later_status=None):
    """The Luna look's full-screen "Logging off..." screen, its status turning to later_status halfway through the
    wait; None in the classic looks, which have none."""
    if not luna_dialogs_wanted():
        return None
    screen = shutting_down_screen(virtual_screen_geometry(app), hold_until_input=hold_until_input)
    screen.set_status(status)
    if later_status:
        QTimer.singleShot(SAFE_SCREEN_DELAY_MS // 2, lambda: screen.set_status(later_status))
    screen.showFullScreen()
    return screen


def aero_logoff_screen():
    relative = "plasma/look-and-feel/chicago95.splashscreen/contents/splash/SevenSession.qml"
    installed = QStandardPaths.locate(QStandardPaths.GenericDataLocation, relative)
    source = (
        Path(installed)
        if installed
        else Path(__file__).resolve().parents[1] / "splash/chicago95.splashscreen/contents/splash/SevenSession.qml"
    )
    if not source.is_file():
        return None
    screen = QQuickView()
    screen.setFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
    screen.setResizeMode(QQuickView.SizeRootObjectToView)
    screen.setInitialProperties({"statusText": "Logging off..."})
    screen.setSource(QUrl.fromLocalFile(str(source)))
    if not screen.rootObject():
        screen.deleteLater()
        return None
    screen.showFullScreen()
    return screen


def screen_delay(screen):
    return SAFE_SCREEN_DELAY_MS if screen else 0


def session_bus():
    from dbus.mainloop.glib import DBusGMainLoop

    return dbus.SessionBus(mainloop=DBusGMainLoop())


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Shut Down dialog for KDE")
    parser.add_argument(
        "--power-off", action="store_true", help="request a normal session shutdown from the Aero power button"
    )
    parser.add_argument("--switch-user", action="store_true", help="lock this session and open the account chooser")
    parser.add_argument("--restart", action="store_true", help="confirm a restart from the Aero power menu")
    parser.add_argument("--log-off", action="store_true", help="ask to log off instead of the Shut Down choices")
    parser.add_argument("--dry-run", action="store_true", help="print commands instead of running them")
    parser.add_argument("--screenshot", metavar="PATH", help="save the dialog as PNG and exit")
    parser.add_argument("--screenshot-safe", metavar="PATH", help="save the safe screen at 1280x720 and exit")
    parser.add_argument("--login-banner", metavar="PATH", help="save the login screen's 2000 banner as PNG and exit")
    args = parser.parse_args()

    app = chicago95ui.make_app("chicago95-shutdown")
    QIcon.setThemeSearchPaths(list(ICON_DIRS) + QIcon.themeSearchPaths())

    if args.switch_user:
        log_off(SWITCH_USER, args.dry_run, None)
        return 0

    action = SHUT_DOWN if args.power_off else RESTART if args.restart else None
    if args.screenshot:
        dialog = screenshot_dialog(args.log_off, action)
        grab_widget(dialog, args.screenshot)
        return 0
    if args.login_banner:
        return 0 if render_login_banner(chicago95ui.look_settings(), args.login_banner) else 1
    if args.screenshot_safe:
        grab_widget(shutting_down_screen(QRect(0, 0, 1280, 720), hold_until_input=False), args.screenshot_safe)
        return 0

    if action is not None:
        if not ask(AeroSessionDialog(action)):
            return 0
        command = shutdown_command(action, dbus_caller())
        if args.dry_run:
            run_command(command, True)
            return 0
        play_shutdown_sound(False)
        return subprocess.run(command, check=False).returncode

    if args.log_off:
        choice = log_off_choice()
        if choice == LOG_OFF and not args.dry_run:
            aero = chicago95ui.widget_style() == "aero"
            screen = aero_logoff_screen() if aero else luna_screen(app, False, "Logging off...")
            action = functools.partial(log_off, choice, False, dbus_caller())
            return end_session(
                app,
                session_bus(),
                choice,
                chicago95ui.look_settings(),
                action,
                350 if aero and screen else screen_delay(screen),
            )
        if choice == LOG_OFF and luna_dialogs_wanted():
            screen = luna_screen(app, True, "Logging off...")

            def finish_logoff():
                log_off(choice, args.dry_run, dbus_caller())

            QTimer.singleShot(SAFE_SCREEN_DELAY_MS, finish_logoff)
            screen.destroyed.connect(app.quit)
            return app.exec()
        log_off(choice, args.dry_run, dbus_caller())
        return 0

    choice = turn_off_choice()
    if choice is None:
        return 0
    if choice == SWITCH_USER:
        log_off(choice, args.dry_run, None)
        return 0

    command = shutdown_command(choice, dbus_caller())
    if choice in (DOS_MODE, STAND_BY, HIBERNATE) or (choice == LOG_OFF and args.dry_run):
        run_command(command, args.dry_run)
        return 0

    # This process runs inside the user's session. It cannot know when all
    # services have stopped, and must never announce that power is safe to cut.
    if not args.dry_run:
        screen = luna_screen(app, False, "Logging off...", "Windows is shutting down...") if choice != LOG_OFF else None
        if choice != LOG_OFF:
            play_shutdown_sound(False)
        action = functools.partial(run_command, command, False)
        return end_session(app, session_bus(), choice, chicago95ui.look_settings(), action, screen_delay(screen))
    if not luna_dialogs_wanted():
        play_shutdown_sound(args.dry_run)
        run_command(command, args.dry_run)
        return 0

    safe_screen = luna_screen(app, True, "Logging off...", "Windows is shutting down...")
    play_shutdown_sound(args.dry_run)
    QTimer.singleShot(SAFE_SCREEN_DELAY_MS, lambda: run_command(command, args.dry_run))
    safe_screen.destroyed.connect(app.quit)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
