#!/usr/bin/env python3
"""Build a Plymouth theme from the very same QML/options used by the live preview."""

import argparse
import json
import math
from pathlib import Path

from PySide6.QtCore import QObject, QUrl
from PySide6.QtGui import QColor, QGuiApplication, QImage
from PySide6.QtQuick import QQuickView
from PySide6.QtTest import QTest

REPO = Path(__file__).resolve().parents[1]


def build(splash, out, size, template):
    app = QGuiApplication.instance() or QGuiApplication([])
    view = QQuickView()
    try:
        render_theme(view, splash, out, size, template)
    finally:
        view.close()
        app.processEvents()


def render_theme(view, splash, out, size, template):
    view.setResizeMode(QQuickView.SizeRootObjectToView)
    view.resize(*size)
    view.setSource(QUrl.fromLocalFile(str(splash / "Splash.qml")))
    if view.errors():
        raise ValueError("\n".join(error.toString() for error in view.errors()))
    view.rootObject().setProperty("booting", True)
    view.show()
    QTest.qWait(100)
    boot = view.rootObject().findChild(QObject, "postXpBoot")
    if boot is None:
        raise ValueError("Select a post-XP boot style before exporting")
    settings = boot.property("options").toVariant()
    for key in ("background", "foreground", "accent"):
        if settings.get(key, "default") != "default" and not QColor(str(settings[key])).isValid():
            raise ValueError(f"{key}: invalid color {settings[key]!r}")
    for key, low, high in (("frames", 1, 600), ("loopStart", 0, 599), ("fps", 1, 60), ("logoSize", 16, 600)):
        value = settings.get(key, "default")
        if value != "default":
            try:
                number = float(value)
            except (TypeError, ValueError) as error:
                raise ValueError(f"{key}: expected a number or 'default'") from error
            if not low <= number <= high or (key in ("frames", "loopStart") and not number.is_integer()):
                raise ValueError(f"{key}: value must be between {low} and {high}")
    if settings.get("loopStart", "default") != "default" and float(settings["loopStart"]) >= boot.property(
        "frameCount"
    ):
        raise ValueError("First loop frame must be below the frame count")
    for field in ("logo", "backgroundImage", "animation"):
        value = settings.get(field, "")
        if value not in ("", "default", "none"):
            url = QUrl(str(value))
            path = Path(url.toLocalFile() if url.isLocalFile() else str(value))
            if not path.is_file():
                raise ValueError(f"{field}: file does not exist: {path}")
    if settings.get("animation", "") not in ("", "default", "none"):
        path = QUrl(str(settings["animation"]))
        sheet = QImage(path.toLocalFile() if path.isLocalFile() else str(settings["animation"]))
        if sheet.isNull() or sheet.height() % boot.property("frameCount"):
            raise ValueError("The animation must be a raster image with equal-height frames stacked vertically")
    boot.setProperty("animated", False)
    boot.setProperty("elapsed", 0)
    out.mkdir(parents=True, exist_ok=True)
    boot.setProperty("animationVisible", False)
    QTest.qWait(30)
    background = view.grabWindow()
    if not background.save(str(out / "background.png")):
        raise OSError("Could not save the boot background")
    prompt_background = QImage(1, 1, QImage.Format_RGB32)
    prompt_background.fill(QColor("black"))
    prompt_background.save(str(out / "prompt-background.png"))
    boot.setProperty("animationVisible", True)
    rect = boot.property("animationRect")
    unit = boot.property("unit")
    x = math.floor(boot.property("offsetX") + rect.x() * unit)
    y = math.floor(boot.property("offsetY") + rect.y() * unit)
    width = math.ceil(rect.width() * unit + 1)
    height = math.ceil(rect.height() * unit + 1)
    count = boot.property("frameCount") if boot.property("drawsAnimation") else 1
    fps = boot.property("fps")
    for index in range(count):
        boot.setProperty("elapsed", index * 1000 / fps + 0.01)
        QTest.qWait(10)
        if not view.grabWindow().copy(x, y, width, height).save(str(out / f"frame-{index}.png")):
            raise OSError(f"Could not save animation frame {index}")
    name = "Chicago95-" + ("Vista" if boot.property("style") == "vista" else boot.property("style"))
    color = boot.property("color")
    values = {
        "WIDTH": size[0],
        "HEIGHT": size[1],
        "AX": x,
        "AY": y,
        "AW": width,
        "AH": height,
        "FRAMES": count,
        "LOOP_START": min(count - 1, boot.property("loopStart")),
        "FPS": fps,
        "BACKGROUND": f"{color.redF()}, {color.greenF()}, {color.blueF()}",
    }
    script = template.read_text()
    for key, value in values.items():
        script = script.replace(f"@{key}@", str(value))
    (out / f"{name}.script").write_text(script)
    (out / f"{name}.plymouth").write_text(
        f"[Plymouth Theme]\nName={name} Boot Screen\n"
        "Description=Customizable post-XP boot screen\nModuleName=script\n\n"
        f"[script]\nImageDir=/usr/share/plymouth/themes/{name}\n"
        f"ScriptFile=/usr/share/plymouth/themes/{name}/{name}.script\n"
    )
    (out / "animation.json").write_text(json.dumps(values, indent=2) + "\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--splash", type=Path, required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--size", default="1920x1080")
    parser.add_argument(
        "--template",
        type=Path,
        default=(
            REPO / "setup/post_xp_boot.script.in"
            if (REPO / "setup").exists()
            else Path.home() / ".local/share/chicago95/post_xp_boot.script.in"
        ),
    )
    args = parser.parse_args()
    size = tuple(int(part) for part in args.size.lower().split("x"))
    if len(size) != 2 or not all(320 <= dimension <= 7680 for dimension in size):
        parser.error("size must be WIDTHxHEIGHT, between 320 and 7680 pixels per dimension")
    build(args.splash, args.out, size, args.template)


if __name__ == "__main__":
    main()
