def inherit(base, **changes):
    return {**base, **changes}


STYLES["2001"] = inherit(
    STYLES["2000"],
    banner_font=15,
    banner_stretch=100,
    banner_spacing=0,
    banner_start=10,
    banner_embolden=0,
    text_drop=1,
    separator_offset=3,
)


def style_of(widget):
    return STYLES.get(widget.banner.get("style", "1995"), STYLES["1995"])


ROOT_ICON, SUB_ICON, ARROW = round(24 * UI_SCALE), round(16 * UI_SCALE), round(7 * UI_SCALE)

CATEGORY_FOLDERS = [
    ("Accessories", {"Utility", "Accessibility", "TextEditor", "Archiving", "Calculator", "Clock"}),
    ("Internet", {"Network", "WebBrowser", "Email", "Chat", "InstantMessaging", "FileTransfer", "P2P"}),
    ("Multimedia", {"AudioVideo", "Audio", "Video", "Player", "Recorder", "Music"}),
    ("Graphics", {"Graphics", "2DGraphics", "RasterGraphics", "VectorGraphics", "Photography", "Viewer"}),
    ("Office", {"Office", "WordProcessor", "Spreadsheet", "Presentation", "Calendar", "ContactManagement", "Finance"}),
    ("Games", {"Game", "ActionGame", "ArcadeGame", "BoardGame", "CardGame", "StrategyGame", "LogicGame", "Emulator"}),
    ("Development", {"Development", "IDE", "Debugger", "Building", "RevisionControl", "WebDevelopment"}),
    ("Education", {"Education", "Science", "Math", "Languages"}),
    (
        "System Tools",
        {"System", "Monitor", "Security", "FileManager", "TerminalEmulator", "PackageManager", "Filesystem"},
    ),
    ("Settings", {"Settings", "DesktopSettings", "HardwareSettings", "X-KDE-settings"}),
]
APPLICATION_DIRS = [
    Path.home() / ".local/share/applications",
    Path("/var/lib/flatpak/exports/share/applications"),
    Path.home() / ".local/share/flatpak/exports/share/applications",
    Path("/usr/local/share/applications"),
    Path("/usr/share/applications"),
]


def read_desktop_entry(path):
    parser = configparser.RawConfigParser(strict=False, interpolation=None)
    try:
        parser.read(path, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        return None
    if not parser.has_section("Desktop Entry"):
        return None
    entry = dict(parser.items("Desktop Entry"))
    hidden = entry.get("nodisplay", "false").lower() == "true" or entry.get("hidden", "false").lower() == "true"
    only_show = entry.get("onlyshowin", "")
    not_show = entry.get("notshowin", "")
    if hidden or entry.get("type", "Application") != "Application" or not entry.get("exec"):
        return None
    if only_show and "KDE" not in only_show.split(";"):
        return None
    if "KDE" in not_show.split(";"):
        return None
    return {
        "name": entry.get("name", path.stem),
        "icon": entry.get("icon", "application-x-executable"),
        "categories": sorted(set(entry.get("categories", "").split(";")) - {""}),
        "path": str(path),
    }


def application_dirs_stamp():
    return {str(d): d.stat().st_mtime for d in APPLICATION_DIRS if d.is_dir()}


def collect_applications():
    """Scan .desktop files, cached on the application directories' mtimes."""
    stamp = application_dirs_stamp()
    try:
        cached = json.loads(CACHE_FILE.read_text())
        if cached.get("stamp") == stamp:
            return cached["apps"]
    except (OSError, ValueError, KeyError):
        pass
    seen = {}
    for directory in APPLICATION_DIRS:
        for path in sorted(directory.glob("*.desktop")):
            if path.name in seen:
                continue
            entry = read_desktop_entry(path)
            if entry:
                seen[path.name] = entry
    apps = list(seen.values())
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    CACHE_FILE.write_text(json.dumps({"stamp": stamp, "apps": apps}))
    return apps


def folder_for(entry):
    categories = set(entry["categories"])
    for folder, members in CATEGORY_FOLDERS:
        if categories & members:
            return folder
    return "Other"


def recent_documents(limit=12):
    try:
        root = ElementTree.parse(Path.home() / ".local/share/recently-used.xbel").getroot()
    except (OSError, ElementTree.ParseError):
        return []
    bookmarks = sorted(root.findall("bookmark"), key=lambda node: node.get("modified", ""), reverse=True)
    documents = []
    for node in bookmarks:
        location = unquote(urlparse(node.get("href", "")).path)
        if location and os.path.exists(location):
            documents.append(location)
        if len(documents) >= limit:
            break
    return documents


def detached(command):
    """The command as its own transient service: restarting the menu stops the menu's unit, and everything in it."""
    return ["systemd-run", "--user", "--quiet", "--collect", *command]


def launch(command):
    subprocess.Popen(detached(command), start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


SHUTDOWN_TOOL = os.path.expanduser("~/.local/bin/chicago95-shutdown")
LOG_OFF_COMMAND = [SHUTDOWN_TOOL, "--log-off"]
SHUT_DOWN_COMMAND = [SHUTDOWN_TOOL]


class RetroMenuStyle(chicago95ui.ClassicStyle):
    """The classic style with classic menu metrics: bigger root icons, roomier rows, small submenu arrows."""

    underline_shortcuts = True  # 2000 hides the shortcut letters' underlines until Alt is pressed

    def styleHint(self, hint, option=None, widget=None, returnData=None):
        if hint == QStyle.SH_UnderlineShortcut:
            return int(self.underline_shortcuts)
        return super().styleHint(hint, option, widget, returnData)

    def pixelMetric(self, metric, option=None, widget=None):
        if metric == QStyle.PM_SmallIconSize and isinstance(widget, RetroMenu):
            return ROOT_ICON if widget.banner else SUB_ICON
        if metric == QStyle.PM_MenuPanelWidth:
            # The root is a plain window on Wayland and paints its own classic bevel; submenus keep Qt's panel.
            return 0 if isinstance(widget, RetroMenu) and widget.banner else round(2 * UI_SCALE)
        if metric in (QStyle.PM_MenuHMargin, QStyle.PM_MenuVMargin):
            return 0
        return super().pixelMetric(metric, option, widget)

    def sizeFromContents(self, kind, option, size, widget=None):
        result = super().sizeFromContents(kind, option, size, widget)
        if kind == QStyle.CT_MenuItem and isinstance(widget, RetroMenu) and size.height() > 2:
            if widget.banner:
                # Measured from the original root menu (tests/test_startmenu_reference.py): rows 32px apart.
                result.setHeight(round(style_of(widget)["row"] * UI_SCALE))
                result.setWidth(result.width() + round(20 * UI_SCALE))
            else:
                result.setWidth(result.width() + round(16 * UI_SCALE))
        return result

    def drawControl(self, element, option, painter, widget=None):
        if (
            element == QStyle.CE_MenuItem
            and isinstance(widget, RetroMenu)
            and widget.banner
            and option.menuItemType == QStyleOptionMenuItem.MenuItemType.Separator
        ):
            # As on the original: shadow then white, 2px into the item,
            # from the banner's edge to 4px short of the frame.
            left, right = BANNER_WIDTH + 3, widget.width() - 3
            y = option.rect.top() + style_of(widget).get("separator_offset", 2)
            painter.fillRect(left, y, right - left, 1, option.palette.color(QPalette.Mid))
            painter.fillRect(left, y + 1, right - left, 1, option.palette.color(QPalette.Light))
            return
        root_icon = None
        # The arrow (drawn in drawPrimitive) is not told the row is selected; remember it from here.
        self.drawing_selected_row = (
            bool(option.state & QStyle.State_Selected) if element == QStyle.CE_MenuItem else False
        )
        if (
            element == QStyle.CE_MenuItem
            and isinstance(widget, RetroMenu)
            and option.menuItemType != QStyleOptionMenuItem.MenuItemType.Separator
        ):
            if option.state & QStyle.State_Selected and option.state & QStyle.State_Enabled:
                painter.fillRect(option.rect, option.palette.highlight())
            if widget.banner:
                # The root icon goes where the original puts it, drawn after Qt (which fills the row
                # background); Qt lays out only the text.
                root_icon = (
                    option.icon.pixmap(ROOT_ICON, ROOT_ICON),
                    option.rect.top() + (option.rect.height() - ROOT_ICON) // 2,
                )
                option.icon = QIcon()
                style = style_of(widget)
                drop = round(style["text_drop"] * UI_SCALE)
                option.rect = option.rect.adjusted(ITEM_LEFT_PAD + round(style["text_gap"] * UI_SCALE), drop, 0, drop)
            else:
                option.rect = option.rect.adjusted(ITEM_LEFT_PAD, 0, 0, 0)
        super().drawControl(element, option, painter, widget)
        if root_icon:
            painter.drawPixmap(round(style_of(widget)["icon_x"] * UI_SCALE), root_icon[1], root_icon[0])

    def drawPrimitive(self, element, option, painter, widget=None):
        if element == QStyle.PE_IndicatorArrowRight and isinstance(widget, RetroMenu) and widget.banner:
            # The original root menu's arrow, measured: 4 columns of 7, 5, 3 and 1 pixels, tip 10px from
            # the frame, centred on the row.
            selected = getattr(self, "drawing_selected_row", False)
            painter.save()
            painter.setPen(Qt.NoPen)
            color = option.palette.color(QPalette.HighlightedText if selected else QPalette.WindowText)
            left, top = widget.width() - round(13 * UI_SCALE), option.rect.center().y() - round(5 * UI_SCALE)
            unit = max(1, round(UI_SCALE))
            for column in range(4):
                painter.fillRect(left + column * unit, top + column * unit, unit, (7 - 2 * column) * unit, color)
            painter.restore()
            return
        if element == QStyle.PE_IndicatorArrowRight and isinstance(widget, RetroMenu):
            centre = option.rect.center()
            option.rect = QRect(centre.x() - ARROW // 2, centre.y() - ARROW // 2, ARROW, ARROW)
        super().drawPrimitive(element, option, painter, widget)


SLIDE_MS = 90


class RetroMenu(QMenu):
    """QMenu with classic item inset and, for the root menu, the vertical navy banner.

    Menus open as the Effects tab's "Menus" choice says (chicago95rc [Animations]): submenus slide out to the
    right, fade in, both, or appear at once; the root, which KWin places on Wayland, can only fade.
    """

    def __init__(self, title="", parent=None, banner=False):
        super().__init__(title, parent)
        self.banner = banner_settings() if banner else None  # also answers "is this the root menu?"
        self.setContentsMargins(
            BANNER_WIDTH + 3 if banner else 0, 3 if banner else 0, 2 if banner else 0, 3 if banner else 0
        )
        self.motions = []
        # Stay a real popup for KWin so it draws no decoration or shadow around the menu.
        # Root menu is a frameless top-level on Wayland (a parentless popup is refused there); KWin places it.
        if banner:
            self.setWindowFlags(
                Qt.Window | Qt.FramelessWindowHint | Qt.NoDropShadowWindowHint | Qt.WindowStaysOnTopHint
            )
        else:
            self.setWindowFlags(self.windowFlags() | Qt.Popup | Qt.FramelessWindowHint | Qt.NoDropShadowWindowHint)
        self.setWindowTitle("chicago95-startmenu-root" if banner else "chicago95-startmenu-sub")

    def showEvent(self, event):
        super().showEvent(event)
        motion, duration = chicago95animations.own_animation(
            chicago95animations.live_state(), "ANIM_MENUS", "slide", SLIDE_MS
        )
        if self.banner:
            self.banner = banner_settings()  # read on every open, so a new choice in Setup shows without a restart
            QApplication.instance().setPalette(
                chicago95ui.retro_palette(chicago95ui.read_scheme())
            )  # and System Settings colours
        final = self.pos()
        # Wayland top-levels cannot be moved by the client; KWin places the root menu, so it only fades.
        slides = motion in ("slide", "both") and not self.banner
        fades = motion in ("fade", "both")
        self.motions = [
            self.animate(b"pos", final + QPoint(-self.width(), 0), final, duration) if slides else None,
            self.animate(b"windowOpacity", 0.0, 1.0, duration) if fades else None,
        ]
        self.motions = [motion for motion in self.motions if motion is not None]

    def animate(self, property_name, start, end, duration):
        motion = QPropertyAnimation(self, property_name, self)
        motion.setStartValue(start)
        motion.setEndValue(end)
        motion.setDuration(duration)
        motion.setEasingCurve(QEasingCurve.OutCubic)
        motion.start()
        return motion

    def paintEvent(self, event):
        super().paintEvent(event)
        if not self.banner:
            return
        painter = QPainter(self)
        w, h = self.width(), self.height()
        style = style_of(self)
        light = self.palette().color(QPalette.Window if style["light"] == "face" else QPalette.Midlight)
        shadow, dark = self.palette().color(QPalette.Mid), QColor(style["dark"])
        painter.fillRect(0, 0, w, 1, light)
        painter.fillRect(0, 0, 1, h, light)
        painter.fillRect(1, 1, w - 2, 1, Qt.white)
        painter.fillRect(1, 1, 1, h - 2, Qt.white)
        painter.fillRect(0, h - 1, w, 1, dark)
        painter.fillRect(w - 1, 0, 1, h, dark)
        painter.fillRect(1, h - 2, w - 2, 1, shadow)
        painter.fillRect(w - 2, 1, 1, h - 2, shadow)
        strip = QRect(3, 3, BANNER_WIDTH, self.height() - 6)
        fill = QLinearGradient(0, strip.top(), 0, strip.bottom())
        for position, colour in banner_stops(self.banner["bannerBackground"], strip.height()):
            fill.setColorAt(position, QColor(colour))
        painter.fillRect(strip, fill)
        painter.translate(strip.left(), strip.bottom())
        painter.rotate(-90)
        x = round(style["banner_start"] * UI_SCALE)
        inset = round(style["banner_inset"] * UI_SCALE)
        gap = style.get("banner_gap")
        # With fixed gaps (2000) every part sits on the words' baseline, centred on their capitals.
        word_font = QFont("Arial")
        word_font.setPixelSize(round(style["banner_font"] * UI_SCALE))
        word_font.setBold(True)
        baseline = inset + (strip.width() + QFontMetrics(word_font).capHeight()) / 2
        for raw_text, bold in banner_parts(self.banner["bannerText"]):
            # Words bold in the text colour, numbers regular in the number colour, Arial (Liberation Sans
            # where Arial is missing) with hard edges; sizes per style, measured on the originals.
            text = (
                raw_text.strip() if gap is not None else raw_text
            )  # fixed gaps between the parts instead of spaces (2000)
            banner_font = QFont("Arial")
            size, stretch = (
                (style["banner_font"], style["banner_stretch"])
                if bold
                else (
                    style.get("banner_number_font", style["banner_font"]),
                    style.get("banner_number_stretch", style["banner_stretch"]),
                )
            )
            banner_font.setPixelSize(round(size * UI_SCALE))
            banner_font.setStretch(stretch)
            # 1995/1998 lettering is pixel-sharp; 2000's has soft grey edges (banner_smooth).
            banner_font.setStyleStrategy(
                QFont.StyleStrategy(QFont.PreferAntialias | QFont.NoSubpixelAntialias)
                if style.get("banner_smooth")
                else QFont.NoAntialias
            )  # grey edges, no colour fringes
            banner_font.setBold(bold)
            spacing = style.get("banner_spacing" if bold else "banner_number_spacing")
            if spacing:
                banner_font.setLetterSpacing(QFont.AbsoluteSpacing, spacing * UI_SCALE)
            colour = QColor(self.banner["bannerTextColor" if bold else "bannerNumberColor"])
            painter.setFont(banner_font)
            metrics = painter.fontMetrics()
            if bold and style.get("banner_embolden"):
                chicago95ui.draw_heavy_text(
                    painter,
                    x,
                    baseline,
                    banner_font,
                    text,
                    colour,
                    style["banner_embolden"] * UI_SCALE,
                    bool(style.get("banner_smooth")),
                )
            else:
                painter.setPen(colour)
                if gap is not None:
                    painter.drawText(QPoint(x, round(baseline)), text)
                else:
                    painter.drawText(
                        QRect(x, inset, strip.height() - x, strip.width()), Qt.AlignLeft | Qt.AlignVCenter, text
                    )
            x += metrics.horizontalAdvance(text) + (round(gap * UI_SCALE) if gap is not None else 0)
        painter.end()


class ClickShield(QWidget):
    """Invisible full-screen X11 window under the menu; any click on it closes the menu.

    Wayland windows never see an X11 popup grab, so this catches outside clicks instead.
    """

    def __init__(self, on_click):
        super().__init__(
            None, Qt.Tool | Qt.FramelessWindowHint | Qt.X11BypassWindowManagerHint | Qt.WindowStaysOnTopHint
        )
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setAttribute(Qt.WA_NoSystemBackground)
        self.on_click = on_click

    def mousePressEvent(self, event):
        self.on_click()


ICON_THEME_DIRS = [Path.home() / ".local/share/icons/Chicago95", Path("/usr/share/icons/Chicago95")]
GENERIC_ICON = "application-x-executable"


@functools.cache
def theme_icon_names():
    """Names the Chicago95 theme actually ships, so every menu icon is the same pixel-art family."""
    return {
        path.stem
        for root in ICON_THEME_DIRS
        if root.is_dir()
        for path in root.rglob("*")
        if path.suffix in (".png", ".svg")
    }


def themed_icon(name, *fallbacks):
    """The first of the names the icon set has; a path is used as is."""
    if name.startswith("/") and os.path.exists(name):
        return chicago95ui.crisp_icon(QIcon(name))
    found = next((candidate for candidate in (name, *fallbacks) if QIcon.hasThemeIcon(candidate)), GENERIC_ICON)
    return chicago95ui.crisp_icon(QIcon.fromTheme(found))


# Root menu icons per style: the icon set and names whose pictures match the originals' 24px icons, found
# by comparing every icon in Chicago95, SE98 and ClassicOS-2000 with them (tests/test_startmenu_icons_reference.py).
# SE98 matches both 98 and 2000. When that set isn't installed the names go to the desktop's icon theme,
# with the last name of each tuple as the generic fallback.
ROOT_ICON_SETS = {"1995": "Chicago95", "1998": "SE98", "2000": "SE98", "2001": "Windows-XP"}
ROOT_ICONS = {
    "1995": {
        "programs": ("applications-all", "folder-open"),
        "documents": ("folder-home", "folder-documents"),
        "settings": ("configuration_section", "preferences-desktop"),
        "find": ("kfind", "system-search"),
        "help": ("system-help", "help-browser"),
        "run": ("system-run", "gtk-execute"),
        "log_off": ("system-log-out",),
        "shut_down": ("system-shutdown",),
    },
    "1998": {
        "programs": ("applications-all", "folder-open"),
        "documents": ("folder-home", "folder-documents"),
        "settings": ("open-menu", "preferences-desktop"),
        "find": ("edit-find", "system-search"),
        "help": ("help-hint", "help-browser"),
        "run": ("system-run", "gtk-execute"),
        "log_off": ("system-log-out",),
        "shut_down": ("system-shutdown",),
    },
    "2000": {
        "programs": ("applications-all", "folder-open"),
        "documents": ("folder-home", "folder-documents"),
        "settings": ("open-menu", "preferences-desktop"),
        "find": ("edit-find", "system-search"),
        "help": ("help-hint", "help-browser"),
        "run": ("system-run", "gtk-execute"),
        "log_off": ("system-log-out",),
        "shut_down": ("gnome-shutdown", "system-shutdown"),
    },
}
ROOT_ICONS["2001"] = {
    "programs": ("applications-other", "folder-open"),
    "documents": ("document-open-recent", "folder-documents"),
    "settings": ("preferences-system", "preferences-desktop"),
    "find": ("system-search",),
    "help": ("help-browser",),
    "run": ("system-run",),
    "log_off": ("system-log-out",),
    "shut_down": ("system-shutdown",),
    "catalog": ("system-software-install",),
    "update": ("system-software-update", "software-update-available"),
}

ICON_SET_DIRS = [Path.home() / ".local/share/icons", Path.home() / ".icons", Path("/usr/share/icons")]


# Only prefer archive artwork verified against the XP menus. Other archive entries include
# older, palette-limited variants and should retain the selected desktop theme's artwork.
XP_MENU_ORIGINALS = {
    "applications-other",
    "document-open-recent",
    "preferences-system",
    "system-search",
    "help-browser",
    "help-contents",
    "system-run",
    "system-log-out",
    "system-shutdown",
    "system-software-update",
}


def original_xp_icon(name):
    """Prefer the user's original artwork to approximations in the desktop icon pack."""
    if name not in XP_MENU_ORIGINALS:
        return None
    for base in ICON_SET_DIRS:
        files = sorted((base / "Windows-XP-Originals").glob(f"*/*/{name}.png"))
        if files:
            icon = QIcon()
            for path in files:
                icon.addFile(str(path))
            return icon
    return None


def root_icon(item, style):
    """The item's icon from the style's matched icon set, or from the desktop's icon theme."""
    names = ROOT_ICONS.get(style, ROOT_ICONS["1995"])[item]
    if style == "2001":
        for name in names:
            original = original_xp_icon(name)
            if original is not None:
                return original
    icon_set = ROOT_ICON_SETS.get(style)
    for base in ICON_SET_DIRS:
        for name in names[:-1] or names:
            files = sorted((base / icon_set).glob(f"*/*/{name}.png")) if icon_set else []
            if not files and style == "2001":
                files = sorted((base / icon_set).glob(f"scalable/*/{name}.svg"))
            if files:
                icon = QIcon()
                for path in files:
                    icon.addFile(str(path))
                return icon
    return themed_icon(*names)


CLASSIC_ROOT_LABELS = {
    "programs": "&Programs",
    "documents": "&Documents",
    "settings": "&Settings",
    "find": "&Find",
    "help": "&Help",
    "run": "&Run...",
    "log_off": "&Log Off...",
    "shut_down": "Sh&ut Down...",
}
ROOT_LABELS = {
    "1995": CLASSIC_ROOT_LABELS,
    "1998": CLASSIC_ROOT_LABELS,
    "2000": CLASSIC_ROOT_LABELS,
    "2001": {
        **CLASSIC_ROOT_LABELS,
        "catalog": "Windows Catalog",
        "update": "Windows Update",
        "find": "S&earch",
        "help": "&Help and Support",
        "log_off": "&Log Off {user}...",
        "shut_down": "Turn O&ff Computer...",
    },
}
TOP_ROOT_ITEMS = {"2001": ("catalog", "update")}
SOFTWARE_CENTRE_COMMANDS = {"catalog": ["plasma-discover"], "update": ["plasma-discover", "--mode", "update"]}


def root_label(item, style, user):
    return ROOT_LABELS.get(style, ROOT_LABELS["1995"])[item].format(user=user)


def control_panel_command(which=shutil.which):
    installed = which("chicago95-control-panel")
    return [installed] if installed else ["systemsettings"]


RUN_TOOL = os.path.expanduser("~/.local/bin/chicago95-run")


def run_command(exists=os.path.exists):
    """Our Run dialog when it is installed, else KRunner."""
    return [RUN_TOOL] if exists(RUN_TOOL) else ["krunner"]


def taskbar_properties_command(which=shutil.which):
    installed = which("chicago95-control-panel")
    return [installed, "--page", "taskbar"] if installed else None


def add_entry(menu, text, icon, callback):
    """icon: a QIcon, or an icon name (or tuple of names, first available wins)."""
    if not isinstance(icon, QIcon):
        icon = themed_icon(*((icon,) if isinstance(icon, str) else icon))
    action = QAction(icon, text, menu)
    action.triggered.connect(lambda _checked=False: callback())
    menu.addAction(action)
    return action


FOLDER_NAMES = {"Utilities": "Accessories", "Lost & Found": "Other"}
_menu_tree_cache = {"stamp": None, "tree": None}


def load_menu_tree():
    """The same application tree Kickoff shows, parsed from the XDG menu spec; cached on dir mtimes."""
    import xdg.Menu

    stamp = application_dirs_stamp()
    if _menu_tree_cache["stamp"] == stamp:
        return _menu_tree_cache["tree"]

    def convert(menu):
        folders, entries = [], []
        for item in menu.getEntries():
            if isinstance(item, xdg.Menu.Menu):
                child = convert(item)
                if child["folders"] or child["entries"]:
                    folders.append({"name": FOLDER_NAMES.get(item.getName(), item.getName()), **child})
            elif isinstance(item, xdg.Menu.MenuEntry):
                desktop = item.DesktopEntry
                entries.append(
                    {
                        "name": desktop.getName(),
                        "icon": desktop.getIcon() or GENERIC_ICON,
                        "path": item.DesktopEntry.filename,
                    }
                )
        entries.sort(key=lambda e: e["name"].lower())
        return {"folders": folders, "entries": entries}

    menu_file = f"/etc/xdg/menus/{os.environ.get('XDG_MENU_PREFIX', 'plasma-')}applications.menu"
    if not os.path.exists(menu_file):
        menu_file = "/etc/xdg/menus/applications.menu"
    tree = convert(xdg.Menu.parse(menu_file))
    _menu_tree_cache.update(stamp=stamp, tree=tree)
    return tree


def fill_folder(menu, node):
    for folder in node["folders"]:
        submenu = RetroMenu(folder["name"], menu)
        submenu.setIcon(themed_icon("folder"))
        fill_folder(submenu, folder)
        menu.addMenu(submenu)
    for entry in node["entries"]:
        add_entry(menu, entry["name"], entry["icon"], lambda path=entry["path"]: launch(["gio", "launch", path]))


def fill_programs_menu(programs):
    programs.clear()
    fill_folder(programs, load_menu_tree())


def fill_documents_menu(documents):
    documents.clear()
    add_entry(
        documents, "My Documents", "folder-documents", lambda: launch(["xdg-open", str(Path.home() / "Documents")])
    )
    documents.addSeparator()
    for location in recent_documents():
        add_entry(
            documents, os.path.basename(location), "text-x-generic", lambda loc=location: launch(["xdg-open", loc])
        )


def build_root_menu():
    root = RetroMenu(banner=True)
    style = banner_settings()["style"]
    user = getpass.getuser()

    def label(item):
        return root_label(item, style, user)

    top_items = TOP_ROOT_ITEMS.get(style, ())
    for item in top_items:
        add_entry(root, label(item), root_icon(item, style), lambda item=item: launch(SOFTWARE_CENTRE_COMMANDS[item]))
    if top_items:
        root.addSeparator()
    programs = RetroMenu(label("programs"), root)
    programs.setIcon(root_icon("programs", style))
    programs.aboutToShow.connect(lambda: fill_programs_menu(programs))
    root.addMenu(programs)
    documents = RetroMenu(label("documents"), root)
    documents.setIcon(root_icon("documents", style))
    documents.aboutToShow.connect(lambda: fill_documents_menu(documents))
    root.addMenu(documents)
    settings = RetroMenu(label("settings"), root)
    settings.setIcon(root_icon("settings", style))
    add_entry(settings, "Control Panel", "preferences-system", lambda: launch(control_panel_command()))
    if taskbar_properties_command():
        add_entry(settings, "Taskbar...", "preferences-system-windows", lambda: launch(taskbar_properties_command()))
    add_entry(settings, "Printers", "printer", lambda: launch(["kcmshell6", "kcm_printer_manager"]))
    add_entry(settings, "Display", "preferences-desktop-display", lambda: launch(["kcmshell6", "kcm_kscreen"]))
    root.addMenu(settings)
    find = RetroMenu(label("find"), root)
    find.setIcon(root_icon("find", style))
    add_entry(find, "Files or Folders...", "system-search", lambda: launch(["kfind"]))
    add_entry(find, "Computer...", "network-workgroup", lambda: launch(["dolphin", "remote:/"]))
    root.addMenu(find)
    add_entry(root, label("help"), root_icon("help", style), lambda: launch(["khelpcenter"]))
    add_entry(root, label("run"), root_icon("run", style), lambda: launch(run_command()))
    root.addSeparator()
    add_entry(root, label("log_off"), root_icon("log_off", style), lambda: launch(LOG_OFF_COMMAND))
    add_entry(root, label("shut_down"), root_icon("shut_down", style), lambda: launch(SHUT_DOWN_COMMAND))
    return root


def is_luna_menu():
    return banner_settings()["style"] == "luna"


def user_directory(location):
    return QStandardPaths.writableLocation(location)


def luna_commands():
    return {
        "control_panel": control_panel_command(),
        "log_off": LOG_OFF_COMMAND,
        "shut_down": SHUT_DOWN_COMMAND,
        "help": ["khelpcenter"],
        "search": ["kfind"],
        "run": run_command(),
        "my_computer": ["dolphin", "computer:/"],
        "my_documents": ["xdg-open", user_directory(QStandardPaths.DocumentsLocation)],
        "my_pictures": ["xdg-open", user_directory(QStandardPaths.PicturesLocation)],
        "my_music": ["xdg-open", user_directory(QStandardPaths.MusicLocation)],
        "printers": ["kcmshell6", "kcm_printer_manager"],
    }


def launch_luna_item(item):
    launch(["gio", "launch", item["path"]] if isinstance(item, dict) else item)


def luna_icon(item):
    name = item["icon"] if isinstance(item, dict) else item
    original = original_xp_icon(name)
    return original if original is not None else themed_icon(name)


def build_luna_menu():
    import chicago95lunamenu

    return chicago95lunamenu.LunaMenu(
        collect_applications(),
        recent_documents(),
        launch_luna_item,
        luna_icon,
        RetroMenu,
        ClickShield,
        user_name=getpass.getuser(),
        user_picture=chicago95ui.user_picture_path(Path.home(), getpass.getuser(), chicago95ui.ACCOUNTS_ICONS),
        programs_filler=fill_programs_menu,
        commands=luna_commands(),
        recent_path=CACHE_FILE.with_name("chicago95-startmenu-usage.json"),
    )


def build_menu():
    return build_luna_menu() if is_luna_menu() else build_root_menu()


def apply_classic_menu_look(app):
    style = RetroMenuStyle("Windows")
    style.underline_shortcuts = banner_settings()["style"] != "2000"
    app.setStyle(style)
    app.setPalette(chicago95ui.retro_palette(chicago95ui.read_scheme()))
    family = "MS W98 UI" if "MS W98 UI" in QFontDatabase.families() else "Noto Sans"
    # classic menus use an 11px face regardless of DPI; a point size would grow with Xft.dpi 144.
    menu_font = QFont(family)
    menu_font.setPixelSize(round(11 * UI_SCALE))
    menu_font.setStyleStrategy(QFont.NoAntialias)  # a pixel font, drawn with hard edges like the original
    app.setFont(menu_font)


def apply_luna_menu_look(app):
    import chicago95luna

    app.setStyle(chicago95luna.LunaStyle())
    app.setPalette(chicago95luna.luna_palette())
    app.setFont(chicago95luna.luna_font())


def apply_retro_look(app):
    {True: apply_luna_menu_look, False: apply_classic_menu_look}[is_luna_menu()](app)
    # The KDE platform theme can switch menu icons off session-wide; classic menus always show them.
    app.setAttribute(Qt.AA_DontShowIconsInMenus, False)
    # Autostart runs before the platform theme plugin can add user icon dirs; add them ourselves.
    home = str(Path.home())
    extra = [f"{home}/.local/share/icons", f"{home}/.icons", "/usr/share/icons", "/usr/share/pixmaps"]
    QIcon.setThemeSearchPaths(extra + [p for p in QIcon.themeSearchPaths() if p not in extra])
    QIcon.setFallbackSearchPaths(
        [f"{home}/.local/share/icons/Chicago95/apps/48", "/usr/share/pixmaps"] + QIcon.fallbackSearchPaths()
    )
    QIcon.setThemeName(
        chicago95ui.menu_icon_theme(chicago95ui.icon_theme(), QIcon.themeSearchPaths())
    )  # the look's set
    QIcon.setFallbackThemeName("hicolor")


class StartMenu:
    """Resident controller: builds the menu once per show and toggles it on SIGUSR1."""

    def __init__(self, app):
        self.app = app
        self.menu = None
        self.watching_focus = False
        self.shield = ClickShield(self.hide)
        self.shield.hide()

    def visible(self):
        return self.menu is not None and self.menu.isVisible()

    def toggle(self):
        self.hide() if self.visible() else self.show()

    def show(self):
        if self.menu is not None:
            self.menu.deleteLater()
        self.menu = build_menu()
        luna = is_luna_menu()
        if not luna:
            self.menu.aboutToHide.connect(lambda: QTimer.singleShot(0, self.shield.hide))
        screen = self.app.primaryScreen()
        if os.environ.get("QT_QPA_PLATFORM") != "wayland" and not luna:
            # X11 only: Wayland delivers activation changes reliably, so focus-out closes the menu.
            self.shield.setGeometry(screen.geometry())
            self.shield.show()
        # A top-level cannot pick its position on Wayland; the KWin rule "chicago95-startmenu" places it.
        self.menu.show()
        self.menu.raise_()
        self.menu.activateWindow()
        if os.environ.get("QT_QPA_PLATFORM") == "wayland":
            self.app.focusWindowChanged.connect(self._on_focus_window)
            self.watching_focus = True
        debug_keys = [k for k in os.environ.get("CHICAGO95_DEBUG_KEYS", "").split(",") if k]
        for index, name in enumerate(debug_keys):
            key = getattr(Qt, f"Key_{name}")
            QTimer.singleShot(
                400 * (index + 1),
                lambda k=key: self.app.sendEvent(
                    self.app.activePopupWidget(), QKeyEvent(QEvent.KeyPress, k, Qt.NoModifier)
                ),
            )

    def _on_focus_window(self, window):
        # Close when focus leaves the menu tree entirely (submenus are child popups of the root).
        if window is None and self.visible():
            QTimer.singleShot(150, lambda: self.hide() if self.app.focusWindow() is None else None)

    def hide(self):
        if self.watching_focus:
            self.app.focusWindowChanged.disconnect(self._on_focus_window)
            self.watching_focus = False
        if self.menu is not None:
            self.menu.hide()
        self.shield.hide()


def signal_running_instance():
    try:
        other = int(PID_FILE.read_text().strip())
        os.kill(other, signal.SIGUSR1)
        return True
    except (OSError, ValueError):
        return False


def drawn_root_menu():
    """The root menu with the current settings, laid out but not shown."""
    app = QApplication(sys.argv)
    apply_retro_look(app)
    menu = build_menu()
    menu.adjustSize()
    return app, menu


def root_menu_height():
    """The root menu's height in logical pixels with the current settings; Setup's window rule places
    the menu from it (Wayland gives the position to KWin, so the rule needs the real height)."""
    _app, menu = drawn_root_menu()
    return menu.height()


def save_screenshot(path):
    """The root menu as it opens, for the Control Panel's preview of settings not yet applied."""
    _app, menu = drawn_root_menu()
    menu.grab().save(path)


def main():
    if "--root-height" in sys.argv:
        print(root_menu_height())
        return 0
    if "--screenshot" in sys.argv:
        save_screenshot(sys.argv[sys.argv.index("--screenshot") + 1])
        return 0
    if signal_running_instance():
        return 0
    QApplication.setHighDpiScaleFactorRoundingPolicy(Qt.HighDpiScaleFactorRoundingPolicy.PassThrough)
    app = QApplication(sys.argv)
    app.setApplicationName("chicago95-startmenu")
    app.setDesktopFileName("chicago95-startmenu")
    app.setQuitOnLastWindowClosed(False)
    apply_retro_look(app)
    PID_FILE.write_text(str(os.getpid()))
    controller = StartMenu(app)
    signal.signal(signal.SIGUSR1, lambda *_: QTimer.singleShot(0, controller.toggle))
    heartbeat = chicago95ui.quit_on_signals(app, signal.SIGTERM)  # noqa: F841  kept alive for the event loop
    if "--daemon" not in sys.argv:
        QTimer.singleShot(0, controller.show)
    code = app.exec()
    PID_FILE.unlink(missing_ok=True)
    return code


if __name__ == "__main__":
    sys.exit(main())
