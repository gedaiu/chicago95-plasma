#!/usr/bin/env python3
"""Chicago95 style cascading Start menu for Plasma.

The first launch stays resident; later launches just signal it (SIGUSR1) to
toggle the menu, so the menu opens instantly. Runs under XWayland so the popup
can be pinned to the screen corner.
"""

import configparser
import functools
import getpass
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import xml.etree.ElementTree as ElementTree
from pathlib import Path
from urllib.parse import unquote, urlparse

DEFAULT_BANNER = {
    "bannerText": "Chicago95",
    "bannerBackground": "#808080",
    "bannerTextColor": "#C0C0C0",
    "bannerNumberColor": "#FFFFFF",
    "style": "1995",
}


def banner_settings(settings_file=None):
    """Banner text and colours chosen in Setup ([StartMenu] in ~/.config/chicago95rc).

    bannerBackground: see banner_stops. style: 1995, 1998 or 2000, picks the menu's measurements (STYLES)."""
    settings = configparser.ConfigParser(interpolation=None)
    settings.read(settings_file or SETTINGS_FILE)
    return {key: settings.get("StartMenu", key, fallback=default) for key, default in DEFAULT_BANNER.items()}


def banner_stops(spec, height):
    """Gradient stops (position 0..1 from the top, colour) for a banner background.

    "#808080" is solid; "#000000,#0000FF" spreads the colours evenly from top to bottom; a colour
    with "@N" sits N pixels above the bottom, so a glow stays behind the lettering whatever the
    menu's height ("#00007B,#00007B@95,#0000FF@45,#00008F@0" is 1998's)."""
    stops = []
    parts = [part.strip() for part in spec.split(",") if part.strip()]
    for index, part in enumerate(parts):
        colour, _, above_bottom = part.partition("@")
        if above_bottom:
            position = 1 - min(float(above_bottom), height) / height
        else:
            position = index / max(1, len(parts) - 1) if len(parts) > 1 else 0
        stops.append((max(0.0, min(1.0, position)), colour))
    return sorted(stops, key=lambda stop: stop[0])


def banner_parts(text):
    """'Windows 2000 Professional' -> words bold, numbers thin, as the classic banners set them."""
    return [(part, not part.strip().isdigit()) for part in re.findall(r"\s*\d+|\s*[^\d]+", text)]


# XWayland: Qt on Wayland rounds the 1.5x compositor scale up to 2 and misreports the screen size,
# so the menu stays on xcb where Xft.dpi 144 gives an exact 1.5x. Integer glyph placement keeps the
# outline font crisp at that fractional ratio.
# Native Wayland: Qt rasterises text once at the compositor scale, so it is crisp like Plasma's
# own labels. The X11 path softened this font at every setting we tried.
os.environ.setdefault("QT_QPA_PLATFORM", "wayland")
os.environ.setdefault("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
UI_SCALE = 1.0
# Scale comes from the X server DPI (Xft.dpi 144); a QT_SCALE_FACTOR here would stack on it.
os.environ.pop("QT_QPA_PLATFORMTHEME", None)
sys.path[:0] = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "luna", "lib"),
    os.path.expanduser("~/.local/lib/chicago95"),
]
import chicago95animations
import chicago95ui  # after the environment above, so its defaults do not override it
from PySide6.QtCore import QEasingCurve, QEvent, QPoint, QPropertyAnimation, QRect, QStandardPaths, Qt, QTimer
from PySide6.QtGui import (
    QAction,
    QColor,
    QFont,
    QFontDatabase,
    QFontMetrics,
    QIcon,
    QKeyEvent,
    QLinearGradient,
    QPainter,
    QPalette,
)
from PySide6.QtWidgets import QApplication, QMenu, QStyle, QStyleOptionMenuItem, QWidget

