PID_FILE = RUNTIME_DIR / "chicago95-startmenu.pid"
CACHE_FILE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "chicago95-startmenu.json"
BANNER_WIDTH = round(21 * UI_SCALE)
SETTINGS_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "chicago95rc"
ITEM_LEFT_PAD = round(6 * UI_SCALE)
# The originals draw the root menu's icons at 24x24, centred in their rows (measured on all three).
# Root menu measurements per style, taken from screenshots of the originals by tests/test_*_reference.py.
# row: row height; text_gap/text_drop: text offset; icon_x: icon position; banner_*: lettering size and
# place (banner_stretch condenses it, in percent); light/dark: the bevel's outer top-left and
# bottom-right ("face" means the face colour).
