        row=32,
        text_gap=4,
        text_drop=2,
        icon_x=30,
        banner_font=18,
        banner_stretch=110,
        banner_spacing=-1,
        banner_start=2,
        banner_inset=2,
        banner_embolden=1,
        banner_smooth=True,
