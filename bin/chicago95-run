INSTANCE_NAME = "chicago95-run"
HISTORY_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "chicago95/run-history"
HISTORY_LENGTH = 26
MATCH_LIMIT = 8
MATCH_ROW_HEIGHT = 18
RunLayout = namedtuple(
    "RunLayout",
    "body icon_at text_at label_at field_at field_width field_height button_top button_lefts ok_inset prompt_height",
)
# The dialog as the 1995 original (tests/references/win95run.png, tests/test_run_reference.py): a 341x139 client
# area, the icon at 13,15, the text from 56,17, "Open:" at 11,66, the field at 54,61 (275x21) and three 75x23
# buttons painted from 93, 174 and 255, 103 rows down. The XP one (tests/references/xprun.png, 347x186 less its
# 3px frame and 29px title) is 341x154 with the icon at 11,19, the text from 54,20, "Open:" at 11,66, the field at 54,60
# and the buttons 114 rows down.
LAYOUTS = {
    "aero": RunLayout((379, 194), (12, 22), (60, 21), (12, 82), (60, 77), 305, 22, 147, (104, 194, 284), 0, 35),
    "classic": RunLayout((341, 139), (11, 19), (55, 18), (11, 66), (54, 61), 275, 21, 103, (93, 174, 255), 1, 30),
    "win98-hidpi": RunLayout((362, 136), (10, 16), (57, 17), (11, 65), (57, 60), 293, 19, 101, (99, 185, 271), 1, 30),
    "nt-classic": RunLayout((341, 155), (11, 19), (54, 18), (11, 66), (54, 61), 275, 21, 115, (93, 174, 255), 1, 30),
    "luna": RunLayout((341, 154), (11, 19), (54, 18), (11, 66), (54, 60), 275, 21, 114, (93, 174, 255), 0, 30),
    "luna-hidpi": RunLayout((318, 152), (9, 17), (49, 16), (8, 63), (50, 59), 256, 19, 112, (88, 163, 239), 0, 30),
}
NT_PROMPT = "Type the name of a program, folder, document, or\nInternet resource, and {os} will open it for you."
PROMPTS = {
    "aero": "Type the name of a program, folder, document, or Internet resource, and {os} will open it for you.",
    "1995": "Type the name of a program, folder, or document, and {os} will open it for you.",
    "1998": "Type the name of a program, folder, document, or Internet resource, and {os} will open it for you.",
    "2000": NT_PROMPT,
    "2001": NT_PROMPT,
    "luna": NT_PROMPT,
}


def layout_key(look):
    if look["widgetStyle"] in ("luna", "aero"):
        return look["widgetStyle"]
    return "nt-classic" if look["style"] in ("2000", "2001") else "classic"


def prompt_key(look):
    return (
        look["widgetStyle"]
        if look["widgetStyle"] in ("luna", "aero")
        else look["style"]
        if look["style"] in PROMPTS
        else "1995"
    )


def read_history(path=None):
    try:
        return [line for line in (path or HISTORY_FILE).read_text().splitlines() if line]
    except OSError:
        return []


def remember(command, history):
    """The history with the command first and at most HISTORY_LENGTH entries, as the original's drop-down kept it."""
    return [command, *[entry for entry in history if entry != command]][:HISTORY_LENGTH]


def write_history(history, path=None):
    path = path or HISTORY_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(f"{entry}\n" for entry in history))


def load_startmenu():
    """The Start menu's application index, from the installed tool or the checkout beside this one."""
    for folder in (Path(__file__).resolve().parent, Path.home() / ".local/bin"):
        path = folder / "chicago95-startmenu"
        if path.exists():
            loader = importlib.machinery.SourceFileLoader("chicago95_startmenu", str(path))
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(module)
            return module
    return None


def strip_field_codes(exec_line):
    return [word for word in shlex.split(exec_line) if not (word.startswith("%") and len(word) == 2)]


def application_matches(text, applications):
    """Applications whose name starts with the text first, then those with a word starting with it, then the rest
    containing it; each as (name, icon, command)."""
    needle = text.casefold()
    ranked = []
    for application in applications:
        name = application["name"].casefold()
        words = name.replace("-", " ").split()
        rank = (
            0
            if name.startswith(needle)
            else 1
            if any(word.startswith(needle) for word in words)
            else 2
            if needle in name
            else None
        )
        if rank is not None:
            ranked.append((rank, application["name"], application))
    return [
        (application["name"], application["icon"], ["gio", "launch", application["path"]])
        for _rank, _name, application in sorted(ranked, key=lambda entry: (entry[0], entry[1].casefold()))
    ]


def command_matches(text, path_dirs):
    """Programs on the PATH that start with the text, as (name, icon, command)."""
    found = set()
    for folder in path_dirs:
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        found.update(name for name in names if name.startswith(text) and os.access(os.path.join(folder, name), os.X_OK))
    return [(name, "application-x-executable", [name]) for name in sorted(found)]


def path_matches(text):
    """Folders and files whose path starts with the text, as (name, icon, command), for ~ and / paths."""
    if not text.startswith(("/", "~")):
        return []
    expanded = os.path.expanduser(text)
    folder, prefix = (expanded, "") if expanded.endswith("/") else os.path.split(expanded)
    try:
        names = sorted(
            name for name in os.listdir(folder or "/") if name.startswith(prefix) and not name.startswith(".")
        )
    except OSError:
        return []
    return [
        (
            os.path.join(folder, name),
            "folder" if os.path.isdir(os.path.join(folder, name)) else "text-x-generic",
            ["xdg-open", os.path.join(folder, name)],
        )
        for name in names
    ]


def matches(text, applications, path_dirs):
    text = text.strip()
    if not text:
        return []
    if "://" in text or text.startswith("www."):
        return [(text, "text-html", ["xdg-open", text])]
    found = path_matches(text) or application_matches(text, applications) + command_matches(text.split()[0], path_dirs)
    return found[:MATCH_LIMIT]


def literal_command(text):
    """What the typed line runs when no match is picked: a path or URL opens, anything else runs as a command."""
    text = text.strip()
    expanded = os.path.expanduser(text)
    if "://" in text or text.startswith("www.") or os.path.exists(expanded):
        return ["xdg-open", expanded]
    return shlex.split(text)


def launch(command):
    subprocess.Popen(
        ["systemd-run", "--user", "--quiet", "--collect", *command],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def themed_icon(name):
    if name.startswith("/") and os.path.exists(name):
        return QIcon(name)
    return QIcon.fromTheme(name, QIcon.fromTheme("application-x-executable"))


class DefaultOutline(QWidget):
    """The black 1px rectangle the originals drew around the default button."""

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor("#000000"))


class AeroRunContent(QWidget):
    def paintEvent(self, _event):
        painter = QPainter(self)
        scale = painter.deviceTransform().m11()
        pixel = 1 / scale
        pane = QRectF(0, 0, floor(self.width() * scale) * pixel, ceil(self.height() * scale) * pixel)
        painter.fillRect(pane.adjusted(pixel, pixel, -pixel, -pixel), Qt.white)


class AeroRunButton(AeroDialogButton):
    def paint_caption(self, painter, option):
        scale = self.devicePixelRatioF()
        offset = {"OK": -0.25, "Cancel": 0.375, "&Browse...": -0.125}.get(option.text)
        if offset is None or scale != 1.5 or not QFontDatabase.hasFamily("Segoe UI"):
            super().paint_caption(painter, option)
            return
        # Preserve the 150% guest's fractional origin when Qt rasterizes Segoe UI.
        painter.save()
        painter.translate(offset / scale, 0)
        super().paint_caption(painter, option)
        painter.restore()


class LunaRunButton(QPushButton):
    def paintEvent(self, event):  # noqa: N802
        caption = mnemonic_caption(self.text())
        if caption and self.devicePixelRatioF() == 1.25 and QFontDatabase.hasFamily("Tahoma"):
            self.paint_native_caption(caption)
        else:
            super().paintEvent(event)
        if not self.hasFocus():
            return
        painter = QPainter(self)
        transform = painter.deviceTransform()
        inverse, _ = transform.inverted()
        frame = transform.mapRect(QRectF(self.rect())).toRect().adjusted(2, 3, -2, -3)
        x, y, right, bottom = frame.getCoords()
        # XP uses the dialog face as an XOR mask for its one-pixel focus dots.
        painter.setCompositionMode(QPainter.RasterOp_SourceXorDestination)
        painter.setPen(QPen(self.palette().window().color(), 0))
        dots = [
            QPointF(column + .5, row + .5)
            for row in (y, bottom)
            for column in range(x + (x + row) % 2, right + 1, 2)
        ]
        dots.extend(
            QPointF(column + .5, row + .5)
            for column in (x, right)
            for row in range(y + 1 + (y + 1 + column) % 2, bottom, 2)
        )
        painter.drawPoints(inverse.map(QPolygonF(dots)))

    def paint_native_caption(self, caption):
        painter = QStylePainter(self)
        option = QStyleOptionButton()
        self.initStyleOption(option)
        option.text = ""
        painter.drawControl(QStyle.CE_PushButton, option)

        # Shape the mnemonic at its native physical ppem so the underline
        # and the adjacent glyph advances snap to the same pixel grid.
        scale = self.devicePixelRatioF()
        size = QSize(round(self.width() * scale), round(self.height() * scale))
        image = QImage(size, QImage.Format_ARGB32_Premultiplied)
        image.fill(Qt.transparent)
        font = self.font()
        font.setPixelSize(13)
        font.setHintingPreference(QFont.PreferFullHinting)
        font.setKerning(False)
        style = self.style()
        show_mnemonic = style.styleHint(QStyle.SH_UnderlineShortcut, option, self)
        with QPainter(image) as text:
            text.setFont(font)
            style.drawItemText(
                text, image.rect(), Qt.AlignCenter, option.palette,
                self.isEnabled(), caption[0], QPalette.ButtonText,
            )
            if show_mnemonic:
                paint_mnemonic_underline(text, caption, image.rect(), option.palette.buttonText())
        image.setDevicePixelRatio(scale)
        painter.drawImage(QPoint(0, 0), image)


class RunHistoryField(QComboBox):
    opening = Signal()

    def showPopup(self):  # noqa: N802
        if self.count():
            self.opening.emit()
        super().showPopup()


class RunHistoryScrollBar(QScrollBar):
    def paintEvent(self, event):  # noqa: N802
        super().paintEvent(event)
        if self.maximum() > self.minimum():
            return
        option = QStyleOptionSlider()
        self.initStyleOption(option)
        style = self.style()
        top = style.subControlRect(QStyle.CC_ScrollBar, option, QStyle.SC_ScrollBarSubLine, self).bottom() + 1
        bottom = style.subControlRect(QStyle.CC_ScrollBar, option, QStyle.SC_ScrollBarAddLine, self).top()
        if bottom <= top:
            return
        track = QRectF(0, top, self.width(), bottom - top)
        origin = self.mapTo(self.window(), QPoint(0, top))
        painter = QPainter(self)
        transform = painter.deviceTransform()
        scale = transform.m11()
        # Anchor the Windows 9x checkerboard to the frame's physical pixels.
        parity = (floor(origin.x() * scale + 0.5) + floor(origin.y() * scale + 0.5)) % 2
        tile = QPixmap(2, 2)
        tile.fill(option.palette.button().color())
        with QPainter(tile) as stipple:
            stipple.fillRect(1 - parity, 0, 1, 1, Qt.white)
            stipple.fillRect(parity, 1, 1, 1, Qt.white)
        tile.setDevicePixelRatio(scale)
        physical = transform.mapRect(track)
        inverse, _ = transform.inverted()
        painter.drawTiledPixmap(inverse.mapRect(QRectF(physical.toRect())), tile)
        painter.end()


class RunHistoryRows(chicago95ui.ListRowDelegate):
    def __init__(self, view, style, scale, native_96dpi=False):
        super().__init__(view)
        self.label_offset = (3, 1) if style in ("1995", "1998") else (0, 0)
        if style == "1998" and scale == 1.25:
            self.label_offset = (3, 0)
        if native_96dpi:
            self.label_offset = (2, 0)
        self.scale = scale

    def sizeHint(self, option, index):  # noqa: N802
        hint = super().sizeHint(option, index)
        scale = self.scale
        if scale == 1.25:
            # Qt accepts integer logical row sizes. Round the boundaries as a
            # group, and put the remaining fraction against the bottom edge.
            pixels = floor(chicago95ui.LIST_ROW_HEIGHT * scale)
            row = index.row()
            upper = round(row * pixels / scale)
            bottom = (row + 1) * pixels / scale
            lower = floor(bottom) if row + 1 == index.model().rowCount() else round(bottom)
            hint.setHeight(lower - upper)
        return hint

    def paint(self, painter, option, index):
        transform = painter.deviceTransform()
        if transform.m22() == 1.25:
            face = chicago95ui.popup_item_bounds(
                painter, self.parent(), index, option.rect, chicago95ui.LIST_ROW_HEIGHT
            )
        else:
            face = transform.mapRect(QRectF(option.rect))
        inverse, _ = transform.inverted()
        selected = bool(option.state & QStyle.State_Selected)
        palette = option.palette
        painter.save()
        painter.setClipRect(inverse.mapRect(face), Qt.IntersectClip)
        painter.fillRect(inverse.mapRect(face), palette.highlight() if selected else palette.base())
        painter.setFont(option.font)
        painter.setPen(palette.highlightedText().color() if selected else palette.text().color())
        inset, drop = self.label_offset
        label = face.adjusted(inset, drop, -inset, drop)
        painter.drawText(inverse.mapRect(label), Qt.AlignLeading | Qt.AlignVCenter, index.data())
        painter.restore()


class RunBehaviour:
    """The Run dialog of the look, with a list of matching programs, files and commands under the field as the
    text is typed: the dialog grows to hold the list and shrinks back when it empties."""

    def __init__(self, look, applications, path_dirs, history):
        self.look = look
        self.layout = LAYOUTS[layout_key(look)]
        self.style = prompt_key(look)
        super().__init__("Run", self.style, self.layout.body, help_button=True)
        self.layout_scale = chicago95ui.window_scale(self)
        self.native_font = self.original_font()
        self.button_size = (82, 28) if self.style == "aero" else chicago95ui.DIALOG_BUTTON_SIZE
        self.win98_hidpi = self.style == "1998" and self.layout_scale == 1.25
        self.luna_hidpi = self.style == "luna" and self.layout_scale == 1.25
        if self.win98_hidpi:
            self.layout = LAYOUTS["win98-hidpi"]
            self.button_size = (80, 23)
            self.resize_body(*self.layout.body)
        if self.luna_hidpi:
            self.layout = LAYOUTS["luna-hidpi"]
            self.button_size = (69, 22)
            self.resize_body(*self.layout.body)
        elif self.layout_scale == 1.25 and self.style in ("2000", "2001"):
            self.layout = self.layout._replace(field_width=256)
        self.aero_content = None
        self.applications = applications
        self.path_dirs = path_dirs
        self.history = history
        self.command = None
        self.build()

    def original_font(self):
        if self.style not in ("1995", "1998") or self.layout_scale not in (1, 1.25):
            return None
        family = f"Chicago95 Windows {self.style[-2:]}"
        if self.layout_scale == 1.25:
            family += " 120 DPI"
        if family not in QFontDatabase.families():
            return None
        font = QFont(family)
        font.setPixelSize(11)
        font.setStyleStrategy(QFont.NoAntialias)
        font.setHintingPreference(QFont.PreferNoHinting)
        return font

    def caption_font(self):
        if self.native_font is None:
            return super().caption_font()
        font = QFont(self.native_font)
        font.setBold(True)
        return font

    def caption_baseline(self, title):
        baseline = super().caption_baseline(title)
        if self.native_font is not None and self.layout_scale == 1.25:
            baseline -= QPointF(0.8, 0.8)
        return baseline

    def build(self):
        body, layout = self.body, self.layout
        native_96dpi = self.native_font is not None and self.layout_scale == 1
        native_tahoma = False
        if self.style == "aero":
            font = chicago95ui.ui_font(12)
            font.setFamilies(["Segoe UI", "Selawik", "Noto Sans", "DejaVu Sans"])
            self.setFont(font)
            body.setObjectName("aeroRunBody")
            body.setStyleSheet("QWidget#aeroRunBody { background: #f0f0f0; }")
            self.aero_content = AeroRunContent(body)
            self.aero_content.setGeometry(0, 0, layout.body[0], 127)
        elif self.style in ("2000", "2001", "luna"):
            family = chicago95ui.NT_CLASSIC_FONT_FAMILIES.get(self.style, "Tahoma")
            font = QFont(family)
            font.setFamilies(list(dict.fromkeys((family, "Tahoma", "Liberation Sans", "Noto Sans"))))
            font.setPixelSize(11)
            native_tahoma = QFontDatabase.hasFamily(family)
            if native_tahoma or self.luna_hidpi:
                font.setStyleStrategy(QFont.NoAntialias)
            if native_tahoma and self.layout_scale == 1:
                font.setHintingPreference(QFont.PreferFullHinting)
                font.setKerning(False)
            elif native_tahoma and self.luna_hidpi:
                font.setPixelSize(10)
            body.setFont(font)
        elif self.native_font is not None:
            body.setFont(self.native_font)
        icon = QLabel(body)
        filenames = {"aero": "aero-run.svg", "2001": "xp-run.svg", "luna": "xp-run.svg"}
        filename = filenames.get(self.style, "classic-run.svg")
        roots = (Path(__file__).resolve().parents[1] / "data/run", Path.home() / ".local/share/chicago95/run")
        style = "2001" if self.style == "luna" else self.style
        candidates = [root / name for name in (f"native/{style}/run.png", filename) for root in roots]
        asset = next((path for path in candidates if path.is_file()), None)
        graphic = chicago95ui.bitmap_icon(asset) if asset else QIcon()
        if graphic.isNull():
            graphic = QIcon.fromTheme("system-run")
        scale = self.layout_scale
        if self.win98_hidpi:
            # At 120 DPI the native hourglass keeps its 32 physical pixels.
            pixmap = graphic.pixmap(QSize(32, 32), 1.0)
            pixmap.setDevicePixelRatio(scale)
            icon.setPixmap(pixmap)
            side = ceil(32 / scale)
            icon.setFixedSize(side, side)
            icon.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        else:
            pixmap = graphic.pixmap(QSize(32, 32), scale)
            if self.style == "aero" and scale == 1.5 and asset and asset.suffix == ".png":
                # At 144 DPI the native image starts one device pixel below the label's top.
                image = pixmap.toImage()
                pixmap = QPixmap.fromImage(image.copy(0, -1, image.width(), image.height()))
                pixmap.setDevicePixelRatio(scale)
            icon.setPixmap(pixmap)
            icon.setFixedSize(32, 32)
        icon.move(*layout.icon_at)
        prompt = QLabel(chicago95ui.fill_placeholders(PROMPTS[self.style], self.look), body)
        prompt.setWordWrap(True)
        prompt.setGeometry(
            layout.text_at[0], layout.text_at[1], layout.body[0] - layout.text_at[0] - 12, layout.prompt_height
        )
        open_label = QLabel("&Open:", body)
        open_label.move(*layout.label_at)
        if native_96dpi:
            prompt.move(prompt.pos() - QPoint(1, 1))
            open_label.move(open_label.pos() - QPoint(0, 2))
        elif self.native_font is not None:
            prompt.move(prompt.pos() + QPoint(1, -1))
            open_label.move(open_label.pos() - QPoint(0, 2))
        elif native_tahoma and self.layout_scale == 1:
            rise = 2 if self.style == "luna" else 1
            prompt.move(prompt.pos() - QPoint(0, rise))
            open_label.move(open_label.pos() - QPoint(0, rise + 1))
        elif native_tahoma and self.luna_hidpi:
            prompt.move(prompt.pos() + QPoint(2, -1))
            open_label.move(open_label.pos() + QPoint(1, -1))
        elif self.style == "aero" and QFontDatabase.hasFamily("Segoe UI"):
            prompt.move(prompt.pos() + QPoint(-1, 1))
        self.field = chicago95ui.classic_combo(RunHistoryField(body))
        open_label.setBuddy(self.field)
        self.field.setEditable(True)
        self.field.setInsertPolicy(QComboBox.NoInsert)
        self.field.addItems(self.history)
        self.field.setGeometry(*layout.field_at, layout.field_width, layout.field_height)
        if self.style in ("1995", "1998"):
            # The editable Run field and its menu button use the face colour for these bevels.
            palette = self.field.palette()
            for group in (QPalette.Active, QPalette.Inactive, QPalette.Disabled):
                palette.setColor(group, QPalette.Midlight, palette.color(group, QPalette.Button))
            self.field.setPalette(palette)
        if self.style != "aero":
            self.field.setMaxVisibleItems(9 if self.style in ("1995", "1998") else HISTORY_LENGTH)
            view = self.field.view()
            if self.style in ("1995", "1998"):
                view.setVerticalScrollBar(RunHistoryScrollBar(Qt.Vertical, view))
            view.setItemDelegate(RunHistoryRows(view, self.style, scale, native_96dpi))
            if self.win98_hidpi or self.style == "luna":
                font = view.font()
                font.setFamilies(["Tahoma", "Liberation Sans", "Selawik", "Noto Sans"])
                font.setPixelSize(11)
                font.setStyleStrategy(QFont.NoAntialias if self.win98_hidpi else QFont.NoSubpixelAntialias)
                view.setFont(font)
            view.setTextElideMode(Qt.ElideNone)
            view.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOn)
            view.selectionModel().currentChanged.connect(view.viewport().update)
            popup = view.window()
            popup.setFrameStyle(QFrame.Box | QFrame.Plain)
            palette = popup.palette()
            palette.setColor(QPalette.WindowText, QColor("#000000"))
            popup.setPalette(palette)
        if self.aero_content is not None:
            arrow = asset.with_name("aero-down.svg").as_posix()
            self.field.setStyleSheet("""
                QComboBox { background: #ffffff; border: 1px solid #b5cfe7;
                            border-top-color: #3d7db7; padding-left: 3px; }
                QComboBox::drop-down { border: none; width: 15px; }
            """ + f'QComboBox::down-arrow {{ image: url("{arrow}"); width: 8px; height: 6px; }}')
            self.field.lineEdit().setFont(body.font())
        self.field.lineEdit().textEdited.connect(self.search)
        self.field.lineEdit().installEventFilter(self)
        self.field.view().installEventFilter(self)
        self.field.opening.connect(self.clear_matches)
        self.field.activated.connect(self.choose_history)
        self.results = QListWidget(body)
        self.results.setGeometry(
            layout.field_at[0], layout.field_at[1] + layout.field_height + 4, layout.field_width, 0
        )
        self.results.hide()
        self.results.itemActivated.connect(lambda _item: self.accept())
        self.results.itemClicked.connect(lambda _item: self.accept())
        self.buttons = {}
        # The original's default button: a 1px black outline around a whole 75x23 button; Qt would draw the
        # outline a pixel inside, so OK sits in an outline of its own and Enter is handled by the dialog.
        self.outline = DefaultOutline(body)
        self.outline.setGeometry(layout.button_lefts[0], layout.button_top, *self.button_size)
        self.outline.setVisible(layout.ok_inset > 0)
        artwork = aero_button_artwork() if self.style == "aero" else None
        # The 120-DPI guest aligns each caption to the physical pixel grid.
        win98_caption_offsets = {"OK": -2, "Cancel": -0.5, "&Browse...": -1.25}
        for label in ("OK", "Cancel", "&Browse..."):
            if artwork:
                button = AeroRunButton(label, artwork, body, default_face="run-default", normal_face="run-normal")
            elif self.luna_hidpi:
                button = LunaRunButton(label, body)
            else:
                button = QPushButton(label, body)
                mnemonic = not QKeySequence.mnemonic(label).isEmpty()
                if native_96dpi:
                    button.setProperty("classicLabelDeviceOffset", QPoint(-2 if mnemonic else -1, -1))
                elif self.win98_hidpi and self.native_font is not None:
                    button.setProperty("classicLabelDeviceOffset", QPointF(win98_caption_offsets[label], -1))
                elif native_tahoma and self.layout_scale == 1 and self.style in ("2000", "2001"):
                    button.setProperty("classicLabelDeviceOffset", QPoint(-1, -1))
            button.setAutoDefault(self.luna_hidpi)
            self.buttons[label] = button
        self.place_buttons(0)
        self.buttons["OK"].setDefault(layout.ok_inset == 0)
        self.update_accept(self.field.currentText())
        self.field.editTextChanged.connect(self.update_accept)
        self.buttons["OK"].clicked.connect(self.accept)
        self.buttons["Cancel"].clicked.connect(self.reject)
        self.buttons["&Browse..."].clicked.connect(self.browse)
        self.field.setFocus()
        self.field.lineEdit().selectAll()

    def update_accept(self, text):
        self.buttons["OK"].setEnabled(bool(text.strip()))

    def clear_matches(self):
        if self.results.isVisible():
            self.results.clear()
            self.show_results(0)

    def choose_history(self, _index):
        self.field.lineEdit().selectAll()

    def preview_history(self):
        view = self.field.view()
        if view.isVisible() and view.currentIndex().isValid():
            row = view.currentIndex().row()
            self.field.setCurrentIndex(row)
            self.field.setEditText(self.field.itemText(row))
            self.field.lineEdit().selectAll()

    def eventFilter(self, watched, event):
        if watched is self.field.view():
            if event.type() == QEvent.KeyPress and event.key() in (
                Qt.Key_Up, Qt.Key_Down, Qt.Key_Home, Qt.Key_End, Qt.Key_PageUp, Qt.Key_PageDown
            ):
                QTimer.singleShot(0, self, self.preview_history)
            return super().eventFilter(watched, event)
        if event.type() == QEvent.KeyPress and event.key() in (Qt.Key_Return, Qt.Key_Enter):
            self.accept()
            return True
        if (
            event.type() == QEvent.KeyPress and event.key() in (Qt.Key_Down, Qt.Key_Up)
            and event.modifiers() == Qt.NoModifier and self.results.isVisible()
        ):
            step = 1 if event.key() == Qt.Key_Down else -1
            self.results.setCurrentRow(max(0, min(self.results.count() - 1, self.results.currentRow() + step)))
            return True
        return super().eventFilter(watched, event)

    def search(self, text):
        if self.applications is None:
            startmenu = load_startmenu()
            self.applications = startmenu.collect_applications() if startmenu else []
        found = matches(text, self.applications, self.path_dirs)
        self.update_accept(text)
        self.results.clear()
        for name, icon, command in found:
            item = QListWidgetItem(themed_icon(icon), name)
            item.setData(Qt.UserRole, command)
            self.results.addItem(item)
        if found:
            self.results.setCurrentRow(0)
        self.show_results(len(found))

    def place_buttons(self, extra):
        width, height = self.button_size
        for index, (left, button) in enumerate(zip(self.layout.button_lefts, self.buttons.values(), strict=True)):
            inset = self.layout.ok_inset if index == 0 else 0
            rect = (left + inset, self.layout.button_top + inset + extra, width - 2 * inset, height - 2 * inset)
            if isinstance(button, AeroDialogButton):
                button.set_aligned_geometry(*rect)
            else:
                button.setGeometry(*rect)

    def show_results(self, count):
        """The list under the field, as tall as its rows; the buttons move down with the dialog's bottom."""
        layout = self.layout
        list_height = count * MATCH_ROW_HEIGHT + 2 if count else 0
        extra = list_height + 4 if count else 0
        self.results.setGeometry(
            layout.field_at[0], layout.field_at[1] + layout.field_height + 4, layout.field_width, list_height
        )
        self.results.setVisible(count > 0)
        self.resize_body(layout.body[0], layout.body[1] + extra)
        if self.aero_content is not None:
            self.aero_content.resize(layout.body[0], 127 + extra)
        self.outline.move(self.outline.x(), layout.button_top + extra)
        self.place_buttons(extra)

    def browse(self):
        path, _filter = QFileDialog.getOpenFileName(self, "Browse", str(Path.home()))
        if path:
            self.field.setEditText(path)
            self.search(path)

    def accept(self):
        text = self.field.currentText().strip()
        if not text:
            return
        current = self.results.currentItem() if self.results.isVisible() else None
        self.command = current.data(Qt.UserRole) if current else literal_command(text)
        self.history = remember(text, self.history)
        write_history(self.history)
        super().accept()


@functools.cache
def run_dialog_class(frame):
    return type("RunDialog", (RunBehaviour, frame), {})


def RunDialog(look=None, applications=None, path_dirs=None, history=None):  # noqa: N802
    look = {**chicago95ui.look_settings(), **(look or {})}
    return run_dialog_class(chicago95ui.dialog_frame_class(look["widgetStyle"] in ("luna", "aero")))(
        look,
        applications,
        path_dirs if path_dirs is not None else os.environ.get("PATH", "").split(os.pathsep),
        read_history() if history is None else history,
    )


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Run dialog for KDE")
    parser.add_argument("--dry-run", action="store_true", help="print the command instead of running it")
    parser.add_argument("--screenshot", metavar="PATH", help="save the dialog as PNG and exit")
    parser.add_argument("--height", action="store_true", help="print the dialog's height in pixels and exit")
    parser.add_argument(
        "--widget-style", choices=("classic", "luna", "aero"), help="with --height: the style to measure"
    )
    parser.add_argument("--menu-style", help="with --height: the Start menu style selected in Setup")
    arguments = parser.parse_args()
    if arguments.height:
        chicago95ui.make_app(INSTANCE_NAME)
        look = {}
        if arguments.widget_style:
            look["widgetStyle"] = arguments.widget_style
        if arguments.menu_style:
            look["style"] = arguments.menu_style
        dialog = RunDialog(look)
        dialog.adjustSize()
        print(dialog.height())
        return 0
    if not arguments.screenshot and not arguments.dry_run and chicago95ui.send_to_running(INSTANCE_NAME, "raise"):
        return 0
    application = chicago95ui.make_app(INSTANCE_NAME)
    dialog = RunDialog()
    if arguments.screenshot:
        dialog.show()
        dialog.grab().save(arguments.screenshot)
        return 0
    instance = chicago95ui.SingleInstance(INSTANCE_NAME, lambda _message: (dialog.raise_(), dialog.activateWindow()))  # noqa: F841

    def finished(result):
        if result == QDialog.Accepted and arguments.dry_run:
            print("dry-run, would run:", " ".join(dialog.command))
        elif result == QDialog.Accepted:
            launch(dialog.command)
        application.quit()

    dialog.finished.connect(finished)
    dialog.show()
    return application.exec()


if __name__ == "__main__":
    sys.exit(main())
