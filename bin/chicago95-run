#!/usr/bin/env python3
import os
import sys

sys.path[:0] = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "luna", "lib"),
    os.path.expanduser("~/.local/lib/chicago95"),
]
import argparse
import functools
import importlib.machinery
import importlib.util
import shlex
import subprocess
from collections import namedtuple
from pathlib import Path

import chicago95ui  # noqa: E401,E702
from PySide6.QtCore import QEvent, Qt
from PySide6.QtGui import QColor, QIcon, QPainter
from PySide6.QtWidgets import (
    QComboBox,
    QDialog,
    QFileDialog,
    QLabel,
    QListWidget,
    QListWidgetItem,
    QPushButton,
    QWidget,
)

INSTANCE_NAME = "chicago95-run"
HISTORY_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "chicago95/run-history"
HISTORY_LENGTH = 26
MATCH_LIMIT = 8
MATCH_ROW_HEIGHT = 18
RunLayout = namedtuple(
    "RunLayout",
    "body icon_at text_at label_at field_at field_width field_height button_top button_lefts ok_inset prompt_height",
)
# The dialog as the 1995 original (tests/references/win95run.png, tests/test_run_reference.py): a 341x139 client
# area, the icon at 13,15, the text from 56,17, "Open:" at 11,66, the field at 54,61 (275x21) and three 75x23
# buttons painted from 93, 174 and 255, 103 rows down. The XP one (tests/references/xprun.png, 347x186 less its
# 3px frame and 29px title) is 341x154 with the icon at 11,19, the text from 54,20, "Open:" at 11,66, the field at 54,60
# and the buttons 114 rows down.
LAYOUTS = {
    "classic": RunLayout((341, 139), (13, 15), (56, 17), (11, 66), (54, 61), 275, 21, 103, (93, 174, 255), 1, 30),
    "luna": RunLayout((341, 154), (11, 19), (54, 20), (11, 66), (54, 60), 275, 21, 114, (93, 174, 255), 0, 40),
}
PROMPTS = {
    "1995": "Type the name of a program, folder, or document, and {os} will open it for you.",
    "1998": "Type the name of a program, folder, document, or Internet resource, and {os} will open it for you.",
    "2000": "Type the name of a program, folder, document, or Internet resource, and {os} will open it for you.",
    "luna": "Type the name of a program, folder, document, or Internet resource, and {os} will open it for you.",
}


def layout_key(look):
    return "luna" if look["widgetStyle"] == "luna" else "classic"


def prompt_key(look):
    return "luna" if look["widgetStyle"] == "luna" else look["style"] if look["style"] in PROMPTS else "1995"


def read_history(path=None):
    try:
        return [line for line in (path or HISTORY_FILE).read_text().splitlines() if line]
    except OSError:
        return []


def remember(command, history):
    """The history with the command first and at most HISTORY_LENGTH entries, as the original's drop-down kept it."""
    return [command, *[entry for entry in history if entry != command]][:HISTORY_LENGTH]


def write_history(history, path=None):
    path = path or HISTORY_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(f"{entry}\n" for entry in history))


def load_startmenu():
    """The Start menu's application index, from the installed tool or the checkout beside this one."""
    for folder in (Path(__file__).resolve().parent, Path.home() / ".local/bin"):
        path = folder / "chicago95-startmenu"
        if path.exists():
            loader = importlib.machinery.SourceFileLoader("chicago95_startmenu", str(path))
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(module)
            return module
    return None


def strip_field_codes(exec_line):
    return [word for word in shlex.split(exec_line) if not (word.startswith("%") and len(word) == 2)]


def application_matches(text, applications):
    """Applications whose name starts with the text first, then those with a word starting with it, then the rest
    containing it; each as (name, icon, command)."""
    needle = text.casefold()
    ranked = []
    for application in applications:
        name = application["name"].casefold()
        words = name.replace("-", " ").split()
        rank = (
            0
            if name.startswith(needle)
            else 1
            if any(word.startswith(needle) for word in words)
            else 2
            if needle in name
            else None
        )
        if rank is not None:
            ranked.append((rank, application["name"], application))
    return [
        (application["name"], application["icon"], ["gio", "launch", application["path"]])
        for _rank, _name, application in sorted(ranked, key=lambda entry: (entry[0], entry[1].casefold()))
    ]


def command_matches(text, path_dirs):
    """Programs on the PATH that start with the text, as (name, icon, command)."""
    found = set()
    for folder in path_dirs:
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        found.update(name for name in names if name.startswith(text) and os.access(os.path.join(folder, name), os.X_OK))
    return [(name, "application-x-executable", [name]) for name in sorted(found)]


def path_matches(text):
    """Folders and files whose path starts with the text, as (name, icon, command), for ~ and / paths."""
    if not text.startswith(("/", "~")):
        return []
    expanded = os.path.expanduser(text)
    folder, prefix = (expanded, "") if expanded.endswith("/") else os.path.split(expanded)
    try:
        names = sorted(
            name for name in os.listdir(folder or "/") if name.startswith(prefix) and not name.startswith(".")
        )
    except OSError:
        return []
    return [
        (
            os.path.join(folder, name),
            "folder" if os.path.isdir(os.path.join(folder, name)) else "text-x-generic",
            ["xdg-open", os.path.join(folder, name)],
        )
        for name in names
    ]


def matches(text, applications, path_dirs):
    text = text.strip()
    if not text:
        return []
    if "://" in text or text.startswith("www."):
        return [(text, "text-html", ["xdg-open", text])]
    found = path_matches(text) or application_matches(text, applications) + command_matches(text.split()[0], path_dirs)
    return found[:MATCH_LIMIT]


def literal_command(text):
    """What the typed line runs when no match is picked: a path or URL opens, anything else runs as a command."""
    text = text.strip()
    expanded = os.path.expanduser(text)
    if "://" in text or text.startswith("www.") or os.path.exists(expanded):
        return ["xdg-open", expanded]
    return shlex.split(text)


def launch(command):
    subprocess.Popen(
        ["systemd-run", "--user", "--quiet", "--collect", *command],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def themed_icon(name):
    if name.startswith("/") and os.path.exists(name):
        return QIcon(name)
    return QIcon.fromTheme(name, QIcon.fromTheme("application-x-executable"))


class DefaultOutline(QWidget):
    """The black 1px rectangle the originals drew around the default button."""

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.setPen(QColor("#000000"))
        painter.drawRect(self.rect().adjusted(0, 0, -1, -1))


class RunBehaviour:
    """The Run dialog of the look, with a list of matching programs, files and commands under the field as the
    text is typed: the dialog grows to hold the list and shrinks back when it empties."""

    def __init__(self, look, applications, path_dirs, history):
        self.look = look
        self.layout = LAYOUTS[layout_key(look)]
        self.style = prompt_key(look)
        super().__init__("Run", self.style, self.layout.body, help_button=True)
        self.applications = applications
        self.path_dirs = path_dirs
        self.history = history
        self.command = None
        self.build()

    def build(self):
        body, layout = self.body, self.layout
        icon = QLabel(body)
        icon.setPixmap(QIcon.fromTheme("system-run").pixmap(32, 32))
        icon.setFixedSize(32, 32)
        icon.move(*layout.icon_at)
        prompt = QLabel(chicago95ui.fill_placeholders(PROMPTS[self.style], self.look), body)
        prompt.setWordWrap(True)
        prompt.setGeometry(
            layout.text_at[0], layout.text_at[1], layout.body[0] - layout.text_at[0] - 12, layout.prompt_height
        )
        open_label = QLabel("&Open:", body)
        open_label.move(*layout.label_at)
        self.field = chicago95ui.classic_combo(QComboBox(body))
        open_label.setBuddy(self.field)
        self.field.setEditable(True)
        self.field.setInsertPolicy(QComboBox.NoInsert)
        self.field.addItems(self.history)
        self.field.setGeometry(*layout.field_at, layout.field_width, layout.field_height)
        self.field.setEditText("")
        self.field.lineEdit().textEdited.connect(self.search)
        self.field.lineEdit().installEventFilter(self)
        self.results = QListWidget(body)
        self.results.setGeometry(
            layout.field_at[0], layout.field_at[1] + layout.field_height + 4, layout.field_width, 0
        )
        self.results.hide()
        self.results.itemActivated.connect(lambda _item: self.accept())
        self.results.itemClicked.connect(lambda _item: self.accept())
        self.buttons = {}
        # The original's default button: a 1px black outline around a whole 75x23 button; Qt would draw the
        # outline a pixel inside, so OK sits in an outline of its own and Enter is handled by the dialog.
        self.outline = DefaultOutline(body)
        self.outline.setGeometry(layout.button_lefts[0], layout.button_top, *chicago95ui.DIALOG_BUTTON_SIZE)
        self.outline.setVisible(layout.ok_inset > 0)
        for left, label in zip(layout.button_lefts, ("OK", "Cancel", "&Browse..."), strict=False):
            button = QPushButton(label, body)
            button.setAutoDefault(False)
            button.setGeometry(left, layout.button_top, *chicago95ui.DIALOG_BUTTON_SIZE)
            self.buttons[label] = button
        self.place_ok_button(0)
        self.buttons["OK"].setDefault(layout.ok_inset == 0)
        self.buttons["OK"].setEnabled(False)
        self.buttons["OK"].clicked.connect(self.accept)
        self.buttons["Cancel"].clicked.connect(self.reject)
        self.buttons["&Browse..."].clicked.connect(self.browse)
        self.field.setFocus()

    def eventFilter(self, watched, event):
        if event.type() == QEvent.KeyPress and event.key() in (Qt.Key_Return, Qt.Key_Enter):
            self.accept()
            return True
        if event.type() == QEvent.KeyPress and event.key() in (Qt.Key_Down, Qt.Key_Up) and self.results.isVisible():
            step = 1 if event.key() == Qt.Key_Down else -1
            self.results.setCurrentRow(max(0, min(self.results.count() - 1, self.results.currentRow() + step)))
            return True
        return super().eventFilter(watched, event)

    def search(self, text):
        if self.applications is None:
            startmenu = load_startmenu()
            self.applications = startmenu.collect_applications() if startmenu else []
        found = matches(text, self.applications, self.path_dirs)
        self.buttons["OK"].setEnabled(bool(text.strip()))
        self.results.clear()
        for name, icon, command in found:
            item = QListWidgetItem(themed_icon(icon), name)
            item.setData(Qt.UserRole, command)
            self.results.addItem(item)
        if found:
            self.results.setCurrentRow(0)
        self.show_results(len(found))

    def place_ok_button(self, extra):
        inset, (width, height) = self.layout.ok_inset, chicago95ui.DIALOG_BUTTON_SIZE
        self.buttons["OK"].setGeometry(
            self.layout.button_lefts[0] + inset,
            self.layout.button_top + inset + extra,
            width - 2 * inset,
            height - 2 * inset,
        )

    def show_results(self, count):
        """The list under the field, as tall as its rows; the buttons move down with the dialog's bottom."""
        layout = self.layout
        list_height = count * MATCH_ROW_HEIGHT + 2 if count else 0
        extra = list_height + 4 if count else 0
        self.results.setGeometry(
            layout.field_at[0], layout.field_at[1] + layout.field_height + 4, layout.field_width, list_height
        )
        self.results.setVisible(count > 0)
        self.resize_body(layout.body[0], layout.body[1] + extra)
        for button in (self.buttons["Cancel"], self.buttons["&Browse..."]):
            button.move(button.x(), layout.button_top + extra)
        self.outline.move(self.outline.x(), layout.button_top + extra)
        self.place_ok_button(extra)

    def browse(self):
        path, _filter = QFileDialog.getOpenFileName(self, "Browse", str(Path.home()))
        if path:
            self.field.setEditText(path)
            self.search(path)

    def accept(self):
        text = self.field.currentText().strip()
        if not text:
            return
        current = self.results.currentItem() if self.results.isVisible() else None
        self.command = current.data(Qt.UserRole) if current else literal_command(text)
        self.history = remember(text, self.history)
        write_history(self.history)
        super().accept()


@functools.cache
def run_dialog_class(frame):
    return type("RunDialog", (RunBehaviour, frame), {})


def RunDialog(look=None, applications=None, path_dirs=None, history=None):  # noqa: N802
    look = {**chicago95ui.look_settings(), **(look or {})}
    return run_dialog_class(chicago95ui.dialog_frame_class(look["widgetStyle"] == "luna"))(
        look,
        applications,
        path_dirs if path_dirs is not None else os.environ.get("PATH", "").split(os.pathsep),
        read_history() if history is None else history,
    )


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Run dialog for KDE")
    parser.add_argument("--dry-run", action="store_true", help="print the command instead of running it")
    parser.add_argument("--screenshot", metavar="PATH", help="save the dialog as PNG and exit")
    arguments = parser.parse_args()
    if not arguments.screenshot and not arguments.dry_run and chicago95ui.send_to_running(INSTANCE_NAME, "raise"):
        return 0
    application = chicago95ui.make_app(INSTANCE_NAME)
    dialog = RunDialog()
    if arguments.screenshot:
        dialog.show()
        dialog.grab().save(arguments.screenshot)
        return 0
    instance = chicago95ui.SingleInstance(INSTANCE_NAME, lambda _message: (dialog.raise_(), dialog.activateWindow()))  # noqa: F841

    def finished(result):
        if result == QDialog.Accepted and arguments.dry_run:
            print("dry-run, would run:", " ".join(dialog.command))
        elif result == QDialog.Accepted:
            launch(dialog.command)
        application.quit()

    dialog.finished.connect(finished)
    dialog.show()
    return application.exec()


if __name__ == "__main__":
    sys.exit(main())
