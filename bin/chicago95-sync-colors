#!/usr/bin/env python3
"""Redraws the window decoration when the title bar colours in the colour scheme change.

Started by chicago95-colors.path whenever ~/.config/kdeglobals is written (System Settings >
Colors, or Setup). The Aurorae decoration is a fixed SVG, so it cannot follow the scheme by itself.

    chicago95-sync-colors           redraw only when the title colours differ from the last run
    chicago95-sync-colors --force   redraw anyway
"""
import os, sys; sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"), os.path.expanduser("~/.local/lib/chicago95")]; import chicago95ui  # noqa: E401,E702

import subprocess
from pathlib import Path

DECORATION = Path.home() / ".local/share/aurorae/themes/Chicago95"
STAMP = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "chicago95-title-colors"


def title_argument(start, blend):
    """'#000080' for a solid title, '#000080,#1084d0' for a gradient."""
    return start.name() if start == blend else f"{start.name()},{blend.name()}"


def title_arguments(scheme):
    return ["--active", title_argument(scheme["title_active"], scheme["title_active_blend"]),
            "--inactive", title_argument(scheme["title_inactive"], scheme["title_inactive_blend"])]


def main():
    arguments = title_arguments(chicago95ui.read_scheme())
    stamp = " ".join(arguments)
    # kdeglobals is rewritten for any setting; only a title colour change is worth a redraw.
    if "--force" not in sys.argv and STAMP.exists() and STAMP.read_text() == stamp:
        return 0
    subprocess.run([sys.executable, str(DECORATION / "make_chicago95_aurorae.py"), "--out", str(DECORATION), *arguments],
                   check=True, stdout=subprocess.DEVNULL)
    subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path", "/KWin",
                    "--method", "org.kde.KWin.reconfigure"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    STAMP.parent.mkdir(parents=True, exist_ok=True)
    STAMP.write_text(stamp)
    print("title bars redrawn:", stamp)
    return 0


if __name__ == "__main__":
    sys.exit(main())
