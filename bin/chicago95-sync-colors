#!/usr/bin/env python3
"""Redraws the window decoration and the Plasma style's taskbar and buttons when the colour scheme's
title bar or face colours, or the look, change.

Started by chicago95-colors.path whenever ~/.config/kdeglobals is written (System Settings >
Colors, or Setup). Both are fixed SVGs, so they cannot follow the scheme by themselves.

    chicago95-sync-colors           redraw only when the title colours differ from the last run
    chicago95-sync-colors --force   redraw anyway
"""

import os
import sys

sys.path[:0] = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "luna", "lib"),
    os.path.expanduser("~/.local/lib/chicago95"),
]
import subprocess
from pathlib import Path

import chicago95ui  # noqa: E401,E702

DECORATION = Path.home() / ".local/share/aurorae/themes/Chicago95"
PLASMA_STYLE = Path.home() / ".local/share/plasma/desktoptheme/Chicago95"
LUNA_GENERATORS = Path.home() / ".local/share/chicago95/luna-generators/luna"
LUNA_DECORATION = Path.home() / ".local/share/aurorae/themes/Chicago95Luna"
LUNA_PLASMA_STYLE = Path.home() / ".local/share/plasma/desktoptheme/Chicago95Luna"
DECORATION_THEMES = {
    "classic": (DECORATION / "make_chicago95_aurorae.py", DECORATION),
    "luna": (LUNA_GENERATORS / "aurorae/make_luna_aurorae.py", LUNA_DECORATION),
}
PLASMA_STYLE_THEMES = {
    "classic": (DECORATION / "make_chicago95_plasmastyle.py", PLASMA_STYLE),
    "luna": (LUNA_GENERATORS / "plasma-style/make_luna_plasmastyle.py", LUNA_PLASMA_STYLE),
}
STAMP = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "chicago95-title-colors"


def title_argument(start, blend):
    """'#000080' for a solid title, '#000080,#1084d0' for a gradient."""
    return start.name() if start == blend else f"{start.name()},{blend.name()}"


# 2000's active title keeps its end colours behind the window icon and the caption buttons.
GRADIENT_MARGINS = {"2000": "18,52"}


def bevel_arguments(scheme, bevel):
    """Both generators' options for the face and the look's 3D lines."""
    colors = chicago95ui.bevel_colors(scheme["face"], bevel)
    return [
        "--face",
        scheme["face"].name(),
        "--light",
        colors["light"].name(),
        "--shadow",
        colors["shadow"].name(),
        "--dark",
        colors["dark"].name(),
    ]


def decoration_arguments(scheme, bevel):
    """The decoration generator's options for the colour scheme's title colours and the look's bevel."""
    return [
        "--active",
        title_argument(scheme["title_active"], scheme["title_active_blend"]),
        "--inactive",
        title_argument(scheme["title_inactive"], scheme["title_inactive_blend"]),
        "--inactive-text",
        scheme["title_inactive_text"].name(),
        *bevel_arguments(scheme, bevel),
        "--gradient-margins",
        GRADIENT_MARGINS.get(bevel, "0,0"),
    ]


def decoration_command(style, arguments):
    generator, out = DECORATION_THEMES[style]
    options = arguments if style == "classic" else []
    return [sys.executable, str(generator), "--out", str(out), *options]


def plasma_style_command(style, scheme, bevel):
    generator, out = PLASMA_STYLE_THEMES[style]
    if style == "luna":
        return [sys.executable, str(generator), "--out", str(out), "--base", str(PLASMA_STYLE)]
    return [
        sys.executable,
        str(generator),
        "--out",
        str(out),
        *bevel_arguments(scheme, bevel),
        "--selection",
        scheme["selection"].name(),
    ]


def main():
    settings = chicago95ui.look_settings()
    scheme, bevel = chicago95ui.read_scheme(), settings["bevel"]
    decoration, plasma_style = settings["decoration"], settings["taskbarStyle"]
    arguments = decoration_arguments(scheme, bevel)
    styles = [] if (decoration, plasma_style) == ("classic", "classic") else [decoration, plasma_style]
    stamp = " ".join([*styles, *arguments])
    # kdeglobals is rewritten for any setting; only a title colour change is worth a redraw.
    if "--force" not in sys.argv and STAMP.exists() and STAMP.read_text() == stamp:
        return 0
    subprocess.run(decoration_command(decoration, arguments), check=True, stdout=subprocess.DEVNULL)
    if PLASMA_STYLE_THEMES[plasma_style][1].exists():
        subprocess.run(plasma_style_command(plasma_style, scheme, bevel), check=True, stdout=subprocess.DEVNULL)
    subprocess.run(
        [
            "gdbus",
            "call",
            "--session",
            "--dest",
            "org.kde.KWin",
            "--object-path",
            "/KWin",
            "--method",
            "org.kde.KWin.reconfigure",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    STAMP.parent.mkdir(parents=True, exist_ok=True)
    STAMP.write_text(stamp)
    print("title bars redrawn:", stamp)
    return 0


if __name__ == "__main__":
    sys.exit(main())
