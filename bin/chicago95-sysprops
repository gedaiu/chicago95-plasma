#!/usr/bin/env python3
import os, sys; sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"), os.path.expanduser("~/.local/lib/chicago95")]; import chicago95ui  # noqa: E702

import platform
import pwd
import re
import socket
import subprocess
from dataclasses import dataclass
from pathlib import Path

from PySide6.QtCore import Qt
from PySide6.QtGui import QColor, QFontMetrics, QIcon, QPainter
from PySide6.QtWidgets import (
    QGridLayout,
    QGroupBox,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

DEVICE_MANAGER_PATH = Path.home() / ".local/bin/chicago95-devmgr"
BUTTON_SIZE = chicago95ui.DIALOG_BUTTON_SIZE
VALUE_INDENT = 16
KIB_PER_GIB = 1024 * 1024


def run_output(command):
    native_environment = {key: value for key, value in os.environ.items() if key != "QT_QPA_PLATFORM"}
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=3, env=native_environment).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def strip_ansi(text):
    return re.sub(r"\x1b\[[0-9;]*m", "", text)


def read_os_name():
    for line in Path("/etc/os-release").read_text().splitlines():
        if line.startswith("PRETTY_NAME="):
            return line.split("=", 1)[1].strip().strip('"')
    return platform.system()


def read_kernel():
    return "Linux " + platform.release()


def read_desktop():
    version_match = re.search(r"(\d+\.\d+)", run_output(["plasmashell", "--version"]))
    version = version_match.group(1) if version_match else "6"
    session = os.environ.get("XDG_SESSION_TYPE", "wayland").capitalize()
    return f"KDE Plasma {version} ({session})"


def read_full_name():
    entry = pwd.getpwuid(os.getuid())
    gecos_name = entry.pw_gecos.split(",")[0].strip()
    return gecos_name or entry.pw_name


def read_product_key():
    machine_id = Path("/etc/machine-id").read_text().strip()
    digits = str(int(machine_id, 16))
    return f"{digits[:5]}-OEM-{digits[5:12]}-{digits[12:17]}"


def read_cpu_model():
    model_match = re.search(r"Model name:\s*(.+)", run_output(["lscpu"]))
    return model_match.group(1).strip() if model_match else platform.processor()


def read_meminfo():
    fields = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        key, value = line.split(":", 1)
        fields[key] = int(value.split()[0])
    return fields


def kib_to_gb(kib):
    return round(kib / KIB_PER_GIB)


def read_display():
    screen_output = strip_ansi(run_output(["kscreen-doctor", "-o"]))
    geometry_match = re.search(r"Geometry:\s*\S+\s+(\d+)x(\d+)", screen_output)
    scale_match = re.search(r"Scale:\s*([0-9.]+)", screen_output)
    if not geometry_match:
        return "Unknown display"
    width, height = int(geometry_match.group(1)), int(geometry_match.group(2))
    scale = float(scale_match.group(1)) if scale_match else 1.0
    description = f"{width}x{height} at {scale:g}x"
    if scale != 1.0:
        description += f" ({round(width * scale)}x{round(height * scale)} panel)"
    return description


def read_swap_description(swap_total_kib):
    swap_table = Path("/proc/swaps").read_text()
    kind = " (zram)" if "zram" in swap_table else ""
    return f"{kib_to_gb(swap_total_kib)} GB swap{kind}"


def read_root_filesystem():
    fstype = run_output(["findmnt", "-no", "FSTYPE", "/"]).strip()
    return fstype.capitalize() if fstype else "Unknown"


@dataclass(frozen=True)
class SystemFacts:
    os_name: str
    kernel: str
    desktop: str
    owner: str
    hostname: str
    product_key: str
    cpu_model: str
    logical_processors: str
    memory: str
    display: str
    resources_free: str
    filesystem: str
    virtual_memory: str


def gather_system_facts():
    meminfo = read_meminfo()
    free_percent = round(100 * meminfo["MemAvailable"] / meminfo["MemTotal"])
    return SystemFacts(
        os_name=read_os_name(),
        kernel=read_kernel(),
        desktop=read_desktop(),
        owner=read_full_name(),
        hostname=socket.gethostname(),
        product_key=read_product_key(),
        cpu_model=read_cpu_model(),
        logical_processors=f"{os.cpu_count()} logical processors",
        memory=f"{kib_to_gb(meminfo['MemTotal'])} GB RAM",
        display=read_display(),
        resources_free=f"{free_percent}% free",
        filesystem=read_root_filesystem(),
        virtual_memory=read_swap_description(meminfo["SwapTotal"]),
    )


def plain_label(text, indent=0):
    label = QLabel(text)
    label.setFont(chicago95ui.ui_font())
    label.setIndent(indent)
    return label


# The dialog as the originals draw it, measured in tests/test_sysprops_reference.py, in dialog
# coordinates (the body starts 3px in and 21px down): a 410px dialog, 448px tall (2000: 461), the tab
# strip at the top of a page frame from x 9 to 400, the computer picture at the left of the General
# page, the facts in two columns at the right, and 75x23 buttons at the bottom right.
DIALOG_WIDTH = 410
DIALOG_HEIGHT = {"1995": 448, "1998": 448, "2000": 461}
BODY_ORIGIN = (3, 21)
DIALOG_FRAME = 3
TABS = {"1995": ["General", "Device Manager", "Hardware Profiles", "Performance"],
        "1998": ["General", "Device Manager", "Hardware Profiles", "Performance"],
        "2000": ["General", "Hardware", "User Profiles", "Advanced"]}
TAB_LEFT, TAB_PADDING, TAB_TOP, SELECTED_TAB_RISE = 11, 13, 31, 2
PAGE_LEFT, PAGE_RIGHT, PAGE_TOP = 9, 400, 49
PAGE_BOTTOM_FROM_END = 40                 # the page frame's black bottom row, from the dialog's bottom
CAPTION_INSET, CAPTION_BASELINE = 6, 45
ICON_POSITION, ICON_SIZE = (65, 100), 96    # centred on the original's picture, which is wider
# The General page's headings: (column, cap-height row) per group; values 18px further in, 18px apart.
HEADINGS = {"1995": [(215, 71), (215, 151), (215, 253)], "1998": [(196, 71), (196, 160), (196, 246)], "2000": [(208, 71), (208, 151), (178, 256)]}
BUTTON_LEFTS = {"1995": {"OK": 245, "Cancel": 326}, "1998": {"OK": 245, "Cancel": 326}, "2000": {"OK": 164, "Cancel": 245, "Apply": 326}}
BUTTONS_TOP = {"1995": 415, "1998": 415, "2000": 428}
CAP_HEIGHT = 9


def in_body(x, y):
    return x - BODY_ORIGIN[0], y - BODY_ORIGIN[1]


class TabStrip(QWidget):
    """The tabs and the page frame, painted the classic way: each tab a white left and top edge with
    rounded corners and a shadow and black right edge; the selected one 2px taller and wider, covering
    its neighbour's edge and the page frame's top line under it; pages shown by a QStackedWidget inside
    the frame. Tab widths follow their captions."""

    def __init__(self, captions, style, parent):
        super().__init__(parent)
        self.captions, self.style = captions, style
        self.pages = QStackedWidget(self)
        self.current = 0
        self.font_ = chicago95ui.ui_font()
        metrics = QFontMetrics(self.font_)
        left, self.boxes = TAB_LEFT, []
        for caption in captions:
            width = metrics.horizontalAdvance(caption) + TAB_PADDING
            self.boxes.append((left, left + width - 1))
            left += width

    def frame_bottom(self):
        """The page frame's black bottom row, in dialog coordinates: the strip fills the body."""
        return self.height() + BODY_ORIGIN[1] + DIALOG_FRAME - PAGE_BOTTOM_FROM_END

    def resizeEvent(self, _event):
        x, y = in_body(PAGE_LEFT + 1, PAGE_TOP + 1)
        self.pages.setGeometry(x, y, PAGE_RIGHT - PAGE_LEFT - 2, self.frame_bottom() - PAGE_TOP - 2)

    def add_page(self, page):
        self.pages.addWidget(page)

    def select(self, index):
        self.current = index
        self.pages.setCurrentIndex(index)
        self.update()

    def mousePressEvent(self, event):
        x, y = event.position().x() + BODY_ORIGIN[0], event.position().y() + BODY_ORIGIN[1]
        for index, (left, right) in enumerate(self.boxes):
            if left - 2 <= x <= right + 2 and TAB_TOP - SELECTED_TAB_RISE <= y < PAGE_TOP:
                self.select(index)

    def paintEvent(self, _event):
        scheme = chicago95ui.read_scheme()
        face, bevel = scheme["face"], chicago95ui.bevel_colors(scheme["face"], self.style)
        white, shadow, dark = QColor("#ffffff"), bevel["shadow"], bevel["dark"]
        painter = QPainter(self)
        painter.translate(-BODY_ORIGIN[0], -BODY_ORIGIN[1])   # paint in dialog coordinates
        bottom = self.frame_bottom()
        selected_left, selected_right = self.boxes[self.current][0] - 2, self.boxes[self.current][1] + 2
        # The page frame: white top and left, shadow and black right and bottom; no top line under the selected tab.
        painter.fillRect(PAGE_LEFT, PAGE_TOP, 1, bottom - PAGE_TOP, white)
        for x0, x1 in ((PAGE_LEFT + 1, selected_left - 1), (selected_right + 1, PAGE_RIGHT - 1)):
            if x1 >= x0:
                painter.fillRect(x0, PAGE_TOP, x1 - x0 + 1, 1, white)
        painter.fillRect(PAGE_RIGHT - 1, PAGE_TOP + 1, 1, bottom - PAGE_TOP - 1, shadow)
        painter.fillRect(PAGE_RIGHT, PAGE_TOP, 1, bottom - PAGE_TOP + 1, dark)
        painter.fillRect(PAGE_LEFT + 1, bottom - 1, PAGE_RIGHT - PAGE_LEFT - 1, 1, shadow)
        painter.fillRect(PAGE_LEFT, bottom, PAGE_RIGHT - PAGE_LEFT + 1, 1, dark)
        painter.setFont(self.font_)
        order = [index for index in range(len(self.boxes)) if index != self.current] + [self.current]
        for index in order:
            left, right = self.boxes[index]
            top, rise = TAB_TOP, 0
            if index == self.current:
                left, right, top, rise = selected_left, selected_right, TAB_TOP - SELECTED_TAB_RISE, SELECTED_TAB_RISE
                painter.fillRect(left, top, right - left + 1, PAGE_TOP - top + 1, face)   # over the neighbours' edges and the frame's top line
            height = PAGE_TOP - top
            painter.fillRect(left, top + 2, 1, height - 2, white)
            painter.fillRect(left + 2, top, right - left - 3, 1, white)
            painter.fillRect(left + 1, top + 1, 1, 1, white)
            painter.fillRect(right - 1, top + 2, 1, height - 2, shadow)
            painter.fillRect(right, top + 2, 1, height - 2, dark)
            painter.fillRect(right - 1, top + 1, 1, 1, dark)
            painter.setPen(scheme.get("text", QColor("#000000")))
            painter.drawText(self.boxes[index][0] + CAPTION_INSET, CAPTION_BASELINE - rise, self.captions[index])
        painter.end()


class GeneralPage(QWidget):
    """The computer picture and the facts, each on the original's row and column."""

    def __init__(self, facts, look, parent=None):
        super().__init__(parent)
        self.look = look
        self.groups = [("System:", [facts.os_name, facts.kernel, facts.desktop]),
                       ("Registered to:", [facts.owner, facts.hostname, facts.product_key]),
                       ("Computer:", [value for value in (facts.cpu_model, facts.logical_processors, facts.memory, facts.display) if value])]
        self.picture = QIcon.fromTheme("computer").pixmap(ICON_SIZE, ICON_SIZE)

    def paintEvent(self, _event):
        painter = QPainter(self)
        page_x, page_y = in_body(PAGE_LEFT + 1, PAGE_TOP + 1)
        painter.translate(-page_x - BODY_ORIGIN[0], -page_y - BODY_ORIGIN[1])   # paint in dialog coordinates
        painter.drawPixmap(ICON_POSITION[0], ICON_POSITION[1], self.picture)
        painter.setFont(chicago95ui.ui_font())
        painter.setPen(QColor("#000000"))
        for (column, row), (heading, values) in zip(HEADINGS[self.look], self.groups):
            painter.drawText(column, row + CAP_HEIGHT, heading)
            for index, value in enumerate(values):
                painter.drawText(column + VALUE_INDENT + 2, row + CAP_HEIGHT + 18 * (index + 1), value)
        painter.end()


def launch_device_manager():
    if DEVICE_MANAGER_PATH.exists():
        subprocess.Popen([str(DEVICE_MANAGER_PATH)])


def build_device_manager_tab():
    tab = QWidget()
    layout = QVBoxLayout(tab)
    layout.setContentsMargins(12, 12, 12, 12)
    layout.setSpacing(8)
    layout.addWidget(plain_label("See Device Manager"))
    open_button = QPushButton("Device Manager...")
    open_button.setFixedSize(120, BUTTON_SIZE[1])
    open_button.clicked.connect(launch_device_manager)
    layout.addWidget(open_button, 0, Qt.AlignLeft)
    layout.addStretch()
    return tab


def status_grid(rows):
    grid = QGridLayout()
    grid.setHorizontalSpacing(12)
    grid.setVerticalSpacing(6)
    for row_index, (name, value) in enumerate(rows):
        grid.addWidget(plain_label(name), row_index, 0)
        grid.addWidget(plain_label(value), row_index, 1)
    grid.setColumnStretch(1, 1)
    return grid


def build_performance_tab(facts):
    tab = QWidget()
    layout = QVBoxLayout(tab)
    layout.setContentsMargins(12, 12, 12, 12)
    layout.setSpacing(10)

    status_box = QGroupBox("Performance status")
    status_box.setFont(chicago95ui.ui_font())
    status_layout = QVBoxLayout(status_box)
    status_layout.setContentsMargins(10, 8, 10, 10)
    status_layout.addLayout(status_grid([
        ("Memory:", facts.memory.replace(" RAM", " of RAM")),
        ("System Resources:", facts.resources_free),
        ("File System:", facts.filesystem),
        ("Virtual Memory:", facts.virtual_memory),
        ("Disk Compression:", "Not installed"),
    ]))
    status_layout.addSpacing(8)
    status_layout.addWidget(plain_label("Your system is configured for optimal performance."))
    layout.addWidget(status_box)

    advanced_box = QGroupBox("Advanced settings")
    advanced_box.setFont(chicago95ui.ui_font())
    advanced_layout = QHBoxLayout(advanced_box)
    advanced_layout.setContentsMargins(10, 8, 10, 10)
    advanced_layout.setSpacing(6)
    for caption in ("File System...", "Graphics...", "Virtual Memory..."):
        button = QPushButton(caption)
        button.setFixedHeight(BUTTON_SIZE[1])
        button.setEnabled(False)
        advanced_layout.addWidget(button)
    layout.addWidget(advanced_box)
    layout.addStretch()
    return tab


def build_pages(facts, look):
    """The pages behind the look's tabs: the originals' names, our contents."""
    pages = {"General": GeneralPage(facts, look), "Device Manager": build_device_manager_tab(), "Hardware": build_device_manager_tab(),
             "Performance": build_performance_tab(facts), "Advanced": build_performance_tab(facts)}
    return [pages.get(caption) or placeholder_page(caption) for caption in TABS[look]]


def placeholder_page(caption):
    page = QWidget()
    layout = QVBoxLayout(page)
    layout.setContentsMargins(12, 12, 12, 12)
    layout.addWidget(plain_label(f"{caption} are not available."))
    layout.addStretch()
    return page


def register_icon_directories():
    icon_directories = [str(Path.home() / ".local/share/icons"), "/usr/share/icons"]
    QIcon.setThemeSearchPaths(icon_directories + QIcon.themeSearchPaths())


def build_window(facts, look=None):
    register_icon_directories()
    look = look if look in TABS else chicago95ui.look_settings()["style"]
    look = look if look in TABS else "1995"
    body = (DIALOG_WIDTH - 6, DIALOG_HEIGHT[look] - 24)
    window = chicago95ui.ClassicDialog("System Properties", look, body, help_button=True)
    window.setWindowIcon(QIcon.fromTheme("computer"))

    strip = TabStrip(TABS[look], look, window.body)
    strip.setGeometry(0, 0, *body)
    for page in build_pages(facts, look):
        strip.add_page(page)
    strip.select(0)
    window.tabs = strip

    buttons = {}
    for caption, left in BUTTON_LEFTS[look].items():
        button = QPushButton(caption, window.body)
        button.setEnabled(caption != "Apply")
        x, y = in_body(left, BUTTONS_TOP[look])
        # Qt keeps a pixel for the default button's outline inside every dialog button's rectangle: the
        # default one grows to put its outline on the original's 75x23, the others grow around it.
        button.setGeometry(x, y, 76, 24) if caption == "OK" else button.setGeometry(x - 1, y - 1, 77, 25)
        buttons[caption] = button
    buttons["OK"].setDefault(True)
    buttons["OK"].clicked.connect(window.accept)
    buttons["Cancel"].clicked.connect(window.reject)
    return window


def main():
    arguments = sys.argv[1:]
    screenshot_path = arguments[arguments.index("--screenshot") + 1] if "--screenshot" in arguments else None
    app = chicago95ui.make_app("System Properties")
    window = build_window(gather_system_facts())
    if screenshot_path:
        window.grab().save(screenshot_path)
        return 0
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
