def branding_defaults(settings):
    """Each name, text and logo as the look's Windows had it, before anyone changes it."""
    look = resolved_look(settings.get("LOOK"), settings)
    return {**{key: look[key] for key in BRANDING_LOOK_KEYS}, "START_TEXT": "Start"}


def branding_field(tab, key, label, settings):
    """One name, text or logo field, with its default and, for a logo, its pictures."""
    default = branding_defaults(settings)[key]
    if key in BRANDING_PICTURES:
        return tab.picture(key, label, BRANDING_PICTURES[key], default=default)
    return tab.text(key, label, default=default)


def detected_branding():
    """This computer's distribution's names and logos (lib/chicago95distro.py), where Setup looks for them."""
    data_dirs = os.environ.get("SETUP_DATA_DIRS", "")
    roots = [path for path in data_dirs.split(":") if path] or chicago95distro.data_dirs()
    fields = chicago95distro.read_os_release(os.environ.get("SETUP_OS_RELEASE") or chicago95distro.OS_RELEASE)
    return chicago95distro.distro_branding(fields, roots)


