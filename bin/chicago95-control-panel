class HeaderBand(QWidget):
    """One band of Explorer's header: an etched line above it (shadow over white), a raised grip at
    its left, then its content."""

    def __init__(self, content=None, content_height=MENU_BAR_HEIGHT, grip=True, trailing=None):
        super().__init__()
        self.has_grip = grip
        self.setFixedHeight(ETCHED_ROWS + content_height)
        layout = QHBoxLayout(self)
        layout.setContentsMargins(BAND_INSET if grip else 0, ETCHED_ROWS, 0 if trailing else 2, 0)
        layout.setSpacing(0)
        if content is not None:
            layout.addWidget(content, 1)
        if trailing is not None:
            layout.addWidget(trailing)

    def paintEvent(self, _event):
        painter = QPainter(self)
        face = self.palette().window().color()
        shadow = chicago95ui.bevel_shades(face)[1]
        white = QColor("#FFFFFF")
        painter.fillRect(self.rect(), face)
        painter.setPen(shadow)
        painter.drawLine(0, 0, self.width() - 1, 0)
        painter.setPen(white)
        painter.drawLine(0, 1, self.width() - 1, 1)
        if not self.has_grip:
            return
        top, bottom = ETCHED_ROWS + 2, self.height() - 3
        painter.setPen(white)
        painter.drawLine(GRIP_LEFT, top, GRIP_LEFT, bottom)
        painter.setPen(shadow)
        painter.drawLine(GRIP_LEFT + 4, top, GRIP_LEFT + 4, bottom)


class MenuBandStyle(chicago95ui.ClassicStyle):
    """The menu bar's captions centred in its 22-row band (tests/test_control_panel_header_reference.py):
    Qt sizes its items to the font and sits them against the top."""

    def sizeFromContents(self, contents, option, size, widget=None):
        grown = super().sizeFromContents(contents, option, size, widget)
        if contents == QStyle.CT_MenuBarItem:
            grown.setHeight(MENU_BAR_HEIGHT)
        return grown

    def drawControl(self, element, option, painter, widget=None):
        if element == QStyle.CE_MenuBarItem:  # the caption's top row 8 below the etched line, as the original's
            option = QStyleOptionMenuItem(option)
            option.rect.adjust(0, 2, 0, 0)
        super().drawControl(element, option, painter, widget)


class ToolbarButton(QToolButton):
    """A Standard Buttons toolbar button as Internet Explorer 4 drew it: the icon in greys near the top, in colour
    with a raised face while the pointer is over it and sunken while held, the label along the bottom, and an
    11px arrow section for a button with a menu."""

    ARROW_WIDTH, ICON_SIZE, ICON_TOP, LABEL_TOP = 11, 22, 1, 26

    def __init__(self, action, has_menu=False):
        super().__init__()
        self.setDefaultAction(action)
        self.has_menu = has_menu
        self.setFixedHeight(TOOLBAR_HEIGHT)
        self.setAttribute(Qt.WA_Hover)

    def main_width(self):
        return max(48, QFontMetrics(self.font()).horizontalAdvance(self.text()) + 12)

    def sizeHint(self):
        return QSize(self.main_width() + (self.ARROW_WIDTH if self.has_menu else 0), TOOLBAR_HEIGHT)

    def minimumSizeHint(self):
        return self.sizeHint()

    def arrow_rect(self):
        return QRect(self.main_width(), 0, self.ARROW_WIDTH, self.height())

    def paintEvent(self, _event):
        painter = QPainter(self)
        palette = self.palette()
        face, shadow = palette.window().color(), palette.dark().color()
        painter.fillRect(self.rect(), face)
        main = QRect(0, 0, self.main_width(), self.height())
        pressed = self.isEnabled() and self.isDown()
        if self.isEnabled() and (self.underMouse() or pressed):
            top_left, bottom_right = (shadow, QColor("#FFFFFF")) if pressed else (QColor("#FFFFFF"), shadow)
            for rect in [main] + ([self.arrow_rect()] if self.has_menu else []):
                painter.setPen(top_left)
                painter.drawLine(rect.topLeft(), rect.topRight())
                painter.drawLine(rect.topLeft(), rect.bottomLeft())
                painter.setPen(bottom_right)
                painter.drawLine(rect.bottomLeft(), rect.bottomRight())
                painter.drawLine(rect.topRight(), rect.bottomRight())
        shift = 1 if pressed else 0
        icon_rect = QRect(
            (main.width() - self.ICON_SIZE) // 2 + shift, self.ICON_TOP + shift, self.ICON_SIZE, self.ICON_SIZE
        )
        if not self.isEnabled():
            self.icon().paint(painter, icon_rect, Qt.AlignCenter, QIcon.Disabled)
        elif self.underMouse() or pressed:
            self.icon().paint(painter, icon_rect, Qt.AlignCenter, QIcon.Normal)
        else:  # in greys until the pointer comes, as Internet Explorer 4 drew its Standard Buttons
            pixmap = self.icon().pixmap(self.ICON_SIZE, self.ICON_SIZE)
            if not pixmap.isNull():
                painter.drawPixmap(icon_rect.topLeft(), chicago95ui.grey_pixmap(pixmap))
        label = QRect(shift, self.LABEL_TOP + shift, main.width(), self.height() - self.LABEL_TOP)
        if self.isEnabled():
            painter.setPen(palette.windowText().color())
            painter.drawText(label, Qt.AlignHCenter | Qt.AlignTop, self.text())
        else:
            painter.setPen(QColor("#FFFFFF"))
            painter.drawText(label.translated(1, 1), Qt.AlignHCenter | Qt.AlignTop, self.text())
            painter.setPen(shadow)
            painter.drawText(label, Qt.AlignHCenter | Qt.AlignTop, self.text())
        if self.has_menu:
            arrow = self.arrow_rect()
            painter.setPen(Qt.NoPen)
            painter.setBrush(palette.windowText().color() if self.isEnabled() else shadow)
            centre = arrow.center()
            painter.drawPolygon(
                [
                    QPoint(centre.x() - 2, centre.y() - 1),
                    QPoint(centre.x() + 3, centre.y() - 1),
                    QPoint(centre.x(), centre.y() + 2),
                ]
            )

    def mousePressEvent(self, event):
        menu = self.defaultAction().menu()
        if (
            self.has_menu
            and menu is not None
            and (self.arrow_rect().contains(event.position().toPoint()) or not self.defaultAction().isEnabled())
        ):
            menu.exec(self.mapToGlobal(QPoint(0, self.height())))
            return
        super().mousePressEvent(event)


def start_logo_pixmap():
    """The Start button's logo: Setup's copy, else the flag shipped with the Start applet."""
    copies = sorted((Path.home() / ".local/share/chicago95").glob("start-logo.*"))
    source = (
        copies[0]
        if copies
        else Path(__file__).resolve().parent.parent / "plasmoids/org.chicago95.start/contents/images/logo-flag.png"
    )
    return QPixmap(str(source))


def status_pane_frames(width, stretches):
    """(left, width) of each pane: shared by stretch, the last one taking what rounding leaves, up to the edge."""
    available = width - STATUS_PANE_GAP * (len(stretches) - 1)
    widths = [available * stretch // sum(stretches) for stretch in stretches[:-1]]
    widths.append(available - sum(widths))
    lefts = [sum(widths[:index]) + STATUS_PANE_GAP * index for index in range(len(widths))]
    return list(zip(lefts, widths, strict=True))


class StatusPane(QWidget):
    """A status bar pane in its one pixel sunken frame."""

    def __init__(self, *contents):
        super().__init__()
        layout = QHBoxLayout(self)
        layout.setContentsMargins(*STATUS_TEXT_MARGINS)
        layout.setSpacing(4)
        for widget in contents:
            layout.addWidget(widget, 1 if widget is contents[-1] else 0)

    def paintEvent(self, _event):
        painter = QPainter(self)
        right, bottom = self.width() - 1, self.height() - 1
        painter.fillRect(0, 0, right, 1, self.palette().dark())
        painter.fillRect(0, 0, 1, bottom, self.palette().dark())
        painter.fillRect(0, bottom, right + 1, 1, self.palette().light())
        painter.fillRect(right, 0, 1, bottom, self.palette().light())


class ClassicStatusBar(QStatusBar):
    """Windows' status bar: the panes reach the bottom edge and the last one runs under the size grip to the right
    edge. Qt's own keeps a row under its panes and the grip beside them, so this one places them itself."""

    def __init__(self, panes):
        super().__init__()
        self.setSizeGripEnabled(False)
        self.setFixedHeight(STATUS_BAR_HEIGHT)
        self.panes = panes
        for pane in panes:
            pane.setParent(self)
        self.grip = QSizeGrip(self)
        self.grip.resize(len(chicago95ui.SIZE_GRIP[0]), len(chicago95ui.SIZE_GRIP))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        frames = status_pane_frames(self.width(), STATUS_PANE_STRETCHES)
        for pane, (left, width) in zip(self.panes, frames, strict=True):
            pane.setGeometry(left, STATUS_PANE_TOP, width, self.height() - STATUS_PANE_TOP)
        self.grip.move(self.width() - self.grip.width(), self.height() - self.grip.height())
        self.grip.raise_()

    def showEvent(self, event):
        super().showEvent(event)
        self.window().installEventFilter(self)

    def eventFilter(self, watched, event):
        """Windows takes the grip away from a maximized window; Qt's grip watches only the window it was made in."""
        if watched is self.window() and event.type() == QEvent.WindowStateChange:
            self.grip.setVisible(not watched.windowState() & (Qt.WindowMaximized | Qt.WindowFullScreen))
        return super().eventFilter(watched, event)


class LogoBox(QWidget):
    """The black box at the right of the menu band, where Windows 98 showed its waving flag."""

    def __init__(self):
        super().__init__()
        self.logo = start_logo_pixmap()
        self.setFixedWidth(LOGO_BOX_WIDTH)

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor("#000000"))
        if self.logo.isNull():
            return
        logo = self.logo.scaledToHeight(self.height() - 6, Qt.SmoothTransformation)
        painter.drawPixmap((self.width() - logo.width()) // 2, (self.height() - logo.height()) // 2, logo)


ARROW_ROWS = (7, 5, 3, 1)  # the classic drop-down arrow, as combo boxes and scroll bars draw it


class ArrowButton(QToolButton):
    """A raised 16x18 button with the classic down arrow; it opens its menu on press. Qt's own tool button
    paints a wedge plus a menu indicator in the corner, which is not the original's arrow."""

    def __init__(self):
        super().__init__()
        self.setFixedSize(*DROPDOWN_SIZE)

    def paintEvent(self, _event):
        painter = QPainter(self)
        option = QStyleOptionButton()
        option.initFrom(self)
        option.rect = self.rect()
        option.state |= QStyle.State_Sunken if self.isDown() else QStyle.State_Raised
        self.style().drawPrimitive(QStyle.PE_PanelButtonBevel, option, painter, self)
        shift = 1 if self.isDown() else 0
        top = (self.height() - len(ARROW_ROWS)) // 2 + shift
        painter.setPen(self.palette().windowText().color())
        for row, width in enumerate(ARROW_ROWS):
            left = (self.width() - width) // 2 + shift
            painter.drawLine(left, top + row, left + width - 1, top + row)

    def mousePressEvent(self, event):
        self.setDown(True)
        self.repaint()
        if self.menu() is not None:
            self.menu().exec(self.mapToGlobal(QPoint(-self.parentWidget().width() + self.width(), self.height())))
        self.setDown(False)


class AddressBar(QWidget):
    """Explorer's Address box as breadcrumbs: each part of the path is a button that goes there."""

    navigate = Signal(tuple)

    def __init__(self, known_pages):
        super().__init__()
        self.known_page_tuples = known_pages
        self.crumb_buttons = []
        self.setFixedHeight(ADDRESS_BOX_HEIGHT)
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(QLabel("Address"))
        self.box = QFrame()
        self.box.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        self.box.setLineWidth(2)
        self.box.setAutoFillBackground(True)
        self.box.setBackgroundRole(QPalette.Base)
        self.box.setFixedHeight(ADDRESS_BOX_HEIGHT)
        box_layout = QHBoxLayout(self.box)
        box_layout.setContentsMargins(0, 0, 0, 0)
        box_layout.setSpacing(0)
        self.icon = QLabel()
        self.icon.setFixedSize(16, 16)
        icon = themed_icon(("preferences-system",))
        self.icon.setPixmap(
            icon.pixmap(16, 16)
            if not icon.isNull()
            else start_logo_pixmap().scaled(16, 16, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        )
        box_layout.addSpacing(2)
        box_layout.addWidget(self.icon)
        crumbs = QWidget()
        self.crumb_layout = QHBoxLayout(crumbs)
        self.crumb_layout.setContentsMargins(2, 0, 2, 0)
        self.crumb_layout.setSpacing(2)
        box_layout.addWidget(crumbs, 1)
        self.dropdown = ArrowButton()
        self.dropdown.setMenu(self.build_known_pages_menu())
        box_layout.addWidget(self.dropdown)
        layout.addWidget(self.box, 1)

    def build_known_pages_menu(self):
        menu = QMenu(self)
        for page in self.known_page_tuples:
            menu.addAction(breadcrumb_text(page)).triggered.connect(
                lambda _checked=False, page=page: self.navigate.emit(page)
            )
        return menu

    def show_page(self, page):
        clear_layout(self.crumb_layout)
        self.crumb_buttons = []
        for depth, part in enumerate(page, start=1):
            if depth > 1:
                self.crumb_layout.addWidget(QLabel(">"))
            crumb = QToolButton()
            crumb.setText(part)
            crumb.setAutoRaise(True)
            crumb.clicked.connect(lambda _checked=False, target=page[:depth]: self.navigate.emit(target))
            self.crumb_layout.addWidget(crumb)
            crumb.show()
            self.crumb_buttons.append(crumb)
        self.crumb_layout.addStretch(1)

    def crumbs(self):
        return [crumb.text() for crumb in self.crumb_buttons]

    def known_pages(self):
        return [breadcrumb_text(page) for page in self.known_page_tuples]


class PictureField(QWidget):
    """A picture setting: one of a few named presets, or a file the Browse button picks."""

    changed = Signal()

    def __init__(self, presets, choose_file):
        super().__init__()
        self.choose_file = choose_file
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        self.combo = chicago95ui.classic_combo(QComboBox())
        for label, value in presets:
            self.combo.addItem(label, value)
        self.combo.addItem("Custom image...")
        self.combo.setVisible(bool(presets))
        self.path_edit = chicago95ui.plain_disabled_text(QLineEdit())
        self.browse_button = QPushButton("Browse...")
        for widget in (self.combo, self.path_edit, self.browse_button):
            layout.addWidget(widget)
        self.combo.currentIndexChanged.connect(self.choice_changed)
        self.path_edit.textChanged.connect(lambda *_: self.changed.emit())
        self.browse_button.clicked.connect(self.choose_custom_file)
        self.loading = False

    @property
    def is_custom(self):
        return self.combo.currentIndex() == self.combo.count() - 1

    def choice_changed(self):
        self.path_edit.setEnabled(self.is_custom)
        self.browse_button.setEnabled(self.is_custom)
        if not self.loading:
            self.changed.emit()

    def value(self):
        return self.path_edit.text() if self.is_custom else self.combo.currentData()

    def set_value(self, value):
        self.loading = True
        preset = self.combo.findData(value)
        self.combo.setCurrentIndex(preset if preset >= 0 else self.combo.count() - 1)
        self.path_edit.setText("" if preset >= 0 else value)
        self.choice_changed()
        self.loading = False

    def choose_custom_file(self):
        path = self.choose_file(self, "Choose a picture", PICTURE_FILTER)
        if not path:
            return
        self.combo.setCurrentIndex(self.combo.count() - 1)
        self.path_edit.setText(path)


class RadioGroup(QGroupBox):
    """A titled group of radio buttons; `chosen` fires once per choice (Qt toggles the old and the new button)."""

    chosen = Signal()


class SettingsTab(QWidget):
    """A page of a property sheet: fields that each show and report one key of setup.conf."""

    changed = Signal()

    def __init__(self, settings, actions):
        super().__init__()
        self.actions = actions
        self.saved = dict(settings)
        self.loading = False
        self.fields = {}
        self.outer = QVBoxLayout(self)
        self.outer.setContentsMargins(*PAGE_INSETS)
        self.form = QFormLayout()
        self.form.setLabelAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self.outer.addLayout(self.form)
        self.outer.addStretch(1)
        self.previews = []

    def preview(self, widget):
        """A picture of the screen the tab's settings shape, refreshed by the sheet with every tab's values."""
        self.previews.append(widget)
        self.form.addRow("", widget)
        return widget

    def group(self, title):
        """Fields registered from now on go inside a framed, titled group, as property sheets group their settings."""
        box = QGroupBox(title)
        self.form = QFormLayout(box)
        self.form.setLabelAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        self.outer.insertWidget(self.outer.count() - 1, box)

    def notify(self):
        if not self.loading:
            self.changed.emit()

    def track(self, key, getter, setter, default, signal=None):
        """A field the tab reports, laid out by its builder; without a signal, its builder notifies the changes."""
        self.fields[key] = (getter, setter, default)
        setter(self.saved.get(key, default))
        if signal is not None:
            signal.connect(lambda *_: self.notify())

    def register(self, key, label, widget, getter, setter, default, signal):
        self.track(key, getter, setter, default, signal)
        if label:
            self.form.addRow(label, widget)
        else:
            self.form.addRow(widget)
        return widget

    def values(self):
        return {key: getter() for key, (getter, _setter, _default) in self.fields.items()}

    def load(self, settings):
        self.loading = True
        for key, (_getter, setter, default) in self.fields.items():
            setter(settings.get(key, default))
        self.loading = False

    def text(self, key, label, default=""):
        edit = chicago95ui.plain_disabled_text(QLineEdit())
        return self.register(key, label, edit, edit.text, edit.setText, default, edit.textChanged)

    def choice(self, key, label, options, default, beside=None):
        """A drop-down list; `beside` puts a widget on the same line, as the Screen Saver tab's Preview button."""
        combo = chicago95ui.classic_combo(QComboBox())
        for option_label, value in options:
            combo.addItem(option_label, value)

        def select(value):
            index = combo.findData(value)
            combo.setCurrentIndex(index if index >= 0 else max(combo.findData(default), 0))

        field = combo
        if beside is not None:
            field = QWidget()
            row = QHBoxLayout(field)
            row.setContentsMargins(0, 0, 0, 0)
            row.addWidget(combo, 1)
            row.addWidget(beside)
        self.register(key, label, field, combo.currentData, select, default, combo.currentIndexChanged)
        return combo

    def radios(self, key, title, options, default):
        """A titled group of radio buttons, one per option, as the originals offer two or three choices."""
        box = RadioGroup(title)
        column = QVBoxLayout(box)
        buttons = QButtonGroup(box)
        buttons.buttonToggled.connect(lambda _button, on: box.chosen.emit() if on else None)
        for option_label, value in options:
            button = QRadioButton(option_label)
            button.setProperty("value", value)
            buttons.addButton(button)
            column.addWidget(button)

        def checked_value():
            return buttons.checkedButton().property("value")

        def select(value):
            values = [button.property("value") for button in buttons.buttons()]
            buttons.buttons()[values.index(value if value in values else default)].setChecked(True)

        self.register(key, "", box, checked_value, select, default, box.chosen)
        return box

    def flag(self, key, label, default="no"):
        box = QCheckBox(label)
        return self.register(
            key,
            "",
            box,
            lambda: "yes" if box.isChecked() else "no",
            lambda value: box.setChecked(value == "yes"),
            default,
            box.toggled,
        )

    def number(self, key, label, minimum, maximum, default, suffix=""):
        """A narrow spin box with its unit beside it, as the originals set numbers."""
        spin = chicago95ui.plain_disabled_text(QSpinBox())
        spin.setRange(minimum, maximum)
        spin.setFixedWidth(QFontMetrics(spin.font()).horizontalAdvance("9999") + 28)
        row = QWidget()
        row_layout = QHBoxLayout(row)
        row_layout.setContentsMargins(0, 0, 0, 0)
        row_layout.setSpacing(4)
        row_layout.addWidget(spin)
        row_layout.addWidget(QLabel(suffix.strip()))
        row_layout.addStretch(1)
        self.register(
            key,
            label,
            row,
            lambda: str(spin.value()),
            lambda value: spin.setValue(int(value) if str(value).isdigit() else default),
            default,
            spin.valueChanged,
        )
        return spin

    def font_family(self, key, label, default):
        combo = chicago95ui.classic_combo(QComboBox())
        combo.addItems(QFontDatabase.families())

        def select(value):
            if combo.findText(value) < 0:
                combo.insertItem(0, value)
            combo.setCurrentIndex(combo.findText(value))

        return self.register(key, label, combo, combo.currentText, select, default, combo.currentIndexChanged)

    def picture(self, key, label, presets, default):
        field = PictureField(presets, self.actions.choose_file)
        return self.register(key, label, field, field.value, field.set_value, default, field.changed)

    def color(self, key, label, default, most=2, stops=False):
        field = ColorListField(lambda current: self.actions.choose_color(self, current), most, stops)
        self.register(key, label, field, field.value, field.set_value, default, field.changed)
        return field


class ColorListField(QWidget):
    """A colour, or a run of them (a gradient's two ends; the Start menu banner's base colour and its stops,
    each at a distance in pixels), shown as swatch buttons that open the colour picker; + adds a colour
    and - takes the last one away."""

    changed = Signal()
    SWATCH_SIZE = (36, 21)

    def __init__(self, choose_color, most=2, stops=False):
        super().__init__()
        self.choose_color, self.most, self.stops = choose_color, most, stops
        self.entries = [("#000000", None)]
        self.swatches, self.stop_boxes = [], []
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)
        self.row = QHBoxLayout()
        self.row.setSpacing(4)
        layout.addLayout(self.row)
        self.add_button, self.remove_button = QPushButton("+"), QPushButton("-")
        for button in (self.add_button, self.remove_button):
            button.setFixedSize(23, 21)
            button.setVisible(most > 1)
            layout.addWidget(button)
        layout.addStretch(1)
        self.add_button.clicked.connect(self.add_colour)
        self.remove_button.clicked.connect(self.remove_last)
        self.rebuild()

    def value(self):
        return ",".join(colour if position is None else f"{colour}@{position}" for colour, position in self.entries)

    def set_value(self, text):
        self.entries = [
            (part.split("@")[0], int(part.split("@")[1]) if "@" in part else None)
            for part in str(text).split(",")
            if part
        ]
        self.rebuild()
        self.changed.emit()

    def rebuild(self):
        while self.row.count():
            self.row.takeAt(0).widget().deleteLater()
        self.swatches, self.stop_boxes = [], []
        for index, (colour, position) in enumerate(self.entries):
            swatch = QPushButton()
            swatch.setFixedSize(*self.SWATCH_SIZE)
            swatch.setIcon(swatch_icon(colour))
            swatch.setIconSize(QSize(self.SWATCH_SIZE[0] - 10, self.SWATCH_SIZE[1] - 8))
            swatch.setToolTip(colour)
            swatch.setProperty("entry", index)
            swatch.clicked.connect(self.swatch_clicked)  # a bound method: see NotificationPopup in chicago95-notifyd
            self.row.addWidget(swatch)
            self.swatches.append(swatch)
            if self.stops and index > 0:
                box = chicago95ui.plain_disabled_text(QSpinBox())
                box.setRange(0, 999)
                box.setSuffix(" px")
                box.setValue(position or 0)
                box.setProperty("entry", index)
                box.valueChanged.connect(self.position_changed)
                self.row.addWidget(box)
                self.stop_boxes.append(box)
        self.add_button.setEnabled(len(self.entries) < self.most)
        self.remove_button.setEnabled(len(self.entries) > 1)

    def swatch_clicked(self):
        self.pick(self.sender().property("entry"))

    def position_changed(self, position):
        self.set_position(self.sender().property("entry"), position)

    def pick(self, index):
        chosen = self.choose_color(self.entries[index][0])
        if not chosen:
            return
        self.entries[index] = (chosen, self.entries[index][1])
        self.rebuild()
        self.changed.emit()

    def set_position(self, index, position):
        self.entries[index] = (self.entries[index][0], position)
        self.changed.emit()

    def add_colour(self):
        self.entries.append((self.entries[-1][0], 0 if self.stops else None))
        self.rebuild()
        self.changed.emit()

    def remove_last(self):
        self.entries.pop()
        self.rebuild()
        self.changed.emit()


REPO_DIR = Path(__file__).resolve().parent.parent
CHICAGO95_DATA = Path.home() / ".local/share/chicago95"
PREVIEW_SCRATCH = tempfile.TemporaryDirectory(prefix="chicago95-previews-")


INSTALLED_SDDM_THEME = Path("/usr/share/sddm/themes/Chicago95Plasma")
INSTALLED_SPLASH = Path.home() / ".local/share/plasma/look-and-feel/chicago95.splashscreen/contents/splash"


def repo_of(values):
    """The checkout Setup ran from (REPO in setup.conf), or this program's own when it is run from one."""
    saved = values.get("REPO")
    return Path(saved).resolve() if saved and (Path(saved) / "install.sh").exists() else REPO_DIR


def sddm_theme_of(values):
    theme = repo_of(values) / "sddm/Chicago95Plasma"
    return theme if theme.exists() else INSTALLED_SDDM_THEME


def splash_of(values):
    splash = repo_of(values) / "splash/chicago95.splashscreen/contents/splash"
    return splash if splash.exists() else INSTALLED_SPLASH


def luna_previews():
    import chicago95lunapreviews

    return chicago95lunapreviews


def luna_root_of(values):
    return repo_of(values) / "luna"


def add_luna_screen(values, destination, screen, style):
    """The Luna QML trees beside a screen that loads them, when the screen's style is luna."""
    if style == "luna":
        luna_previews().copy_screen_trees(luna_root_of(values), destination / "luna", screen)


def picture_file(choice, repo=REPO_DIR):
    """The file behind a picture choice, as Setup resolves it (setup/steps.sh image_source and login_logo):
    a bundled name, the Start button's logo, or the user's own file."""
    flag = repo / "plasmoids/org.chicago95.start/contents/images/logo-flag.png"
    named = {
        "flag": flag,
        "xp": repo / "plasmoids/org.chicago95.start/contents/images/logo-xp-16.png",
        "penguin": repo / "plasmoids/org.chicago95.start/contents/images/logo-penguin.svg",
        "waving-flag": CHICAGO95_DATA / "waving-flag.png",
        "keys": repo / "sddm/Chicago95Plasma/key.svg",
        "padlock": repo / "sddm/Chicago95Plasma/padlock.svg",
        "classic": repo / "splash/chicago95.splashscreen/contents/splash/images/background.png",
    }
    if choice == "start":
        copies = sorted(CHICAGO95_DATA.glob("start-logo.*"))
        return copies[0] if copies else flag
    chosen = named.get(choice, Path(choice))
    return chosen if chosen.exists() else flag


@functools.cache
def load_tool(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), tool_path(name))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def branding_look(values):
    """What the 2000 banners show (the Shut Down dialog's BrandBanner), from the settings."""
    company_logo = values.get("COMPANY_LOGO", "text")
    return {
        "style": values.get("LOGIN_STYLE", "classic"),
        "bannerText": values.get("BANNER_TEXT", "Chicago95"),
        "osName": values.get("BANNER_TEXT", "Chicago95"),
        "osCompany": values.get("COMPANY", "KDE"),
        "edition": values.get("EDITION", "Professional"),
        "osLogo": str(picture_file(values.get("LOGIN_LOGO", "start"), repo_of(values))),
        "companyLogo": "" if company_logo in ("text", "") else company_logo,
        "tagline": values.get("TAGLINE", "Built on Linux Technology"),
    }


def render_banner(values, path):
    load_tool("chicago95-shutdown").render_login_banner(branding_look(values), path)
    return path


def fresh_scratch(owner):
    """A new scratch folder for a preview's files; the owner's previous one goes."""
    folder = Path(tempfile.mkdtemp(dir=PREVIEW_SCRATCH.name))
    if owner.scratch:
        shutil.rmtree(owner.scratch, ignore_errors=True)
    owner.scratch = folder
    return folder


class QmlPreview(QQuickWidget):
    """A QML screen in a scratch copy, reloaded from a fresh copy on every refresh (its settings file is a
    JavaScript library, which the engine would otherwise keep)."""

    SCALED_SCENE = """import QtQuick
Item {{
    property alias dialog: inner.item
    Loader {{
        id: inner
        source: "{source}"
        width: {width}
        height: {height}
        scale: {scale}
        transformOrigin: Item.TopLeft
    }}
}}
"""

    def __init__(self, size, scale=1.0):
        super().__init__()
        self.scratch = None
        self.context = {}
        self.full_size, self.scale = size, scale
        self.setResizeMode(QQuickWidget.SizeRootObjectToView)
        self.setFixedSize(round(size[0] * scale), round(size[1] * scale))

    def fit(self, size, scale):
        self.full_size, self.scale = size, scale
        self.setFixedSize(round(size[0] * scale), round(size[1] * scale))

    def load(self, main_qml, context=None):
        """The screen at its own size, shrunk by `scale` to fit a property sheet (a wrapper beside the file)."""
        self.context = context or {}
        for name, value in self.context.items():
            self.rootContext().setContextProperty(name, value)
        self.engine().clearComponentCache()
        source = Path(main_qml)
        if self.scale != 1.0:
            width, height = self.full_size
            wrapper = source.parent / "scaled-preview.qml"
            wrapper.write_text(
                self.SCALED_SCENE.format(source=source.name, width=width, height=height, scale=self.scale)
            )
            source = wrapper
        self.setSource(QUrl.fromLocalFile(str(source)))

    def dialog(self):
        """The screen's own root item (behind the scaling wrapper, when there is one)."""
        root = self.rootObject()
        return root.property("dialog") if root is not None and self.scale != 1.0 else root


class LogOnPreview(QmlPreview):
    """The log-on dialog as the theme draws it, with the texts, pictures and style chosen."""

    SIZE, SCALE = (440, 250), 0.6  # the dialog's own size, shrunk to fit the property sheet
    LUNA_SIZE, LUNA_SCALE = (800, 600), 0.33  # the XP welcome screen fills the screen

    def __init__(self):
        super().__init__(self.SIZE, self.SCALE)

    def refresh(self, values):
        folder = fresh_scratch(self)
        style = values.get("LOGIN_STYLE", "classic")
        theme = sddm_theme_of(values)
        banner = render_banner(values, folder / "login-banner.png") if style == "2000" else None
        icon = picture_file(values.get("LOGIN_ICON", "keys"), repo_of(values))
        main_qml = login_preview.prepare_login_theme(theme, folder, banner=banner, icon=icon)
        add_luna_screen(values, folder / "theme", "sddm", style)
        self.fit(*{"luna": (self.LUNA_SIZE, self.LUNA_SCALE)}.get(style, (self.SIZE, self.SCALE)))
        self.engine().addImportPath(str(folder / "imports"))
        settings = {
            "loginStyle": style,
            "loginTitle": values.get("LOGIN_TITLE", "Log On to %h"),
            "loginMessage": values.get("LOGIN_MESSAGE", "Type a user name and password to log on."),
            "loginIcon": f"login-icon{icon.suffix}",
            "titleActive": values.get("TITLE_ACTIVE", "") if style == "2000" else "",
            "scale": "1",
        }
        self.load(main_qml, login_preview.login_context(theme, host_name=socket.gethostname(), **settings))


MENU_STYLES = ("1995", "1998", "2000", "2001", "luna")
LUNA_MENU_PREVIEW_WIDTH = 250
LOOK_FACES = {
    "2000": "#D4D0C8",
    "2001": "#D4D0C8",
    "luna": "#ECE9D8",
}  # the button face of a look; the others are the classic grey
CLASSIC_FACE = "#C0C0C0"
TASKBAR_STRIP = QSize(120, 28)  # the taskbar's height; widened to the menu once it is drawn
START_BUTTON_SCENE = """import QtQuick
import "{ui}"
Rectangle {{
    color: face
    Rectangle {{
        width: parent.width
        height: 1
        color: Qt.tint(face, "#80ffffff")
    }}
    Rectangle {{
        y: 1
        width: parent.width
        height: 1
        color: "#ffffff"
    }}
    StartButton {{
        id: button
        objectName: "startButton"
        x: 2
        y: 4
        text: startText
        logoSource: startLogo
        bevel: startBevel
        face: parent.color
        held: true
    }}
}}
"""


INSTALLED_START_PLASMOID = Path.home() / ".local/share/plasma/plasmoids/org.chicago95.start/contents/ui"


def menu_style_of(values):
    chosen = values.get("START_MENU_STYLE") or values.get("LOOK")
    return chosen if chosen in MENU_STYLES else "1998"


def start_button_ui(installed=INSTALLED_START_PLASMOID, repo=REPO_DIR):
    """The folder with StartButton.qml: the plasmoid Setup installed, or the checkout's when running from it."""
    checkout = repo / "plasmoids/org.chicago95.start/contents/ui"
    return checkout if checkout.exists() else installed


class StartMenuPreview(QWidget):
    """The Start menu open above the pressed Start button, with the tab's values before they are applied: the menu
    drawn by the Start menu itself, offscreen on a scratch chicago95rc; the button by the taskbar's StartButton.qml."""

    def __init__(self):
        super().__init__()
        self.scratch = None
        self.shot = None
        self.menu_style = "1998"
        self.menu_label = QLabel()
        self.button = QQuickWidget()  # a strip of taskbar with the Start button, as wide as the menu above it
        self.button.setResizeMode(QQuickWidget.SizeRootObjectToView)
        self.button.setFixedSize(TASKBAR_STRIP)
        self.process = QProcess(self)
        self.process.finished.connect(self.show_menu)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        layout.addWidget(self.menu_label, 0, Qt.AlignLeft)
        layout.addWidget(self.button, 0, Qt.AlignLeft)

    def refresh(self, values):
        folder = fresh_scratch(self)
        self.menu_style = menu_style_of(values)
        self.draw_menu(folder, values, self.menu_style)
        show_button = {"luna": self.show_luna_button}.get(
            values.get("TASKBAR_STYLE", self.menu_style), self.show_classic_button
        )
        show_button(folder, values)

    def show_scene(self, scene, context, height):
        for name, value in context.items():
            self.button.rootContext().setContextProperty(name, value)
        self.button.setFixedHeight(height)
        self.button.engine().clearComponentCache()
        self.button.setSource(QUrl.fromLocalFile(str(scene)))

    def show_classic_button(self, folder, values):
        look = self.menu_style
        scene = folder / "StartButtonPreview.qml"
        scene.write_text(START_BUTTON_SCENE.format(ui=start_button_ui(repo=repo_of(values)).as_uri()))
        context = {
            "startText": values.get("START_TEXT", "Start"),
            "startLogo": QUrl.fromLocalFile(str(picture_file(values.get("START_LOGO", "flag"), repo_of(values)))),
            "startBevel": chicago95ui.bevel_for_style(look),
            "face": QColor(LOOK_FACES.get(look, CLASSIC_FACE)),
        }
        self.show_scene(scene, context, TASKBAR_STRIP.height())

    def show_luna_button(self, folder, values):
        parts = folder / "luna-panel"
        luna_previews().copy_panel_parts(luna_root_of(values), parts)
        self.button.engine().addImportPath(str(luna_previews().qml_import_root()))
        scene = folder / "LunaStartButtonPreview.qml"
        scene.write_text(luna_previews().panel_scene(luna_previews().START_SCENE, parts))
        context = {"panelRows": luna_previews().panel_rows(), "startText": values.get("START_TEXT", "Start")}
        self.show_scene(scene, context, luna_previews().PANEL_HEIGHT)

    def draw_menu(self, folder, values, look):
        config = folder / "config"
        config.mkdir()
        user_colours = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kdeglobals"
        if user_colours.exists():
            shutil.copy(user_colours, config / "kdeglobals")
        (config / "chicago95rc").write_text(
            "[StartMenu]\n"
            f"bannerText={values.get('BANNER_TEXT', 'Chicago95')}\n"
            f"bannerBackground={values.get('BANNER_BG', '#808080')}\n"
            f"bannerTextColor={values.get('BANNER_FG', '#C0C0C0')}\n"
            f"style={look}\n"
        )
        if self.process.state() != QProcess.NotRunning:
            self.process.kill()
            self.process.waitForFinished()
        environment = QProcessEnvironment.systemEnvironment()
        environment.insert("XDG_CONFIG_HOME", str(config))
        environment.insert("QT_QPA_PLATFORM", "offscreen")
        self.process.setProcessEnvironment(environment)
        self.shot = folder / "menu.png"
        # The Start menu beside this Control Panel: both installed by Setup, or both in the checkout.
        start_menu = Path(__file__).resolve().parent / "chicago95-startmenu"
        self.process.start(sys.executable, [str(start_menu), "--screenshot", str(self.shot)])

    def show_menu(self):
        menu = QPixmap(str(self.shot))
        if self.menu_style == "luna":
            menu = menu.scaledToWidth(LUNA_MENU_PREVIEW_WIDTH, Qt.SmoothTransformation)
        self.menu_label.setPixmap(menu)
        self.button.setFixedWidth(max(menu.width(), TASKBAR_STRIP.width()))


class BrandingPreview(QLabel):
    """The 2000 log-on banner, drawn with the branding chosen; under the Windows XP log-on, the XP wordmark with
    the edition."""

    WIDTH = 350  # the 411-wide banner shrunk to fit the property sheet

    def __init__(self):
        super().__init__()
        self.scratch = None
        self.setFixedSize(self.WIDTH, round(93 * self.WIDTH / 411))
        self.wordmark = QQuickWidget(self)
        self.wordmark.setResizeMode(QQuickWidget.SizeRootObjectToView)
        self.wordmark.resize(self.size())
        self.wordmark.hide()

    def refresh(self, values):
        show_style = {"luna": self.show_wordmark}.get(values.get("LOGIN_STYLE", "classic"), self.show_banner)
        show_style(values)

    def show_banner(self, values):
        self.wordmark.hide()
        banner = render_banner({**values, "LOGIN_STYLE": "2000"}, fresh_scratch(self) / "banner.png")
        self.setPixmap(QPixmap(str(banner)).scaledToWidth(self.WIDTH, Qt.SmoothTransformation))

    def show_wordmark(self, values):
        folder = fresh_scratch(self)
        luna_previews().copy_screen_trees(luna_root_of(values), folder / "luna")
        (folder / "WordmarkPreview.qml").write_text(luna_previews().WORDMARK_SCENE)
        self.wordmark.rootContext().setContextProperty("wordmarkEdition", values.get("EDITION", "Professional"))
        self.wordmark.engine().clearComponentCache()
        self.wordmark.setSource(QUrl.fromLocalFile(str(folder / "WordmarkPreview.qml")))
        self.wordmark.show()


class LoadingPreview(QmlPreview):
    """The loading screen as Plasma shows it, with the style, pictures and texts chosen, at stage 3."""

    SIZE, SCALE = (320, 240), 0.6

    def __init__(self):
        super().__init__(self.SIZE, self.SCALE)

    @staticmethod
    def settings_js(values):
        company_logo = values.get("COMPANY_LOGO", "text")
        entries = {
            "style": boot_style(values),
            "brandText": values.get("BANNER_TEXT", "Chicago95"),
            "brandLogo": str(picture_file(values.get("LOGIN_LOGO", "start"), repo_of(values))),
            "edition": values.get("EDITION", "Professional"),
            "tagline": values.get("TAGLINE", "Built on Linux Technology"),
            "company": values.get("COMPANY", "KDE"),
            "companyLogo": "" if company_logo in ("text", "") else company_logo,
            "loadingText": values.get("LOADING_TEXT", "Starting up..."),
            "footer": values.get("LOADING_FOOTER", "Chicago95 for KDE Plasma").replace("%h", socket.gethostname()),
            "picture": str(picture_file(values.get("SPLASH_IMAGE", "classic"), repo_of(values))),
        }
        return ".pragma library\n" + "".join(f"var {name} = {json.dumps(value)}\n" for name, value in entries.items())

    def refresh(self, values):
        folder = fresh_scratch(self) / "splash"
        shutil.copytree(splash_of(values), folder)
        add_luna_screen(values, folder, "splash", boot_style(values))
        (folder / "settings.js").write_text(self.settings_js(values))
        self.load(folder / "Splash.qml")
        if self.dialog() is not None:
            self.dialog().setProperty("stage", 3)


def swatch_icon(colour):
    pixmap = QPixmap(26, 13)
    pixmap.fill(QColor(colour))
    painter = QPainter(pixmap)
    painter.setPen(QColor("#000000"))
    painter.drawRect(0, 0, pixmap.width() - 1, pixmap.height() - 1)
    painter.end()
    return QIcon(pixmap)


class TaskButtonPreview(QWidget):
    """Two task buttons as the taskbar draws them, as wide as the width chosen: a window's, then the
    active window's pressed one."""

    def __init__(self, look):
        super().__init__()
        self.look = look
        self.scratch = None
        self.button_width = LOOK_BUTTON_WIDTH
        self.icon = QIcon.fromTheme("text-x-generic")
        self.luna_view = QQuickWidget(self)
        self.luna_view.setResizeMode(QQuickWidget.SizeRootObjectToView)
        self.luna_view.hide()
        self.setFixedHeight(chicago95ui.TASK_BUTTON_HEIGHT)

    def refresh(self, values):
        show_style = {"luna": self.show_luna}.get(values.get("TASKBAR_STYLE", "classic"), self.show_classic)
        show_style(values)
        self.show_width(self.button_width)

    def show_classic(self, _values):
        self.luna_view.hide()
        self.setFixedHeight(chicago95ui.TASK_BUTTON_HEIGHT)

    def show_luna(self, values):
        parts = fresh_scratch(self) / "luna-panel"
        luna_previews().copy_panel_parts(luna_root_of(values), parts)
        scene = parts.parent / "LunaTaskButtonPreview.qml"
        scene.write_text(luna_previews().panel_scene(luna_previews().TASKS_SCENE, parts))
        self.luna_view.engine().addImportPath(str(luna_previews().qml_import_root()))
        self.luna_view.rootContext().setContextProperty("panelRows", luna_previews().panel_rows())
        self.luna_view.rootContext().setContextProperty("taskWidth", self.button_width)
        self.luna_view.engine().clearComponentCache()
        self.luna_view.setSource(QUrl.fromLocalFile(str(scene)))
        self.setFixedHeight(luna_previews().PANEL_HEIGHT)
        self.luna_view.show()

    def show_width(self, width):
        self.button_width = width
        self.luna_view.rootContext().setContextProperty("taskWidth", width)
        self.luna_view.setFixedSize(self.sizeHint())
        self.updateGeometry()
        self.update()

    def sizeHint(self):
        return QSize(2 * self.button_width + 3, self.height())

    def paintEvent(self, _event):
        if self.luna_view.isVisibleTo(self):
            return
        painter = QPainter(self)
        for position, (caption, pressed) in enumerate((("Document - Notepad", False), ("My Computer", True))):
            rect = QRect(position * (self.button_width + 3), 0, self.button_width, self.height())
            chicago95ui.paint_task_button(painter, rect, caption, self.icon, pressed, self.look)


class ChoiceSlider(QWidget):
    """A slider over a few named steps, labelled at its ends, as the Mouse page's pointer speed."""

    changed = Signal()

    def __init__(self, options):
        super().__init__()
        self.values = [value for _label, value in options]
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(0, len(options) - 1)
        self.slider.setPageStep(1)
        self.slider.setTickPosition(QSlider.TicksBelow)
        self.slider.setTickInterval(1)
        row = QHBoxLayout(self)
        row.setContentsMargins(0, 0, 0, 0)
        row.addWidget(QLabel(options[0][0]))
        row.addWidget(self.slider, 1)
        row.addWidget(QLabel(options[-1][0]))
        self.slider.valueChanged.connect(lambda *_: self.changed.emit())

    def value(self):
        return self.values[self.slider.value()]

    def set_value(self, value):
        self.slider.setValue(self.values.index(value) if value in self.values else 0)


class ScreenAreaField(QWidget):
    """Windows 98's Screen area: a slider from Less to More over the screen's sizes, the chosen one in words."""

    changed = Signal()

    def __init__(self, sizes):
        super().__init__()
        self.sizes = sizes or [""]
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(0, len(self.sizes) - 1)
        self.slider.setPageStep(1)
        self.label = QLabel()
        self.label.setAlignment(Qt.AlignHCenter)
        row = QHBoxLayout()
        row.addWidget(QLabel("Less"))
        row.addWidget(self.slider, 1)
        row.addWidget(QLabel("More"))
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addLayout(row)
        layout.addWidget(self.label)
        self.slider.valueChanged.connect(self.moved)
        self.moved()

    def moved(self):
        self.label.setText(self.value().replace("x", " by ") + " pixels" if self.value() else "")
        self.changed.emit()

    def value(self):
        return self.sizes[self.slider.value()]

    def set_value(self, value):
        self.slider.setValue(self.sizes.index(value) if value in self.sizes else 0)


class ButtonWidthField(QWidget):
    """The longest a window's button on the taskbar may be: the look's own, or a width from 60 to 300 pixels."""

    changed = Signal()

    def __init__(self, look):
        super().__init__()
        self.checkbox = QCheckBox("Use the look's own width")
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setTickPosition(QSlider.TicksBelow)
        self.slider.setTickInterval(20)
        self.spin = chicago95ui.plain_disabled_text(QSpinBox())
        for control in (self.slider, self.spin):
            control.setRange(MIN_BUTTON_WIDTH, MAX_BUTTON_WIDTH)
        self.preview = TaskButtonPreview(look)
        controls = QHBoxLayout()
        controls.addWidget(QLabel("Narrow"))
        controls.addWidget(self.slider, 1)
        controls.addWidget(QLabel("Wide"))
        controls.addWidget(self.spin)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.checkbox)
        layout.addLayout(controls)
        layout.addWidget(self.preview)
        self.slider.valueChanged.connect(self.spin.setValue)
        self.spin.valueChanged.connect(self.slider.setValue)
        self.spin.valueChanged.connect(self.width_changed)
        self.checkbox.toggled.connect(self.width_changed)
        self.show_state()

    def refresh(self, values):
        self.preview.refresh(values)

    def width_changed(self):
        self.show_state()
        self.changed.emit()

    def show_state(self):
        self.slider.setEnabled(not self.checkbox.isChecked())
        self.spin.setEnabled(not self.checkbox.isChecked())
        self.preview.show_width(LOOK_BUTTON_WIDTH if self.checkbox.isChecked() else self.spin.value())

    def value(self):
        return "0" if self.checkbox.isChecked() else str(self.spin.value())

    def set_value(self, value):
        chosen = str(value).isdigit() and int(value) > 0
        self.checkbox.setChecked(not chosen)
        self.spin.setValue(int(value) if chosen else LOOK_BUTTON_WIDTH)
        self.show_state()


class LauncherList(QWidget):
    """The Quick Launch programs in order, with the buttons that add, remove and move them."""

    changed = Signal()

    def __init__(self, choose_file):
        super().__init__()
        self.choose_file = choose_file
        self.list_widget = QListWidget()
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.list_widget, 1)
        buttons = QVBoxLayout()
        for caption, action in (
            ("Add...", self.add),
            ("Remove", self.remove),
            ("Move Up", lambda: self.move(-1)),
            ("Move Down", lambda: self.move(1)),
        ):
            button = chicago95ui.dialog_button(caption)
            button.clicked.connect(action)
            buttons.addWidget(button)
        buttons.addStretch(1)
        layout.addLayout(buttons)

    def value(self):
        return ",".join(self.list_widget.item(row).text() for row in range(self.list_widget.count()))

    def set_value(self, value):
        self.list_widget.clear()
        for launcher in value.split(","):
            if launcher:
                item = QListWidgetItem(launcher)
                item.setSizeHint(QSize(0, LIST_ROW_HEIGHT))
                self.list_widget.addItem(item)

    def add(self):
        path = self.choose_file(self, "Add to Quick Launch", "Programs (*.desktop)")
        if path:
            self.list_widget.addItem(launcher_for_desktop_file(path))
            self.changed.emit()

    def remove(self):
        row = self.list_widget.currentRow()
        if row >= 0:
            self.list_widget.takeItem(row)
            self.changed.emit()

    def move(self, step):
        row = self.list_widget.currentRow()
        target = row + step
        if row < 0 or not 0 <= target < self.list_widget.count():
            return
        item = self.list_widget.takeItem(row)
        self.list_widget.insertItem(target, item)
        self.list_widget.setCurrentRow(target)
        self.changed.emit()


class AppearancePreview(QWidget):
    """Windows 98's Appearance sample (the tech2u Display Properties picture), on the desktop colour: an inactive
    window, the active one with its Normal, Disabled and Selected menu and its Window Text, and a Message Box."""

    SIZE = QSize(358, 178)
    INACTIVE, ACTIVE, MESSAGE = QRect(10, 9, 302, 112), QRect(16, 29, 300, 126), QRect(22, 104, 212, 66)
    TITLE_HEIGHT = 18

    def __init__(self):
        super().__init__()
        self.active, self.inactive, self.desktop, self.look = "#000080", "#808080", "#008080", "1995"
        self.active_title = QRect()
        self.setFixedSize(self.SIZE)

    def show_colors(self, active, inactive, desktop, look):
        self.active, self.inactive, self.desktop, self.look = active, inactive, desktop, look
        self.update()

    def face(self):
        return QColor(LOOK_FACES.get(self.look, CLASSIC_FACE))

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor(self.desktop.split(",")[0]))
        self.sunken(painter, self.rect())
        self.window(painter, self.INACTIVE, "Inactive Window", self.inactive, buttons=3)
        self.active_title = self.window(painter, self.ACTIVE, "Active Window", self.active, buttons=3)
        self.menu_and_text(painter, self.ACTIVE)
        self.window(painter, self.MESSAGE, "Message Box", self.active, buttons=1)
        self.message(painter, self.MESSAGE)

    def sunken(self, painter, rect):
        colours = chicago95ui.bevel_colors(self.face(), chicago95ui.bevel_for_style(self.look))
        for inset, (top_left, bottom_right) in enumerate(
            ((colours["shadow"], QColor("#FFFFFF")), (colours["dark"], colours["light"]))
        ):
            edge = rect.adjusted(inset, inset, -inset, -inset)
            painter.fillRect(edge.left(), edge.top(), edge.width(), 1, top_left)
            painter.fillRect(edge.left(), edge.top(), 1, edge.height(), top_left)
            painter.fillRect(edge.left(), edge.bottom(), edge.width(), 1, bottom_right)
            painter.fillRect(edge.right(), edge.top(), 1, edge.height(), bottom_right)

    def raised(self, painter, rect):
        colours = chicago95ui.bevel_colors(self.face(), chicago95ui.bevel_for_style(self.look))
        painter.fillRect(rect, self.face())
        painter.fillRect(rect.left(), rect.top(), rect.width(), 1, colours["light"])
        painter.fillRect(rect.left(), rect.top(), 1, rect.height(), colours["light"])
        painter.fillRect(rect.left() + 1, rect.top() + 1, rect.width() - 2, 1, QColor("#FFFFFF"))
        painter.fillRect(rect.left() + 1, rect.top() + 1, 1, rect.height() - 2, QColor("#FFFFFF"))
        painter.fillRect(rect.left(), rect.bottom(), rect.width(), 1, colours["dark"])
        painter.fillRect(rect.right(), rect.top(), 1, rect.height(), colours["dark"])
        painter.fillRect(rect.left() + 1, rect.bottom() - 1, rect.width() - 2, 1, colours["shadow"])
        painter.fillRect(rect.right() - 1, rect.top() + 1, 1, rect.height() - 2, colours["shadow"])

    def window(self, painter, rect, caption, colours, buttons):
        """A window's frame and title bar; the title bar's rectangle."""
        self.raised(painter, rect)
        title = QRect(rect.left() + 4, rect.top() + 4, rect.width() - 8, self.TITLE_HEIGHT)
        stops = [QColor(stop.split("@")[0]) for stop in colours.split(",")]
        gradient = QLinearGradient(title.left(), 0, title.right(), 0)
        gradient.setColorAt(0, stops[0])
        gradient.setColorAt(1, stops[-1])
        painter.fillRect(title, gradient)
        painter.setPen(QColor("#FFFFFF") if colours is self.active else QColor(LOOK_FACES.get(self.look, CLASSIC_FACE)))
        painter.setFont(chicago95ui.ui_font(bold=True))
        painter.drawText(title.adjusted(3, 0, 0, 0), Qt.AlignVCenter, caption)
        right = title.right() - 2
        for index, glyph in enumerate(("minimize", "maximize", "close")[-buttons:][::-1]):
            button = QRect(right - 16 - index * 16 - (2 if index else 0), title.top() + 2, 16, 14)
            self.raised(painter, button)
            self.glyph(painter, button, glyph)
        return title

    def glyph(self, painter, button, glyph):
        """The title buttons' black marks, drawn on their pixel grid: a bar, a box with a thick top, a cross."""
        left, top, black = button.left() + 4, button.top() + 3, QColor("#000000")
        if glyph == "minimize":
            painter.fillRect(left, top + 6, 6, 2, black)
        elif glyph == "maximize":
            painter.fillRect(left, top, 9, 2, black)
            painter.fillRect(left, top, 1, 8, black)
            painter.fillRect(left + 8, top, 1, 8, black)
            painter.fillRect(left, top + 7, 9, 1, black)
        else:
            for step in range(7):
                painter.fillRect(left + step, top + step, 2, 1, black)
                painter.fillRect(left + 6 - step, top + step, 2, 1, black)

    def menu_and_text(self, painter, rect):
        menu = QRect(rect.left() + 4, rect.top() + 4 + self.TITLE_HEIGHT + 1, rect.width() - 8, 18)
        painter.setFont(chicago95ui.ui_font())
        x = menu.left() + 6
        for word, kind in (("Normal", "normal"), ("Disabled", "disabled"), ("Selected", "selected")):
            width = painter.fontMetrics().horizontalAdvance(word) + 12
            cell = QRect(x - 6, menu.top(), width, menu.height())
            if kind == "selected":
                painter.fillRect(cell, self.palette().highlight())
            painter.setPen(
                self.palette().highlightedText().color()
                if kind == "selected"
                else chicago95ui.bevel_colors(self.face(), chicago95ui.bevel_for_style(self.look))["shadow"]
                if kind == "disabled"
                else QColor("#000000")
            )
            painter.drawText(cell, Qt.AlignCenter, word)
            x += width
        text = QRect(menu.left() + 2, menu.bottom() + 3, menu.width() - 4, rect.bottom() - menu.bottom() - 8)
        painter.fillRect(text, QColor("#FFFFFF"))
        scroll = QRect(text.right() - 15, text.top(), 16, text.height())
        painter.fillRect(scroll, self.face())
        for arrow in (QRect(scroll.left(), scroll.top(), 16, 16), QRect(scroll.left(), scroll.bottom() - 15, 16, 16)):
            self.raised(painter, arrow)
        painter.setPen(QColor("#000000"))
        painter.setFont(chicago95ui.ui_font(13, bold=True))
        painter.drawText(text.adjusted(4, 2, -20, 0), Qt.AlignTop | Qt.AlignLeft, "Window Text")

    def message(self, painter, rect):
        painter.setFont(chicago95ui.ui_font())
        painter.setPen(QColor("#000000"))
        painter.drawText(rect.adjusted(8, 4 + self.TITLE_HEIGHT + 4, 0, 0), Qt.AlignTop | Qt.AlignLeft, "Message Text")
        button = QRect(rect.center().x() - 37, rect.bottom() - 28, 75, 23)
        painter.fillRect(button, QColor("#000000"))
        self.raised(painter, button.adjusted(1, 1, -1, -1))
        painter.drawText(button, Qt.AlignCenter, "OK")


SHEET_MARGINS = (
    6,
    8,
    6,
    7,
)  # a property sheet's tabs and buttons inside its window (tests/test_control_panel_components_reference.py)
PAGE_INSETS = (
    13,
    9,
    12,
    9,
)  # left, top, right, bottom inside the page frame (tests/test_control_panel_components_reference.py)
from chicago95ui import (
    TAB_INSET,
    TAB_RISE,
    TAB_ROW_HEIGHT,
    TAB_SEAM,
    TAB_SPREAD,
    paint_tab,
    paint_tab_caption,
    tab_width,
)


class AppearanceSwitch(QStackedWidget):
    """The Appearance sample in the widget style chosen: the classic mock, or the Windows XP one, swapped live."""

    def __init__(self):
        super().__init__()
        import chicago95lunacontrolpanel

        self.mocks = {"classic": AppearancePreview(), "luna": chicago95lunacontrolpanel.LunaAppearancePreview()}
        for mock in self.mocks.values():
            self.addWidget(mock)
        self.setFixedSize(AppearancePreview.SIZE)
        self.show_style("luna" if chicago95ui.luna_widgets() else "classic")

    def show_style(self, widget_style):
        self.setCurrentWidget(self.mocks.get(widget_style, self.mocks["classic"]))

    def show_colors(self, active, inactive, desktop, look):
        for mock in self.mocks.values():
            mock.show_colors(active, inactive, desktop, look)

    def refresh(self, values):
        self.show_style(values.get("WIDGET_STYLE", "classic"))

    def __getattr__(self, name):
        return getattr(self.currentWidget(), name)


class TabRows(QWidget):
    """The tabs of a TabControl, wrapped into rows as the classic control does when they do not fit on a line."""

    chosen = Signal(int)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.names, self.selected, self.rows = [], 0, []

    def add_tab(self, name):
        self.names.append(name)
        self.relayout()

    def select(self, index):
        self.selected = index
        self.relayout()

    def relayout(self):
        metrics = QFontMetrics(self.font())
        widths = [tab_width(metrics, name) for name in self.names]
        self.rows = rows_for_selected(tab_rows(widths, max(self.width() - 2 * TAB_INSET, 1)), self.selected)
        self.setFixedHeight(len(self.rows) * TAB_ROW_HEIGHT + TAB_RISE + TAB_SEAM)
        self.update()

    def resizeEvent(self, _event):
        self.relayout()

    def tab_rects(self):
        rects = {}
        for row_number, row in enumerate(self.rows):
            left = TAB_INSET
            for index, width in row:
                top = TAB_RISE + row_number * TAB_ROW_HEIGHT
                if index == self.selected:
                    spread_left = max(left - TAB_SPREAD, 0)
                    rects[index] = QRect(
                        spread_left,
                        top - TAB_RISE,
                        left + width + TAB_SPREAD - spread_left,
                        TAB_ROW_HEIGHT + TAB_RISE + TAB_SEAM,
                    )
                else:
                    rects[index] = QRect(left, top, width, TAB_ROW_HEIGHT)
                left += width
        return rects

    def paintEvent(self, _event):
        painter = QPainter(self)
        rects = self.tab_rects()
        for index in sorted(rects, key=lambda tab: tab == self.selected):
            rect = rects[index]
            if index == self.selected:
                rect = rect.adjusted(0, 0, 0, -TAB_SEAM)
            paint_tab(painter, rect, self.palette(), index == self.selected)
            paint_tab_caption(painter, rect, self.palette(), self.names[index])

    def mousePressEvent(self, event):
        for index, rect in self.tab_rects().items():
            if rect.contains(event.position().toPoint()) and index != self.selected:
                self.chosen.emit(index)
                return


class TabControl(QWidget):
    """The classic tab control: multi-row tabs over a raised page. It answers like a QTabWidget."""

    currentChanged = Signal(int)

    def __init__(self):
        super().__init__()
        self.stack = QStackedWidget()
        self.pane = QFrame(self)
        self.pane.setFrameStyle(QFrame.StyledPanel | QFrame.Raised)
        pane_layout = QVBoxLayout(self.pane)
        pane_layout.setContentsMargins(0, 0, 0, 0)
        pane_layout.addWidget(self.stack)
        self.bar = TabRows(self)
        self.bar.chosen.connect(self.setCurrentIndex)

    def place(self):
        """The bar overlaps the page's top border by TAB_SEAM rows, so the selected tab can cover it."""
        self.bar.setGeometry(0, 0, self.width(), self.bar.height())
        self.pane.setGeometry(
            0, self.bar.height() - TAB_SEAM, self.width(), max(self.height() - self.bar.height() + TAB_SEAM, 0)
        )
        self.bar.raise_()

    def resizeEvent(self, _event):
        self.place()

    def sizeHint(self):
        page = self.pane.sizeHint()
        return QSize(page.width(), self.bar.height() - TAB_SEAM + page.height())

    def minimumSizeHint(self):
        page = self.pane.minimumSizeHint()
        return QSize(page.width(), self.bar.height() - TAB_SEAM + page.height())

    def addTab(self, widget, name):
        self.stack.addWidget(widget)
        self.bar.add_tab(name)
        self.place()

    def count(self):
        return self.stack.count()

    def tabText(self, index):
        return self.bar.names[index]

    def widget(self, index):
        return self.stack.widget(index)

    def currentIndex(self):
        return self.stack.currentIndex()

    def setCurrentIndex(self, index):
        if index == self.currentIndex():
            return
        self.stack.setCurrentIndex(index)
        self.bar.select(index)
        self.place()
        self.currentChanged.emit(index)


WindowChrome = namedtuple(
    "WindowChrome",
    "header_band toolbar_button status_bar status_pane logo_box menu_style tab_control progress_bar appearance_preview",
)
CLASSIC_WINDOW_CHROME = WindowChrome(
    HeaderBand,
    ToolbarButton,
    ClassicStatusBar,
    StatusPane,
    LogoBox,
    lambda: MenuBandStyle("Windows"),
    TabControl,
    ClassicProgressBar,
    AppearancePreview,
)


def window_chrome():
    """The Control Panel's window parts of the look's widget style: the classic ones, or Windows XP's."""
    if not chicago95ui.luna_widgets():
        return CLASSIC_WINDOW_CHROME
    import chicago95luna
    import chicago95lunacontrolpanel

    header_band, toolbar_button, status_bar, status_pane, logo_box, progress_bar, preview = (
        chicago95lunacontrolpanel.CHROME_FIELDS
    )
    return WindowChrome(
        header_band,
        toolbar_button,
        status_bar,
        status_pane,
        logo_box,
        chicago95luna.LunaStyle,
        QTabWidget,
        progress_bar,
        preview,
    )


def scrolling(tab):
    """The tab in a frameless scroll area: a sheet keeps the standard size, and a tab too big for it scrolls."""
    area = QScrollArea()
    area.setFrameShape(QFrame.NoFrame)
    area.setWidgetResizable(True)
    area.viewport().setBackgroundRole(QPalette.Window)
    # Luna's tab page is the near-white XP page the style paints; the viewport stays clear so it shows through.
    area.viewport().setAutoFillBackground(not chicago95ui.luna_widgets())
    area.setWidget(tab)
    return area


def with_custom_look(changed):
    """A component changed on its own, without the Scheme choosing it, makes the look a custom one."""
    own_component = any(key in changed for key in COMPONENT_KEYS) and "LOOK" not in changed
    return {**changed, "LOOK": "custom"} if own_component else changed


class PropertiesPage(QWidget):
    """An applet's page in the Control Panel's window: property sheet tabs with OK, Cancel and Apply."""

    finished = Signal()

    def __init__(self, title, tabs, apply_changes):
        super().__init__()
        self.title = title
        self.apply_changes = apply_changes
        self.tabs = window_chrome().tab_control()
        self.settings_tabs = [tab for _name, tab in tabs]
        for name, tab in tabs:
            self.tabs.addTab(scrolling(tab), name)
            tab.changed.connect(self.refresh_apply_button)
        self.baseline = self.collect_values()
        self.preview_timer = QTimer(self)
        self.preview_timer.setSingleShot(True)
        self.preview_timer.setInterval(150)
        self.preview_timer.timeout.connect(self.refresh_previews)
        self.refresh_previews()
        self.ok_button = chicago95ui.dialog_button("OK")
        self.cancel_button = chicago95ui.dialog_button("Cancel")
        self.apply_button = chicago95ui.dialog_button("&Apply", enabled=False)
        self.ok_button.clicked.connect(self.ok)
        self.cancel_button.clicked.connect(self.cancel)
        self.apply_button.clicked.connect(self.apply)
        buttons = QHBoxLayout()
        buttons.addStretch(1)
        for button in (self.ok_button, self.cancel_button, self.apply_button):
            buttons.addWidget(button)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(*SHEET_MARGINS)
        layout.addWidget(self.tabs, 1)
        layout.addLayout(buttons)

    def tab_names(self):
        return [self.tabs.tabText(index) for index in range(self.tabs.count())]

    def collect_values(self):
        return {key: value for tab in self.settings_tabs for key, value in tab.values().items()}

    def changed_values(self):
        changed = {key: value for key, value in self.collect_values().items() if self.baseline.get(key) != value}
        return with_custom_look(changed)

    def refresh_apply_button(self):
        self.apply_button.setEnabled(bool(self.changed_values()))
        self.preview_timer.start()

    def refresh_previews(self):
        """Every preview sees the saved settings under this sheet's current values: a tab's screen can
        depend on another tab's choices (the loading screen on the log-on style, the banners on the branding)."""
        values = {**(self.settings_tabs[0].saved if self.settings_tabs else {}), **self.collect_values()}
        for tab in self.settings_tabs:
            for preview in tab.previews:
                preview.refresh(values)

    def apply(self):
        if not self.apply_changes(self.changed_values()):
            return False
        self.baseline = self.collect_values()
        self.refresh_apply_button()
        return True

    def ok(self):
        if not self.changed_values() or self.apply():
            self.finished.emit()

    def discard_changes(self):
        for tab in self.settings_tabs:
            tab.load(self.baseline)
        self.refresh_apply_button()

    def cancel(self):
        self.discard_changes()
        self.finished.emit()


SHEET_SIZE = QSize(398, 424)  # Display Properties inside its 3px frame and title bar (the tech2u pictures: 404 by 448)


class PropertySheetWindow(QDialog):
    """An applet in its own window, as Windows 98 opened Display Properties: a property sheet of fixed size whose
    title bar has only the ? and close buttons; closing it is Cancel."""

    def __init__(self, page, parent):
        super().__init__(
            parent,
            Qt.Dialog
            | Qt.CustomizeWindowHint
            | Qt.WindowTitleHint
            | Qt.WindowContextHelpButtonHint
            | Qt.WindowCloseButtonHint,
        )
        self.page = page
        self.setWindowTitle(f"{page.title} Properties")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(page)
        page.finished.connect(self.hide)
        self.setFixedSize(SHEET_SIZE)

    def reject(self):
        self.page.cancel()

    def closeEvent(self, event):
        self.page.discard_changes()
        super().closeEvent(event)


# ---- Mouse Properties (tests/references/win98mouse.png, tests/test_mouse_page.py): the Buttons tab's parts sit
# where the original's do, in page-frame coordinates; the tab's own origin is TAB_PAGE_FRAME pixels inside the frame.
TAB_PAGE_FRAME = 2
MOUSE_LAYOUT = {
    "configuration": QRect(15, 19, 355, 165),
    "speed": QRect(15, 198, 355, 138),
    "right-handed": (QPoint(25, 38), 16),  # the circle, and how far its caption's ink starts from it
    "left-handed": (QPoint(125, 38), 21),
    "left heading": QPoint(25, 71),
    "left lines": (QPoint(34, 87), QPoint(34, 100)),
    "right heading": QPoint(260, 71),
    "right lines": (QPoint(269, 87), QPoint(269, 100)),
    "picture": QRect(151, 79, 83, 80),
    "slider": QRect(63, 238, 137, 0),
    "slow": QPoint(25, 238),
    "fast": QPoint(215, 238),
    "test area label": QPoint(260, 220),
    "test area": QRect(259, 236, 80, 85),
}
# A QGroupBox's frame starts GROUP_TITLE_RISE rows below its widget's top and ends a row and a column short of it;
# a QLabel draws its ink a pixel right of the font's bearing.
GROUP_TITLE_RISE, GROUP_FRAME_SLACK, LABEL_INK_SHIFT, RADIO_RISE = 5, 1, 1, 1
DOUBLE_CLICK_RANGE = (100, 900)
POINTER_SPEED_STEPS = 10


def page_rect(rect):
    return rect.translated(-TAB_PAGE_FRAME, -TAB_PAGE_FRAME)


PICTURE_FACE = QColor("#C0C0C0").rgb()  # the 16-colour pictures' button face, repainted in the look's own


def control_panel_picture(name, face=None):
    """A picture of the Control Panel's own (data/control-panel), from the install or the repository, its grey
    button-face pixels repainted in `face` (a QColor), as the originals mapped their bitmaps' 3D colours."""
    installed = CHICAGO95_DATA / "control-panel" / name
    image = QImage(str(installed if installed.exists() else REPO_DIR / "data/control-panel" / name)).convertToFormat(
        QImage.Format_ARGB32
    )
    if face is not None and face.rgb() != PICTURE_FACE:
        for y in range(image.height()):
            for x in range(image.width()):
                if image.pixel(x, y) == PICTURE_FACE:
                    image.setPixel(x, y, face.rgb())
    return QPixmap.fromImage(image)


class MousePicture(QWidget):
    """The mouse of Mouse Properties, its primary button marked: the left one, or the picture mirrored for
    the left-handed."""

    def __init__(self):
        super().__init__()
        self.left_handed = False

    def show_hand(self, left_handed):
        self.left_handed = left_handed
        self.update()

    def paintEvent(self, _event):
        QPainter(self).drawPixmap(
            0, 0, control_panel_picture("mouse-left.png" if self.left_handed else "mouse-right.png")
        )


class ClickTestArea(QFrame):
    """The double-click test area: two clicks within the chosen time open the box, two more close it."""

    def __init__(self):
        super().__init__()
        self.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        self.interval_ms = 500
        self.open = False
        self.last_click_at = None

    def clicked_at(self, milliseconds):
        if self.last_click_at is not None and milliseconds - self.last_click_at <= self.interval_ms:
            self.open = not self.open
            self.last_click_at = None
            self.update()
        else:
            self.last_click_at = milliseconds

    def mousePressEvent(self, _event):
        self.clicked_at(int(time.monotonic() * 1000))

    def mouseDoubleClickEvent(self, event):
        self.mousePressEvent(event)

    def paintEvent(self, event):
        super().paintEvent(event)
        face = self.palette().window().color()
        closed = control_panel_picture("jack-closed.png", face)
        picture = control_panel_picture("jack-open.png", face) if self.open else closed
        inside = self.contentsRect()
        # The closed box sits in the lower half, as the original's; the open one grows upwards from the same floor.
        floor = inside.center().y() + closed.height() + 2
        QPainter(self).drawPixmap(inside.center().x() - picture.width() // 2, floor - picture.height(), picture)


class MouseButtonsTab(SettingsTab):
    """Button configuration, with the mouse picture and what each button does, and the double-click speed."""

    def __init__(self, settings, actions):
        super().__init__(settings, actions)
        self.outer.setContentsMargins(0, 0, 0, 0)
        self.setMinimumSize(
            page_rect(MOUSE_LAYOUT["speed"]).bottomRight().x() + 20, page_rect(MOUSE_LAYOUT["speed"]).bottom() + 14
        )
        self.group_at("&Button configuration", MOUSE_LAYOUT["configuration"])
        self.group_at("&Double-click speed", MOUSE_LAYOUT["speed"])
        self.hands = QButtonGroup(self)
        for text, value, at in (("&Right-handed", "right", "right-handed"), ("&Left-handed", "left", "left-handed")):
            circle, caption_gap = MOUSE_LAYOUT[at]
            button = QRadioButton(text, self)
            button.setProperty("value", value)
            button.setProperty("captionGap", caption_gap)
            self.hands.addButton(button)
            button.move(page_rect(QRect(circle, QSize(1, 1))).topLeft() - QPoint(0, RADIO_RISE))
            button.adjustSize()
            button.resize(
                button.width() + caption_gap, max(button.height(), QFontMetrics(button.font()).height() + RADIO_RISE)
            )
        self.picture = MousePicture()
        self.picture.setParent(self)
        self.picture.setGeometry(page_rect(MOUSE_LAYOUT["picture"]))
        for heading, lines, texts in (
            ("left heading", "left lines", ("Left Button:", "- Normal Select", "- Normal Drag")),
            ("right heading", "right lines", ("Right Button:", "- Context Menu", "- Special Drag")),
        ):
            self.text_at(texts[0], MOUSE_LAYOUT[heading])
            for text, at in zip(texts[1:], MOUSE_LAYOUT[lines], strict=True):
                self.text_at(text, at)
        self.speed = QSlider(Qt.Horizontal, self)
        self.speed.setRange(*DOUBLE_CLICK_RANGE)
        self.speed.setSingleStep(100)
        self.speed.setPageStep(100)
        self.speed.setTickPosition(QSlider.TicksBelow)
        self.speed.setTickInterval(DOUBLE_CLICK_RANGE[1] - DOUBLE_CLICK_RANGE[0])  # a tick at each end, as the original
        self.speed.setInvertedAppearance(True)  # slow (a long time) on the left, fast on the right
        slider = page_rect(MOUSE_LAYOUT["slider"])
        self.speed.setGeometry(slider.left(), slider.top(), slider.width(), self.speed.sizeHint().height())
        self.text_at("Slow", MOUSE_LAYOUT["slow"])
        self.text_at("Fast", MOUSE_LAYOUT["fast"])
        self.test_area = ClickTestArea()
        self.test_area.setParent(self)
        self.text_at("Test area:", MOUSE_LAYOUT["test area label"])
        self.test_area.setGeometry(page_rect(MOUSE_LAYOUT["test area"]))
        self.hands.buttonToggled.connect(lambda button, on: self.hand_changed() if on else None)
        self.speed.valueChanged.connect(lambda value: setattr(self.test_area, "interval_ms", value))
        self.field(
            "MOUSE_HAND",
            lambda: self.hands.checkedButton().property("value"),
            self.select_hand,
            "right",
            self.hands.buttonToggled,
        )
        self.field(
            "DOUBLE_CLICK_MS",
            lambda: str(self.speed.value()),
            lambda value: self.speed.setValue(int(value)),
            "500",
            self.speed.valueChanged,
        )

    def field(self, key, getter, setter, default, signal):
        self.fields[key] = (getter, setter, default)
        setter(self.saved.get(key, default))
        signal.connect(lambda *_: self.notify())

    def select_hand(self, value):
        for button in self.hands.buttons():
            if button.property("value") == value:
                button.setChecked(True)

    def hand_changed(self):
        self.picture.show_hand(self.hands.checkedButton().property("value") == "left")

    def group_at(self, title, rect):
        box = QGroupBox(title, self)
        box.setGeometry(page_rect(rect).adjusted(0, -GROUP_TITLE_RISE, GROUP_FRAME_SLACK, GROUP_FRAME_SLACK))
        box.lower()

    def text_at(self, text, ink_at):
        """A label whose ink starts at ink_at (page-frame coordinates), whatever the font's bearings."""
        label = QLabel(text, self)
        label.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        metrics = QFontMetrics(label.font())
        ink = metrics.tightBoundingRect(text.replace("&", ""))
        label.move(
            page_rect(QRect(ink_at, QSize(1, 1))).topLeft()
            - QPoint(ink.left() + LABEL_INK_SHIFT, metrics.ascent() + ink.top())
        )
        label.adjustSize()
        return label


