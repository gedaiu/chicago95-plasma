    COMPONENTS_BY_KEY[_boot_key] = ("splash", "plymouth")


def boot_style(values):
    """The boot and loading screens' style: chosen on its own, or the login's until it is (as setup/steps.sh)."""
    return values.get("BOOT_STYLE") or values.get("LOGIN_STYLE", "classic")


@tab_builder("Booting Screen", "Boot Screen")
def boot_screen_tab(settings, actions):
    """The screen shown while the computer boots: a picture, as 1995 and 1998 had, the 2000 page with the progress
    bar, XP's black screen, or Vista–11. After log on, Plasma uses the login's own screen: the desktop's colour
    under the hourglass, or XP's Welcome screen. Applying rebuilds the boot image, which asks
    for the administrator password."""
    tab = SettingsTab(settings, actions)
    tab.choice(
        "BOOT_STYLE",
        "Style",
        [
            ("Classic (1995 and 1998): a picture", "classic"),
            ("Windows 2000: the page with its progress bar", "2000"),
            ("Windows XP: the black screen with its sliding bar", "luna"),
            *post_xp_boot.STYLES,
        ],
        default=boot_style(settings),
    )
    tab.group("Classic picture")
    branding_field(tab, "SPLASH_IMAGE", "Picture:", settings)
    tab.group("Vista and later: content")
    tab.picture("BOOT_LOGO", "Logo:", [("Original", "default"), ("Hidden", "none")], "default")
    tab.text("BOOT_NAME", "Product name:")
    tab.text("BOOT_TEXT", "Loading text (default = original):", "default")
    tab.text("BOOT_FOOTER", "Footer (default = original):", "default")
    tab.font_family("BOOT_FONT", "Font (default = original):", "default")
    tab.color("BOOT_BACKGROUND", "Background:", "#000000", most=1)
    tab.picture("BOOT_BACKGROUND_IMAGE", "Background picture:", [("None", "")], "")
    tab.color("BOOT_FOREGROUND", "Text and dots:", "#ffffff", most=1)
    tab.text("BOOT_ACCENT", "Logo/bar color (default = original):", "default")
    tab.text("BOOT_LOGO_SIZE", "Logo size (default = original):", "default")
    tab.group("Vista and later: animation")
    tab.picture("BOOT_ANIMATION", "Vertical sprite sheet:", [("Original", ""), ("Hidden", "none")], "")
    tab.text("BOOT_FRAMES", "Frame count (default = original):", "default")
    tab.text("BOOT_LOOP_START", "First loop frame (default = original):", "default")
    tab.text("BOOT_FPS", "Frames per second (default = original):", "default")
    tab.group("2000 texts")
    branding_field(tab, "LOADING_TEXT", "Text beside the progress bar:", settings)
    branding_field(tab, "LOADING_FOOTER", "Bottom line:", settings)
    tab.group("Preview")
    boot_preview = tab.preview(LoadingPreview())
    test_boot = QPushButton("Test boot sequence…")
    test_boot.clicked.connect(boot_preview.open_boot_test)
    tab.form.addRow("", test_boot)
    tab.group("After log on")
    tab.preview(AfterLogOnPreview())
