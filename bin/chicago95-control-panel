@tab_builder("Taskbar", "Quick Launch")
def quick_launch_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    live = actions.current_launchers()
    initial = ",".join(live if live is not None else default_launchers(DEFAULT_LAUNCHER_FILES))
    field = LauncherList(lambda parent, title, name_filter: actions.choose_file(parent, title, name_filter))
    tab.register("LAUNCHERS", "", field, field.value, field.set_value, initial, field.changed)
    return tab


