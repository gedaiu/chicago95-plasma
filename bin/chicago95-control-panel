ICON_SETS = [("Chicago95 (1995)", "chicago95"), ("SE98 (1998)", "se98"), ("ClassicOS 2000", "classicos2000")]
COLOR_FIELDS = (("TITLE_ACTIVE", "Active title bar:"), ("TITLE_INACTIVE", "Inactive title bar:"),
                ("BANNER_BG", "Start menu banner:"), ("BANNER_FG", "Banner text:"))


@tab_builder("Display", "Appearance")
def appearance_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    start = LOOK_PRESETS["1995"]
    tab.group("Scheme")
    tab.scheme = tab.choice("LOOK", "Scheme:", [("Windows 95", "1995"), ("Windows 98", "1998"), ("Windows 2000", "2000"), ("Custom", "custom")], default="1995")
    tab.color_edits = {key: tab.color(key, label, default=start[key], validator=valid_banner_colors if key == "BANNER_BG" else None) for key, label in COLOR_FIELDS}
    tab.preview = TitleBarPreview(start["TITLE_ACTIVE"], start["TITLE_INACTIVE"])
    tab.form.addRow("", tab.preview)
    tab.group("Icons")
    tab.icons = tab.choice("ICONS", "Icon set:", ICON_SETS, default=start["ICONS"])
    state = {"applying": False}

    def settling():
        return tab.loading or state["applying"]

    def scheme_changed():
        preset = LOOK_PRESETS.get(tab.scheme.currentData())
        if settling() or preset is None:
            return
        state["applying"] = True
        for key, edit in tab.color_edits.items():
            edit.setText(preset[key])
        tab.icons.setCurrentIndex(tab.icons.findData(preset["ICONS"]))
        state["applying"] = False

    def refresh_preview():
        tab.preview.show_colors(tab.color_edits["TITLE_ACTIVE"].text(), tab.color_edits["TITLE_INACTIVE"].text())

    def colour_edited():
        refresh_preview()
        if settling():
            return
        state["applying"] = True
        tab.scheme.setCurrentIndex(tab.scheme.findData("custom"))
        state["applying"] = False

    tab.scheme.currentIndexChanged.connect(scheme_changed)
    for edit in tab.color_edits.values():
        edit.textChanged.connect(colour_edited)
    refresh_preview()
    return tab


@tab_builder("Display", "Screen Saver")
def screen_saver_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    savers = actions.list_screensavers()
    saver = tab.choice("SAVER", "Screen saver:", [(label, name) for name, label in savers] or [("Deep Stars", "deepstars")], default="deepstars")
    wait = tab.number("IDLE_MIN", "Wait:", 1, 60, default=5, suffix=" minutes")
    preview = chicago95ui.dialog_button("Preview", enabled=bool(savers))
    preview.clicked.connect(lambda: actions.start_process(tool_path("chicago95-screensaver"), ["--hack", saver.currentData()]))
    tab.form.addRow("", preview)
    tab.lock_warning = QLabel(f"Your screen locks after {actions.lock_timeout_minutes()} minutes, before the screen saver starts, so you will not see it.")
    tab.lock_warning.setWordWrap(True)
    tab.form.addRow("", tab.lock_warning)

    def show_warning():
        tab.lock_warning.setVisible(screensaver_hidden_by_lock(wait.value(), actions.lock_timeout_minutes()))

    wait.valueChanged.connect(show_warning)
    show_warning()
    return tab


SOUND_EVENTS = (("desktop-login", "Start Windows"), ("desktop-logout", "Exit Windows"), ("dialog-error", "Critical Stop"),
                ("dialog-warning", "Exclamation"), ("dialog-information", "Asterisk"), ("dialog-question", "Question"),
                ("bell-window-system", "Default Sound"), ("trash-empty", "Empty Recycle Bin"), ("window-maximized", "Maximize"),
                ("window-minimized", "Minimize"), ("menu-popup", "Menu Popup"))


@tab_builder("Sounds", "Sounds")
def sounds_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    themes = [(name, theme_id) for theme_id, name in installed_sound_themes(actions.sound_roots)]
    scheme = tab.choice("SOUND_THEME", "Scheme:", themes or [("Chicago95", "Chicago95")], default="Chicago95")
    events = QListWidget()
    for event, label in SOUND_EVENTS:
        events.addItem(label)
        events.item(events.count() - 1).setData(Qt.UserRole, event)
    player = actions.program_installed("pw-play") or actions.program_installed("paplay")
    play = chicago95ui.dialog_button("Play", enabled=bool(player))

    def play_selected():
        item = events.currentItem()
        if item is None:
            return
        sound = chicago95ui.sound_file(scheme.currentData(), item.data(Qt.UserRole), actions.sound_roots)
        if sound:
            actions.start_process(player, [sound])

    play.clicked.connect(play_selected)
    tab.form.addRow("Events:", events)
    tab.form.addRow("", play)
    return tab


