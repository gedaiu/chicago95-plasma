@dataclass(frozen=True)
class Applet:
    name: str
    icon_names: tuple
    description: str
    external_tool: str = ""
    own_window: bool = False  # opens as its own property sheet, as Windows 98's Display Properties did
    command: tuple[str, ...] = ()
    target: str = ""


