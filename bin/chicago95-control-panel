)


def aero_band(content=None, content_height=MENU_BAR_HEIGHT, grip=True, trailing=None):
    band = QWidget()
    layout = QHBoxLayout(band)
    layout.setContentsMargins(4, 0, 4, 0)
    if content:
        layout.addWidget(content)
    band.setFixedHeight(content_height)
    return band


class AeroNavigationButton(QToolButton):
    def __init__(self, forward=False):
        super().__init__()
        self.forward = forward
        self.glow = QVariantAnimation(self)
        self.glow.setDuration(140)
        self.glow.setStartValue(0.0)
        self.glow.setEndValue(1.0)
        self.glow.valueChanged.connect(self.update_glow)

    def update_glow(self, _value):
        self.update()

    def enterEvent(self, event):
        super().enterEvent(event)
        self.glow.setDirection(QVariantAnimation.Forward)
        self.glow.start()

    def leaveEvent(self, event):
        super().leaveEvent(event)
        self.glow.setDirection(QVariantAnimation.Backward)
        self.glow.start()

    def paintEvent(self, event):
        if not self.isEnabled():
            painter = QPainter(self)
            if self.forward:
                painter.translate(self.width(), 0)
                painter.scale(-1, 1)
            size = self.iconSize()
            bounds = QRectF(0, 0, size.width(), size.height())
            bounds.moveCenter(QRectF(self.rect()).center())
            control_panel_picture("aero-navigation-disabled.svg").render(painter, bounds)
            return
        super().paintEvent(event)
        strength = self.glow.currentValue()
        if self.isEnabled() and strength:
            painter = QPainter(self)
            painter.setRenderHint(QPainter.Antialiasing)
            painter.setPen(QColor(194, 240, 255, round(210 * strength)))
            painter.setBrush(QColor(127, 214, 255, round(65 * strength)))
            painter.drawEllipse(self.rect().adjusted(1, 1, -2, -2))


class AeroCategoryHeading(QPushButton):
    def __init__(self, title):
        super().__init__(title)
        self.setProperty("heading", True)
        self.setAutoDefault(True)
        self.setCursor(Qt.PointingHandCursor)
        font = self.font()
        font.setStretch(98)
        self.setFont(font)

    def event(self, event):
        if event.type() in (QEvent.FocusIn, QEvent.FocusOut) and (card := self.parentWidget()):
            card.update()
        return super().event(event)


class AeroCategoryCard(QFrame):
    def __init__(self):
        super().__init__()
        self.setObjectName("categoryCard")
        self.highlighted = False

    def enterEvent(self, event):
        super().enterEvent(event)
        self.highlighted = True
        self.update()

    def leaveEvent(self, event):
        super().leaveEvent(event)
        self.highlighted = False
        self.update()

    def paintEvent(self, event):
        super().paintEvent(event)
        heading = QApplication.focusWidget()
        heading_focused = isinstance(heading, AeroCategoryHeading) and heading.parentWidget() is self
        if self.highlighted or heading_focused:
            painter = QPainter(self)
            if self.highlighted:
                self.paint_highlight(painter)
            if heading_focused:
                self.paint_heading_focus(painter, heading)

    def paint_heading_focus(self, painter, heading):
        pen = QPen(Qt.black, 1, Qt.DotLine, Qt.FlatCap)
        pen.setDashPattern([1, 1])
        pen.setCosmetic(True)
        painter.setPen(pen)
        painter.setBrush(Qt.NoBrush)
        width = min(heading.width(), heading.fontMetrics().horizontalAdvance(heading.text()))
        # Keep the dashes on both vertical edges in phase on the device grid.
        scale = painter.deviceTransform().m11()
        pixels = round(width * scale)
        width = (pixels + pixels % 2) / scale
        box = QRectF(heading.x() - 2.5, heading.y() - 2.5, width, heading.height() + 1)
        painter.drawRect(box)

    def paint_highlight(self, painter):
        painter.setRenderHint(QPainter.Antialiasing)
        outline = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        fill = QLinearGradient(0, 1.5, 0, self.height() - 1.5)
        fill.setColorAt(0, QColor("#fcfeff"))
        fill.setColorAt(0.27, QColor.fromRgbF(249 / 255, 251.35 / 255, 1))
        fill.setColorAt(0.36, QColor.fromRgbF(246.83 / 255, 250.57 / 255, 1))
        fill.setColorAt(0.78, QColor.fromRgbF(239.65 / 255, 246.4 / 255, 1))
        fill.setColorAt(1, QColor.fromRgbF(236.4 / 255, 244.5 / 255, 1))
        painter.setPen(QColor("#b9d7fc"))
        painter.setBrush(fill)
        painter.drawRoundedRect(outline, 2.5, 1.6)
        bevel = QLinearGradient(0, 1.5, 0, self.height() - 1.5)
        bevel.setColorAt(0, QColor("#fdfeff"))
        bevel.setColorAt(1, QColor("#f3f8ff"))
        painter.setPen(QPen(bevel, 1))
        painter.setBrush(Qt.NoBrush)
        painter.drawRoundedRect(outline.adjusted(1, 1, -1, -1), 1.4, 1.4)
        painter.setRenderHint(QPainter.Antialiasing, False)


class AeroCategoryView(QWidget):
    def paintEvent(self, _event):
        painter = QPainter(self)
        # Continue the heading's tint and reach white above the first row of cards.
        tint = QLinearGradient(0, 0, 0, 4)
        tint.setColorAt(0, QColor("#fefeff"))
        tint.setColorAt(1, QColor("white"))
        painter.fillRect(self.rect(), tint)


class ClassicAppletDelegate(QStyledItemDelegate):
    """Draw SVG applet art on the native icon grid at fractional desktop scales."""

    def __init__(self, view, artwork, *, xp_classic=False):
        super().__init__(view)
        self.artwork = artwork
        self.xp_classic = xp_classic

    def paint(self, painter, option, index):
        art = self.artwork.get(index.data(Qt.UserRole).name)
        if not art or option.state & QStyle.State_Selected:
            super().paint(painter, option, index)
            return

        item = QStyleOptionViewItem(option)
        self.initStyleOption(item, index)
        style = item.widget.style() if item.widget else QApplication.style()
        icon = style.subElementRect(QStyle.SE_ItemViewItemDecoration, item, item.widget)
        item.icon = QIcon()
        style.drawControl(QStyle.CE_ItemViewItem, item, painter, item.widget)

        transform = painter.deviceTransform()
        device_bounds = transform.mapRect(QRectF(icon))
        # The guest keeps 16px and 32px icons when DPI changes its text and grid spacing.
        side = 16 if device_bounds.width() < 24 else 32
        centre = device_bounds.center()
        left = round(centre.x() - side / 2)
        if self.xp_classic and transform.m11() == 1.25:
            # XP Classic's 120-DPI icon grid is one device pixel to the left.
            left -= 1
        square = QRectF(left, round(centre.y() - side / 2), side, side)
        inverse, _ = transform.inverted()
        control_panel_picture(art).render(painter, inverse.mapRect(square))


class AeroAppletDelegate(QStyledItemDelegate):
    def initStyleOption(self, option, index):
        super().initStyleOption(option, index)
        if option.state & QStyle.State_MouseOver:
            option.font.setUnderline(True)


def aero_toolbutton(action, has_menu=False):
    button = QToolButton()
    button.setDefaultAction(action)
    button.setAutoRaise(True)
    button.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
    if has_menu:
        button.setPopupMode(QToolButton.MenuButtonPopup)
    return button


def aero_status_pane(*widgets):
    pane = QWidget()
    layout = QHBoxLayout(pane)
    layout.setContentsMargins(3, 0, 3, 0)
    for widget in widgets:
        layout.addWidget(widget)
    return pane


def aero_status_bar(panes):
    bar = QStatusBar()
    for pane, stretch in zip(panes, STATUS_PANE_STRETCHES, strict=True):
        bar.addWidget(pane, stretch)
    return bar


def window_chrome():
    """The Control Panel's window parts of the look's widget style: the classic ones, or Windows XP's."""
    if chicago95ui.widget_style() == "aero":
        return WindowChrome(
            aero_band,
            aero_toolbutton,
            aero_status_bar,
            aero_status_pane,
            QWidget,
            QApplication.style,
            QTabWidget,
            QProgressBar,
            AppearancePreview,
        )
    if not chicago95ui.luna_widgets():
        return CLASSIC_WINDOW_CHROME
    import chicago95luna
    import chicago95lunacontrolpanel

    header_band, toolbar_button, status_bar, status_pane, logo_box, progress_bar, preview = (
        chicago95lunacontrolpanel.CHROME_FIELDS
    )
    return WindowChrome(
        header_band,
        toolbar_button,
        status_bar,
        status_pane,
        logo_box,
        chicago95luna.LunaStyle,
        QTabWidget,
        progress_bar,
        preview,
    )


def scrolling(tab):
    """The tab in a frameless scroll area: a sheet keeps the standard size, and a tab too big for it scrolls."""
    area = QScrollArea()
    area.setFrameShape(QFrame.NoFrame)
    area.setWidgetResizable(True)
    area.viewport().setBackgroundRole(QPalette.Window)
    # Luna's tab page is the near-white XP page the style paints; the viewport stays clear so it shows through.
    area.viewport().setAutoFillBackground(not chicago95ui.luna_widgets())
    area.setWidget(tab)
    # setWidget() enables auto-fill on its child. Undo that for Luna so the
    # tab frame's gradient remains visible through the entire scrolling page.
    if chicago95ui.luna_widgets():
        tab.setAutoFillBackground(False)
        area.setAutoFillBackground(False)
        area.viewport().setAutoFillBackground(False)
    return area


def with_custom_look(changed):
    """A component changed on its own, without the Scheme choosing it, makes the look a custom one."""
    own_component = any(key in changed for key in COMPONENT_KEYS) and "LOOK" not in changed
    return {**changed, "LOOK": "custom"} if own_component else changed


class PropertiesPage(QWidget):
    """An applet's page in the Control Panel's window: property sheet tabs with OK, Cancel and Apply."""

    finished = Signal()

    def __init__(self, title, tabs, apply_changes):
        super().__init__()
        self.title = title
        self.apply_changes = apply_changes
        self.tabs = window_chrome().tab_control()
        self.settings_tabs = [tab for _name, tab in tabs]
        self.classic_display = title == "Display" and bool(tabs) and is_classic_display(self.settings_tabs[0].saved)
        self.luna_display = title == "Display" and chicago95ui.luna_widgets()
        aero_taskbar = title == "Taskbar" and chicago95ui.widget_style() == "aero"
        if self.luna_display:
            font = chicago95ui.ui_font()
            font.setFamilies(["Tahoma", "Liberation Sans", "Noto Sans"])
            font.setStyleStrategy(QFont.NoAntialias)
            self.setFont(font)
        elif aero_taskbar:
            font = chicago95ui.ui_font()
            font.setFamilies(["Segoe UI", "Selawik", "Noto Sans"])
            self.setFont(font)
        for name, tab in tabs:
            area = tab if title == "Themes" else scrolling(tab)
            if title == "Display":
                tab.ensurePolished()
                area.setMinimumSize(tab.minimumSizeHint().expandedTo(tab.minimumSize()))
            self.tabs.addTab(area, name)
            tab.changed.connect(self.refresh_apply_button)
            if self.luna_display and name == "Settings":
                def queue_slider_focus(_index, slider=tab.screen_area.slider):
                    def focus_slider():
                        if slider.isVisible():
                            slider.setFocus(Qt.TabFocusReason)

                    QTimer.singleShot(0, slider, focus_slider)

                self.tabs.currentChanged.connect(queue_slider_focus)
        self.baseline = self.collect_values()
        self.preview_timer = QTimer(self)
        self.preview_timer.setSingleShot(True)
        self.preview_timer.setInterval(150)
        self.preview_timer.timeout.connect(self.refresh_previews)
        self.refresh_previews()
        self.ok_button = chicago95ui.dialog_button("OK")
        if self.luna_display or aero_taskbar:
            self.ok_button.setDefault(True)
        self.cancel_button = chicago95ui.dialog_button("Cancel")
        self.apply_button = chicago95ui.dialog_button("&Apply", enabled=False)
        self.ok_button.clicked.connect(self.ok)
        self.cancel_button.clicked.connect(self.cancel)
        self.apply_button.clicked.connect(self.apply)
        buttons = QHBoxLayout()
        buttons.addStretch(1)
        for button in (self.ok_button, self.cancel_button, self.apply_button):
            if self.classic_display:
                button.setFixedSize(80, 22)
            elif self.luna_display:
                button.setFixedSize(79, 21)
            elif aero_taskbar:
                button.setFixedSize(73, 21)
            buttons.addWidget(button)
        layout = QVBoxLayout(self)
        margins = (6, 6, 6, 7) if self.classic_display or self.luna_display else SHEET_MARGINS
        if aero_taskbar:
            margins = (6, 6, 7, 9)
            buttons.setSpacing(8)
        layout.setContentsMargins(*margins)
        layout.addWidget(self.tabs, 1)
        layout.addLayout(buttons)

    def tab_names(self):
        return [self.tabs.tabText(index) for index in range(self.tabs.count())]

    def tab_index(self, name):
        return self.tab_names().index("Desktop" if self.luna_display and name == "Background" else name)

    def collect_values(self):
        return {key: value for tab in self.settings_tabs for key, value in tab.values().items()}

    def changed_values(self):
        changed = {key: value for key, value in self.collect_values().items() if self.baseline.get(key) != value}
        if self.title == "Themes":
            look = changed.get("LOOK")
            if look in LOOK_PRESETS:
                return self.collect_values()
            return changed
        return with_custom_look(with_look_values(changed, self.settings_tabs[0].saved))

    def refresh_apply_button(self):
        self.apply_button.setEnabled(bool(self.changed_values()))
        self.preview_timer.start()

    def refresh_previews(self):
        """Every preview sees the saved settings under this sheet's current values: a tab's screen can
        depend on another tab's choices (the loading screen on the log-on style, the banners on the branding)."""
        values = {**(self.settings_tabs[0].saved if self.settings_tabs else {}), **self.collect_values()}
        for tab in self.settings_tabs:
            for preview in tab.previews:
                preview.refresh(values)

    def apply(self):
        if not self.apply_changes(self.changed_values()):
            return False
        self.baseline = self.collect_values()
        self.refresh_apply_button()
        return True

    def take_applied(self, settings, applied):
        """Another page applied these keys: this one shows them too, except the ones it changed itself and has
        not applied yet; those and its other changes stay pending."""
        own = self.changed_values()
        shown = [key for key in applied if key in self.baseline and key not in own]
        for tab in self.settings_tabs:
            tab.saved = dict(settings)
            tab.load(settings, shown)
        self.baseline.update({key: settings[key] for key in shown})
        self.refresh_apply_button()

    def ok(self):
        if not self.changed_values() or self.apply():
            self.finished.emit()

    def discard_changes(self):
        for tab in self.settings_tabs:
            tab.load(self.baseline)
        self.refresh_apply_button()

    def cancel(self):
        self.discard_changes()
        self.finished.emit()


SHEET_SIZE = QSize(398, 424)  # Display Properties inside its 3px frame and title bar (the tech2u pictures: 404 by 448)
CLASSIC_DISPLAY_SIZE = QSize(422, 415)
LUNA_DISPLAY_SIZE = QSize(422, 414)
CLASSIC_DISPLAY_LOOKS = ("1995", "1998", "2000", "2001")


def is_classic_display(settings):
    return settings.get("LOOK") in CLASSIC_DISPLAY_LOOKS and chicago95ui.widget_style() == "classic"


class PropertySheetWindow(QDialog):
    """An applet in its own window, as Windows 98 opened Display Properties: a property sheet of fixed size whose
    title bar has only the ? and close buttons; closing it is Cancel."""

    def __init__(self, page, parent):
        super().__init__(
            parent,
            Qt.Dialog
            | Qt.CustomizeWindowHint
            | Qt.WindowTitleHint
            | Qt.WindowContextHelpButtonHint
            | Qt.WindowCloseButtonHint,
        )
        self.page = page
        self.setWindowTitle(f"{page.title} Properties")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(page)
        page.finished.connect(self.hide)
        if page.title == "Display":
            if isinstance(page.tabs, QTabWidget):
                page.tabs.setUsesScrollButtons(False)
                page.tabs.tabBar().setElideMode(Qt.ElideNone)
            self.ensurePolished()
            if page.classic_display:
                preferred = CLASSIC_DISPLAY_SIZE
            elif page.luna_display:
                preferred = LUNA_DISPLAY_SIZE
            else:
                preferred = SHEET_SIZE
            self.setFixedSize(preferred.expandedTo(self.minimumSizeHint()))
        elif page.title == "Taskbar" and chicago95ui.widget_style() == "aero":
            self.setWindowTitle("Taskbar and Start Menu Properties")
            page.tabs.tabBar().setStyleSheet(
                "QTabBar::tab { padding: 2px 6px; border: 1px solid #9197a2; color: #151515;"
                " background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #fafafa, stop:.49 #ededed,"
                " stop:.5 #e4e4e4, stop:1 #d4d4d4); margin-top: 2px; }"
                "QTabBar::tab:selected { margin-top: 0; padding-bottom: 4px; background: white;"
                " border-bottom-color: white; }"
                "QTabBar::tab:!selected:hover { background: #e4f2fc; }"
            )
            page.tabs.setTabText(0, "Taskbar")
            page.tabs.setTabText(2, "Toolbars")
            self.resize(SHEET_SIZE)
        else:
            self.setFixedSize(SHEET_SIZE)

    def reject(self):
        self.page.cancel()

    def closeEvent(self, event):
        self.page.discard_changes()
        super().closeEvent(event)


# ---- Mouse Properties (tests/references/win98mouse.png, tests/test_mouse_page.py): the Buttons tab's parts sit
# where the original's do, in page-frame coordinates; the tab's own origin is TAB_PAGE_FRAME pixels inside the frame.
TAB_PAGE_FRAME = 2
MOUSE_LAYOUT = {
    "configuration": QRect(15, 19, 355, 165),
    "speed": QRect(15, 198, 355, 138),
    "right-handed": (QPoint(25, 38), 16),  # the circle, and how far its caption's ink starts from it
    "left-handed": (QPoint(125, 38), 21),
    "left heading": QPoint(25, 71),
    "left lines": (QPoint(34, 87), QPoint(34, 100)),
    "right heading": QPoint(260, 71),
    "right lines": (QPoint(269, 87), QPoint(269, 100)),
    "picture": QRect(151, 79, 83, 80),
    "slider": QRect(63, 238, 137, 0),
    "slow": QPoint(25, 238),
    "fast": QPoint(215, 238),
    "test area label": QPoint(260, 220),
    "test area": QRect(259, 236, 80, 85),
}
# A QGroupBox's frame starts GROUP_TITLE_RISE rows below its widget's top and ends a row and a column short of it;
# a QLabel draws its ink a pixel right of the font's bearing.
GROUP_TITLE_RISE, GROUP_FRAME_SLACK, LABEL_INK_SHIFT, RADIO_RISE = 5, 1, 1, 1
DOUBLE_CLICK_RANGE = (100, 900)
POINTER_SPEED_STEPS = 10


def page_rect(rect):
    return rect.translated(-TAB_PAGE_FRAME, -TAB_PAGE_FRAME)


def control_panel_asset(name):
    checkout = REPO_DIR / "data/control-panel"
    return (checkout if checkout.is_dir() else CHICAGO95_DATA / "control-panel") / name


def control_panel_art(name):
    return control_panel_asset(name).read_bytes()


@functools.lru_cache(maxsize=32)
def control_panel_picture(name):
    return QSvgRenderer(control_panel_art(name))


class MousePicture(QWidget):
    """The mouse of Mouse Properties, its primary button marked: the left one, or the picture mirrored for
    the left-handed."""

    def __init__(self):
        super().__init__()
        self.left_handed = False

    def show_hand(self, left_handed):
        self.left_handed = left_handed
        self.update()

    def paintEvent(self, _event):
        svg = control_panel_picture("mouse-left.svg" if self.left_handed else "mouse-right.svg")
        svg.render(QPainter(self), QRectF(QPoint(0, 0), svg.defaultSize()))


class ClickTestArea(QFrame):
    """The double-click test area: two clicks within the chosen time open the box, two more close it."""

    def __init__(self):
        super().__init__()
        self.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        self.interval_ms = 500
        self.open = False
        self.last_click_at = None

    def clicked_at(self, milliseconds):
        if self.last_click_at is not None and milliseconds - self.last_click_at <= self.interval_ms:
            self.open = not self.open
            self.last_click_at = None
            self.update()
        else:
            self.last_click_at = milliseconds

    def mousePressEvent(self, _event):
        self.clicked_at(int(time.monotonic() * 1000))

    def mouseDoubleClickEvent(self, event):
        self.mousePressEvent(event)

    def paintEvent(self, event):
        super().paintEvent(event)
        svg = control_panel_picture("jack-open.svg" if self.open else "jack-closed.svg")
        # Both pictures share the right and bottom edges inside the native test area.
        inside = self.contentsRect()
        size = svg.defaultSize()
        x = inside.center().x() + 17 - size.width()
        y = inside.center().y() + 18 - size.height()
        svg.render(QPainter(self), QRectF(QPoint(x, y), size))


class MouseButtonsTab(SettingsTab):
    """Button configuration, with the mouse picture and what each button does, and the double-click speed."""

    def __init__(self, settings, actions):
        super().__init__(settings, actions)
        self.outer.setContentsMargins(0, 0, 0, 0)
        self.setMinimumSize(
            page_rect(MOUSE_LAYOUT["speed"]).bottomRight().x() + 20, page_rect(MOUSE_LAYOUT["speed"]).bottom() + 14
        )
        self.group_at("&Button configuration", MOUSE_LAYOUT["configuration"])
        self.group_at("&Double-click speed", MOUSE_LAYOUT["speed"])
        self.hands = QButtonGroup(self)
        for text, value, at in (("&Right-handed", "right", "right-handed"), ("&Left-handed", "left", "left-handed")):
            circle, caption_gap = MOUSE_LAYOUT[at]
            button = QRadioButton(text, self)
            button.setProperty("value", value)
            button.setProperty("captionGap", caption_gap)
            self.hands.addButton(button)
            button.move(page_rect(QRect(circle, QSize(1, 1))).topLeft() - QPoint(0, RADIO_RISE))
            button.adjustSize()
            button.resize(
                button.width() + caption_gap, max(button.height(), QFontMetrics(button.font()).height() + RADIO_RISE)
            )
        self.picture = MousePicture()
        self.picture.setParent(self)
        self.picture.setGeometry(page_rect(MOUSE_LAYOUT["picture"]))
        for heading, lines, texts in (
            ("left heading", "left lines", ("Left Button:", "- Normal Select", "- Normal Drag")),
            ("right heading", "right lines", ("Right Button:", "- Context Menu", "- Special Drag")),
        ):
            self.text_at(texts[0], MOUSE_LAYOUT[heading])
            for text, at in zip(texts[1:], MOUSE_LAYOUT[lines], strict=True):
                self.text_at(text, at)
        self.speed = QSlider(Qt.Horizontal, self)
        self.speed.setRange(*DOUBLE_CLICK_RANGE)
        self.speed.setSingleStep(100)
        self.speed.setPageStep(100)
        self.speed.setTickPosition(QSlider.TicksBelow)
        self.speed.setTickInterval(DOUBLE_CLICK_RANGE[1] - DOUBLE_CLICK_RANGE[0])  # a tick at each end, as the original
        self.speed.setInvertedAppearance(True)  # slow (a long time) on the left, fast on the right
        slider = page_rect(MOUSE_LAYOUT["slider"])
        self.speed.setGeometry(slider.left(), slider.top(), slider.width(), self.speed.sizeHint().height())
        self.text_at("Slow", MOUSE_LAYOUT["slow"])
        self.text_at("Fast", MOUSE_LAYOUT["fast"])
        self.test_area = ClickTestArea()
        self.test_area.setParent(self)
        self.text_at("Test area:", MOUSE_LAYOUT["test area label"])
        self.test_area.setGeometry(page_rect(MOUSE_LAYOUT["test area"]))
        self.hands.buttonToggled.connect(lambda button, on: self.hand_changed() if on else None)
        self.speed.valueChanged.connect(lambda value: setattr(self.test_area, "interval_ms", value))
        self.field(
            "MOUSE_HAND",
            lambda: self.hands.checkedButton().property("value"),
            self.select_hand,
            "right",
            self.hands.buttonToggled,
        )
        self.field(
            "DOUBLE_CLICK_MS",
            lambda: str(self.speed.value()),
            lambda value: self.speed.setValue(int(value)),
            "500",
            self.speed.valueChanged,
        )

    def field(self, key, getter, setter, default, signal):
        self.fields[key] = (getter, setter, default)
        setter(self.saved.get(key, default))
        signal.connect(lambda *_: self.notify())

    def select_hand(self, value):
        for button in self.hands.buttons():
            if button.property("value") == value:
                button.setChecked(True)

    def hand_changed(self):
        self.picture.show_hand(self.hands.checkedButton().property("value") == "left")

    def group_at(self, title, rect):
        box = QGroupBox(title, self)
        box.setGeometry(page_rect(rect).adjusted(0, -GROUP_TITLE_RISE, GROUP_FRAME_SLACK, GROUP_FRAME_SLACK))
        box.lower()

    def text_at(self, text, ink_at):
        """A label whose ink starts at ink_at (page-frame coordinates), whatever the font's bearings."""
        label = QLabel(text, self)
        label.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        metrics = QFontMetrics(label.font())
        ink = metrics.tightBoundingRect(text.replace("&", ""))
        label.move(
            page_rect(QRect(ink_at, QSize(1, 1))).topLeft()
            - QPoint(ink.left() + LABEL_INK_SHIFT, metrics.ascent() + ink.top())
        )
        label.adjustSize()
        return label


