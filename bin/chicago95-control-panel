ICON_SETS = [("Chicago95 (1995)", "chicago95"), ("SE98 (1998)", "se98"), ("ClassicOS 2000", "classicos2000")]
COLOR_FIELDS = (("TITLE_ACTIVE", "Active title bar:"), ("TITLE_INACTIVE", "Inactive title bar:"),
                ("BANNER_BG", "Start menu banner:"), ("BANNER_FG", "Banner text:"))


@tab_builder("Display", "Appearance")
def appearance_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    start = LOOK_PRESETS["1995"]
    tab.scheme = tab.choice("LOOK", "Scheme:", [("Windows 95", "1995"), ("Windows 98", "1998"), ("Windows 2000", "2000"), ("Custom", "custom")], default="1995")
    tab.color_edits = {key: tab.color(key, label, default=start[key], validator=valid_banner_colors if key == "BANNER_BG" else None) for key, label in COLOR_FIELDS}
    tab.icons = tab.choice("ICONS", "Icon set:", ICON_SETS, default=start["ICONS"])
    tab.preview = TitleBarPreview(start["TITLE_ACTIVE"], start["TITLE_INACTIVE"])
    tab.form.addRow("", tab.preview)
    state = {"applying": False}

    def settling():
        return tab.loading or state["applying"]

    def scheme_changed():
        preset = LOOK_PRESETS.get(tab.scheme.currentData())
        if settling() or preset is None:
            return
        state["applying"] = True
        for key, edit in tab.color_edits.items():
            edit.setText(preset[key])
        tab.icons.setCurrentIndex(tab.icons.findData(preset["ICONS"]))
        state["applying"] = False

    def refresh_preview():
        tab.preview.show_colors(tab.color_edits["TITLE_ACTIVE"].text(), tab.color_edits["TITLE_INACTIVE"].text())

    def colour_edited():
        refresh_preview()
        if settling():
            return
        state["applying"] = True
        tab.scheme.setCurrentIndex(tab.scheme.findData("custom"))
        state["applying"] = False

    tab.scheme.currentIndexChanged.connect(scheme_changed)
    for edit in tab.color_edits.values():
        edit.textChanged.connect(colour_edited)
    refresh_preview()
    return tab


