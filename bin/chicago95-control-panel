@tab_builder("Mouse", "Motion")
def mouse_motion_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    tab.group("Pointer speed")
    tab.pointer_speed = QSlider(Qt.Horizontal)
    tab.pointer_speed.setRange(-POINTER_SPEED_STEPS, POINTER_SPEED_STEPS)
    tab.pointer_speed.setTickPosition(QSlider.TicksBelow)
    tab.pointer_speed.setTickInterval(2)
    row = QHBoxLayout()
    row.addWidget(QLabel("Slow"))
    row.addWidget(tab.pointer_speed, 1)
    row.addWidget(QLabel("Fast"))
    tab.register(
        "POINTER_SPEED",
        "",
        row_widget(row),
        lambda: f"{tab.pointer_speed.value() / POINTER_SPEED_STEPS:.1f}",
        lambda value: tab.pointer_speed.setValue(round(float(value) * POINTER_SPEED_STEPS)),
        "0.0",
        tab.pointer_speed.valueChanged,
    )
    tab.group("Pointer trail")
    tab.trails = QCheckBox("Show pointer trails")
    tab.trails.setEnabled(False)  # Wayland draws no pointer trails
    tab.trails.setToolTip("Plasma on Wayland does not draw pointer trails.")
    trail = QSlider(Qt.Horizontal)
    trail.setEnabled(False)
    trail_row = QHBoxLayout()
    trail_row.addWidget(QLabel("Short"))
    trail_row.addWidget(trail, 1)
    trail_row.addWidget(QLabel("Long"))
    tab.form.addRow(tab.trails)
    tab.form.addRow(row_widget(trail_row))
    return tab


def row_widget(layout):
    widget = QWidget()
    layout.setContentsMargins(0, 0, 0, 0)
    widget.setLayout(layout)
    return widget


def preset_panel_height(style):
    if chicago95ui.screen_scale() == 1.25 and style in ("classic", "luna"):
        return 27 if style == "luna" else 26
    return {"classic": 28, "luna": 30, "aero": 40}[style]


def taskbar_style_and_size_fields(tab, settings):
    style = taskbar_style_field(tab, settings)
    form = tab.form
    height = tab.number(
        "PANEL", "Taskbar height:", 22, 64, default=preset_panel_height(style.currentData()), suffix=" pixels"
    )
    width = ButtonWidthField(settings.get("LOOK", "1995"))
    tab.register("TASK_BUTTON_WIDTH", "Taskbar button width:", width, width.value, width.set_value, "0", width.changed)
    tab.previews.append(width)
    tab.choice(
        "QUICK_LAUNCH",
        "Quick Launch:",
        [("From the look (1998 on)", "auto"), ("Always", "yes"), ("Never", "no")],
        default="auto",
    )

    def update_sizes():
        visible = style.currentData() != "aero"
        form.setRowVisible(height.parentWidget(), visible)
        form.setRowVisible(width, visible)

    style.currentIndexChanged.connect(update_sizes)
    update_sizes()


def taskbar_style_field(tab, settings):
    taskbar_style = tab.choice(
        "TASKBAR_STYLE",
        "Taskbar style:",
        TASKBAR_STYLES,
        default=LOOK_PRESETS.get(settings.get("LOOK"), LOOK_PRESETS["1995"])["TASKBAR_STYLE"],
    )
    taskbar_style.setToolTip(TASKBAR_STYLE_HELP)
    taskbar_style.setWhatsThis(TASKBAR_STYLE_HELP)
    return taskbar_style


@tab_builder("Taskbar", "Taskbar Options")
def taskbar_options_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    aero = chicago95ui.widget_style() == "aero"
    tab.group("Taskbar appearance" if aero else "Taskbar")
    if aero:
        tab.flag("TASKBAR_AUTOHIDE", "Auto-hide the taskbar", default="no")
        tab.flag("TASKBAR_ON_TOP", "Keep the taskbar on top of other windows", default="yes")
    else:
        taskbar_style_and_size_fields(tab, settings)
    tab.choice(
        "TASK_GROUPING",
        "Taskbar buttons:",
        [
            ("Use the taskbar style default" if aero else "From the taskbar style (Windows 7 combines)", "auto"),
            ("Always combine, hide labels", "always"),
            ("Combine when taskbar is full", "full"),
            ("Never combine", "never"),
        ],
        default="auto",
    )
    if aero:
        tab.group("Notification area")
        tab.flag("CLOCK_SHOW", "Show clock", default="yes")
        add_clock_format(tab)
        tab.group("Window previews")
    else:
        tab.flag("TASKBAR_AUTOHIDE", "Auto hide", default="no")
        tab.flag("TASKBAR_ON_TOP", "Always on top", default="yes")
    tab.choice(
        "PREVIEW_SIZE",
        "Window previews:",
        [("Off", "off"), ("Small (160 pixels)", "160"), ("Medium (240 pixels)", "240"), ("Large (320 pixels)", "320")],
        default="off",
    )
    if not aero:
        tab.group("Clock")
        tab.flag("CLOCK_SHOW", "Show clock", default="yes")
        add_clock_format(tab)
    return tab


