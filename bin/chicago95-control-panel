def page_location(applet_name, tab_index):
    """The first tab is the applet's page itself; the others add their name, as in the address bar."""
    tab_name = PAGE_TABS[applet_name][tab_index]
    return HOME_PAGE + (applet_name,) + ((tab_name,) if tab_index > 0 else ())


