@tab_builder("Mouse", "Motion")
def mouse_motion_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    tab.group("Pointer speed")
    tab.pointer_speed = QSlider(Qt.Horizontal)
    tab.pointer_speed.setRange(-POINTER_SPEED_STEPS, POINTER_SPEED_STEPS)
    tab.pointer_speed.setTickPosition(QSlider.TicksBelow)
    tab.pointer_speed.setTickInterval(2)
    row = QHBoxLayout()
    row.addWidget(QLabel("Slow"))
    row.addWidget(tab.pointer_speed, 1)
    row.addWidget(QLabel("Fast"))
    tab.register(
        "POINTER_SPEED",
        "",
        row_widget(row),
        lambda: f"{tab.pointer_speed.value() / POINTER_SPEED_STEPS:.1f}",
        lambda value: tab.pointer_speed.setValue(round(float(value) * POINTER_SPEED_STEPS)),
        "0.0",
        tab.pointer_speed.valueChanged,
    )
    tab.group("Pointer trail")
    tab.trails = QCheckBox("Show pointer trails")
    tab.trails.setEnabled(False)  # Wayland draws no pointer trails
    tab.trails.setToolTip("Plasma on Wayland does not draw pointer trails.")
    trail = QSlider(Qt.Horizontal)
    trail.setEnabled(False)
    trail_row = QHBoxLayout()
    trail_row.addWidget(QLabel("Short"))
    trail_row.addWidget(trail, 1)
    trail_row.addWidget(QLabel("Long"))
    tab.form.addRow(tab.trails)
    tab.form.addRow(row_widget(trail_row))
    return tab


def row_widget(layout):
    widget = QWidget()
    layout.setContentsMargins(0, 0, 0, 0)
    widget.setLayout(layout)
    return widget


