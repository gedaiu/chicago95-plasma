def resolved_look(look, settings):
    preset = LOOK_PRESETS.get(look, LOOK_PRESETS["1995"])
    image, splash = preset["BACKGROUND_IMAGE"], preset["SPLASH_IMAGE"]
    installed = CHICAGO95_DATA / "wallpapers" / Path(image).name
    wallpaper = installed if installed.is_file() else repo_of(settings) / image
    return {
        **preset,
        "BACKGROUND_IMAGE": str(wallpaper) if "/" in image else image,
        "SPLASH_IMAGE": str(splash_of(settings) / "images" / Path(splash).name) if "/" in splash else splash,
    }


def preset_wallpaper(look, settings):
    resolved = resolved_look(look, settings)
    return {key: resolved[key] for key in ("BACKGROUND_MODE", "BACKGROUND_IMAGE", "BACKGROUND_FILL")}


def desktop_theme(look, settings):
    return {**resolved_look(look, settings), "PANEL": str(preset_panel_height(LOOK_PRESETS[look]["TASKBAR_STYLE"]))}


class DesktopThemePreview(QWidget):
    def __init__(self, selector, settings):
        super().__init__()
        self.selector = selector
        self.images = {}
        source = repo_of(settings) / "data/control-panel/theme-previews"
        installed = CHICAGO95_DATA / "control-panel/theme-previews"
        selector.setIconSize(QSize(32, 24))
        selector.view().setItemDelegate(QStyledItemDelegate(selector.view()))
        for look in LOOK_PRESETS:
            path = source / f"{look}.jpg"
            image = QPixmap(str(path if path.is_file() else installed / path.name))
            self.images[look] = image
            selector.setItemIcon(selector.findData(look), QIcon(image))
        self.setMinimumSize(160, 120)
        selector.highlighted.connect(self.show_index)
        selector.currentIndexChanged.connect(self.show_index)
        selector.view().installEventFilter(self)
        self.show_index(selector.currentIndex())

    def show_index(self, index):
        self.look = self.selector.itemData(index)
        self.setAccessibleName(f"{self.selector.itemText(index)} desktop preview")
        self.update()

    def eventFilter(self, watched, event):
        if event.type() == QEvent.Hide:
            self.show_index(self.selector.currentIndex())
        return super().eventFilter(watched, event)

    def paintEvent(self, _event):
        painter = QPainter(self)
        image = self.images.get(self.look)
        if image is None or image.isNull():
            painter.drawText(self.rect(), Qt.AlignCenter, "No preset preview")
            return
        size = image.size().scaled(self.size(), Qt.KeepAspectRatio)
        target = QRect(QPoint(), size)
        target.moveCenter(self.rect().center())
        scaled = image.scaled(size * self.devicePixelRatioF(), Qt.KeepAspectRatio, Qt.SmoothTransformation)
        painter.drawPixmap(target, scaled, scaled.rect())


class LunaDisplayThemePreview(DesktopThemePreview):
    def __init__(self, selector, settings):
        super().__init__(selector, settings)
        import chicago95lunacontrolpanel

        self.wallpaper = QPixmap(resolved_look("luna", settings)["BACKGROUND_IMAGE"])
        self.sample = chicago95lunacontrolpanel.LunaAppearancePreview(property_sheet=True)

    def paintEvent(self, event):
        if self.look != "luna" or self.wallpaper.isNull():
            super().paintEvent(event)
            return
        from chicago95lunacontrolpanel import PALETTE

        painter = QPainter(self)
        painter.setRenderHint(QPainter.SmoothPixmapTransform)
        painter.setRenderHint(QPainter.Antialiasing)
        frame = self.rect().adjusted(2, 0, -2, 0)
        bounds = frame.adjusted(1, 1, -1, -1)
        painter.drawPixmap(bounds, self.wallpaper, self.wallpaper.rect())
        painter.setPen(QColor("#aca896"))
        painter.drawRect(frame.adjusted(0, 0, -1, -1))

        window = QRect(26, 26, round(bounds.width() * .71), round(bounds.height() * .65))
        self.sample.window(painter, window, "Active Window", PALETTE["title_active"], 3, True)
        self.sample.sheet_window_text(painter, window)
        themed_icon(("user-trash",)).paint(painter, QRect(bounds.right() - 41, bounds.bottom() - 32, 24, 24))


@tab_builder("Themes", "Desktop Theme")
def themes_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    theme = tab.choice("LOOK", "Desktop theme:", [*START_MENU_STYLES, ("Custom", "custom")], "1995")
    theme.model().item(theme.findData("custom")).setEnabled(False)
    label = QLabel(
        "Applies window frames, controls, desktop colours, icons, taskbar, Start menu, "
        "sign-in and boot screens, and sounds."
    )
    label.setWordWrap(True)
    tab.form.addRow(label)
    panel_style = tab.choice(
        "CONTROL_PANEL_STYLE", "Control Panel style:", [("Follow desktop theme", "auto"), *COMPONENT_STYLES], "auto"
    )
    tab.outer.takeAt(tab.outer.count() - 1)  # give the preview the space below the two selectors
    tab.outer.addWidget(DesktopThemePreview(theme, settings), 1)
    saved_look = settings.get("LOOK")
    defaults = desktop_theme(saved_look if saved_look in LOOK_PRESETS else "1995", settings)
    values = {}
    for key, default in defaults.items():
        if key != "CONTROL_PANEL_STYLE":
            tab.track(key, lambda key=key: values[key], lambda value, key=key: values.update({key: value}), default)

    def select_theme():
        look = theme.currentData()
        if tab.loading or look not in LOOK_PRESETS:
            return
        values.update(desktop_theme(look, settings))
        panel_style.setCurrentIndex(panel_style.findData("auto"))
        tab.notify()

    theme.currentIndexChanged.connect(select_theme)
    theme.activated.connect(select_theme)
    return tab


@tab_builder("Sounds", "Sounds")
def sounds_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    themes = [(name, theme_id) for theme_id, name in installed_sound_themes(actions.sound_roots)]
    if not themes:
        themes.append(("Chicago95", "Chicago95"))
    for label, scheme_id in (("Windows XP", "WindowsXP"), ("Windows 7", "Windows7")):
        if not any(theme_id == scheme_id for _, theme_id in themes):
            themes.append((label, scheme_id))
    scheme = tab.choice("SOUND_THEME", "Scheme:", themes, default="Chicago95")
    events = QListWidget()
    for event, label in SOUND_EVENTS:
        events.addItem(label)
        events.item(events.count() - 1).setData(Qt.UserRole, event)
    player = actions.program_installed("pw-play") or actions.program_installed("paplay")
    play = chicago95ui.dialog_button("Play", enabled=bool(player))

    def play_selected():
        item = events.currentItem()
        if item is None:
            return
        sound = chicago95ui.sound_file(scheme.currentData(), item.data(Qt.UserRole), actions.sound_roots)
        if sound:
            actions.start_process(player, [sound])

    play.clicked.connect(play_selected)
    tab.form.addRow("Events:", events)
    tab.form.addRow("", play)
    return tab


# The desktop icons the Effects tab offers; "auto" is the look's own (setup/steps.sh desktop_icon_defaults).
DESKTOP_ICON_CHOICES = [
    ("The look's own", "auto"),
    ("None", ""),
    ("My Computer, Network Neighborhood, Recycle Bin", "computer,network,recycle"),
    ("Those and My Documents", "computer,documents,network,recycle"),
]


EFFECTS_COLUMNS = 2  # the lists in two columns, each under its caption, so the tab fits Display Properties
EFFECTS_LIST_LETTERS = 9


@tab_builder("Display", "Effects")
def effects_tab(settings, actions):
    """Every animation by event (setup/animations.conf): KDE's effects, ours and the installed ones of each
    event's kind; a list shows what runs now until a choice is saved."""
    tab = SettingsTab(settings, actions)
    table = chicago95animations.read_animations(chicago95animations.table_path())
    installed = actions.installed_effects()
    live = actions.live_animations()
    tab.combos, tab.settings_buttons = {}, {}
    luna_display = chicago95ui.luna_widgets()
    icons = tab.choice("DESKTOP_ICONS", "Desktop icons:", DESKTOP_ICON_CHOICES, default="auto")
    icons.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)
    icons.setMinimumContentsLength(12)
    compact = luna_display or is_classic_display(settings)
    if compact:
        tab.outer.setContentsMargins(10, 6, 10, 6)
        tab.outer.setSpacing(3)
    tab.classic_button = chicago95ui.dialog_button("&Classic")
    if luna_display:
        icons.setFixedHeight(20)
        tab.classic_button.setFixedHeight(20)
    tab.classic_button.clicked.connect(
        lambda: (
            tab.load(
                {
                    **tab.values(),
                    "DESKTOP_ICONS": "auto",
                    **table.classic.get(settings.get("LOOK", "1998"), {}),
                }
            )
            or tab.notify()
        )
    )
    for group in dict.fromkeys(event.group for event in table.events):
        box = QGroupBox(group)
        grid = QGridLayout(box)
        grid.setVerticalSpacing(2)
        if compact:
            grid.setContentsMargins(6, 2, 6, 2)
        events = [event for event in table.events if event.group == group]
        for index, event in enumerate(events):
            current = chicago95animations.current_choice(table, event.key, installed, live)
            field = animation_field(tab, table, installed, event, current, compact_luna=luna_display)
            grid.addWidget(field, index // EFFECTS_COLUMNS, index % EFFECTS_COLUMNS)
        if group == table.events[-1].group:
            grid.addWidget(tab.classic_button, len(events) // EFFECTS_COLUMNS, 1, Qt.AlignRight | Qt.AlignBottom)
        tab.outer.insertWidget(tab.outer.count() - 1, box)
    return tab


def luna_display_tabs(settings, actions):
    """The XP Display sheet places Themes first and opens Effects from Appearance."""
    appearance = appearance_tab(settings, actions, luna_sheet=True)
    themes = SettingsTab(settings, actions)
    selector = chicago95ui.classic_combo(QComboBox())
    for index in range(appearance.scheme.count()):
        selector.addItem(appearance.scheme.itemText(index), appearance.scheme.itemData(index))
    selector.setCurrentIndex(appearance.scheme.currentIndex())
    selector.currentIndexChanged.connect(appearance.scheme.setCurrentIndex)
    appearance.scheme.currentIndexChanged.connect(selector.setCurrentIndex)
    themes.selector = selector
    themes.outer.setContentsMargins(13, 6, 14, 16)
    help_text = QLabel(
        "A theme is a background plus a set of sounds, icons, and other elements to help you personalize "
        "your computer with one click."
    )
    help_text.setWordWrap(True)
    help_text.setAlignment(Qt.AlignLeft | Qt.AlignTop)
    help_text.setMinimumHeight(33)
    themes.form.addRow(help_text)
    selector_row = QHBoxLayout()
    selector_row.addWidget(selector, 1)
    for text in ("Save As...", "Delete"):
        button = chicago95ui.dialog_button(text, enabled=False)
        button.setFixedSize(78, 20)
        selector_row.addWidget(button)
    themes.form.addRow(buddy_label("&Theme:", selector))
    themes.form.addRow(selector_row)
    themes.outer.takeAt(themes.outer.count() - 1)
    themes.outer.addWidget(QLabel("Sample:"))
    themes.theme_preview = LunaDisplayThemePreview(selector, settings)
    selector.setIconSize(QSize(0, 0))
    for index in range(selector.count()):
        selector.setItemIcon(index, QIcon())
    themes.outer.addWidget(themes.theme_preview, 1)

    effects = effects_tab(settings, actions)
    appearance.fields.update(effects.fields)

    dialog = QDialog(appearance)
    dialog.setWindowTitle("Effects")
    layout = QVBoxLayout(dialog)
    layout.addWidget(effects)
    buttons = QHBoxLayout()
    buttons.addStretch(1)
    accept = chicago95ui.dialog_button("OK")
    cancel = chicago95ui.dialog_button("Cancel")
    accept.clicked.connect(dialog.accept)
    cancel.clicked.connect(dialog.reject)
    buttons.addWidget(accept)
    buttons.addWidget(cancel)
    layout.addLayout(buttons)

    def edit_effects():
        before = effects.values()
        if dialog.exec() == QDialog.Accepted:
            appearance.notify()
        else:
            effects.load(before)

    appearance.effects_button.clicked.connect(edit_effects)
    return [
        ("Themes", themes),
        ("Desktop", background_tab(settings, actions, colour_field=appearance.color_edits["BACKGROUND_COLOR"])),
        ("Screen Saver", screen_saver_tab(settings, actions)),
        ("Appearance", appearance),
        ("Settings", display_settings_tab(settings, actions)),
    ]


def animation_field(tab, table, installed, event, current, *, compact_luna=False):
    """One event's control under its caption: the speed slider, the wobbly check box, or a list with a button
    that opens the chosen effect's KDE settings."""
    options = chicago95animations.event_choices(table, event.key, installed)
    cell = QWidget()
    column = QVBoxLayout(cell)
    column.setContentsMargins(0, 0, 0, 0)
    column.setSpacing(1)
    if [value for _label, value in options] == ["no", "yes"]:
        box = QCheckBox(event.label)
        tab.track(
            event.key,
            lambda: "yes" if box.isChecked() else "no",
            lambda value: box.setChecked(value == "yes"),
            current,
            box.toggled,
        )
        column.addWidget(box)
        return cell
    column.addWidget(QLabel(event.label))
    if event.key == chicago95animations.SPEED_KEY:
        tab.speed_slider = ChoiceSlider(options)
        tab.track(event.key, tab.speed_slider.value, tab.speed_slider.set_value, current, tab.speed_slider.changed)
        column.addWidget(tab.speed_slider)
        return cell
    combo = chicago95ui.classic_combo(QComboBox())
    combo.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)  # long names show when it opens
    combo.setMinimumContentsLength(EFFECTS_LIST_LETTERS)
    for label, value in options:
        combo.addItem(label, value)
    button = QPushButton("...")
    height = 20 if compact_luna else combo.sizeHint().height()
    if compact_luna:
        combo.setFixedHeight(height)
    button.setFixedSize(20, height)
    button.setToolTip("Settings for this effect")
    row = QHBoxLayout()
    row.setSpacing(2)
    row.addWidget(combo, 1)
    row.addWidget(button)
    column.addLayout(row)
    tab.track(
        event.key,
        combo.currentData,
        lambda value: combo.setCurrentIndex(max(combo.findData(value), 0)),
        current,
        combo.currentIndexChanged,
    )
    tab.combos[event.key], tab.settings_buttons[event.key] = combo, button

    def settings_command():
        effects = chicago95animations.choice_effects(table, event.key, combo.currentData())
        pages = [
            installed[effect].settings for effect in map(chicago95animations.effect_id, effects) if effect in installed
        ]
        return next((page for page in pages if page), None)

    def show_state():
        button.setEnabled(settings_command() is not None)

    button.clicked.connect(lambda: tab.actions.start_process(settings_command()[0], list(settings_command()[1:])))
    combo.currentIndexChanged.connect(show_state)
    show_state()
    return cell


@tab_builder("Display", "Background")
def background_tab(settings, actions, *, colour_field=None):
    """Windows 98's Background tab (the tech2u Display Properties picture): the monitor showing the desktop, the
    Wallpaper list with (None) first, Browse..., Pattern... and Display. The desktop colour is Appearance's."""
    tab = SettingsTab(settings, actions)
    luna = chicago95ui.luna_widgets()
    if luna:
        tab.outer.setContentsMargins(14, 31, 14, 8)
        tab.outer.insertSpacing(0, 16)
        tab.form.setVerticalSpacing(4)
    patterns = background_patterns(settings)
    tab.monitor = MonitorPreview(desktop_colour(settings), luna=luna)
    tab.outer.insertWidget(0, tab.monitor, 0, Qt.AlignHCenter)
    if not luna:
        tab.group("Wallpaper")
    tab.wallpapers = QListWidget()
    tab.wallpapers.addItem(QListWidgetItem(QIcon.fromTheme("dialog-cancel"), "(None)"))
    for label, path in actions.wallpapers():
        add_wallpaper(tab.wallpapers, label, path)
    browse = chicago95ui.dialog_button("&Browse...")
    tab.pattern_button = chicago95ui.dialog_button("&Pattern...")
    tab.display = chicago95ui.classic_combo(QComboBox())
    for label, value in (("Center", "center"), ("Tile", "tile"), ("Stretch", "stretch"), ("Cover", "cover")):
        tab.display.addItem(label, value)
    side = QVBoxLayout()
    side.addWidget(browse)
    if luna:
        tab.wallpapers.setIconSize(QSize(16, 16))
        tab.wallpapers.setFixedHeight(112)
        browse.setFixedSize(78, 21)
        tab.pattern_button.setFixedHeight(21)
        tab.display.setFixedSize(79, 20)
        side.addSpacing(7)
        side.addWidget(buddy_label("&Position:", tab.display))
        side.addWidget(tab.display)
        if colour_field is not None:
            tab.colour_button = QPushButton()
            tab.colour_button.setIconSize(QSize(63, 13))
            tab.colour_button.setFixedSize(78, 20)
            tab.colour_button.clicked.connect(lambda: colour_field.pick(0))
            side.addWidget(buddy_label("Co&lor:", tab.colour_button))
            side.addWidget(tab.colour_button)
        side.addStretch(1)
    else:
        side.addWidget(tab.pattern_button)
        side.addStretch(1)
        side.addWidget(buddy_label("&Display:", tab.display))
        side.addWidget(tab.display)
    row = QHBoxLayout()
    row.addWidget(tab.wallpapers, 1)
    row.addLayout(side)
    tab.form.addRow(buddy_label("&Background:" if luna else "&Select a picture:", tab.wallpapers))
    tab.form.addRow(row)
    if luna:
        tab.form.addRow(tab.pattern_button)
    pattern = {"name": "none"}

    def wallpaper():
        item = tab.wallpapers.currentItem()
        return item.data(Qt.UserRole) or "" if item is not None else ""

    def show_wallpaper(path):
        rows = [tab.wallpapers.item(row).data(Qt.UserRole) for row in range(tab.wallpapers.count())]
        if path and path not in rows:
            add_wallpaper(tab.wallpapers, Path(path).stem, path)
            rows.append(path)
        tab.wallpapers.setCurrentRow(rows.index(path) if path in rows else 0)

    def set_pattern(name):
        pattern["name"] = name if name in patterns else "none"
        refresh()

    def mode():
        return "image" if wallpaper() else ("pattern" if pattern["name"] != "none" else "color")

    def refresh():
        tab.display.setEnabled(bool(wallpaper()))
        tab.pattern_button.setEnabled(not wallpaper())
        colour = colour_field.value() if colour_field is not None else desktop_colour(settings)
        if colour_field is not None:
            tab.colour_button.setIcon(swatch_icon(colour, (63, 13)))
            tab.colour_button.setToolTip(colour)
        tab.monitor.show_desktop(colour, patterns.get(pattern["name"]), wallpaper(), tab.display.currentData())

    def choose_pattern():
        chosen = actions.choose_pattern(tab, pattern["name"], patterns)
        if chosen is not None:
            set_pattern(chosen)
            tab.notify()

    def browse_picture():
        chosen = actions.choose_file(tab, "Browse", "Pictures (*.png *.jpg *.jpeg *.bmp *.gif *.svg *.webp)")
        if chosen:
            show_wallpaper(chosen)

    defaults = (
        preset_wallpaper(settings.get("LOOK"), settings)
        if not (settings.get("BACKGROUND_MODE") or settings.get("BACKGROUND_COLOR"))
        else preset_wallpaper(None, settings)
    )
    tab.track("BACKGROUND_MODE", mode, lambda _value: None, defaults["BACKGROUND_MODE"])
    tab.track("BACKGROUND_PATTERN", lambda: pattern["name"], set_pattern, "none")
    tab.track(
        "BACKGROUND_IMAGE", wallpaper, show_wallpaper, defaults["BACKGROUND_IMAGE"], tab.wallpapers.currentRowChanged
    )
    tab.track(
        "BACKGROUND_FILL",
        tab.display.currentData,
        lambda value: tab.display.setCurrentIndex(max(tab.display.findData(value), 0)),
        defaults["BACKGROUND_FILL"],
        tab.display.currentIndexChanged,
    )
    tab.wallpapers.currentRowChanged.connect(refresh)
    tab.display.currentIndexChanged.connect(refresh)
    tab.pattern_button.clicked.connect(choose_pattern)
    browse.clicked.connect(browse_picture)
    if colour_field is not None:
        colour_field.changed.connect(refresh)
    refresh()
    return tab


def buddy_label(text, widget):
    """A caption whose underlined letter takes the focus to its control, as the originals' captions do."""
    label = QLabel(text)
    label.setBuddy(widget)
    return label


def add_wallpaper(wallpapers, label, path):
    item = QListWidgetItem(QIcon.fromTheme("image-x-generic"), label)
    item.setData(Qt.UserRole, path)
    wallpapers.addItem(item)


class ResolutionSlider(QSlider):
    dismissed = Signal()

    def paintEvent(self, event):
        option = QStyleOptionSlider()
        self.initStyleOption(option)
        option.sliderPosition = self.minimum()
        low = self.style().subControlRect(QStyle.CC_Slider, option, QStyle.SC_SliderHandle, self)
        option.sliderPosition = self.maximum()
        high = self.style().subControlRect(QStyle.CC_Slider, option, QStyle.SC_SliderHandle, self)
        y1, y2 = high.center().y(), low.center().y()
        with QPainter(self) as painter:
            painter.setPen(QColor("#d5dfe5"))
            span = self.maximum() - self.minimum()
            for position in range(span + 1):
                y = y1 + round((y2 - y1) * position / max(1, span))
                painter.drawLine(11, y, 28, y)
            control_panel_picture("aero-resolution-track.svg").render(painter, QRectF(7, y1, 18, y2 - y1 + 1))
        super().paintEvent(event)

    def keyPressEvent(self, event):
        if event.key() in (Qt.Key_Escape, Qt.Key_Return, Qt.Key_Enter, Qt.Key_Tab, Qt.Key_Backtab) or (
            event.key() in (Qt.Key_Up, Qt.Key_Down) and event.modifiers() & Qt.AltModifier
        ):
            self.dismissed.emit()
            event.accept()
            return
        super().keyPressEvent(event)


class ResolutionPicker(QComboBox):
    """The Windows 7 resolution field uses a vertical scale in its dropdown."""

    ROW_HEIGHT = 19
    POPUP_WIDTH = 202

    def __init__(self):
        super().__init__()
        self.popup = None
        self.currentIndexChanged.connect(self.sync_slider)

    def showPopup(self):
        if self.count() == 0 or self.popup is not None:
            return
        popup = QFrame(self, Qt.Popup | Qt.FramelessWindowHint)
        popup.setAttribute(Qt.WA_DeleteOnClose)
        popup.destroyed.connect(self.popup_destroyed)
        popup.setFont(chicago95ui.ui_font(11))
        popup.setObjectName("resolutionFlyout")
        popup.setStyleSheet(
            "#resolutionFlyout { background: white; border: 1px solid #646464; }"
            "QToolButton { background: transparent; border: 0; color: #111; padding: 0; }"
            "QLabel { color: #646464; }"
        )
        self.popup = popup

        scale = QWidget()
        layout = QVBoxLayout(scale)
        layout.setContentsMargins(12, 8, 9, 8)
        layout.setSpacing(0)
        high = QLabel("High")
        high.setIndent(8)
        high.setFixedHeight(20)
        layout.addWidget(high)

        row = QHBoxLayout()
        row.setSpacing(3)
        track = QFrame()
        track.setObjectName("resolutionTrack")
        track.setStyleSheet("#resolutionTrack { border: 1px dotted #606060; }")
        track.setFixedSize(31, self.count() * self.ROW_HEIGHT + 7)
        track_layout = QHBoxLayout(track)
        track_layout.setContentsMargins(0, 0, 0, 0)
        self.slider = ResolutionSlider(Qt.Vertical, track)
        self.slider.setAccessibleName("Resolution")
        self.slider.setRange(0, self.count() - 1)
        self.slider.setPageStep(1)
        self.slider.setFixedSize(28, (self.count() - 1) * self.ROW_HEIGHT + 10)
        thumb = control_panel_asset("aero-resolution-thumb.svg")
        self.slider.setStyleSheet(
            "QSlider::groove:vertical { width: 18px; margin: 0 4px 0 0; background: transparent; }"
            "QSlider::handle:vertical { height: 11px; margin: 0 0 0 -2px; "
            f'border-image: url("{thumb}"); }}'
        )
        self.slider.dismissed.connect(self.hidePopup)
        self.slider.valueChanged.connect(self.select_position)
        track_layout.addWidget(self.slider, 0, Qt.AlignVCenter)
        row.addWidget(track)

        modes = QVBoxLayout()
        modes.setContentsMargins(0, 3, 0, 3)
        modes.setSpacing(0)
        for index in range(self.count()):
            label = QToolButton()
            label.setText(self.itemText(index))
            label.setFocusPolicy(Qt.NoFocus)
            label.setFixedHeight(self.ROW_HEIGHT)
            label.clicked.connect(lambda _checked=False, i=index: self.setCurrentIndex(i))
            modes.addWidget(label, 0, Qt.AlignLeft)
        row.addLayout(modes, 1)
        layout.addLayout(row)
        low = QLabel("Low")
        low.setIndent(8)
        low.setFixedHeight(20)
        layout.addWidget(low)

        desktop = self.screen().geometry()
        size = QSize(self.POPUP_WIDTH, scale.sizeHint().height())
        popup_layout = QVBoxLayout(popup)
        popup_layout.setContentsMargins(0, 0, 0, 0)
        if size.height() > desktop.height():
            scroller = QScrollArea()
            scroller.setFrameShape(QFrame.NoFrame)
            scroller.setWidget(scale)
            scroller.setWidgetResizable(True)
            popup_layout.addWidget(scroller)
            size.setHeight(desktop.height())
        else:
            popup_layout.addWidget(scale)
        popup.resize(size)
        origin = self.mapToGlobal(QPoint(0, 7))
        popup.move(
            max(desktop.left(), min(origin.x(), desktop.right() - size.width() + 1)),
            max(desktop.top(), min(origin.y(), desktop.bottom() - size.height() + 1)),
        )
        self.sync_slider()
        popup.show()
        self.slider.setFocus(Qt.PopupFocusReason)

    def popup_destroyed(self):
        self.popup = None

    def hidePopup(self):
        if self.popup is not None:
            self.popup.close()
        super().hidePopup()

    def select_position(self, value):
        self.setCurrentIndex(self.count() - 1 - value)

    def sync_slider(self):
        if self.popup is not None:
            self.slider.setValue(self.count() - 1 - self.currentIndex())


class ScreenResolutionPage(QWidget):
    finished = Signal()

    def __init__(self, actions, change_screen_area):
        super().__init__()
        self.actions = actions
        self.change_screen_area = change_screen_area
        self.current_resolution = ""
        self.setFont(chicago95ui.ui_font(11))
        self.setObjectName("screenResolution")
        self.setStyleSheet(
            "#screenResolution { background: white; }"
            "#resolutionHeading { color: #003399; font-size: 16px; }"
            "QPushButton[link=true] { background: transparent; border: 0; padding: 0;"
            " color: #0066cc; text-align: left; }"
            "QPushButton[link=true]:hover { text-decoration: underline; }"
            "QPushButton[link=true]:focus { border: 1px dotted #0066cc; }"
        )
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 20, 0, 0)
        layout.setSpacing(0)
        form = QWidget()
        form.setMaximumWidth(565)
        fields = QVBoxLayout(form)
        fields.setContentsMargins(0, 0, 0, 0)
        fields.setSpacing(0)
        aligned = QHBoxLayout()
        aligned.setContentsMargins(12, 0, 0, 0)
        aligned.addStretch(1)
        aligned.addWidget(form, 10)
        aligned.addStretch(1)
        layout.addLayout(aligned)

        headline = QLabel("Change the appearance of your display")
        headline.setObjectName("resolutionHeading")
        headline.setFixedHeight(26)
        fields.addWidget(headline)
        fields.addSpacing(6)
        preview = QFrame()
        preview.setObjectName("resolutionPreview")
        preview.setFixedHeight(114)
        preview.setStyleSheet("#resolutionPreview { border: 1px solid #a0a0a0; }")
        preview_row = QHBoxLayout(preview)
        preview_row.setContentsMargins(4, 0, 12, 0)
        preview_row.setSpacing(12)
        self.monitor = QSvgWidget(str(control_panel_asset("aero-resolution-monitor.svg")))
        self.monitor.setFixedSize(128, 96)
        self.monitor.setAccessibleName("Display 1")
        preview_row.addStretch(1)
        preview_row.addWidget(self.monitor, 0, Qt.AlignVCenter)
        preview_row.addStretch(1)
        tools = QVBoxLayout()
        tools.setContentsMargins(0, 11, 0, 0)
        tools.setSpacing(7)
        artwork = aero_button_artwork()
        detect = AeroDialogButton("Detect", artwork, self)
        self.identify = AeroDialogButton("Identify", artwork, self)
        for button in (detect, self.identify):
            button.setFixedSize(chicago95ui.DIALOG_BUTTON_SIZE[0], 22)
        detect.clicked.connect(self.refresh_screen)
        self.identify.clicked.connect(self.identify_display)
        tools.addWidget(detect)
        tools.addWidget(self.identify)
        tools.addStretch(1)
        preview_row.addLayout(tools)
        fields.addWidget(preview)
        fields.addSpacing(16)

        self.display = QComboBox()
        self.display.setMinimumWidth(171)
        self.display.setFixedHeight(22)
        self.display.setSizeAdjustPolicy(QComboBox.AdjustToContents)
        self.resolutions = ResolutionPicker()
        self.resolutions.setFixedSize(100, 24)
        for label, combo in (("&Display:", self.display), ("&Resolution:", self.resolutions)):
            row = QHBoxLayout()
            row.setSpacing(0)
            caption = buddy_label(label, combo)
            caption.setFixedWidth(103)
            row.addWidget(caption)
            row.addWidget(combo)
            row.addStretch()
            fields.addLayout(row)
            fields.addSpacing(12)

        fields.addSpacing(5)
        fields.addWidget(self.link("Advanced settings", self.open_kde_display), 0, Qt.AlignRight)
        fields.addSpacing(6)
        fields.addWidget(self.rule(1))
        fields.addSpacing(8)
        for caption, command in (
            ("Connect to a projector", self.open_kde_display),
            ("Make text and other items larger or smaller", self.open_kde_display),
            ("What display settings should I choose?", self.show_help),
        ):
            fields.addWidget(self.link(caption, command), 0, Qt.AlignLeft)
            fields.addSpacing(6)
        layout.addSpacing(10)
        layout.addWidget(self.rule(1))
        layout.addSpacing(10)
        self.ok_button = AeroDialogButton("OK", artwork, self)
        self.cancel_button = AeroDialogButton("Cancel", artwork, self)
        self.apply_button = AeroDialogButton("Apply", artwork, self)
        self.apply_button.setEnabled(False)
        buttons = QHBoxLayout()
        buttons.setContentsMargins(12, 0, 0, 0)
        buttons.addStretch(1)
        button_group = QWidget()
        button_group.setMaximumWidth(form.maximumWidth())
        button_row = QHBoxLayout(button_group)
        button_row.setContentsMargins(0, 0, 0, 0)
        button_row.setSpacing(7)
        button_row.addStretch()
        for button in (self.ok_button, self.cancel_button, self.apply_button):
            button.setFixedSize(chicago95ui.DIALOG_BUTTON_SIZE[0], 22)
            button_row.addWidget(button)
        buttons.addWidget(button_group, 10)
        buttons.addStretch(1)
        layout.addLayout(buttons)
        layout.addStretch()
        self.resolutions.currentIndexChanged.connect(self.update_apply)
        self.resolutions.currentIndexChanged.connect(self.update_preview)
        self.ok_button.clicked.connect(self.finish)
        self.apply_button.clicked.connect(self.apply)
        self.cancel_button.clicked.connect(self.finished)

    def sizeHint(self):
        return QSize(785, 536)

    @staticmethod
    def rule(height):
        line = QWidget()
        line.setFixedHeight(height)
        line.setStyleSheet("background: #ccc;")
        return line

    def link(self, caption, command):
        button = QPushButton(caption)
        button.setProperty("link", True)
        button.setCursor(Qt.PointingHandCursor)
        button.setFixedHeight(20)
        button.clicked.connect(command)
        return button

    def refresh_screen(self):
        screen = self.actions.current_screen()
        self.current_resolution = screen.current if screen else ""
        self.display.clear()
        self.display.addItem(f"1. {screen.output}" if screen else "Unknown monitor")
        self.display.setEnabled(screen is not None)
        self.identify.setEnabled(screen is not None)
        self.monitor.setVisible(screen is not None)
        self.resolutions.blockSignals(True)
        self.resolutions.clear()
        if screen:
            for size in reversed(screen.sizes):
                self.resolutions.addItem(size.replace("x", " × "), size)
            self.resolutions.setCurrentIndex(self.resolutions.findData(screen.current))
        self.resolutions.blockSignals(False)
        self.resolutions.setEnabled(screen is not None)
        self.update_apply()
        self.update_preview()

    def identify_display(self):
        indicator = QLabel("1", self, Qt.ToolTip)
        indicator.setStyleSheet("background: #254a82; color: white; padding: 16px; font-size: 36px;")
        indicator.adjustSize()
        indicator.move(self.screen().availableGeometry().center() - indicator.rect().center())
        indicator.show()
        QTimer.singleShot(2000, indicator.deleteLater)

    def open_kde_display(self):
        self.actions.start_process("kcmshell6", ["kcm_kscreen"])

    def show_help(self):
        self.actions.show_message(
            self,
            "Screen Resolution",
            "Choose a resolution supported by your display. "
            "Higher resolutions fit more on the screen. Confirm the change to keep it.",
        )

    def update_apply(self):
        selected = self.resolutions.currentData()
        self.apply_button.setEnabled(bool(selected and selected != self.current_resolution))

    def update_preview(self):
        selected = self.resolutions.currentData()
        if selected:
            width, height = (max(1, round(int(side) / 10)) for side in selected.split("x"))
            size = QSize(width, height)
            limit = QSize(248, 96)
            if width > limit.width() or height > limit.height():
                size = size.scaled(limit, Qt.KeepAspectRatio)
            self.monitor.setFixedSize(size)

    def apply(self):
        if not self.apply_button.isEnabled():
            return
        self.current_resolution = self.change_screen_area(self.resolutions.currentData())
        if self.current_resolution is None:
            self.refresh_screen()
            return
        self.resolutions.setCurrentIndex(self.resolutions.findData(self.current_resolution))
        self.update_apply()

    def finish(self):
        self.apply()
        self.finished.emit()


class ExplorerSidebar(QWidget):
    """The Web View introduction and the selected applet's description."""

    theme_requested = Signal()

    def __init__(self, actions, *, win2000=False):
        super().__init__()
        self.art = control_panel_picture("win2000-sidebar.svg" if win2000 else "win98-sidebar.svg")
        self.art_height = 82 if win2000 else 124
        self.setFixedWidth(146 if win2000 else 174)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(10 if win2000 else 12, 9 if win2000 else 14, 10, 10)
        layout.setSpacing(0)
        icon = QLabel()
        icon.setPixmap(QIcon(str(control_panel_asset("win98-control-panel.svg"))).pixmap(26, 26))
        layout.addWidget(icon, 0, Qt.AlignLeft)
        layout.addSpacing(5)
        heading = QLabel("Control Panel" if win2000 else "Control\nPanel")
        font = heading.font()
        font.setFamily("Sans Serif")
        font.setPixelSize(17 if win2000 else 22)
        font.setBold(True)
        heading.setFont(font)
        heading.setFixedHeight(25 if win2000 else 51)
        layout.addWidget(heading)
        layout.addSpacing(15 if win2000 else 25)
        if win2000:
            self.search = QLineEdit()
            self.search.setAccessibleName("Search Control Panel")
            self.search.setPlaceholderText("Search Control Panel")
            self.search.hide()
            layout.addWidget(self.search)
        self.applet_title = QLabel()
        title_font = self.applet_title.font()
        title_font.setBold(True)
        self.applet_title.setFont(title_font)
        layout.addWidget(self.applet_title)
        self.description = QLabel()
        self.description.setTextFormat(Qt.PlainText)
        self.description.setAlignment(Qt.AlignLeft | Qt.AlignTop)
        self.description.setWordWrap(True)
        layout.addWidget(self.description)
        for caption, address in (
            ("Chicago95 Updates" if win2000 else "Chicago95 Repository", "https://github.com/gedaiu/chicago95-plasma"),
            (
                "Technical Support" if win2000 else "Report an issue",
                "https://github.com/gedaiu/chicago95-plasma/issues",
            ),
        ):
            link = QLabel(f'<a href="{address}">{caption}</a>')
            link.setTextInteractionFlags(Qt.TextBrowserInteraction)
            link.linkActivated.connect(lambda target: actions.start_process("xdg-open", [target]))
            layout.addWidget(link)
            layout.addSpacing(3)
        if not win2000:
            themes = QLabel('<a href="themes">Choose a desktop theme</a>')
            themes.setTextInteractionFlags(Qt.TextBrowserInteraction)
            themes.linkActivated.connect(lambda _target: self.theme_requested.emit())
            layout.addWidget(themes)
        layout.addStretch()
        self.show_applet(None)

    def show_applet(self, applet):
        self.applet_title.setVisible(applet is not None)
        self.applet_title.setText(applet.name if applet else "")
        self.description.setFixedHeight(35 if applet else 105)
        self.description.setText(
            applet.description
            if applet
            else "Use the settings in Control Panel to personalize your computer.\n\n"
            "Select an item to view its description."
        )

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), Qt.white)
        self.art.render(painter, QRectF(0, 0, self.width(), self.art_height))


class XPTaskPane(QWidget):
    view_requested = Signal()
    theme_requested = Signal()

    def __init__(self, actions, *, luna=False):
        super().__init__()
        self.background = control_panel_picture("xp-task-pane.svg") if luna else None
        self.setFixedWidth(210)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 15, 12, 10)
        layout.setSpacing(14)
        self.view_link = self.link("Switch to Category View", self.view_requested.emit, "win98-control-panel.svg")
        layout.addWidget(self.task_group("Control Panel", [self.view_link], primary=True, luna=luna))
        links = [
            self.link(
                "Chicago95 Updates",
                lambda: actions.start_process("xdg-open", ["https://github.com/gedaiu/chicago95-plasma/releases"]),
                "xp-task-updates.svg",
            ),
            self.link("Choose a desktop theme", self.theme_requested.emit, "xp-applet-display.svg"),
        ]
        layout.addWidget(self.task_group("See Also", links, primary=False, luna=luna))
        self.search = QLineEdit()
        self.search.setAccessibleName("Search Control Panel")
        self.search.setPlaceholderText("Search Control Panel")
        self.search.hide()
        layout.addWidget(self.search)
        layout.addStretch()

    @staticmethod
    def link(text, activate, asset):
        item = QPushButton(text)
        item.setCursor(Qt.PointingHandCursor)
        item.setFocusPolicy(Qt.TabFocus)
        item.setIcon(QIcon(str(control_panel_asset(asset))))
        item.setIconSize(QSize(13, 13))
        item.setFixedHeight(19)
        item.clicked.connect(activate)
        return item

    @staticmethod
    def task_group(title, links, *, primary, luna):
        frame = QFrame()
        frame.setObjectName("xpTaskGroup")
        content = QWidget()
        content.setObjectName("xpTaskContent")
        header = QPushButton(title)
        header.setObjectName("xpTaskHeader")
        header.setCheckable(True)
        header.setChecked(True)
        header.setFixedHeight(20)
        header.setCursor(Qt.PointingHandCursor)
        if primary:
            header.setIcon(QIcon(str(control_panel_asset("xp-task-panel.svg"))))
            header.setIconSize(QSize(22, 20))
        arrow = QLabel("⌃", header)
        arrow.setObjectName("xpTaskArrow")
        arrow.setAttribute(Qt.WA_TransparentForMouseEvents)
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(0, 0, 8, 0)
        header_layout.addWidget(arrow, 0, Qt.AlignRight | Qt.AlignVCenter)
        header.toggled.connect(content.setVisible)
        header.toggled.connect(lambda opened: arrow.setText("⌃" if opened else "⌄"))
        header_colour = "#ffffff" if primary else "#104090" if luna else "#111111"
        header_fill = (
            "qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #0752b9,stop:1 #3e75ce)"
            if primary and luna
            else "#0a246a"
            if primary
            else "qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #ffffff,stop:1 #bdcef5)"
            if luna
            else "#d4d0c8"
        )
        frame.setStyleSheet(
            f"#xpTaskGroup {{ border: 1px solid {'#ffffff' if luna else '#a4a4a4'}; }}"
            f"#xpTaskHeader {{ border: 0; background: {header_fill}; color: {header_colour};"
            f" font-weight: bold; padding-left: {1 if primary else 9}px; }}"
            f"#xpTaskArrow {{ color: {header_colour}; font-weight: bold; }}"
            f"#xpTaskContent {{ background: {'#e2eaff' if luna else '#ffffff'}; }}"
            f"QPushButton {{ border: 0; background: transparent; color: {'#1648a6' if luna else '#101010'};"
            " text-align: left; padding-left: 4px; }"
            "QPushButton:hover { text-decoration: underline; }"
        )
        inner = QVBoxLayout(content)
        inner.setContentsMargins(9, 5, 7, 6)
        inner.setSpacing(0)
        for item in links:
            inner.addWidget(item)
        layout = QVBoxLayout(frame)
        layout.setContentsMargins(1, 1, 1, 1)
        layout.setSpacing(0)
        layout.addWidget(header)
        layout.addWidget(content)
        return frame

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), Qt.white)
        if self.background:
            self.background.render(painter, QRectF(self.rect()))


class XPCategoryPage(QWidget):
    def __init__(self, *, luna):
        super().__init__()
        self.background = QColor("#6375d6") if luna else QColor(Qt.white)
        self.watermark = control_panel_picture("xp-category-watermark.svg") if luna else None

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), self.background)
        if self.watermark:
            # The paper and pencil sit at the lower-right of the page.
            width, height = 227, 244
            bounds = QRectF(self.width() - width, self.height() - height, width, height)
            painter.setOpacity(0.65)
            self.watermark.render(painter, bounds)


class XPCategoryLink(QLabel):
    def __init__(self, title, *, luna):
        super().__init__()
        self.title = title
        self.luna = luna
        self.setObjectName("xpCategoryLink")
        self.setTextInteractionFlags(Qt.TextBrowserInteraction)
        self.setWordWrap(True)
        self.linkHovered.connect(self.show_hover)
        self.show_hover("")

    def show_hover(self, address):
        color = "#ffffff" if self.luna else "#000080" if address else "#000000"
        decoration = "underline" if address else "none"
        self.setText(f'<a href="category" style="color:{color}; text-decoration:{decoration}">{self.title}</a>')


class ControlPanel(QMainWindow):
    def __init__(self, settings_path=SETTINGS_FILE, actions=None):
        super().__init__()
        self.settings_path = Path(settings_path)
        self.actions = actions or Actions()
        self.history = NavigationHistory(HOME_PAGE)
        self.applet_pages = {}
        self.applet_windows = {}
        self.screen_resolution = None
        self.showing_page = False
        self.setWindowTitle("Control Panel")
        self.setWindowIcon(QIcon.fromTheme("preferences-system"))
        style = chicago95ui.widget_style()
        look = read_settings(self.settings_path).get("LOOK")
        self.aero = style == "aero"
        self.win95 = style == "classic" and look == "1995"
        self.win98 = style == "classic" and look == "1998"
        self.win2000 = style == "classic" and look == "2000"
        self.xp = look in ("2001", "luna") and style in ("classic", "luna")
        self.xp_luna = self.xp and style == "luna"
        self.xp_category = False
        self.xp_group = None
        self.uses_web_view = self.win98 or self.win2000 or self.xp
        classic_applets = {"1995": WIN95_APPLETS, "1998": WIN98_APPLETS, "2000": WIN2000_APPLETS}
        self.applets = classic_applets.get(look, APPLETS) if style == "classic" else APPLETS
        if self.xp:
            self.applets = XP_APPLETS
        self.applet_by_name = {**APPLET_BY_NAME, **{applet.name: applet for applet in self.applets}}
        self.resize(QSize(780, 540) if self.aero else QSize(500, 420))
        self.icon_view = self.build_icon_view()
        self.pages = QStackedWidget()
        self.home_view = self.build_web_view() if self.uses_web_view else self.icon_view
        self.pages.addWidget(self.home_view)
        self.setCentralWidget(self.pages)
        self.build_header()
        self.build_status_bar()
        if self.aero or self.xp:
            self.statusBar().hide()
        if self.aero:
            self.category_details = {}
            self.category_view = self.build_category_view()
            self.pages.addWidget(self.category_view)
        self.set_view("Category" if self.aero else "Large Icons")
        if self.xp:
            self.icon_view.setFocus()
        self.show_selection()
        self.refresh_navigation()

    def build_icon_view(self):
        view = QListWidget()
        art_by_applet = {}
        if self.aero:
            view.setMouseTracking(True)
            view.setItemDelegate(AeroAppletDelegate(view))
        elif self.xp:
            art_by_applet = XP_APPLET_ART
            view.setItemDelegate(ClassicAppletDelegate(view, art_by_applet, xp_classic=not self.xp_luna))
        elif self.win95 or self.uses_web_view:
            art_by_applet = WIN95_APPLET_ART if self.win95 else EXPLORER_APPLET_ART
            view.setItemDelegate(ClassicAppletDelegate(view, art_by_applet))
            view.setSelectionMode(QListView.ExtendedSelection)
        view.setMovement(QListView.Static)
        view.setSpacing(0)
        view.setWordWrap(True)
        view.setResizeMode(QListView.Adjust)
        view.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        view.setLineWidth(2)
        for applet in self.applets:
            art = art_by_applet.get(applet.name)
            icon = QIcon(str(control_panel_asset(art))) if art else themed_icon(applet.icon_names)
            item = QListWidgetItem(icon, applet.name)
            item.setData(Qt.UserRole, applet)
            view.addItem(item)
        view.itemSelectionChanged.connect(self.show_selection)
        view.itemActivated.connect(lambda item: self.open_applet(item.data(Qt.UserRole).name))
        return view

    def build_web_view(self):
        frame = QFrame()
        frame.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        frame.setLineWidth(2)
        self.icon_view.setFrameShape(QFrame.NoFrame)
        self.sidebar = (
            XPTaskPane(self.actions, luna=self.xp_luna)
            if self.xp
            else ExplorerSidebar(self.actions, win2000=self.win2000)
        )
        self.sidebar.theme_requested.connect(lambda: self.open_applet("Themes"))
        if self.win2000 or self.xp:
            self.sidebar.search.textChanged.connect(self.filter_web_applets)
        self.sidebar_area = QWidget()
        sidebar_layout = QHBoxLayout(self.sidebar_area)
        gap = 0 if self.xp else 13 if self.win2000 else 15
        sidebar_layout.setContentsMargins(0, 0, gap, 0)
        sidebar_layout.addWidget(self.sidebar)
        self.sidebar_area.setAutoFillBackground(True)
        self.sidebar_area.setBackgroundRole(QPalette.Base)
        row = QHBoxLayout(frame)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(0)
        row.addWidget(self.sidebar_area)
        if self.xp:
            self.sidebar.view_requested.connect(self.toggle_xp_view)
            self.xp_views = QStackedWidget()
            self.xp_views.addWidget(self.icon_view)
            self.xp_category_view = self.build_xp_categories()
            self.xp_views.addWidget(self.xp_category_view)
            row.addWidget(self.xp_views, 1)
        else:
            row.addWidget(self.icon_view, 1)
        return frame

    def build_status_bar(self):
        """Windows 98's status bar: three sunken panes (the message, a spare one, the place) and a size grip."""
        self.status_message = QLabel()
        chrome = window_chrome()
        if self.win95:
            self.status_panes = (chrome.status_pane(self.status_message),)
            self.setStatusBar(chrome.status_bar(self.status_panes))
            return
        self.status_place_icon = QLabel()
        icon = themed_icon(("computer",))
        self.status_place_icon.setPixmap(
            icon.pixmap(16, 16)
            if not icon.isNull()
            else start_logo_pixmap().scaled(16, 16, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        )
        self.status_panes = (
            chrome.status_pane(self.status_message),
            chrome.status_pane(QLabel()),
            chrome.status_pane(self.status_place_icon, QLabel("My Computer")),
        )
        status_bar = (
            ClassicStatusBar(self.status_panes, (64, 13, 23)) if self.win2000 else chrome.status_bar(self.status_panes)
        )
        self.setStatusBar(status_bar)

    def build_header(self):
        chrome = window_chrome()
        if self.aero:
            self.build_aero_header()
            return
        self.menu_bar = QMenuBar()
        compact_menu = (self.uses_web_view and not self.xp_luna) or self.win95
        menu_height = 20 if compact_menu else MENU_BAR_HEIGHT
        if self.xp_luna:
            menu_height = XP_LUNA_MENU_HEIGHT
        self.menu_style = MenuBandStyle("Windows", item_height=menu_height) if compact_menu else chrome.menu_style()
        self.menu_bar.setStyle(self.menu_style)
        self.menu_bar.setFixedHeight(menu_height)
        self.build_menus()
        self.build_standard_navigation()
        if self.win95:
            self.setMenuWidget(self.menu_bar)
            return
        self.toolbar = self.build_standard_toolbar()
        if self.xp:
            from chicago95lunacontrolpanel import LunaLogoBox

            self.logo_box = LunaLogoBox()
            self.logo_box.setFixedWidth(30)
        else:
            self.logo_box = chrome.logo_box()
        known_pages = [HOME_PAGE] + [HOME_PAGE + (applet.name,) for applet in APPLETS if not applet.external_tool]
        address_icon = QIcon(str(control_panel_asset("win98-control-panel.svg"))) if self.uses_web_view else None
        self.address_bar = AddressBar(known_pages, icon=address_icon)
        self.address_bar.navigate.connect(self.navigate)
        address_row = self.address_bar
        if self.win2000 or self.xp:
            address_row = QWidget()
            address_layout = QHBoxLayout(address_row)
            address_layout.setContentsMargins(0, 0, 0, 0)
            address_layout.setSpacing(4)
            address_layout.addWidget(self.address_bar, 1)
            go = QToolButton()
            go.setText("Go")
            go.setIcon(QIcon.fromTheme("go-jump"))
            go.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            go.setAutoRaise(True)
            go.clicked.connect(lambda: self.show_page(self.history.current))
            address_layout.addWidget(go)
        self.header = QWidget()
        layout = QVBoxLayout(self.header)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        header_band = functools.partial(HeaderBand, inset=6) if compact_menu else chrome.header_band
        for band in (
            header_band(self.menu_bar, menu_height, trailing=self.logo_box),
            header_band(self.toolbar, self.toolbar.height()),
            header_band(address_row),
        ):
            layout.addWidget(band)
        if not self.uses_web_view:
            layout.addWidget(header_band(None, 0, grip=False))
        self.setMenuWidget(self.header)

    def build_aero_header(self):
        self.header = QWidget()
        layout = QVBoxLayout(self.header)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        self.toolbar = QFrame()
        self.toolbar.setObjectName("aeroNavigation")
        self.toolbar.setStyleSheet(
            "QFrame#aeroNavigation { border-bottom: 1px solid #1b344d; background: "
            "qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #7398bc,stop:.18 #235f98,"
            "stop:.63 #245d94,stop:1 #486d93); }"
        )
        row = QHBoxLayout(self.toolbar)
        # Aero keeps the band compact when the rest of the shell is scaled up.
        compact = chicago95ui.window_scale(self) >= 1.5
        vertical_padding = 1 if compact else 3
        nav_size = 23 if compact else 27
        row.setContentsMargins(1, vertical_padding, 2, vertical_padding)
        row.setSpacing(2)
        self.toolbar_buttons = {}
        for name, icon, fallback, distance in (
            ("Back", "go-previous", QStyle.SP_ArrowBack, -1),
            ("Forward", "go-next", QStyle.SP_ArrowForward, 1),
        ):
            action = QAction(QIcon.fromTheme(icon, self.style().standardIcon(fallback)), name, self)
            action.triggered.connect(lambda _checked=False, step=distance: self.jump(step))
            action.setShortcut("Alt+Left" if distance < 0 else "Alt+Right")
            self.addAction(action)
            button = AeroNavigationButton(forward=distance > 0)
            button.setDefaultAction(action)
            button.setAutoRaise(True)
            button.setIconSize(QSize(nav_size - 1, nav_size - 1))
            button.setFixedSize(nav_size, nav_size)
            button.setStyleSheet("QToolButton { border: 0; padding: 0; }")
            self.toolbar_buttons[name] = button
            row.addWidget(button)
        self.back_action = self.toolbar_buttons["Back"].defaultAction()
        self.forward_action = self.toolbar_buttons["Forward"].defaultAction()
        self.up_action = QAction("Up", self)
        self.up_action.setShortcut("Alt+Up")
        self.up_action.triggered.connect(lambda: self.navigate(parent_location(self.history.current)))
        self.addAction(self.up_action)
        history = QToolButton()
        history.setArrowType(Qt.DownArrow)
        history.setAccessibleName("Navigation history")
        history.setAutoRaise(True)
        history.setFixedWidth(9)
        history.setPopupMode(QToolButton.InstantPopup)
        history.setStyleSheet("QToolButton::menu-indicator { image: none; }")
        menu = QMenu(history)
        menu.aboutToShow.connect(lambda: self.fill_navigation_history(menu))
        history.setMenu(menu)
        row.addWidget(history)
        pages = [HOME_PAGE, *(HOME_PAGE + (name,) for name in AERO_CATEGORIES)]
        pages.extend(HOME_PAGE + (applet.name,) for applet in APPLETS if not applet.external_tool)
        pages.append(SCREEN_RESOLUTION_PAGE)
        self.address_bar = AddressBar(pages, aero=True)
        self.address_bar.navigate.connect(self.navigate)
        refresh = QAction("Refresh", self)
        refresh.setShortcut("F5")
        refresh.triggered.connect(lambda: self.show_page(self.history.current))
        self.address_bar.refresh_requested.connect(refresh.trigger)
        self.addAction(refresh)
        row.addWidget(self.address_bar, 7)
        search = QLineEdit()
        search.setClearButtonEnabled(True)
        search.setAccessibleName("Search Control Panel")
        search.setPlaceholderText("Search Control Panel")
        search.setMinimumWidth(115)
        search.setFixedHeight(self.address_bar.height() - 2)
        search.setStyleSheet(
            "QLineEdit { background: white; color: #172632; border: 1px solid #435564;"
            " border-bottom-color: #799db9; padding: 0 3px; placeholder-text-color: #646464; }"
        )
        search.addAction(QIcon.fromTheme("system-search"), QLineEdit.TrailingPosition).triggered.connect(
            lambda: search.setFocus(Qt.MouseFocusReason)
        )
        self.search = search
        search.textEdited.connect(self.search_applets)
        row.addWidget(search, 2)
        layout.addWidget(self.toolbar)

        self.home_heading = QWidget()
        self.home_heading.setObjectName("aeroHomeHeading")
        self.home_heading.setStyleSheet(
            "QWidget#aeroHomeHeading { background: white; }"
            "QWidget#aeroHomeHeading[category=true] { background: "
            "qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f2f6fb,stop:1 #fefeff); }"
            "QLabel { color: #526477; }"
            "QToolButton { background: transparent; border: 1px solid transparent; color: #0066cc; }"
            "QToolButton:hover { background: #e5f1ff; border-color: #b9d7fc; }"
        )
        titles = QHBoxLayout(self.home_heading)
        heading = QLabel("Adjust your computer's settings")
        heading.setStyleSheet("font-size: 15px; color: #003399;")
        titles.addWidget(heading, 1)
        titles.addWidget(QLabel("View by:"))
        self.view_menu = QMenu(self)
        self.view_button = QToolButton()
        self.view_button.setAutoRaise(True)
        self.view_button.setStyleSheet(
            "QToolButton::menu-indicator { subcontrol-position: right center; width: 8px; }"
            "QToolButton { padding-right: 10px; }"
        )
        self.view_button.setPopupMode(QToolButton.InstantPopup)
        self.view_button.setMenu(self.view_menu)
        for name in ("Category", "Large Icons", "Small Icons"):
            self.view_menu.addAction(name).triggered.connect(lambda _checked=False, name=name: self.set_view(name))
        titles.addWidget(self.view_button)
        layout.addWidget(self.home_heading)
        self.setMenuWidget(self.header)

    def build_category_view(self):
        widget = AeroCategoryView()
        widget.setStyleSheet(AERO_CATEGORY_STYLE)
        widget.setObjectName("categoryView")
        layout = QHBoxLayout(widget)
        layout.setContentsMargins(70, 12, 70, 12)
        layout.setSpacing(0)
        for offset in (0, 4):
            column = QVBoxLayout()
            column.setSpacing(0)
            layout.addLayout(column, 1)
            for index, (category, (icon, links)) in enumerate(
                list(AERO_CATEGORIES.items())[offset : offset + 4], start=offset
            ):
                card = AeroCategoryCard()
                card.setMinimumHeight(AERO_CATEGORY_HEIGHTS[index])
                row = QHBoxLayout(card)
                row.setContentsMargins(1, 2, 2, 2)
                row.setSpacing(11)
                picture = QToolButton()
                picture.setAccessibleName(category)
                picture.setIcon(
                    QIcon(str(control_panel_asset(icon)))
                    if icon.endswith(".svg")
                    else themed_icon((icon, APPLET_BY_NAME[links[0][1]].icon_names[0]))
                )
                picture.setIconSize(QSize(48, 48))
                picture.setStyleSheet("background: transparent; border: none; padding: 0")
                picture.setCursor(Qt.PointingHandCursor)
                picture.setFocusPolicy(Qt.NoFocus)
                row.addWidget(picture, 0, Qt.AlignTop)
                tasks = QVBoxLayout()
                tasks.setSpacing(1)
                row.addLayout(tasks, 1)
                row.setAlignment(tasks, Qt.AlignTop)
                heading = AeroCategoryHeading(category)
                tasks.addWidget(heading)
                heading.clicked.connect(lambda _, title=category: self.navigate(HOME_PAGE + (title,)))
                picture.clicked.connect(heading.click)
                for text, applet, tab in links:
                    button = QPushButton(text)
                    button.setAutoDefault(True)
                    button.setCursor(Qt.PointingHandCursor)
                    button.clicked.connect(lambda _, name=applet, section=tab: self.open_category_task(name, section))
                    tasks.addWidget(button)
                column.addWidget(card)
                if category != "Clock, Language, and Region":
                    column.addSpacing(6)
            column.addStretch()
        return widget

    def category_detail(self, category):
        if category in self.category_details:
            return self.category_details[category]
        page = QWidget()
        page.setObjectName("categoryDetails")
        page.setStyleSheet(AERO_CATEGORY_STYLE)
        columns = QHBoxLayout(page)
        columns.setContentsMargins(0, 0, 0, 0)
        columns.setSpacing(0)
        sidebar = QFrame()
        sidebar.setFixedWidth(199)
        sidebar.setObjectName("categorySidebar")
        sidebar.setStyleSheet("""
            #categorySidebar { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                stop:0 #dce6f4,stop:.65 #e7f0fc,stop:1 #e7f1ff); }
            #categorySidebar QPushButton { color: #172f59; }
            #categorySidebar QPushButton[current=true] { font-weight: bold; }
        """)
        nav = QVBoxLayout(sidebar)
        nav.setContentsMargins(10, 12, 6, 12)
        nav.setSpacing(5)
        for title in ("Control Panel Home", *AERO_CATEGORIES):
            target = HOME_PAGE if title == "Control Panel Home" else HOME_PAGE + (title,)
            button = QPushButton(
                {
                    "User Accounts and Family Safety": "User Accounts and Family\nSafety",
                    "Appearance and Personalization": "Appearance and\nPersonalization",
                }.get(title, title)
            )
            button.setAccessibleName(title)
            button.setAutoDefault(True)
            button.setProperty("current", title == category)
            button.setCursor(Qt.PointingHandCursor)
            button.clicked.connect(lambda _, path=target: self.navigate(path))
            line = QHBoxLayout()
            line.setSpacing(0)
            if title == category:
                marker = QLabel("•")
                marker.setFixedWidth(18)
                marker.setStyleSheet("color: #172f59; font-weight: bold;")
                line.addWidget(marker, 0, Qt.AlignTop)
            else:
                line.addSpacing(18)
            line.addWidget(button, 1)
            nav.addLayout(line)
            if target == HOME_PAGE:
                nav.addSpacing(7)
        nav.addStretch()
        columns.addWidget(sidebar)
        area = QScrollArea()
        area.setFrameShape(QFrame.NoFrame)
        area.setWidgetResizable(True)
        content = QWidget()
        content.setObjectName("categoryContent")
        content.setStyleSheet("#categoryContent {background: white;}")
        groups = QVBoxLayout(content)
        groups.setContentsMargins(14, 16, 10, 12)
        groups.setSpacing(4)
        if category == "Appearance and Personalization":
            by_applet = {
                "Themes": [
                    ("Change the theme", "Themes", ""),
                    ("Change desktop background", "Display", "Background"),
                    ("Change window colors", "Display", "Appearance"),
                    ("Change sound effects", "Sounds", ""),
                    ("Change screen saver", "Display", "Screen Saver"),
                ],
                "Display": [("Adjust screen resolution", "Display", "Settings")],
                "Taskbar": [("Customize the Start menu", "Taskbar", "Start Menu")],
                "Fonts": [("Change the screen font", "Fonts", "")],
            }
        else:
            by_applet = {}
            for task in AERO_CATEGORIES[category][1]:
                by_applet.setdefault(task[1], []).append(task)
        for applet, links in by_applet.items():
            card = AeroCategoryCard()
            row = QHBoxLayout(card)
            row.setContentsMargins(4, 2, 4, 2)
            row.setSpacing(10)
            icon = QToolButton()
            icon.setIcon(themed_icon(APPLET_BY_NAME[applet].icon_names))
            icon.setIconSize(QSize(32, 32))
            icon.setAccessibleName(applet)
            icon.setStyleSheet("border: 0; background: transparent")
            icon.setCursor(Qt.PointingHandCursor)
            icon.clicked.connect(lambda _, name=applet: self.open_applet(name))
            row.addWidget(icon, 0, Qt.AlignTop)
            grid = QGridLayout()
            grid.setHorizontalSpacing(12)
            grid.setVerticalSpacing(2)
            title = {"Themes": "Personalization", "Taskbar": "Taskbar and Start Menu"}.get(applet, applet)
            heading = AeroCategoryHeading(title)
            heading.clicked.connect(lambda _, name=applet: self.open_applet(name))
            grid.addWidget(heading, 0, 0, 1, 3)
            for index, (label, target_applet, tab) in enumerate(links):
                link = QPushButton(label)
                link.setAutoDefault(True)
                link.setCursor(Qt.PointingHandCursor)
                link.clicked.connect(lambda _, name=target_applet, section=tab: self.open_category_task(name, section))
                grid.addWidget(link, 1 + index // 3, index % 3)
            row.addLayout(grid)
            row.addStretch()
            groups.addWidget(card)
        groups.addStretch()
        area.setWidget(content)
        columns.addWidget(area)
        self.pages.addWidget(page)
        self.category_details[category] = page
        return page

    def open_category_task(self, name, tab):
        if self.aero and name == "Display" and tab and tab != "Settings":
            self.open_window(name)
        else:
            self.open_applet(name)
            if self.aero and name == "Display":
                return
        if tab:
            sheet = self.applet_sheet(name)
            sheet.tabs.setCurrentIndex(sheet.tab_index(tab))

    def fill_navigation_history(self, menu):
        menu.clear()
        for index, page in enumerate(self.history.pages):
            item = menu.addAction(breadcrumb_text(page))
            distance = index - self.history.position
            item.setEnabled(distance != 0)
            item.triggered.connect(lambda _checked=False, step=distance: self.jump(step))

    def search_applets(self, text):
        if self.history.current != HOME_PAGE:
            self.navigate(HOME_PAGE)
            if self.history.current != HOME_PAGE:
                self.search.clear()
                return
        self.show_aero_home(text)

    def show_aero_home(self, text):
        category = self.view_button.text() == "Category" and not text
        if self.home_heading.property("category") != category:
            self.home_heading.layout().setContentsMargins(*((72, 18, 72, 18) if category else (18, 9, 16, 9)))
            self.home_heading.setProperty("category", category)
            style = self.home_heading.style()
            style.unpolish(self.home_heading)
            style.polish(self.home_heading)
        self.pages.setCurrentWidget(self.category_view if category else self.icon_view)
        for row in range(self.icon_view.count()):
            item = self.icon_view.item(row)
            applet = item.data(Qt.UserRole)
            item.setHidden(text.casefold() not in f"{applet.name} {applet.description}".casefold())

    def build_menus(self):
        menu_bar = self.menu_bar
        file_menu = menu_bar.addMenu("&File")
        edit_menu = menu_bar.addMenu("&Edit")
        self.view_menu = menu_bar.addMenu("&View")
        view_choices = QActionGroup(self)
        for name, mode in VIEW_MODES.items():
            choice = self.view_menu.addAction(mode.menu_text)
            choice.setCheckable(True)
            choice.setChecked(name == "Large Icons")
            choice.triggered.connect(lambda _checked=False, name=name: self.set_view(name))
            view_choices.addAction(choice)
        if self.win95 or self.uses_web_view:
            project_menu = file_menu.addMenu("Chicago95 &Settings")
            originals = {applet.name for applet in self.applets}
            for applet in APPLETS:
                if applet.name not in originals:
                    project_menu.addAction(applet.name, lambda name=applet.name: self.open_applet(name))
            file_menu.addAction("&Close", self.close)
        if self.win95:
            edit_menu.addAction("Select &All", self.icon_view.selectAll).setShortcut("Ctrl+A")
        elif self.win2000 or self.xp:
            menu_bar.addMenu("F&avorites")
            menu_bar.addMenu("&Tools")
        else:
            menu_bar.addMenu("&Go")
            menu_bar.addMenu("F&avorites")
        if self.uses_web_view and not self.xp:
            self.view_menu.addSeparator()
            self.web_view_action = self.view_menu.addAction("as &Web Page")
            self.web_view_action.setCheckable(True)
            self.web_view_action.setChecked(True)
            self.web_view_action.toggled.connect(self.set_web_view)
        help_menu = menu_bar.addMenu("&Help")
        if self.win95:
            help_menu.addAction(
                "Help &Topics",
                lambda: self.actions.show_message(
                    self,
                    "Control Panel",
                    "Double-click an icon to change its settings. Open Chicago95 Settings from the File menu "
                    "to select a desktop theme or change Chicago95 features.",
                ),
            )

    def build_standard_navigation(self):
        self.back_action = QAction(QIcon.fromTheme("go-previous"), "Back", self)
        self.forward_action = QAction(QIcon.fromTheme("go-next"), "Forward", self)
        self.up_action = QAction(QIcon.fromTheme("go-up"), "Up", self)
        self.back_action.triggered.connect(lambda: self.jump(-1))
        self.forward_action.triggered.connect(lambda: self.jump(1))
        self.up_action.triggered.connect(lambda: self.navigate(parent_location(self.history.current)))
        if self.win95:
            for action, shortcut in (
                (self.back_action, "Alt+Left"),
                (self.forward_action, "Alt+Right"),
                (self.up_action, "Alt+Up"),
            ):
                action.setShortcut(shortcut)
                self.addAction(action)

    def build_standard_toolbar(self):
        if self.win2000 or self.xp:
            return self.build_compact_toolbar()
        toolbar = QWidget()
        toolbar.setFixedHeight(WIN98_TOOLBAR_HEIGHT if self.win98 else TOOLBAR_HEIGHT)
        layout = QHBoxLayout(toolbar)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        views_action = QAction(QIcon.fromTheme("view-list-icons"), "Views", self)
        views_action.setMenu(self.view_menu)
        self.toolbar_buttons = {}

        def add_button(action, has_menu=False):
            button_class = Win98ToolbarButton if self.win98 else window_chrome().toolbar_button
            button = button_class(action, has_menu)
            self.toolbar_buttons[action.text()] = button
            layout.addWidget(button)

        def add_separator():
            separator = QFrame()
            separator.setFrameStyle(QFrame.VLine | QFrame.Sunken)
            separator.setFixedWidth(6)
            layout.addWidget(separator)

        for action, has_menu in ((self.back_action, True), (self.forward_action, True), (self.up_action, False)):
            add_button(action, has_menu)
        add_separator()
        if self.win98:
            groups = (
                (("Cut", "edit-cut"), ("Copy", "edit-copy"), ("Paste", "edit-paste")),
                (("Undo", "edit-undo"),),
                (("Delete", "edit-delete"), ("Properties", "document-properties")),
            )
            for group in groups:
                for caption, icon in group:
                    action = QAction(QIcon.fromTheme(icon), caption, self)
                    action.setEnabled(False)
                    add_button(action)
                add_separator()
            self.toolbar_buttons["Copy"].defaultAction().triggered.connect(self.copy_current_applet)
            self.toolbar_buttons["Properties"].defaultAction().triggered.connect(self.open_current_applet)
        add_button(views_action, has_menu=True)
        layout.addStretch(1)
        return toolbar

    def build_compact_toolbar(self):
        toolbar = QWidget()
        height = (
            XP_LUNA_TOOLBAR_HEIGHT if self.xp_luna else XP_CLASSIC_TOOLBAR_HEIGHT if self.xp else WIN2000_TOOLBAR_HEIGHT
        )
        toolbar.setFixedHeight(height)
        row = QHBoxLayout(toolbar)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(1)
        self.toolbar_buttons = {}

        def button(action, text=False, popup=None):
            control = QToolButton()
            control.setDefaultAction(action)
            control.setAutoRaise(True)
            icon_size = 18 if self.xp else 13
            control.setIconSize(QSize(icon_size, icon_size))
            control.setFixedHeight(height)
            if text:
                control.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            if popup is not None:
                control.setPopupMode(popup)
            self.toolbar_buttons[action.text()] = control
            row.addWidget(control)

        def separator():
            rule = QFrame()
            rule.setFrameStyle(QFrame.VLine | QFrame.Sunken)
            rule.setFixedWidth(5)
            row.addWidget(rule)

        button(self.back_action, text=True, popup=QToolButton.MenuButtonPopup)
        button(self.forward_action, popup=QToolButton.MenuButtonPopup)
        button(self.up_action)
        separator()
        search = QAction(themed_icon(("system-search", "edit-find")), "Search", self)
        search.triggered.connect(self.toggle_web_search)
        button(search, text=True)
        folders = QAction(themed_icon(("folder-open", "folder")), "Folders", self)
        folders.triggered.connect(lambda: self.actions.start_process("xdg-open", [str(Path.home())]))
        button(folders, text=True)
        if self.win2000:
            history = QAction(themed_icon(("document-open-recent", "view-history")), "History", self)
            menu = QMenu(toolbar)
            menu.aboutToShow.connect(lambda: self.fill_navigation_history(menu))
            history.setMenu(menu)
            button(history, text=True, popup=QToolButton.InstantPopup)
            separator()
            for caption, icon in (
                ("Copy", "edit-copy"),
                ("Paste", "edit-paste"),
                ("Delete", "edit-delete"),
                ("Undo", "edit-undo"),
            ):
                action = QAction(themed_icon((icon,)), caption, self)
                action.setEnabled(False)
                button(action)
            self.toolbar_buttons["Copy"].defaultAction().triggered.connect(self.copy_current_applet)
        separator()
        views = QAction(themed_icon(("view-list-icons", "view-list-details")), "Views", self)
        views.setMenu(self.view_menu)
        button(views, popup=QToolButton.InstantPopup)
        row.addStretch(1)
        return toolbar

    def set_web_view(self, visible):
        self.sidebar_area.setVisible(visible)
        if self.win2000 and not visible:
            self.sidebar.search.clear()
            self.sidebar.search.hide()

    def toggle_web_search(self):
        search = self.sidebar.search
        if self.history.current == HOME_PAGE and not search.isHidden():
            search.clear()
            search.hide()
            if self.xp:
                self.show_xp_view()
            return
        self.navigate(HOME_PAGE)
        if self.history.current == HOME_PAGE:
            if self.xp:
                self.xp_group = None
                self.xp_views.setCurrentWidget(self.icon_view)
            else:
                self.web_view_action.setChecked(True)
            search.show()
            search.setFocus()

    def filter_web_applets(self, text):
        query = text.casefold().strip()
        for index, applet in enumerate(self.applets):
            outside_group = self.xp_group is not None and applet.name not in self.xp_group
            self.icon_view.item(index).setHidden(outside_group or query not in applet.name.casefold())

    def build_xp_categories(self):
        scroll = QScrollArea()
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setWidgetResizable(True)
        page = XPCategoryPage(luna=self.xp_luna)
        text = "#ffffff" if self.xp_luna else "#000000"
        page.setStyleSheet("QToolButton { border: 0; background: transparent; padding: 0; }")
        category_font = page.font()
        category_font.setFamilies(["Tahoma", "Wine Tahoma", "Liberation Sans", "DejaVu Sans"])
        category_font.setPixelSize(11 if self.xp_luna else 12)
        category_font.setBold(self.xp_luna)
        category_font.setStyleStrategy(QFont.NoAntialias)
        layout = QVBoxLayout(page)
        layout.setContentsMargins(18, 19 if self.xp_luna else 17, 16, 16)
        layout.setSpacing(8)
        heading = QLabel("Pick a category")
        font = QFont(category_font)
        font.setBold(True)
        font.setPixelSize(27)
        font.setStretch(99)
        font.setStyleStrategy(QFont.NoSubpixelAntialias)
        heading.setFont(font)
        heading.setIndent(6 if self.xp_luna else 5)
        heading.setStyleSheet(f"color: {'#d6dff7' if self.xp_luna else text}")
        layout.addWidget(heading)
        grid = QGridLayout()
        grid.setHorizontalSpacing(4)
        grid.setVerticalSpacing(0)
        grid.setColumnStretch(0, 1)
        grid.setColumnStretch(1, 1)
        for index, (title, primary, members) in enumerate(XP_CATEGORIES):
            card = QHBoxLayout()
            card.setSpacing(3)
            glyph = QToolButton()
            glyph.setIcon(QIcon(str(control_panel_asset(XP_CATEGORY_ART[primary]))))
            glyph.setIconSize(QSize(38, 38))
            glyph.setFixedSize(44, 52)
            glyph.setAccessibleName(title)
            glyph.setCursor(Qt.PointingHandCursor)
            glyph.clicked.connect(lambda _checked=False, names=members: self.open_xp_category(names))
            card.addWidget(glyph)
            link = XPCategoryLink(title, luna=self.xp_luna)
            link.setFont(category_font)
            link.setMaximumWidth(137)
            link.linkActivated.connect(lambda _target, names=members: self.open_xp_category(names))
            card.addWidget(link, 1)
            card.addStretch()
            grid.addLayout(card, index % 5, index // 5)
        layout.addLayout(grid)
        layout.addStretch()
        scroll.setWidget(page)
        return scroll

    def open_xp_category(self, members):
        self.xp_group = members
        self.show_xp_view()

    def toggle_xp_view(self):
        self.sidebar.search.clear()
        self.sidebar.search.hide()
        self.xp_category = not self.xp_category
        self.xp_group = None
        self.show_xp_view()

    def show_xp_view(self):
        self.sidebar.view_link.setText("Switch to Classic View" if self.xp_category else "Switch to Category View")
        show_categories = self.xp_category and self.xp_group is None and self.sidebar.search.isHidden()
        self.xp_views.setCurrentWidget(self.xp_category_view if show_categories else self.icon_view)
        self.filter_web_applets(self.sidebar.search.text())
        if not show_categories and self.sidebar.search.isHidden():
            self.icon_view.setFocus()

    def set_view(self, name):
        view = VIEW_MODES["Large Icons" if name == "Category" else name]
        if self.aero:
            self.view_button.setText(name)
            self.show_aero_home(self.search.text())
            if name in ("Category", "Large Icons", "Small Icons"):
                view = ViewMode(
                    name,
                    view.icon_size,
                    QSize(220, view.icon_size + 16),
                    QListView.ListMode,
                    QListView.LeftToRight,
                    True,
                )
            self.icon_view.setFrameShape(QFrame.NoFrame)
            self.icon_view.setStyleSheet("QListWidget { padding: 8px 15px; background: white; color: #006600; }")
        self.icon_view.setViewMode(view.mode)
        self.icon_view.setFlow(view.flow)
        self.icon_view.setWrapping(view.wrapping)
        icon_size = view.icon_size
        if self.win95 or self.uses_web_view:
            icon_size = round(icon_size / chicago95ui.window_scale(self))
        self.icon_view.setIconSize(QSize(icon_size, icon_size))
        self.icon_view.setGridSize(QSize(60, 75) if self.win2000 and name == "Large Icons" else view.grid)
        for row in range(self.icon_view.count()):
            item = self.icon_view.item(row)
            applet = item.data(Qt.UserRole)
            if (self.win2000 or self.xp) and name == "Large Icons":
                captions = XP_ICON_CAPTIONS if self.xp else WIN2000_ICON_CAPTIONS
                caption = captions.get(applet.name, applet.name)
                item.setText(caption)
                item.setToolTip(applet.name if caption != applet.name else "")
                continue
            item.setToolTip("")
            item.setText(
                f"{applet.name}{DETAILS_SEPARATOR}{applet.description}" if view.shows_description else applet.name
            )

    def show_selection(self):
        selected = self.icon_view.selectedItems()
        if self.uses_web_view and not self.xp:
            applet = selected[0].data(Qt.UserRole) if selected else None
            self.sidebar.show_applet(applet)
            self.toolbar_buttons["Copy"].defaultAction().setEnabled(bool(applet))
            if self.win98:
                self.toolbar_buttons["Properties"].defaultAction().setEnabled(bool(applet))
            self.status_message.setText(
                applet.description if applet else f"{self.icon_view.count()} object(s)" if self.win2000 else ""
            )
            return
        if self.win95 and len(selected) > 1:
            message = f"{len(selected)} object(s) selected"
        elif selected:
            message = selected[0].data(Qt.UserRole).description
        else:
            message = f"{self.icon_view.count()} object(s)"
        self.status_message.setText(message)

    def copy_current_applet(self):
        item = self.icon_view.currentItem()
        if item and item.isSelected():
            QApplication.clipboard().setText(item.data(Qt.UserRole).name)

    def open_current_applet(self):
        item = self.icon_view.currentItem()
        if item and item.isSelected():
            self.open_applet(item.data(Qt.UserRole).name)

    def show_again(self, page_slug):
        """A later launch asked for the window: its page, if named, then the window up and in front."""
        self.showNormal()
        self.raise_()
        self.activateWindow()
        if page_slug in PAGE_SLUGS:
            self.open_applet(PAGE_SLUGS[page_slug])

    def open_applet(self, name):
        applet = self.applet_by_name[name]
        if applet.target:
            return self.open_applet(applet.target)
        if applet.command:
            program, *arguments = applet.command
            if self.actions.program_installed(program):
                self.actions.start_process(program, arguments)
            else:
                self.actions.show_message(self, applet.name, f"{program} is unavailable on this desktop.")
            return
        if applet.external_tool:
            self.actions.start_process(tool_path(applet.external_tool), [])
            return
        if self.aero and name == "Display":
            self.navigate(SCREEN_RESOLUTION_PAGE)
            return
        if applet.own_window:
            self.open_window(name)
            return
        self.navigate(HOME_PAGE + (name,))

    def open_window(self, applet_name):
        if applet_name not in self.applet_windows:
            self.applet_windows[applet_name] = PropertySheetWindow(self.build_sheet(applet_name), self)
        sheet = self.applet_windows[applet_name]
        sheet.show()
        sheet.raise_()
        sheet.activateWindow()

    def applet_sheet(self, applet_name):
        """An opened applet's property sheet: in its own window, or a page of this one."""
        window = self.applet_windows.get(applet_name)
        return window.page if window is not None else self.page_for(applet_name)

    def build_sheet(self, applet_name):
        settings = read_settings(self.settings_path)
        if applet_name == "Display" and chicago95ui.luna_widgets():
            tabs = luna_display_tabs(settings, self.actions)
        else:
            tabs = [
                (tab_name, build_tab(applet_name, tab_name, settings, self.actions))
                for tab_name in PAGE_TABS[applet_name]
            ]
        return PropertiesPage(applet_name, tabs, self.apply_changes)

    def navigate(self, page):
        if self.aero and page == HOME_PAGE + ("Display",):
            page = SCREEN_RESOLUTION_PAGE
        if self.aero and page[1:2] == ("Taskbar",):
            self.open_window("Taskbar")
            return
        if not self.may_go_to(page):
            return
        self.history.visit(page)
        self.show_page(page)

    def jump(self, steps):
        pages = self.history.pages_before if steps < 0 else self.history.pages_after
        if not self.may_go_to(pages[abs(steps) - 1]):
            return
        step = self.history.back if steps < 0 else self.history.forward
        for _ in range(abs(steps)):
            step()
        self.show_page(self.history.current)

    def current_applet_page(self):
        page = self.pages.currentWidget()
        return page if isinstance(page, PropertiesPage) else None

    def may_go_to(self, target):
        """Leaving an applet's page with changes not applied asks first; moving between its tabs does not."""
        page = self.current_applet_page()
        staying = page is not None and len(target) > 1 and target[1] == page.title
        return page is None or staying or self.can_leave(page)

    def can_leave(self, page):
        if not page.changed_values():
            return True
        answer = self.actions.ask_to_apply(self)
        if answer == "cancel":
            return False
        if answer == "yes":
            return page.apply()
        page.discard_changes()
        return True

    def closeEvent(self, event):
        page = self.current_applet_page()
        if page is None or self.can_leave(page):
            event.accept()
        else:
            event.ignore()

    def page_for(self, applet_name):
        if applet_name not in self.applet_pages:
            page = self.build_sheet(applet_name)
            page.finished.connect(lambda: self.navigate(HOME_PAGE))
            page.tabs.currentChanged.connect(lambda index, name=applet_name: self.tab_changed(name, index))
            self.applet_pages[applet_name] = page
            self.pages.addWidget(page)
        return self.applet_pages[applet_name]

    def show_page(self, page):
        self.showing_page = True
        if len(page) == 1:
            if self.aero:
                self.show_aero_home(self.search.text())
            else:
                self.pages.setCurrentWidget(self.home_view)
            self.show_selection()
        elif self.aero and page[1] in AERO_CATEGORIES:
            self.pages.setCurrentWidget(self.category_detail(page[1]))
        elif self.aero and page == SCREEN_RESOLUTION_PAGE:
            if self.screen_resolution is None:
                self.screen_resolution = ScreenResolutionPage(self.actions, self.change_screen_area)
                self.screen_resolution.finished.connect(lambda: self.jump(-1))
                self.pages.addWidget(self.screen_resolution)
            self.screen_resolution.refresh_screen()
            self.pages.setCurrentWidget(self.screen_resolution)
            size = self.screen_resolution.sizeHint() + QSize(0, self.toolbar.sizeHint().height())
            self.resize(self.size().expandedTo(size.boundedTo(self.screen().availableGeometry().size())))
        else:
            applet_page = self.page_for(page[1])
            applet_page.tabs.setCurrentIndex(applet_page.tab_index(page[2]) if len(page) > 2 else 0)
            self.pages.setCurrentWidget(applet_page)
            self.resize(self.size().expandedTo(self.minimumSizeHint()))
            self.status_message.clear()
        self.showing_page = False
        self.refresh_navigation()

    def apply_changes(self, changes):
        live = {key: changes[key] for key in LIVE_KEYS if key in changes}
        changes = {key: value for key, value in changes.items() if key not in LIVE_KEYS}
        if live.get("SCREEN_AREA"):
            self.change_screen_area(live["SCREEN_AREA"])
        if not changes:
            return True
        settings = read_settings(self.settings_path)
        # A page that applies a whole look sends every value it shows: only the ones that differ are set again.
        changes = {key: value for key, value in changes.items() if settings.get(key) != value}
        settings.update(changes)
        write_settings(self.settings_path, settings)
        # The same names are on several pages (Distro Setup and the pages they come from): each open one shows them.
        for page in [*self.applet_pages.values(), *(window.page for window in self.applet_windows.values())]:
            page.take_applied(settings, changes)
        repo = settings.get("REPO", "")
        if not repo or not Path(repo, "install.sh").is_file():
            self.actions.show_message(
                self,
                "Setup files not found",
                "The Chicago95 Plasma folder is not known. Run install.sh once from it, then try again.",
            )
            return False
        if chicago95apply.appliers_for(changes, settings):
            self.actions.run_setup(self, apply_command(repo, self.settings_path, list(changes)))
        return True

    def change_screen_area(self, area):
        """A new size for the screen, kept only when confirmed in time; otherwise the old size and its slider return."""
        screen = self.actions.current_screen()
        if screen is None or area not in screen.modes:
            return None
        if area == screen.current:
            return screen.current
        self.actions.set_screen_mode(screen.output, screen.modes[area])
        if self.actions.keep_screen_mode(self):
            return area
        self.actions.set_screen_mode(screen.output, screen.modes[screen.current])
        for sheet in [window.page for window in self.applet_windows.values()] + list(self.applet_pages.values()):
            for tab in sheet.settings_tabs:
                if hasattr(tab, "screen_area"):
                    tab.screen_area.set_value(screen.current)
        return screen.current

    def tab_changed(self, applet_name, index):
        if self.showing_page:
            return
        page = self.applet_pages[applet_name]
        self.history.visit(page_location(applet_name, index, page.tabs.tabText(index)))
        self.refresh_navigation()

    def refresh_navigation(self):
        current = self.history.current
        if not self.win95:
            self.address_bar.show_page(current)
        self.back_action.setEnabled(self.history.can_go_back)
        self.forward_action.setEnabled(self.history.can_go_forward)
        self.up_action.setEnabled(parent_location(current) != current)
        if self.aero:
            self.home_heading.setVisible(current == HOME_PAGE)
            return
        if self.win95:
            return
        self.back_action.setMenu(self.history_menu(self.history.pages_before, -1))
        self.forward_action.setMenu(self.history_menu(self.history.pages_after, 1))

    def history_menu(self, pages, direction):
        if not pages:
            return None
        menu = QMenu(self)
        for distance, page in enumerate(pages, start=1):
            menu.addAction(breadcrumb_text(page)).triggered.connect(
                lambda _checked=False, steps=direction * distance: self.jump(steps)
            )
        return menu


INSTANCE_NAME = "chicago95-control-panel"


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Control Panel")
    parser.add_argument("--page", choices=sorted(PAGE_SLUGS), help="open this applet's page")
    parser.add_argument("--screenshot", metavar="PNG", help="save a picture of the window and exit")
    arguments = parser.parse_args()
    app = chicago95ui.make_app("Control Panel")
    app.setDesktopFileName(INSTANCE_NAME)
    # One window: a later launch (Properties on the taskbar) hands its page to the open one, which comes back up.
    if not arguments.screenshot and chicago95ui.send_to_running(INSTANCE_NAME, arguments.page or ""):
        return 0
    window = ControlPanel()
    if not arguments.screenshot:
        window.show()
    if arguments.page:
        window.open_applet(PAGE_SLUGS[arguments.page])
    if arguments.screenshot:
        target = window.applet_windows.get(PAGE_SLUGS.get(arguments.page), window)
        return 0 if target.grab().save(arguments.screenshot) else 1
    instance = chicago95ui.SingleInstance(INSTANCE_NAME, window.show_again)  # noqa: F841  kept alive with the window
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
