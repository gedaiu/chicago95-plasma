class ControlPanel(QMainWindow):
    def __init__(self, settings_path=SETTINGS_FILE, actions=None):
        super().__init__()
        self.settings_path = Path(settings_path)
        self.actions = actions or Actions()
        self.history = NavigationHistory(HOME_PAGE)
        self.applet_pages = {}
        self.showing_page = False
        self.setWindowTitle("Control Panel")
        self.setWindowIcon(QIcon.fromTheme("preferences-system"))
        self.resize(500, 420)
        self.icon_view = self.build_icon_view()
        self.pages = QStackedWidget()
        self.pages.addWidget(self.icon_view)
        self.setCentralWidget(self.pages)
        self.build_header()
        self.build_status_bar()
        self.set_view("Large Icons")
        self.show_selection()
        self.refresh_navigation()

    def build_icon_view(self):
        view = QListWidget()
        view.setMovement(QListView.Static)
        view.setSpacing(0)
        view.setWordWrap(True)
        view.setResizeMode(QListView.Adjust)
        view.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        view.setLineWidth(2)
        for applet in APPLETS:
            item = QListWidgetItem(themed_icon(applet.icon_names), applet.name)
            item.setData(Qt.UserRole, applet)
            view.addItem(item)
        view.itemSelectionChanged.connect(self.show_selection)
        view.itemActivated.connect(lambda item: self.open_applet(item.data(Qt.UserRole).name))
        return view

    def build_status_bar(self):
        """Windows 98's status bar: three sunken panes (the message, a spare one, the place) and a size grip."""
        bar = self.statusBar()
        bar.setFixedHeight(STATUS_BAR_HEIGHT)
        bar.setSizeGripEnabled(True)
        self.status_message = QLabel()
        place = QWidget()
        place_layout = QHBoxLayout(place)
        place_layout.setContentsMargins(2, 0, 0, 0)
        place_layout.setSpacing(4)
        self.status_place_icon = QLabel()
        icon = themed_icon(("computer",))
        self.status_place_icon.setPixmap(icon.pixmap(16, 16) if not icon.isNull() else start_logo_pixmap().scaled(16, 16, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        place_layout.addWidget(self.status_place_icon)
        place_layout.addWidget(QLabel("My Computer"), 1)
        self.status_panes = (self.status_message, QLabel(), place)
        for pane, stretch in zip(self.status_panes, (5, 2, 3)):
            bar.addPermanentWidget(pane, stretch)

    def build_header(self):
        self.menu_bar = QMenuBar()
        self.menu_bar.setFixedHeight(MENU_BAR_HEIGHT)
        self.build_menus()
        self.toolbar = self.build_standard_toolbar()
        self.logo_box = LogoBox()
        known_pages = [HOME_PAGE] + [HOME_PAGE + (applet.name,) for applet in APPLETS if not applet.external_tool]
        self.address_bar = AddressBar(known_pages)
        self.address_bar.navigate.connect(self.navigate)
        self.header = QWidget()
        layout = QVBoxLayout(self.header)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        for band in (HeaderBand(self.menu_bar, trailing=self.logo_box), HeaderBand(self.toolbar, TOOLBAR_HEIGHT), HeaderBand(self.address_bar), HeaderBand(None, 0, grip=False)):
            layout.addWidget(band)
        self.setMenuWidget(self.header)

    def build_menus(self):
        menu_bar = self.menu_bar
        for title in ("&File", "&Edit"):
            menu_bar.addMenu(title)
        self.view_menu = menu_bar.addMenu("&View")
        view_choices = QActionGroup(self)
        for name, mode in VIEW_MODES.items():
            choice = self.view_menu.addAction(mode.menu_text)
            choice.setCheckable(True)
            choice.setChecked(name == "Large Icons")
            choice.triggered.connect(lambda _checked=False, name=name: self.set_view(name))
            view_choices.addAction(choice)
        for title in ("&Go", "F&avorites", "&Help"):
            menu_bar.addMenu(title)

    def build_standard_toolbar(self):
        toolbar = QWidget()
        toolbar.setFixedHeight(TOOLBAR_HEIGHT)
        layout = QHBoxLayout(toolbar)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        self.back_action = QAction(QIcon.fromTheme("go-previous"), "Back", self)
        self.forward_action = QAction(QIcon.fromTheme("go-next"), "Forward", self)
        self.up_action = QAction(QIcon.fromTheme("go-up"), "Up", self)
        views_action = QAction(QIcon.fromTheme("view-list-icons"), "Views", self)
        views_action.setMenu(self.view_menu)
        self.back_action.triggered.connect(lambda: self.jump(-1))
        self.forward_action.triggered.connect(lambda: self.jump(1))
        self.up_action.triggered.connect(lambda: self.navigate(parent_location(self.history.current)))
        self.toolbar_buttons = {}
        for action, has_menu in ((self.back_action, True), (self.forward_action, True), (self.up_action, False)):
            self.toolbar_buttons[action.text()] = ToolbarButton(action, has_menu)
            layout.addWidget(self.toolbar_buttons[action.text()])
        separator = QFrame()
        separator.setFrameStyle(QFrame.VLine | QFrame.Sunken)
        separator.setFixedWidth(6)
        layout.addWidget(separator)
        self.toolbar_buttons["Views"] = ToolbarButton(views_action, has_menu=True)
        layout.addWidget(self.toolbar_buttons["Views"])
        layout.addStretch(1)
        return toolbar

    def set_view(self, name):
        view = VIEW_MODES[name]
        self.icon_view.setViewMode(view.mode)
        self.icon_view.setFlow(view.flow)
        self.icon_view.setWrapping(view.wrapping)
        self.icon_view.setIconSize(QSize(view.icon_size, view.icon_size))
        self.icon_view.setGridSize(view.grid)
        for row in range(self.icon_view.count()):
            item = self.icon_view.item(row)
            applet = item.data(Qt.UserRole)
            item.setText(f"{applet.name}{DETAILS_SEPARATOR}{applet.description}" if view.shows_description else applet.name)

    def show_selection(self):
        selected = self.icon_view.selectedItems()
        self.status_message.setText(selected[0].data(Qt.UserRole).description if selected else f"{self.icon_view.count()} object(s)")

    def open_applet(self, name):
        applet = APPLET_BY_NAME[name]
        if applet.external_tool:
            self.actions.start_process(tool_path(applet.external_tool), [])
            return
        self.navigate(HOME_PAGE + (name,))

    def navigate(self, page):
        if not self.may_go_to(page):
            return
        self.history.visit(page)
        self.show_page(page)

    def jump(self, steps):
        pages = self.history.pages_before if steps < 0 else self.history.pages_after
        if not self.may_go_to(pages[abs(steps) - 1]):
            return
        step = self.history.back if steps < 0 else self.history.forward
        for _ in range(abs(steps)):
            step()
        self.show_page(self.history.current)

    def current_applet_page(self):
        page = self.pages.currentWidget()
        return page if isinstance(page, PropertiesPage) else None

    def may_go_to(self, target):
        """Leaving an applet's page with changes not applied asks first; moving between its tabs does not."""
        page = self.current_applet_page()
        staying = page is not None and len(target) > 1 and target[1] == page.title
        return page is None or staying or self.can_leave(page)

    def can_leave(self, page):
        if not page.changed_values():
            return True
        answer = self.actions.ask_to_apply(self)
        if answer == "cancel":
            return False
        if answer == "yes":
            return page.apply()
        page.discard_changes()
        return True

    def closeEvent(self, event):
        page = self.current_applet_page()
        if page is None or self.can_leave(page):
            event.accept()
        else:
            event.ignore()

    def page_for(self, applet_name):
        if applet_name not in self.applet_pages:
            settings = read_settings(self.settings_path)
            tabs = [(tab_name, build_tab(applet_name, tab_name, settings, self.actions)) for tab_name in PAGE_TABS[applet_name]]
            page = PropertiesPage(applet_name, tabs, self.apply_changes)
            page.finished.connect(lambda: self.navigate(HOME_PAGE))
            page.tabs.currentChanged.connect(lambda index, name=applet_name: self.tab_changed(name, index))
            self.applet_pages[applet_name] = page
            self.pages.addWidget(page)
        return self.applet_pages[applet_name]

    def show_page(self, page):
        self.showing_page = True
        if len(page) == 1:
            self.pages.setCurrentWidget(self.icon_view)
            self.show_selection()
        else:
            applet_page = self.page_for(page[1])
            applet_page.tabs.setCurrentIndex(applet_page.tab_names().index(page[2]) if len(page) > 2 else 0)
            self.pages.setCurrentWidget(applet_page)
            self.status_message.clear()
        self.showing_page = False
        self.refresh_navigation()

    def apply_changes(self, changes):
        settings = read_settings(self.settings_path)
        settings.update(changes)
        write_settings(self.settings_path, settings)
        repo = settings.get("REPO", "")
        if not repo or not Path(repo, "install.sh").is_file():
            self.actions.show_message(self, "Setup files not found",
                                      "The Chicago95 Plasma folder is not known. Run install.sh once from it, then try again.")
            return False
        components = components_for(changes)
        if components:
            self.actions.run_setup(self, setup_command(repo, self.settings_path, components))
        return True

    def tab_changed(self, applet_name, index):
        if self.showing_page:
            return
        self.history.visit(page_location(applet_name, index))
        self.refresh_navigation()

    def refresh_navigation(self):
        current = self.history.current
        self.address_bar.show_page(current)
        self.back_action.setEnabled(self.history.can_go_back)
        self.forward_action.setEnabled(self.history.can_go_forward)
        self.up_action.setEnabled(parent_location(current) != current)
        self.back_action.setMenu(self.history_menu(self.history.pages_before, -1))
        self.forward_action.setMenu(self.history_menu(self.history.pages_after, 1))

    def history_menu(self, pages, direction):
        if not pages:
            return None
        menu = QMenu(self)
        for distance, page in enumerate(pages, start=1):
            menu.addAction(breadcrumb_text(page)).triggered.connect(lambda _checked=False, steps=direction * distance: self.jump(steps))
        return menu


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Control Panel")
    parser.add_argument("--page", choices=sorted(PAGE_SLUGS), help="open this applet's page")
    parser.add_argument("--screenshot", metavar="PNG", help="save a picture of the window and exit")
    arguments = parser.parse_args()
    app = chicago95ui.make_app("Control Panel")
    window = ControlPanel()
    if arguments.page:
        window.open_applet(PAGE_SLUGS[arguments.page])
    if arguments.screenshot:
        return 0 if window.grab().save(arguments.screenshot) else 1
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
