LOOK_BUTTON_WIDTH, MIN_BUTTON_WIDTH, MAX_BUTTON_WIDTH = 160, 60, 300

COLORS_PATTERN = re.compile(r"^#[0-9A-Fa-f]{6}(,#[0-9A-Fa-f]{6})?$")


class NavigationHistory:
    """The pages visited, as Explorer's Back and Forward walk them; a page is a tuple, ("Control Panel", "Taskbar")."""

    def __init__(self, home):
        self.pages = [home]
        self.position = 0

    @property
    def current(self):
        return self.pages[self.position]

    @property
    def can_go_back(self):
        return self.position > 0

    @property
    def can_go_forward(self):
        return self.position < len(self.pages) - 1

    @property
    def pages_before(self):
        return self.pages[: self.position][::-1]

    @property
    def pages_after(self):
        return self.pages[self.position + 1 :]

    def visit(self, page):
        if page == self.current:
            return
        self.pages = self.pages[: self.position + 1] + [page]
        self.position += 1

    def back(self):
        self.position = max(0, self.position - 1)
        return self.current

    def forward(self):
        self.position = min(len(self.pages) - 1, self.position + 1)
        return self.current


def parent_location(page):
    return page[:-1] or page


def breadcrumb_text(page):
    return " > ".join(page)


def read_settings(path):
    if not Path(path).exists():
        return {}
    lines = [line for line in Path(path).read_text().splitlines() if "=" in line and not line.startswith("#")]
    return dict(line.split("=", 1) for line in lines)


def write_settings(path, settings):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text("".join(f"{key}={value}\n" for key, value in settings.items()))


def with_look_values(changed, saved):
    look = changed.get("LOOK")
    if look not in LOOK_PRESETS:
        return changed
    differing = {key: value for key, value in desktop_theme(look, saved).items() if saved.get(key) != value}
    return {**differing, **changed}


def components_for(changed_keys):
    needed = {component for key in changed_keys for component in COMPONENTS_BY_KEY.get(key, ())}
    return [component for component in INSTALL_ORDER if component in needed]


# Setup restarts plasmashell, and the Control Panel may have been started by it (from the taskbar): in
# its own systemd scope, Setup isn't stopped along with plasmashell's service halfway through.
OWN_SCOPE = ["systemd-run", "--user", "--scope", "--quiet", "--collect"]


def setup_command(repo, settings_path, components):
    return OWN_SCOPE + [
        f"{repo}/install.sh",
        "--plain",
        "--yes",
        f"--settings={settings_path}",
        f"--components={','.join(components)}",
    ]


def apply_command(repo, settings_path, changed_keys):
    """Sets the changed choices alone: the checkout's lib/chicago95apply.py knows what each one needs."""
    return OWN_SCOPE + [
        "python3",
        f"{repo}/lib/chicago95apply.py",
        f"--settings={settings_path}",
        f"--changed={','.join(changed_keys)}",
    ]


def update_command(repo, settings_path, components):
    """Pulls the repository forward, then reruns Setup for the components the saved settings touch."""
    return OWN_SCOPE + [
        "sh",
        "-c",
        'git -C "$1" pull --ff-only && "$1/install.sh" --plain --yes "--settings=$2" "$3"',
        "chicago95-update",
        repo,
        str(settings_path),
        f"--components={','.join(components)}",
    ]


def valid_colors(text):
    return COLORS_PATTERN.match(text) is not None


def tab_rows(widths, available):
    """Tabs wrapped into rows that fit `available`; each row is stretched to fill it. Rows of (index, width)."""
    rows, current, used = [], [], 0
    for index, width in enumerate(widths):
        if current and used + width > available:
            rows.append(current)
            current, used = [], 0
        current.append((index, width))
        used += width
    rows.append(current)
    return rows if len(rows) == 1 else [stretch_row(row, available) for row in rows]


def stretch_row(row, available):
    extra = available - sum(width for _index, width in row)
    return [
        (index, width + extra // len(row) + (position < extra % len(row)))
        for position, (index, width) in enumerate(row)
    ]


def rows_for_selected(rows, selected):
    """The row with the selected tab goes to the bottom, against the page; the rows after it come to the top."""
    at = next(position for position, row in enumerate(rows) if any(index == selected for index, _width in row))
    return rows[at + 1 :] + rows[: at + 1]


def parse_screensavers(output):
    return [tuple(line.split("\t", 1)) for line in output.splitlines() if "\t" in line]


def installed_sound_themes(roots):
    themes = {}
    for root in roots:
        for index_file in sorted(Path(root).glob("*/index.theme")):
            theme_id = index_file.parent.name
            if theme_id in themes or not (index_file.parent / "stereo").is_dir():
                continue
            index = configparser.ConfigParser(interpolation=None, strict=False)
            index.read(index_file)
            themes[theme_id] = index.get("Sound Theme", "Name", fallback=theme_id)
    return sorted(themes.items(), key=lambda theme: (theme[0] != "Chicago95", theme[1]))


def read_launchers(appletsrc_path):
    """The Quick Launch the task list saved, or None when it never saved one (it then shows its defaults)."""
    applets = configparser.ConfigParser(interpolation=None, strict=False)
    applets.optionxform = str
    applets.read(appletsrc_path)
    for applet_group in applets.sections():
        general_group = f"{applet_group}][Configuration][General"
        if applets[applet_group].get("plugin") == "org.chicago95.tasks" and applets.has_option(
            general_group, "launchers"
        ):
            return [launcher for launcher in applets[general_group]["launchers"].split(",") if launcher]
    return None


def screensaver_hidden_by_lock(idle_minutes, lock_minutes):
    return idle_minutes >= lock_minutes


def launcher_for_desktop_file(path):
    """A program from the applications menu is named by its menu id; any other .desktop file by its URL."""
    for folder in (Path("/usr/share/applications"), Path.home() / ".local/share/applications"):
        if Path(path).parent == folder:
            return f"applications:{Path(path).name}"
    return f"file://{path}"


DEFAULT_LAUNCHER_FILES = [
    Path.home() / ".local/share/plasma/plasmoids/org.chicago95.tasks/contents/config/main.xml",
    Path(__file__).resolve().parent.parent / "plasmoids/org.chicago95.tasks/contents/config/main.xml",
]


def default_launchers(config_files):
    """The Quick Launch programs the task list starts with, from the first of its settings files that exists."""
    kcfg = "{http://www.kde.org/standards/kcfg/1.0}"
    for config_file in filter(Path.exists, map(Path, config_files)):
        for entry in ElementTree.parse(config_file).iter(f"{kcfg}entry"):
            if entry.get("name") == "launchers":
                return [launcher for launcher in entry.findtext(f"{kcfg}default", "").split(",") if launcher]
    return []


def live_launchers():
    return read_launchers(APPLETS_FILE)


@dataclass(frozen=True)
class Screen:
    output: str
    current: str  # "WIDTHxHEIGHT"
    sizes: list  # every size it offers, smallest first
    modes: dict  # size -> kscreen-doctor mode id, the fastest refresh of that size


def screen_size(mode):
    return f"{mode['size']['width']}x{mode['size']['height']}"


def screen_from_doctor(report):
    """The first enabled output of `kscreen-doctor -j`: its size now and the sizes it offers."""
    output = next((output for output in report.get("outputs", []) if output.get("enabled")), None)
    if output is None:
        return None
    fastest = {}
    for mode in sorted(output["modes"], key=lambda mode: mode.get("refreshRate", 0)):
        fastest[screen_size(mode)] = mode["id"]
    current = next(screen_size(mode) for mode in output["modes"] if mode["id"] == output["currentModeId"])
    sizes = sorted(fastest, key=lambda size: tuple(int(side) for side in size.split("x")))
    return Screen(output["name"], current, sizes, {size: fastest[size] for size in sizes})


def native_environment():
    """The environment for KDE's own tools: this program's Qt platform is not theirs."""
    dropped = ("QT_QPA_PLATFORM", "QT_STYLE_OVERRIDE") if chicago95ui.luna_widgets() else ("QT_QPA_PLATFORM",)
    return {key: value for key, value in os.environ.items() if key not in dropped}


def live_screen():
    if not chicago95ui.compositor_reachable():
        return None
    try:
        report = subprocess.run(
            ["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=5, env=native_environment(), check=False
        )
        return screen_from_doctor(json.loads(report.stdout))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def set_screen_mode(output, mode):
    subprocess.run(
        ["kscreen-doctor", f"output.{output}.mode.{mode}"],
        capture_output=True,
        timeout=15,
        env=native_environment(),
        check=False,
    )


def display_depth(output):
    display = next((screen for screen in QGuiApplication.screens() if screen.name() == output), None)
    display = display or QGuiApplication.primaryScreen()
    return display.depth() if display is not None else 0


KEEP_SCREEN_SECONDS = 15


def keep_screen_mode(parent):
    """Windows 98's question after a new screen area: kept only when answered Yes within 15 seconds."""
    box = QMessageBox(QMessageBox.Question, "Monitor Settings", "", QMessageBox.Yes | QMessageBox.No, parent)
    box.setDefaultButton(QMessageBox.No)
    left = {"seconds": KEEP_SCREEN_SECONDS}

    def tick():
        box.setText(
            "Your desktop has been reconfigured. Do you want to keep these settings?\n\n"
            f"Reverting in {left['seconds']} seconds."
        )
        left["seconds"] -= 1
        if left["seconds"] < 0:
            box.done(QMessageBox.No)

    timer = QTimer(box)
    timer.timeout.connect(tick)
    tick()
    timer.start(1000)
    return box.exec() == QMessageBox.Yes


def installed_screensavers():
    try:
        listing = subprocess.run(
            [tool_path("chicago95-screensaver"), "--list"], capture_output=True, text=True, timeout=10, check=False
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse_screensavers(listing)


def lock_timeout_minutes():
    """Minutes before KDE locks the screen, 5 unless it says otherwise."""
    try:
        answer = subprocess.run(
            ["kreadconfig6", "--file", "kscreenlockerrc", "--group", "Daemon", "--key", "Timeout"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        ).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 5
    return int(answer) if answer.isdigit() else 5


def clear_layout(layout):
    """Removes and hides every widget at once; deleteLater alone leaves the old ones painted until the event
    loop runs."""
    while layout.count():
        widget = layout.takeAt(0).widget()
        if widget is not None:
            widget.hide()
            widget.setParent(None)
            widget.deleteLater()


TAB_BUILDERS = {}


def tab_builder(applet_name, tab_name):
    def register(builder):
        TAB_BUILDERS[(applet_name, tab_name)] = builder
        return builder

    return register


def build_tab(applet_name, tab_name, settings, actions):
    return TAB_BUILDERS.get((applet_name, tab_name), SettingsTab)(settings, actions)


def themed_icon(names):
    return next((icon for icon in map(QIcon.fromTheme, names) if not icon.isNull()), QIcon())


def tool_path(name):
    """The tool beside this Control Panel (both installed by Setup, or both in the checkout), so a checkout's Control
    Panel never draws with an older installed copy; the installed one when there is none beside it."""
    beside = Path(__file__).resolve().parent / name
    return str(beside if beside.exists() else Path.home() / ".local/bin" / name)


def screensaver_picture_dir():
    """The Screen Saver tab's monitor pictures (data/screensaver-previews): installed by Setup, or the checkout's."""
    installed = Path.home() / ".local/share/chicago95/screensaver-previews"
    return installed if installed.is_dir() else Path(__file__).resolve().parent.parent / "data/screensaver-previews"


def start_detached(program, arguments):
    QProcess.startDetached(program, arguments)


LIST_ROW_HEIGHT = 13  # tests/references/listbox-selected.png
PROGRESS_CHUNK, PROGRESS_GAP, PROGRESS_FRAME, PROGRESS_INSET = 14, 2, 2, 3  # tests/references/progressbar.png


class ClassicProgressBar(QProgressBar):
    """A progress bar of separate navy blocks in a sunken frame, as the originals drew it."""

    def paintEvent(self, _event):
        painter = QPainter(self)
        frame = QStyleOptionFrame()
        frame.initFrom(self)
        frame.rect = self.rect()
        frame.lineWidth = PROGRESS_FRAME
        frame.state |= QStyle.State_Sunken
        self.style().drawPrimitive(QStyle.PE_Frame, frame, painter, self)
        inner = self.rect().adjusted(PROGRESS_INSET, PROGRESS_INSET, -PROGRESS_INSET, -PROGRESS_INSET)
        span = self.maximum() - self.minimum()
        filled = inner.width() * (self.value() - self.minimum()) // span if span else 0
        painter.setPen(Qt.NoPen)
        painter.setBrush(self.palette().highlight())
        left = inner.left()
        while left + PROGRESS_CHUNK <= inner.left() + filled:
            painter.drawRect(QRect(left, inner.top(), PROGRESS_CHUNK, inner.height()))
            left += PROGRESS_CHUNK + PROGRESS_GAP


class ApplyQuestion(QDialog):
    """Do you want to apply your changes? Yes, No or Cancel, centred under the question
    as the classic message box has them."""

    BUTTON_GAP, TEXT_TO_BUTTONS, MARGIN = 6, 18, 11  # tests/references/messagebox-yesnocancel.png

    def __init__(self, parent):
        super().__init__(parent)
        self.setWindowTitle("Control Panel")
        self.answer = "cancel"
        self.text = QLabel("Do you want to apply your changes?")
        self.buttons = {name: chicago95ui.dialog_button(name) for name in ("Yes", "No", "Cancel")}
        row = QHBoxLayout()
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(self.BUTTON_GAP)
        row.addStretch(1)
        for name, button in self.buttons.items():
            button.clicked.connect(lambda _checked=False, name=name: self.choose(name))
            row.addWidget(button)
        row.addStretch(1)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(self.MARGIN, self.MARGIN, self.MARGIN, self.MARGIN)
        layout.setSpacing(self.TEXT_TO_BUTTONS)
        layout.addWidget(self.text)
        layout.addLayout(row)
        self.buttons["Yes"].setDefault(True)

    def choose(self, name):
        self.answer = name.lower()
        self.accept() if name != "Cancel" else self.reject()


class ApplyProgress(QDialog):
    """Shown while Setup applies the changes: a busy bar, and Setup's output behind a Details button."""

    def __init__(self, parent, command):
        super().__init__(parent)
        self.command = command
        self.failed = False
        self.setWindowTitle("Applying changes")
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        environment = QProcessEnvironment.systemEnvironment()
        environment.insert("SUDO_ASKPASS", tool_path("chicago95-askpass"))
        self.process.setProcessEnvironment(environment)
        self.process.readyReadStandardOutput.connect(self.read_output)
        self.process.finished.connect(self.finish)
        self.process.errorOccurred.connect(
            lambda error: self.fail(f"Setup could not be started ({self.command[0]}): {error.name}")
        )
        self.label = QLabel("Please wait while the changes are applied...")
        self.bar = window_chrome().progress_bar()
        self.bar.setRange(0, 100)
        self.bar.setTextVisible(False)
        self.pulse = QTimer(self)
        self.pulse.setInterval(80)
        self.pulse.timeout.connect(lambda: self.bar.setValue((self.bar.value() + 3) % 101))
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.hide()
        self.details_button = chicago95ui.dialog_button("Details >>")
        self.details_button.clicked.connect(self.details_clicked)
        layout = QVBoxLayout(self)
        for widget in (self.label, self.bar, self.log):
            layout.addWidget(widget)
        layout.addWidget(self.details_button, 0, Qt.AlignRight)
        self.setMinimumWidth(380)

    def start(self):
        self.pulse.start()
        self.process.start(self.command[0], self.command[1:])

    def read_output(self):
        self.log.appendPlainText(bytes(self.process.readAllStandardOutput()).decode(errors="replace").rstrip("\n"))

    def finish(self, exit_code, _exit_status):
        self.pulse.stop()
        if exit_code == 0:
            self.accept()
        else:
            self.fail(f"Setup stopped with exit code {exit_code}.")

    def fail(self, reason):
        self.failed = True
        self.pulse.stop()
        self.bar.setValue(0)
        self.label.setText("The changes could not be applied.")
        self.log.appendPlainText(reason)
        self.log.show()
        self.details_button.setText("Close")

    def details_clicked(self):
        if self.failed:
            self.reject()
            return
        self.log.setVisible(self.log.isHidden())
        self.details_button.setText("Details >>" if self.log.isHidden() else "<< Details")


def run_setup_in_background(parent, command):
    progress = ApplyProgress(parent, command)
    progress.start()
    progress.exec()


SOUND_ROOTS = (Path.home() / ".local/share/sounds", Path("/usr/share/sounds"))
PICTURE_FILTER = "Pictures (*.png *.jpg *.jpeg *.svg *.bmp *.gif);;All files (*)"


def choose_file_dialog(parent, title, name_filter):
    return QFileDialog.getOpenFileName(parent, title, str(Path.home()), name_filter)[0]


def choose_color_dialog(parent, current):
    start = QColor(current.split(",")[0])
    chosen = QColorDialog.getColor(start if start.isValid() else QColor("#008080"), parent)
    return chosen.name().upper() if chosen.isValid() else ""


def show_message(parent, title, text):
    if not chicago95ui.luna_widgets():
        QMessageBox.warning(parent, title, text)
        return
    box = QMessageBox(QMessageBox.Warning, title, text, QMessageBox.Ok, parent)
    box.setFont(parent.font())
    box.findChild(QDialogButtonBox).setCenterButtons(True)
    warning = box.style().standardIcon(QStyle.SP_MessageBoxWarning)
    box.setIconPixmap(warning.pixmap(QSize(24, 24), box.devicePixelRatioF()))
    label = box.findChild(QLabel, "qt_msgbox_label")
    if label is not None:
        label.setMinimumHeight(31)
        label.setAlignment(Qt.AlignLeading | Qt.AlignVCenter)
    box.layout().setContentsMargins(11, 11, 11, 12)
    button = box.button(QMessageBox.Ok)
    button.setStyle(chicago95ui.classic_style())
    button.setFixedSize(80, 24)
    box.exec()


def ask_to_apply_changes(parent):
    question = ApplyQuestion(parent)
    question.exec()
    return question.answer


PICTURE_SUFFIXES = {".png", ".jpg", ".jpeg", ".bmp", ".gif", ".svg", ".webp"}


def find_wallpapers(home=None, system=Path("/usr/share/wallpapers")):
    """(label, path) of the pictures to offer: those in ~/Pictures, then each Plasma wallpaper's largest image."""
    pictures = Path(home or Path.home()) / "Pictures"
    found = [
        (picture.stem, str(picture))
        for picture in sorted(pictures.glob("*"))
        if picture.suffix.lower() in PICTURE_SUFFIXES and picture.is_file()
    ]
    for images in sorted(Path(system).glob("*/contents/images")):
        largest = max(images.glob("*"), key=lambda image: image.stat().st_size, default=None)
        if largest is not None:
            found.append((images.parent.parent.name, str(largest)))
    return found


def background_patterns(settings):
    """The desktop patterns Setup draws (setup/background_pattern.py), by name, as 8 rows of bits."""
    script = Path(settings.get("REPO") or REPO_DIR) / "setup/background_pattern.py"
    if not script.exists():
        return {}
    spec = importlib.util.spec_from_file_location("background_pattern", script)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.PATTERNS


def choose_pattern_dialog(parent, current, patterns):
    """Windows 98's Pattern dialog: the patterns by name with (None) first, the chosen one previewed."""
    dialog = QDialog(parent)
    dialog.setWindowTitle("Pattern")
    names = QListWidget()
    names.addItem("(None)")
    for name in patterns:
        names.addItem(name.capitalize())
    choices = ["none", *patterns]
    names.setCurrentRow(choices.index(current) if current in choices else 0)
    buttons = QHBoxLayout()
    buttons.addStretch(1)
    for caption, slot in (("OK", dialog.accept), ("Cancel", dialog.reject)):
        button = chicago95ui.dialog_button(caption)
        button.clicked.connect(slot)
        buttons.addWidget(button)
    layout = QVBoxLayout(dialog)
    layout.addWidget(QLabel("&Pattern:"))
    layout.addWidget(names)
    layout.addLayout(buttons)
    return choices[names.currentRow()] if dialog.exec() == QDialog.Accepted else None


