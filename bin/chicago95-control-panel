def branding_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    for key, label in (("EDITION", "Edition:"), ("TAGLINE", "Tagline:"), ("COMPANY", "Company:")):
        branding_field(tab, key, label, settings)
    branding_field(tab, "COMPANY_LOGO", "Company logo:", settings)
    tab.group("Preview (the log-on banner)")
    tab.preview(BrandingPreview())
    return tab


