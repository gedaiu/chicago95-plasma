    tab.form.addRow("", preview)
    tab.lock_warning = QLabel(f"Your screen locks after {actions.lock_timeout_minutes()} minutes, before the screen saver starts, so you will not see it.")
    tab.lock_warning.setWordWrap(True)
    tab.form.addRow("", tab.lock_warning)

    def show_warning():
        tab.lock_warning.setVisible(screensaver_hidden_by_lock(wait.value(), actions.lock_timeout_minutes()))

    wait.valueChanged.connect(show_warning)
    show_warning()
    return tab


SOUND_EVENTS = (("desktop-login", "Start Windows"), ("desktop-logout", "Exit Windows"), ("dialog-error", "Critical Stop"),
                ("dialog-warning", "Exclamation"), ("dialog-information", "Asterisk"), ("dialog-question", "Question"),
                ("bell-window-system", "Default Sound"), ("trash-empty", "Empty Recycle Bin"), ("window-maximized", "Maximize"),
                ("window-minimized", "Minimize"), ("menu-popup", "Menu Popup"))


@tab_builder("Sounds", "Sounds")
def sounds_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    themes = [(name, theme_id) for theme_id, name in installed_sound_themes(actions.sound_roots)]
    scheme = tab.choice("SOUND_THEME", "Scheme:", themes or [("Chicago95", "Chicago95")], default="Chicago95")
    events = QListWidget()
    for event, label in SOUND_EVENTS:
        events.addItem(label)
        events.item(events.count() - 1).setData(Qt.UserRole, event)
    player = actions.program_installed("pw-play") or actions.program_installed("paplay")
    play = chicago95ui.dialog_button("Play", enabled=bool(player))

    def play_selected():
        item = events.currentItem()
        if item is None:
            return
        sound = chicago95ui.sound_file(scheme.currentData(), item.data(Qt.UserRole), actions.sound_roots)
        if sound:
            actions.start_process(player, [sound])

    play.clicked.connect(play_selected)
    tab.form.addRow("Events:", events)
    tab.form.addRow("", play)
    return tab


