COLORS_PATTERN = re.compile(r"^#[0-9A-Fa-f]{6}(,#[0-9A-Fa-f]{6})?$")
BANNER_COLORS_PATTERN = re.compile(r"^#[0-9A-Fa-f]{6}(@[0-9]+)?(,#[0-9A-Fa-f]{6}(@[0-9]+)?)*$")


class NavigationHistory:
    """The pages visited, as Explorer's Back and Forward walk them; a page is a tuple, ("Control Panel", "Taskbar")."""

    def __init__(self, home):
        self.pages = [home]
        self.position = 0

    @property
    def current(self):
        return self.pages[self.position]

    @property
    def can_go_back(self):
        return self.position > 0

    @property
    def can_go_forward(self):
        return self.position < len(self.pages) - 1

    @property
    def pages_before(self):
        return self.pages[:self.position][::-1]

    @property
    def pages_after(self):
        return self.pages[self.position + 1:]

    def visit(self, page):
        if page == self.current:
            return
        self.pages = self.pages[:self.position + 1] + [page]
        self.position += 1

    def back(self):
        self.position = max(0, self.position - 1)
        return self.current

    def forward(self):
        self.position = min(len(self.pages) - 1, self.position + 1)
        return self.current


def parent_location(page):
    return page[:-1] or page


def breadcrumb_text(page):
    return " > ".join(page)


def read_settings(path):
    if not Path(path).exists():
        return {}
    lines = [line for line in Path(path).read_text().splitlines() if "=" in line and not line.startswith("#")]
    return dict(line.split("=", 1) for line in lines)


def write_settings(path, settings):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text("".join(f"{key}={value}\n" for key, value in settings.items()))


def components_for(changed_keys):
    needed = {component for key in changed_keys for component in COMPONENTS_BY_KEY.get(key, ())}
    return [component for component in INSTALL_ORDER if component in needed]


def setup_command(repo, settings_path, components):
    return [f"{repo}/install.sh", "--plain", "--yes", f"--settings={settings_path}", f"--components={','.join(components)}"]


def valid_colors(text):
    return COLORS_PATTERN.match(text) is not None


def valid_banner_colors(text):
    return BANNER_COLORS_PATTERN.match(text) is not None


def parse_screensavers(output):
    return [tuple(line.split("\t", 1)) for line in output.splitlines() if "\t" in line]


def installed_sound_themes(roots):
    themes = {}
    for root in roots:
        for index_file in sorted(Path(root).glob("*/index.theme")):
            theme_id = index_file.parent.name
            if theme_id in themes or not (index_file.parent / "stereo").is_dir():
                continue
            index = configparser.ConfigParser(interpolation=None, strict=False)
            index.read(index_file)
            themes[theme_id] = index.get("Sound Theme", "Name", fallback=theme_id)
    return sorted(themes.items(), key=lambda theme: (theme[0] != "Chicago95", theme[1]))


def read_launchers(appletsrc_path):
    """The Quick Launch the task list saved, or None when it never saved one (it then shows its defaults)."""
    applets = configparser.ConfigParser(interpolation=None, strict=False)
    applets.optionxform = str
    applets.read(appletsrc_path)
    for applet_group in applets.sections():
        general_group = f"{applet_group}][Configuration][General"
        if applets[applet_group].get("plugin") == "org.chicago95.tasks" and applets.has_option(general_group, "launchers"):
            return [launcher for launcher in applets[general_group]["launchers"].split(",") if launcher]
    return None


def screensaver_hidden_by_lock(idle_minutes, lock_minutes):
    return idle_minutes >= lock_minutes


def launcher_for_desktop_file(path):
    """A program from the applications menu is named by its menu id; any other .desktop file by its URL."""
    for folder in (Path("/usr/share/applications"), Path.home() / ".local/share/applications"):
        if Path(path).parent == folder:
            return f"applications:{Path(path).name}"
    return f"file://{path}"


DEFAULT_LAUNCHER_FILES = [Path.home() / ".local/share/plasma/plasmoids/org.chicago95.tasks/contents/config/main.xml",
                          Path(__file__).resolve().parent.parent / "plasmoids/org.chicago95.tasks/contents/config/main.xml"]


def default_launchers(config_files):
    """The Quick Launch programs the task list starts with, from the first of its settings files that exists."""
    kcfg = "{http://www.kde.org/standards/kcfg/1.0}"
    for config_file in filter(Path.exists, map(Path, config_files)):
        for entry in ElementTree.parse(config_file).iter(f"{kcfg}entry"):
            if entry.get("name") == "launchers":
                return [launcher for launcher in entry.findtext(f"{kcfg}default", "").split(",") if launcher]
    return []


def live_launchers():
    return read_launchers(APPLETS_FILE)


def installed_screensavers():
    try:
        listing = subprocess.run([tool_path("chicago95-screensaver"), "--list"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return parse_screensavers(listing)


def lock_timeout_minutes():
    """Minutes before KDE locks the screen, 5 unless it says otherwise."""
    try:
        answer = subprocess.run(["kreadconfig6", "--file", "kscreenlockerrc", "--group", "Daemon", "--key", "Timeout"],
                                capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 5
    return int(answer) if answer.isdigit() else 5


def clear_layout(layout):
    while layout.count():
        widget = layout.takeAt(0).widget()
        if widget is not None:
            widget.deleteLater()


TAB_BUILDERS = {}


def tab_builder(applet_name, tab_name):
    def register(builder):
        TAB_BUILDERS[(applet_name, tab_name)] = builder
        return builder
    return register


def build_tab(applet_name, tab_name, settings, actions):
    return TAB_BUILDERS.get((applet_name, tab_name), SettingsTab)(settings, actions)


def themed_icon(names):
    return next((icon for icon in map(QIcon.fromTheme, names) if not icon.isNull()), QIcon())


def tool_path(name):
    installed = Path.home() / ".local/bin" / name
    return str(installed if installed.exists() else Path(__file__).resolve().parent / name)


def start_detached(program, arguments):
    QProcess.startDetached(program, arguments)


class ApplyProgress(QDialog):
    """Shown while Setup applies the changes: a busy bar, and Setup's output behind a Details button."""

    def __init__(self, parent, command):
        super().__init__(parent)
        self.command = command
        self.failed = False
        self.setWindowTitle("Applying changes")
        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        environment = QProcessEnvironment.systemEnvironment()
        environment.insert("SUDO_ASKPASS", tool_path("chicago95-askpass"))
        self.process.setProcessEnvironment(environment)
        self.process.readyReadStandardOutput.connect(self.read_output)
        self.process.finished.connect(self.finish)
        self.process.errorOccurred.connect(lambda _error: self.fail(self.process.errorString()))
        self.label = QLabel("Please wait while the changes are applied...")
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.hide()
        self.details_button = chicago95ui.dialog_button("Details >>")
        self.details_button.clicked.connect(self.details_clicked)
        layout = QVBoxLayout(self)
        for widget in (self.label, self.bar, self.log):
            layout.addWidget(widget)
        layout.addWidget(self.details_button, 0, Qt.AlignRight)
        self.setMinimumWidth(380)

    def start(self):
        self.process.start(self.command[0], self.command[1:])

    def read_output(self):
        self.log.appendPlainText(bytes(self.process.readAllStandardOutput()).decode(errors="replace").rstrip("\n"))

    def finish(self, exit_code, _exit_status):
        if exit_code == 0:
            self.accept()
        else:
            self.fail(f"Setup stopped with exit code {exit_code}.")

    def fail(self, reason):
        self.failed = True
        self.bar.setRange(0, 1)
        self.label.setText("The changes could not be applied.")
        self.log.appendPlainText(reason)
        self.log.show()
        self.details_button.setText("Close")

    def details_clicked(self):
        if self.failed:
            self.reject()
            return
        self.log.setVisible(self.log.isHidden())
        self.details_button.setText("Details >>" if self.log.isHidden() else "<< Details")


def run_setup_in_background(parent, command):
    progress = ApplyProgress(parent, command)
    progress.start()
    progress.exec()


SOUND_ROOTS = (Path.home() / ".local/share/sounds", Path("/usr/share/sounds"))
PICTURE_FILTER = "Pictures (*.png *.jpg *.jpeg *.svg *.bmp *.gif);;All files (*)"


def choose_file_dialog(parent, title, name_filter):
    return QFileDialog.getOpenFileName(parent, title, str(Path.home()), name_filter)[0]


def choose_color_dialog(parent, current):
    start = QColor(current.split(",")[0])
    chosen = QColorDialog.getColor(start if start.isValid() else QColor("#008080"), parent)
    return chosen.name().upper() if chosen.isValid() else ""


def show_message(parent, title, text):
    QMessageBox.warning(parent, title, text)


def ask_to_apply_changes(parent):
    answer = QMessageBox.question(parent, "Control Panel", "Do you want to apply your changes?",
                                  QMessageBox.Yes | QMessageBox.No | QMessageBox.Cancel)
    return {QMessageBox.Yes: "yes", QMessageBox.No: "no"}.get(answer, "cancel")


@dataclass
class Actions:
    """What the window does outside itself; tests swap these for recorders."""
    start_process: Callable = start_detached
    run_setup: Callable = run_setup_in_background
    choose_file: Callable = choose_file_dialog
    choose_color: Callable = choose_color_dialog
    show_message: Callable = show_message
    ask_to_apply: Callable = ask_to_apply_changes
    program_installed: Callable = shutil.which
    current_launchers: Callable = live_launchers
    list_screensavers: Callable = installed_screensavers
    lock_timeout_minutes: Callable = lock_timeout_minutes
    sound_roots: tuple = SOUND_ROOTS


class AddressBar(QWidget):
    """Explorer's Address box as breadcrumbs: each part of the path is a button that goes there."""
    navigate = Signal(tuple)

    def __init__(self, known_pages):
        super().__init__()
        self.known_page_tuples = known_pages
        self.crumb_buttons = []
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(QLabel("Address"))
        self.box = QFrame()
        self.box.setFrameStyle(QFrame.Panel | QFrame.Sunken)
        self.box.setLineWidth(2)
        self.box.setAutoFillBackground(True)
        self.box.setBackgroundRole(self.backgroundRole().Base)
        self.crumb_layout = QHBoxLayout(self.box)
        self.crumb_layout.setContentsMargins(2, 0, 2, 0)
        self.crumb_layout.setSpacing(2)
        layout.addWidget(self.box, 1)
        self.dropdown = QToolButton()
        self.dropdown.setArrowType(Qt.DownArrow)
        self.dropdown.setPopupMode(QToolButton.InstantPopup)
        self.dropdown.setMenu(self.build_known_pages_menu())
        layout.addWidget(self.dropdown)

    def build_known_pages_menu(self):
        menu = QMenu(self)
        for page in self.known_page_tuples:
            menu.addAction(breadcrumb_text(page)).triggered.connect(lambda _checked=False, page=page: self.navigate.emit(page))
        return menu

    def show_page(self, page):
        clear_layout(self.crumb_layout)
        self.crumb_buttons = []
        for depth, part in enumerate(page, start=1):
            if depth > 1:
                self.crumb_layout.addWidget(QLabel(">"))
            crumb = QToolButton()
            crumb.setText(part)
            crumb.setAutoRaise(True)
            crumb.clicked.connect(lambda _checked=False, target=page[:depth]: self.navigate.emit(target))
            self.crumb_layout.addWidget(crumb)
            self.crumb_buttons.append(crumb)
        self.crumb_layout.addStretch(1)

    def crumbs(self):
        return [crumb.text() for crumb in self.crumb_buttons]

    def known_pages(self):
        return [breadcrumb_text(page) for page in self.known_page_tuples]


class PictureField(QWidget):
    """A picture setting: one of a few named presets, or a file the Browse button picks."""
    changed = Signal()

    def __init__(self, presets, choose_file):
        super().__init__()
        self.choose_file = choose_file
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        self.combo = QComboBox()
        for label, value in presets:
            self.combo.addItem(label, value)
        self.combo.addItem("Custom image...")
        self.combo.setVisible(bool(presets))
        self.path_edit = QLineEdit()
        self.browse_button = QPushButton("Browse...")
        for widget in (self.combo, self.path_edit, self.browse_button):
            layout.addWidget(widget)
        self.combo.currentIndexChanged.connect(self.choice_changed)
        self.path_edit.textChanged.connect(self.changed.emit)
        self.browse_button.clicked.connect(self.choose_custom_file)
        self.loading = False

    @property
    def is_custom(self):
        return self.combo.currentIndex() == self.combo.count() - 1

    def choice_changed(self):
        self.path_edit.setEnabled(self.is_custom)
        self.browse_button.setEnabled(self.is_custom)
        if not self.loading:
            self.changed.emit()

    def value(self):
        return self.path_edit.text() if self.is_custom else self.combo.currentData()

    def set_value(self, value):
        self.loading = True
        preset = self.combo.findData(value)
        self.combo.setCurrentIndex(preset if preset >= 0 else self.combo.count() - 1)
        self.path_edit.setText("" if preset >= 0 else value)
        self.choice_changed()
        self.loading = False

    def choose_custom_file(self):
        path = self.choose_file(self, "Choose a picture", PICTURE_FILTER)
        if not path:
            return
        self.combo.setCurrentIndex(self.combo.count() - 1)
        self.path_edit.setText(path)


class SettingsTab(QWidget):
    """A page of a property sheet: fields that each show and report one key of setup.conf."""
    changed = Signal()

    def __init__(self, settings, actions):
        super().__init__()
        self.actions = actions
        self.saved = dict(settings)
        self.loading = False
        self.fields = {}
        self.form = QFormLayout(self)
        self.form.setLabelAlignment(Qt.AlignRight)

    def notify(self):
        if not self.loading:
            self.changed.emit()

    def register(self, key, label, widget, getter, setter, default, signal):
        self.fields[key] = (getter, setter, default)
        setter(self.saved.get(key, default))
        signal.connect(lambda *_: self.notify())
        self.form.addRow(label, widget)
        return widget

    def values(self):
        return {key: getter() for key, (getter, _setter, _default) in self.fields.items()}

    def load(self, settings):
        self.loading = True
        for key, (_getter, setter, default) in self.fields.items():
            setter(settings.get(key, default))
        self.loading = False

    def text(self, key, label, default=""):
        edit = QLineEdit()
        return self.register(key, label, edit, edit.text, edit.setText, default, edit.textChanged)

    def choice(self, key, label, options, default):
        combo = QComboBox()
        for option_label, value in options:
            combo.addItem(option_label, value)

        def select(value):
            index = combo.findData(value)
            combo.setCurrentIndex(index if index >= 0 else combo.findData(default))

        return self.register(key, label, combo, combo.currentData, select, default, combo.currentIndexChanged)

    def flag(self, key, label, default="no"):
        box = QCheckBox(label)
        return self.register(key, "", box, lambda: "yes" if box.isChecked() else "no", lambda value: box.setChecked(value == "yes"), default, box.toggled)

    def number(self, key, label, minimum, maximum, default, suffix=""):
        spin = QSpinBox()
        spin.setRange(minimum, maximum)
        spin.setSuffix(suffix)
        return self.register(key, label, spin, lambda: str(spin.value()), lambda value: spin.setValue(int(value) if str(value).isdigit() else default),
                             default, spin.valueChanged)

    def font_family(self, key, label, default):
        combo = QComboBox()
        combo.addItems(QFontDatabase.families())

        def select(value):
            if combo.findText(value) < 0:
                combo.insertItem(0, value)
            combo.setCurrentIndex(combo.findText(value))

        return self.register(key, label, combo, combo.currentText, select, default, combo.currentIndexChanged)

    def picture(self, key, label, presets, default):
        field = PictureField(presets, lambda parent, title, name_filter: self.actions.choose_file(parent, title, name_filter))
        return self.register(key, label, field, field.value, field.set_value, default, field.changed)

    def color(self, key, label, default, validator=None):
        validator = validator or valid_colors
        edit = QLineEdit()
        choose = QPushButton("Choose...")
        row = QWidget()
        row_layout = QHBoxLayout(row)
        row_layout.setContentsMargins(0, 0, 0, 0)
        row_layout.addWidget(edit)
        row_layout.addWidget(choose)
        last_valid = {"color": default}

        def typed(text):
            valid = validator(text)
            last_valid["color"] = text if valid else last_valid["color"]
            edit.setProperty("invalid", not valid)
            palette = edit.palette()
            palette.setColor(QPalette.Text, QColor("#FF0000" if not valid else "#000000"))
            edit.setPalette(palette)

        edit.textChanged.connect(typed)
        choose.clicked.connect(lambda: edit.setText(self.actions.choose_color(self, last_valid["color"]) or edit.text()))
        self.register(key, label, row, lambda: last_valid["color"], edit.setText, default, edit.textChanged)
        return edit


class TaskButtonPreview(QWidget):
    """Two task buttons as wide as the width chosen, drawn with the widget style."""

    def __init__(self):
        super().__init__()
        self.button_width = LOOK_BUTTON_WIDTH
        self.setFixedHeight(28)

    def show_width(self, width):
        self.button_width = width
        self.update()

    def paintEvent(self, _event):
        painter = QPainter(self)
        for position, caption in enumerate(("Document", "Browser")):
            option = QStyleOptionButton()
            option.rect = QRect(position * (self.button_width + 3), 0, self.button_width, self.height())
            option.text = caption
            option.state = QStyle.State_Enabled | QStyle.State_Raised
            self.style().drawControl(QStyle.CE_PushButton, option, painter, self)


class ButtonWidthField(QWidget):
    """The longest a window's button on the taskbar may be: the look's own, or a width from 60 to 300 pixels."""
    changed = Signal()

    def __init__(self):
        super().__init__()
        self.checkbox = QCheckBox("Use the look's own width")
        self.slider = QSlider(Qt.Horizontal)
        self.spin = QSpinBox()
        for control in (self.slider, self.spin):
            control.setRange(MIN_BUTTON_WIDTH, MAX_BUTTON_WIDTH)
        self.preview = TaskButtonPreview()
        controls = QHBoxLayout()
        controls.addWidget(self.slider, 1)
        controls.addWidget(self.spin)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.checkbox)
        layout.addLayout(controls)
        layout.addWidget(self.preview)
        self.slider.valueChanged.connect(self.spin.setValue)
        self.spin.valueChanged.connect(self.slider.setValue)
        self.spin.valueChanged.connect(self.width_changed)
        self.checkbox.toggled.connect(self.width_changed)
        self.show_state()

    def width_changed(self):
        self.show_state()
        self.changed.emit()

    def show_state(self):
        self.slider.setEnabled(not self.checkbox.isChecked())
        self.spin.setEnabled(not self.checkbox.isChecked())
        self.preview.show_width(LOOK_BUTTON_WIDTH if self.checkbox.isChecked() else self.spin.value())

    def value(self):
        return "0" if self.checkbox.isChecked() else str(self.spin.value())

    def set_value(self, value):
        chosen = str(value).isdigit() and int(value) > 0
        self.checkbox.setChecked(not chosen)
        if chosen:
            self.spin.setValue(int(value))
        self.show_state()


class LauncherList(QWidget):
    """The Quick Launch programs in order, with the buttons that add, remove and move them."""
    changed = Signal()

    def __init__(self, choose_file):
        super().__init__()
        self.choose_file = choose_file
        self.list_widget = QListWidget()
        layout = QHBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.list_widget, 1)
        buttons = QVBoxLayout()
        for caption, action in (("Add...", self.add), ("Remove", self.remove), ("Move Up", lambda: self.move(-1)), ("Move Down", lambda: self.move(1))):
            button = chicago95ui.dialog_button(caption)
            button.clicked.connect(action)
            buttons.addWidget(button)
        buttons.addStretch(1)
        layout.addLayout(buttons)

    def value(self):
        return ",".join(self.list_widget.item(row).text() for row in range(self.list_widget.count()))

    def set_value(self, value):
        self.list_widget.clear()
        self.list_widget.addItems([launcher for launcher in value.split(",") if launcher])

    def add(self):
        path = self.choose_file(self, "Add to Quick Launch", "Programs (*.desktop)")
        if path:
            self.list_widget.addItem(launcher_for_desktop_file(path))
            self.changed.emit()

    def remove(self):
        row = self.list_widget.currentRow()
        if row >= 0:
            self.list_widget.takeItem(row)
            self.changed.emit()

    def move(self, step):
        row = self.list_widget.currentRow()
        target = row + step
        if row < 0 or not 0 <= target < self.list_widget.count():
            return
        item = self.list_widget.takeItem(row)
        self.list_widget.insertItem(target, item)
        self.list_widget.setCurrentRow(target)
        self.changed.emit()


class TitleBarPreview(QWidget):
    """An active and an inactive title bar in the colours chosen; two colours make a gradient from left to right."""

    def __init__(self, active, inactive):
        super().__init__()
        self.active, self.inactive = active, inactive
        self.setFixedHeight(46)

    def show_colors(self, active, inactive):
        self.active, self.inactive = active, inactive
        self.update()

    def paintEvent(self, _event):
        painter = QPainter(self)
        for row, (colors, caption) in enumerate(((self.active, "Active Window"), (self.inactive, "Inactive Window"))):
            bar = QRect(0, row * 23, self.width(), 21)
            gradient = QLinearGradient(bar.left(), 0, bar.right(), 0)
            stops = [QColor(stop.split("@")[0]) for stop in colors.split(",")]
            gradient.setColorAt(0, stops[0])
            gradient.setColorAt(1, stops[-1])
            painter.fillRect(bar, gradient)
            painter.setPen(QColor("#FFFFFF"))
            painter.drawText(bar.adjusted(4, 0, 0, 0), Qt.AlignVCenter, caption)


class PropertiesPage(QWidget):
    """An applet's page in the Control Panel's window: property sheet tabs with OK, Cancel and Apply."""
    finished = Signal()

    def __init__(self, title, tabs, apply_changes):
        super().__init__()
        self.title = title
        self.apply_changes = apply_changes
        self.tabs = QTabWidget()
        self.settings_tabs = [tab for _name, tab in tabs]
        for name, tab in tabs:
            self.tabs.addTab(tab, name)
            tab.changed.connect(self.refresh_apply_button)
        self.baseline = self.collect_values()
        self.ok_button = chicago95ui.dialog_button("OK")
        self.cancel_button = chicago95ui.dialog_button("Cancel")
        self.apply_button = chicago95ui.dialog_button("Apply", enabled=False)
        self.ok_button.clicked.connect(self.ok)
        self.cancel_button.clicked.connect(self.cancel)
        self.apply_button.clicked.connect(self.apply)
        buttons = QHBoxLayout()
        buttons.addStretch(1)
        for button in (self.ok_button, self.cancel_button, self.apply_button):
            buttons.addWidget(button)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.addWidget(self.tabs, 1)
        layout.addLayout(buttons)

    def tab_names(self):
        return [self.tabs.tabText(index) for index in range(self.tabs.count())]

    def collect_values(self):
        return {key: value for tab in self.settings_tabs for key, value in tab.values().items()}

    def changed_values(self):
        return {key: value for key, value in self.collect_values().items() if self.baseline.get(key) != value}

    def refresh_apply_button(self):
        self.apply_button.setEnabled(bool(self.changed_values()))

    def apply(self):
        if not self.apply_changes(self.changed_values()):
            return False
        self.baseline = self.collect_values()
        self.refresh_apply_button()
        return True

    def ok(self):
        if not self.changed_values() or self.apply():
            self.finished.emit()

    def discard_changes(self):
        for tab in self.settings_tabs:
            tab.load(self.baseline)
        self.refresh_apply_button()

    def cancel(self):
        self.discard_changes()
        self.finished.emit()


