def boot_style(values):
    """The boot and loading screens' style: chosen on its own, or the login's until it is (as setup/steps.sh)."""
    return values.get("BOOT_STYLE") or values.get("LOGIN_STYLE", "classic")


@tab_builder("Booting Screen", "Boot Screen")
def boot_screen_tab(settings, actions):
    """The screen shown while the computer boots and while Plasma loads: a picture, as 1995 and 1998 had, or
    the 2000 page with the progress bar. Applying rebuilds the boot image, which asks for the administrator password."""
    tab = SettingsTab(settings, actions)
    tab.radios(
        "BOOT_STYLE",
        "Style",
        [
            ("Classic (1995 and 1998): a picture", "classic"),
            ("Windows 2000: the page with its progress bar", "2000"),
            ("Windows XP: the black screen with its sliding bar", "luna"),
        ],
        default=boot_style(settings),
    )
    tab.group("Classic picture")
    tab.picture("SPLASH_IMAGE", "Picture:", [("Chicago95 picture", "classic")], default="classic")
    tab.group("2000 texts")
    tab.text("LOADING_TEXT", "Text beside the progress bar:", default="Starting up...")
    tab.text("LOADING_FOOTER", "Bottom line:", default="Chicago95 for KDE Plasma")
    tab.group("Preview")
    tab.preview(LoadingPreview())
    return tab


ICON_SETS = [("Chicago95 (1995)", "chicago95"), ("SE98 (1998)", "se98"), ("ClassicOS 2000", "classicos2000")]
# The Appearance tab's items (Windows 98 lists every part of the screen; these are the ones this desktop
# colours): its setting, and how many colours it takes (stops: the banner's base colour and its glows).
APPEARANCE_ITEMS = (
    ("Active Title Bar", "TITLE_ACTIVE", 2, False),
    ("Controls", "WIDGET_STYLE", 0, False),
    ("Desktop", "BACKGROUND_COLOR", 1, False),
    ("Icon", "ICONS", 0, False),
    ("Inactive Title Bar", "TITLE_INACTIVE", 2, False),
    ("Start Menu Banner", "BANNER_BG", 8, True),
    ("Start Menu Banner Text", "BANNER_FG", 1, False),
    ("Window Frames", "DECORATION", 0, False),
)


@tab_builder("Display", "Appearance")
def appearance_tab(settings, actions):
    """Windows 98's Appearance tab (the tech2u Display Properties picture): the sample windows in the scheme's
    colours, Scheme with Save As and Delete, and Item with the chosen part's settings."""
    tab = SettingsTab(settings, actions)
    tab.outer.setContentsMargins(12, PAGE_INSETS[1], 12, PAGE_INSETS[3])  # the 358px preview fits the sheet's 386
    start = LOOK_PRESETS["1995"]
    tab.preview = AppearanceSwitch()
    tab.previews.append(tab.preview)
    tab.outer.insertWidget(0, tab.preview)
    tab.scheme = chicago95ui.classic_combo(QComboBox())
    for label, value in (
        ("Windows 95", "1995"),
        ("Windows 98", "1998"),
        ("Windows 2000", "2000"),
        ("Windows XP Classic", "2001"),
        ("Windows XP", "luna"),
        ("Custom", "custom"),
    ):
        tab.scheme.addItem(label, value)
    tab.save_as_button = chicago95ui.dialog_button("Sa&ve As...", enabled=False)
    tab.delete_button = chicago95ui.dialog_button("&Delete", enabled=False)
    tab.items = chicago95ui.classic_combo(QComboBox())
    tab.item_editors = QStackedWidget()
    tab.color_edits = {}
    component_combos = {}
    for label, key, most, stops in APPEARANCE_ITEMS:
        editor = QWidget()
        form = QFormLayout(editor)
        form.setContentsMargins(0, 0, 0, 0)
        if key == "ICONS":
            tab.icons = chicago95ui.classic_combo(QComboBox())
            for icon_label, value in ICON_SETS:
                tab.icons.addItem(icon_label, value)
            form.addRow("Icon set:", tab.icons)
        elif key in ("DECORATION", "WIDGET_STYLE"):
            component_combos[key] = chicago95ui.classic_combo(QComboBox())
            for style_label, value in COMPONENT_STYLES:
                component_combos[key].addItem(style_label, value)
            form.addRow("Style:", component_combos[key])
        else:
            tab.color_edits[key] = ColorListField(lambda current: actions.choose_color(tab, current), most, stops)
            form.addRow("Color:", tab.color_edits[key])
        tab.items.addItem(label, key)
        tab.item_editors.addWidget(editor)
    tab.items.currentIndexChanged.connect(tab.item_editors.setCurrentIndex)
    tab.items.setCurrentIndex(tab.items.findText("Desktop"))
    scheme_row = QHBoxLayout()
    scheme_row.addWidget(tab.scheme, 1)
    scheme_row.addWidget(tab.save_as_button)
    scheme_row.addWidget(tab.delete_button)
    item_row = QHBoxLayout()
    item_row.addWidget(tab.items, 1)
    item_row.addWidget(tab.item_editors, 1)
    for label, row, buddy in (("&Scheme:", scheme_row, tab.scheme), ("&Item:", item_row, tab.items)):
        tab.form.addRow(buddy_label(label, buddy))
        tab.form.addRow(row)
    font_row = QHBoxLayout()  # the original's Font line, greyed out as for the Desktop: fonts are the Fonts applet's
    font = chicago95ui.classic_combo(QComboBox())
    font.addItem(chicago95ui.ui_font().family())
    font_row.addWidget(font, 1)
    for caption in ("B", "I"):
        style_button = QPushButton(caption)
        style_button.setFixedSize(20, 21)
        font_row.addWidget(style_button)
    tab.form.addRow(buddy_label("&Font:", font))
    tab.form.addRow(font_row)
    for index in range(font_row.count()):
        font_row.itemAt(index).widget().setEnabled(False)
    tab.track(
        "LOOK",
        tab.scheme.currentData,
        lambda value: tab.scheme.setCurrentIndex(max(tab.scheme.findData(value), 0)),
        "1995",
        tab.scheme.currentIndexChanged,
    )
    for key, field in tab.color_edits.items():
        tab.track(key, field.value, field.set_value, start[key], field.changed)
    tab.track(
        "ICONS",
        tab.icons.currentData,
        lambda value: tab.icons.setCurrentIndex(max(tab.icons.findData(value), 0)),
        start["ICONS"],
        tab.icons.currentIndexChanged,
    )
    saved_look = LOOK_PRESETS.get(settings.get("LOOK"), start)
    for key, combo in component_combos.items():
        tab.track(
            key,
            combo.currentData,
            lambda value, combo=combo: combo.setCurrentIndex(max(combo.findData(value), 0)),
            saved_look[key],
            combo.currentIndexChanged,
        )
    unseen_components = {key: saved_look[key] for key in UNSEEN_COMPONENT_KEYS}
    for key in UNSEEN_COMPONENT_KEYS:
        tab.track(
            key,
            lambda key=key: unseen_components[key],
            lambda value, key=key: unseen_components.update({key: value}),
            saved_look[key],
        )
    state = {"applying": False}

    def settling():
        return tab.loading or state["applying"]

    def scheme_changed():
        preset = LOOK_PRESETS.get(tab.scheme.currentData())
        if settling() or preset is None:
            return
        state["applying"] = True
        for key, field in tab.color_edits.items():
            field.set_value(preset[key])
        tab.icons.setCurrentIndex(tab.icons.findData(preset["ICONS"]))
        for key, combo in component_combos.items():
            combo.setCurrentIndex(combo.findData(preset[key]))
        unseen_components.update({key: preset[key] for key in UNSEEN_COMPONENT_KEYS})
        state["applying"] = False
        refresh_preview()

    def refresh_preview():
        tab.preview.show_colors(
            tab.color_edits["TITLE_ACTIVE"].value(),
            tab.color_edits["TITLE_INACTIVE"].value(),
            tab.color_edits["BACKGROUND_COLOR"].value(),
            tab.scheme.currentData(),
        )

    def colour_edited():
        refresh_preview()
        if settling():
            return
        state["applying"] = True
        tab.scheme.setCurrentIndex(tab.scheme.findData("custom"))
        state["applying"] = False

    tab.scheme.currentIndexChanged.connect(scheme_changed)
    for field in tab.color_edits.values():
        field.changed.connect(colour_edited)
    for combo in component_combos.values():
        combo.currentIndexChanged.connect(lambda *_: colour_edited())
    refresh_preview()
    return tab


MONITOR_SCREEN = (152, 112)  # the Screen Saver tab's monitor (tests/references/win98screensaver.png)


MONITOR_CASE = (184, 147)  # the monitor drawn on the Screen Saver tab (tests/references/win98screensaver.png)
MONITOR_STAND_LEFT = 48
MONITOR_STAND = (  # its stand, row by row from the case's bottom: S shadow, K black, W white, g power light
    "S..SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSK",
    "S..SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSKKKKSSS...........SSSSSSSSSSSSSK",
    ".WW.....................................................KggW...W.........S...........SSK",
    ".WW.....................................................KggW...W.........S..........SSSK",
    "..WW....................................................KWWW...WSSSSSSSSSS.........SSSK",
    "...WW.............................................................................SSSK",
    "....WSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSK",
    ".....SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSK",
    ".......KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK",
)


def monitor_case_row(row):
    """One row of the case: a dithered white bevel top and left, a dithered shadow bottom and right, and the sunken
    frame round the 152x112 screen ('t'). '.' is the face colour."""
    width, height = MONITOR_CASE
    cells = ["."] * width

    def put(first, last, mark, step=1, start=None):
        for column in range(first if start is None else start, last + 1, step):
            cells[column] = mark

    if row == 0:
        put(1, width - 2, "W")
    elif row == 1:
        put(0, width - 2, "W")
        cells[-1] = "S"
    elif row in (2, 3):
        put(0, 3 - (row == 3), "W")
        put(4, width - 3, "W", 2, 5 if row == 2 else 4)
        put(width - 2, width - 1, "S")
    elif row in (height - 5, height - 4):
        put(0, 1, "W")
        cells[2 if row == height - 4 else 3] = "W"
        put(6 if row == height - 5 else 5, width - 5, "S", 2)
        put(width - 3, width - 1, "S")
    elif row == height - 3:
        put(0, 1, "W")
        put(2, width - 1, "S")
    elif row == height - 2:
        put(1, width - 2, "S")
        cells[-1] = "K"
    elif row == height - 1:
        cells[1] = "S"
        put(2, width - 2, "K")
    else:
        put(0, 1, "W")
        cells[3 if row % 2 == 0 else 2] = "W"
        if row % 2 == 0:
            put(width - 3, width - 1, "S")
        else:
            cells[width - 4] = "S"
            put(width - 2, width - 1, "S")
    screen_left, screen_top = 16, 17
    screen_right, screen_bottom = screen_left + MONITOR_SCREEN[0] - 1, screen_top + MONITOR_SCREEN[1] - 1
    if row == screen_top - 2 or row == screen_bottom + 1:
        put(screen_left - 2, screen_right + 1, "S")
        cells[screen_right + 2] = "W"
    elif row == screen_top - 1:
        cells[screen_left - 2] = "S"
        put(screen_left - 1, screen_right, "K")
        cells[screen_right + 1] = "S"
        cells[screen_right + 2] = "W"
    elif screen_top <= row <= screen_bottom:
        cells[screen_left - 2] = "S"
        cells[screen_left - 1] = "K"
        put(screen_left, screen_right, "t")
        cells[screen_right + 1] = "S"
        cells[screen_right + 2] = "W"
    elif row == screen_bottom + 2:
        put(screen_left - 2, screen_right + 2, "W")
    return "".join(cells)


def monitor_rows():
    case = [monitor_case_row(row) for row in range(MONITOR_CASE[1])]
    stand = [
        "." * MONITOR_STAND_LEFT + line + "." * (MONITOR_CASE[0] - MONITOR_STAND_LEFT - len(line))
        for line in MONITOR_STAND
    ]
    return case + stand


def cover_rect(picture, screen):
    """Where a picture that covers the screen goes: scaled to reach both edges, keeping its shape, centred."""
    scale = max(screen.width() / picture.width(), screen.height() / picture.height())
    size = QSize(round(picture.width() * scale), round(picture.height() * scale))
    left = screen.left() + int((screen.width() - size.width()) / 2)
    top = screen.top() + int((screen.height() - size.height()) / 2)
    return QRect(QPoint(left, top), size)


class MonitorPreview(QWidget):
    """The monitor drawn at the top of the Screen Saver tab: its screen shows the chosen screensaver's picture,
    or the desktop colour."""

    def __init__(self, desktop_colour):
        super().__init__()
        self.desktop_colour = QColor(desktop_colour)
        self.rows = monitor_rows()
        self.picture = QPixmap()
        self.pattern, self.wallpaper, self.fill = None, QPixmap(), "center"
        self.setFixedSize(MONITOR_CASE[0], len(self.rows))

    def show_desktop(self, colour, pattern, wallpaper, fill):
        """The desktop as the Background tab sets it: its colour, an 8 by 8 pattern over it, or a wallpaper."""
        self.desktop_colour = QColor(colour)
        self.pattern = pattern
        self.wallpaper = QPixmap(str(wallpaper)) if wallpaper and Path(wallpaper).exists() else QPixmap()
        self.fill = fill
        self.update()

    def paint_desktop(self, painter):
        screen = self.screen_rect()
        painter.save()
        painter.setClipRect(screen)
        for row, bits in enumerate(self.pattern or []):
            for column in range(8):
                if bits & (0x80 >> column):
                    for x in range(screen.left() + column, screen.right() + 1, 8):
                        for y in range(screen.top() + row, screen.bottom() + 1, 8):
                            painter.fillRect(x, y, 1, 1, Qt.black)
        if not self.wallpaper.isNull():
            self.paint_wallpaper(painter, screen)
        painter.restore()

    def paint_wallpaper(self, painter, screen):
        if self.fill == "stretch":
            painter.drawPixmap(screen, self.wallpaper)
            return
        if self.fill == "cover":
            painter.drawPixmap(cover_rect(self.wallpaper.size(), screen), self.wallpaper)
            return
        # The screen in the picture stands for the real one: the wallpaper shrinks by as much.
        real = QGuiApplication.primaryScreen().size() if QGuiApplication.primaryScreen() else QSize(1024, 768)
        size = self.wallpaper.size() * (screen.width() / max(1, real.width()))
        size = QSize(max(1, size.width()), max(1, size.height()))
        if self.fill == "tile":
            for x in range(screen.left(), screen.right() + 1, size.width()):
                for y in range(screen.top(), screen.bottom() + 1, size.height()):
                    painter.drawPixmap(QRect(QPoint(x, y), size), self.wallpaper)
            return
        painter.drawPixmap(QRect(screen.center() - QPoint(size.width() // 2, size.height() // 2), size), self.wallpaper)

    def show_picture(self, path):
        self.picture = QPixmap(str(path)) if path is not None and Path(path).exists() else QPixmap()
        self.update()

    def screen_rect(self):
        return QRect(16, 17, *MONITOR_SCREEN)

    def paintEvent(self, _event):
        painter = QPainter(self)
        colours = {
            "W": QColor("#FFFFFF"),
            "K": QColor("#000000"),
            "S": self.palette().dark().color(),
            "t": self.desktop_colour,
            "g": QColor("#00FF00"),
        }
        painter.fillRect(self.rect(), self.palette().window())
        for y, line in enumerate(self.rows):
            for x, mark in enumerate(line):
                if mark in colours:
                    painter.fillRect(x, y, 1, 1, colours[mark])
        self.paint_desktop(painter)
        if not self.picture.isNull():
            painter.drawPixmap(self.screen_rect(), self.picture)


def desktop_colour(settings):
    return (
        settings.get("BACKGROUND_COLOR", "#008080") if valid_colors(settings.get("BACKGROUND_COLOR", "")) else "#008080"
    )


@tab_builder("Display", "Settings")
def display_settings_tab(settings, actions):
    """Windows 98's Settings tab: the monitor, the display's name, Colors and Screen area side by side, Advanced."""
    tab = SettingsTab(settings, actions)
    tab.monitor = MonitorPreview(desktop_colour(settings))
    tab.outer.insertWidget(0, tab.monitor, 0, Qt.AlignHCenter)
    screen = actions.current_screen()
    tab.display_name = QLabel(screen.output if screen else "Unknown monitor")
    tab.form.addRow("Display:", tab.display_name)
    colours, area = QGroupBox("Colors"), QGroupBox("Screen area")
    QVBoxLayout(colours).addWidget(chicago95ui.classic_combo(QComboBox()))
    colours.findChild(QComboBox).addItem("True Color (32 bit)")
    tab.screen_area = ScreenAreaField(screen.sizes if screen else [])
    tab.screen_area.setEnabled(screen is not None)
    QVBoxLayout(area).addWidget(tab.screen_area)
    row = QHBoxLayout()
    row.addWidget(colours, 1)
    row.addWidget(area, 1)
    tab.outer.insertLayout(tab.outer.count() - 1, row)
    if screen is not None:
        tab.fields["SCREEN_AREA"] = (tab.screen_area.value, tab.screen_area.set_value, screen.current)
        tab.screen_area.set_value(screen.current)
        tab.screen_area.changed.connect(tab.notify)
    tab.advanced_button = chicago95ui.dialog_button("Ad&vanced...")
    tab.advanced_button.clicked.connect(lambda: actions.start_process("kcmshell6", ["kcm_kscreen"]))
    buttons = QHBoxLayout()
    buttons.addStretch(1)
    buttons.addWidget(tab.advanced_button)
    tab.outer.insertLayout(tab.outer.count() - 1, buttons)
    return tab


@tab_builder("Display", "Screen Saver")
def screen_saver_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    tab.monitor = MonitorPreview(desktop_colour(settings))
    tab.outer.insertWidget(0, tab.monitor, 0, Qt.AlignHCenter)
    tab.group("Screen Saver")
    savers = actions.list_screensavers()
    preview = chicago95ui.dialog_button("Preview", enabled=bool(savers))
    tab.saver_combo = saver = tab.choice(
        "SAVER",
        "",
        [(label, name) for name, label in savers] or [("Deep Stars", "deepstars")],
        default="deepstars",
        beside=preview,
    )
    pictures = actions.screensaver_pictures()

    def show_picture():
        tab.monitor.show_picture(pictures / f"{saver.currentData()}.png")

    saver.currentIndexChanged.connect(show_picture)
    show_picture()
    wait = tab.number("IDLE_MIN", "Wait:", 1, 60, default=5, suffix=" minutes")
    preview.clicked.connect(
        lambda: actions.start_process(tool_path("chicago95-screensaver"), ["--hack", saver.currentData()])
    )
    tab.lock_warning = QLabel(
        f"Your screen locks after {actions.lock_timeout_minutes()} minutes, "
        "before the screen saver starts, so you will not see it."
    )
    tab.lock_warning.setWordWrap(True)
    tab.form.addRow("", tab.lock_warning)

    def show_warning():
        tab.lock_warning.setVisible(screensaver_hidden_by_lock(wait.value(), actions.lock_timeout_minutes()))

    wait.valueChanged.connect(show_warning)
    show_warning()
    return tab


SOUND_EVENTS = (
    ("desktop-login", "Start Windows"),
    ("desktop-logout", "Exit Windows"),
    ("dialog-error", "Critical Stop"),
    ("dialog-warning", "Exclamation"),
    ("dialog-information", "Asterisk"),
    ("dialog-question", "Question"),
    ("bell-window-system", "Default Sound"),
    ("trash-empty", "Empty Recycle Bin"),
    ("window-maximized", "Maximize"),
    ("window-minimized", "Minimize"),
    ("menu-popup", "Menu Popup"),
)


@tab_builder("Sounds", "Sounds")
def sounds_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    themes = [(name, theme_id) for theme_id, name in installed_sound_themes(actions.sound_roots)]
    scheme = tab.choice("SOUND_THEME", "Scheme:", themes or [("Chicago95", "Chicago95")], default="Chicago95")
    events = QListWidget()
    for event, label in SOUND_EVENTS:
        events.addItem(label)
        events.item(events.count() - 1).setData(Qt.UserRole, event)
    player = actions.program_installed("pw-play") or actions.program_installed("paplay")
    play = chicago95ui.dialog_button("Play", enabled=bool(player))

    def play_selected():
        item = events.currentItem()
        if item is None:
            return
        sound = chicago95ui.sound_file(scheme.currentData(), item.data(Qt.UserRole), actions.sound_roots)
        if sound:
            actions.start_process(player, [sound])

    play.clicked.connect(play_selected)
    tab.form.addRow("Events:", events)
    tab.form.addRow("", play)
    return tab


# The desktop icons the Effects tab offers; "auto" is the look's own (setup/steps.sh desktop_icon_defaults).
DESKTOP_ICON_CHOICES = [
    ("The look's own", "auto"),
    ("None", ""),
    ("My Computer, Network Neighborhood, Recycle Bin", "computer,network,recycle"),
    ("Those and My Documents", "computer,documents,network,recycle"),
]


EFFECTS_COLUMNS = 2  # the lists in two columns, each under its caption, so the tab fits Display Properties
EFFECTS_LIST_LETTERS = 9


@tab_builder("Display", "Effects")
def effects_tab(settings, actions):
    """Every animation by event (setup/animations.conf): KDE's effects, ours and the installed ones of each
    event's kind; a list shows what runs now until a choice is saved."""
    tab = SettingsTab(settings, actions)
    table = chicago95animations.read_animations(chicago95animations.table_path())
    installed = actions.installed_effects()
    live = actions.live_animations()
    tab.combos, tab.settings_buttons = {}, {}
    tab.choice("DESKTOP_ICONS", "Desktop icons:", DESKTOP_ICON_CHOICES, default="auto")
    tab.classic_button = chicago95ui.dialog_button("&Classic")
    tab.classic_button.clicked.connect(
        lambda: (
            tab.load(
                {
                    **tab.values(),
                    "DESKTOP_ICONS": "auto",
                    **table.classic.get(settings.get("LOOK", "1998"), {}),
                }
            )
            or tab.notify()
        )
    )
    for group in dict.fromkeys(event.group for event in table.events):
        box = QGroupBox(group)
        grid = QGridLayout(box)
        grid.setVerticalSpacing(2)
        events = [event for event in table.events if event.group == group]
        for index, event in enumerate(events):
            current = chicago95animations.current_choice(table, event.key, installed, live)
            field = animation_field(tab, table, installed, event, current)
            grid.addWidget(field, index // EFFECTS_COLUMNS, index % EFFECTS_COLUMNS)
        if group == events[-1].group == table.events[-1].group:
            grid.addWidget(tab.classic_button, len(events) // EFFECTS_COLUMNS, 1, Qt.AlignRight | Qt.AlignBottom)
        tab.outer.insertWidget(tab.outer.count() - 1, box)
    return tab


def animation_field(tab, table, installed, event, current):
    """One event's control under its caption: the speed slider, the wobbly check box, or a list with a button
    that opens the chosen effect's KDE settings."""
    options = chicago95animations.event_choices(table, event.key, installed)
    cell = QWidget()
    column = QVBoxLayout(cell)
    column.setContentsMargins(0, 0, 0, 0)
    column.setSpacing(1)
    if [value for _label, value in options] == ["no", "yes"]:
        box = QCheckBox(event.label)
        tab.track(
            event.key,
            lambda: "yes" if box.isChecked() else "no",
            lambda value: box.setChecked(value == "yes"),
            current,
            box.toggled,
        )
        column.addWidget(box)
        return cell
    column.addWidget(QLabel(event.label))
    if event.key == chicago95animations.SPEED_KEY:
        tab.speed_slider = ChoiceSlider(options)
        tab.track(event.key, tab.speed_slider.value, tab.speed_slider.set_value, current, tab.speed_slider.changed)
        column.addWidget(tab.speed_slider)
        return cell
    combo = chicago95ui.classic_combo(QComboBox())
    combo.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)  # long names show when it opens
    combo.setMinimumContentsLength(EFFECTS_LIST_LETTERS)
    for label, value in options:
        combo.addItem(label, value)
    button = QPushButton("...")
    button.setFixedSize(20, combo.sizeHint().height())
    button.setToolTip("Settings for this effect")
    row = QHBoxLayout()
    row.setSpacing(2)
    row.addWidget(combo, 1)
    row.addWidget(button)
    column.addLayout(row)
    tab.track(
        event.key,
        combo.currentData,
        lambda value: combo.setCurrentIndex(max(combo.findData(value), 0)),
        current,
        combo.currentIndexChanged,
    )
    tab.combos[event.key], tab.settings_buttons[event.key] = combo, button

    def settings_command():
        effects = chicago95animations.choice_effects(table, event.key, combo.currentData())
        pages = [
            installed[effect].settings for effect in map(chicago95animations.effect_id, effects) if effect in installed
        ]
        return next((page for page in pages if page), None)

    def show_state():
        button.setEnabled(settings_command() is not None)

    button.clicked.connect(lambda: tab.actions.start_process(settings_command()[0], list(settings_command()[1:])))
    combo.currentIndexChanged.connect(show_state)
    show_state()
    return cell


@tab_builder("Display", "Background")
def background_tab(settings, actions):
    """Windows 98's Background tab (the tech2u Display Properties picture): the monitor showing the desktop, the
    Wallpaper list with (None) first, Browse..., Pattern... and Display. The desktop colour is Appearance's."""
    tab = SettingsTab(settings, actions)
    patterns = background_patterns(settings)
    tab.monitor = MonitorPreview(desktop_colour(settings))
    tab.outer.insertWidget(0, tab.monitor, 0, Qt.AlignHCenter)
    tab.group("Wallpaper")
    tab.wallpapers = QListWidget()
    tab.wallpapers.addItem(QListWidgetItem(QIcon.fromTheme("dialog-cancel"), "(None)"))
    for label, path in actions.wallpapers():
        add_wallpaper(tab.wallpapers, label, path)
    browse = chicago95ui.dialog_button("&Browse...")
    tab.pattern_button = chicago95ui.dialog_button("&Pattern...")
    tab.display = chicago95ui.classic_combo(QComboBox())
    for label, value in (("Center", "center"), ("Tile", "tile"), ("Stretch", "stretch"), ("Cover", "cover")):
        tab.display.addItem(label, value)
    side = QVBoxLayout()
    for widget in (browse, tab.pattern_button):
        side.addWidget(widget)
    side.addStretch(1)
    side.addWidget(buddy_label("&Display:", tab.display))
    side.addWidget(tab.display)
    row = QHBoxLayout()
    row.addWidget(tab.wallpapers, 1)
    row.addLayout(side)
    tab.form.addRow(buddy_label("&Select a picture:", tab.wallpapers))
    tab.form.addRow(row)
    pattern = {"name": "none"}

    def wallpaper():
        item = tab.wallpapers.currentItem()
        return item.data(Qt.UserRole) or "" if item is not None else ""

    def show_wallpaper(path):
        rows = [tab.wallpapers.item(row).data(Qt.UserRole) for row in range(tab.wallpapers.count())]
        if path and path not in rows:
            add_wallpaper(tab.wallpapers, Path(path).stem, path)
            rows.append(path)
        tab.wallpapers.setCurrentRow(rows.index(path) if path in rows else 0)

    def set_pattern(name):
        pattern["name"] = name if name in patterns else "none"
        refresh()

    def mode():
        return "image" if wallpaper() else ("pattern" if pattern["name"] != "none" else "color")

    def refresh():
        tab.display.setEnabled(bool(wallpaper()))
        tab.pattern_button.setEnabled(not wallpaper())
        tab.monitor.show_desktop(
            desktop_colour(settings), patterns.get(pattern["name"]), wallpaper(), tab.display.currentData()
        )

    def choose_pattern():
        chosen = actions.choose_pattern(tab, pattern["name"], patterns)
        if chosen is not None:
            set_pattern(chosen)
            tab.notify()

    def browse_picture():
        chosen = actions.choose_file(tab, "Browse", "Pictures (*.png *.jpg *.jpeg *.bmp *.gif *.svg *.webp)")
        if chosen:
            show_wallpaper(chosen)

    tab.track("BACKGROUND_MODE", mode, lambda _value: None, "color")
    tab.track("BACKGROUND_PATTERN", lambda: pattern["name"], set_pattern, "none")
    tab.track("BACKGROUND_IMAGE", wallpaper, show_wallpaper, "", tab.wallpapers.currentRowChanged)
    tab.track(
        "BACKGROUND_FILL",
        tab.display.currentData,
        lambda value: tab.display.setCurrentIndex(max(tab.display.findData(value), 0)),
        "center",
        tab.display.currentIndexChanged,
    )
    tab.wallpapers.currentRowChanged.connect(refresh)
    tab.display.currentIndexChanged.connect(refresh)
    tab.pattern_button.clicked.connect(choose_pattern)
    browse.clicked.connect(browse_picture)
    refresh()
    return tab


def buddy_label(text, widget):
    """A caption whose underlined letter takes the focus to its control, as the originals' captions do."""
    label = QLabel(text)
    label.setBuddy(widget)
    return label


def add_wallpaper(wallpapers, label, path):
    item = QListWidgetItem(QIcon.fromTheme("image-x-generic"), label)
    item.setData(Qt.UserRole, path)
    wallpapers.addItem(item)


class ControlPanel(QMainWindow):
    def __init__(self, settings_path=SETTINGS_FILE, actions=None):
        super().__init__()
        self.settings_path = Path(settings_path)
        self.actions = actions or Actions()
        self.history = NavigationHistory(HOME_PAGE)
        self.applet_pages = {}
        self.applet_windows = {}
        self.showing_page = False
        self.setWindowTitle("Control Panel")
        self.setWindowIcon(QIcon.fromTheme("preferences-system"))
        self.resize(500, 420)
        self.icon_view = self.build_icon_view()
        self.pages = QStackedWidget()
        self.pages.addWidget(self.icon_view)
        self.setCentralWidget(self.pages)
        self.build_header()
        self.build_status_bar()
        self.set_view("Large Icons")
        self.show_selection()
        self.refresh_navigation()

    def build_icon_view(self):
        view = QListWidget()
        view.setMovement(QListView.Static)
        view.setSpacing(0)
        view.setWordWrap(True)
        view.setResizeMode(QListView.Adjust)
        view.setFrameStyle(QFrame.StyledPanel | QFrame.Sunken)
        view.setLineWidth(2)
        for applet in APPLETS:
            item = QListWidgetItem(themed_icon(applet.icon_names), applet.name)
            item.setData(Qt.UserRole, applet)
            view.addItem(item)
        view.itemSelectionChanged.connect(self.show_selection)
        view.itemActivated.connect(lambda item: self.open_applet(item.data(Qt.UserRole).name))
        return view

    def build_status_bar(self):
        """Windows 98's status bar: three sunken panes (the message, a spare one, the place) and a size grip."""
        self.status_message = QLabel()
        self.status_place_icon = QLabel()
        icon = themed_icon(("computer",))
        self.status_place_icon.setPixmap(
            icon.pixmap(16, 16)
            if not icon.isNull()
            else start_logo_pixmap().scaled(16, 16, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        )
        chrome = window_chrome()
        self.status_panes = (
            chrome.status_pane(self.status_message),
            chrome.status_pane(QLabel()),
            chrome.status_pane(self.status_place_icon, QLabel("My Computer")),
        )
        self.setStatusBar(chrome.status_bar(self.status_panes))

    def build_header(self):
        chrome = window_chrome()
        self.menu_bar = QMenuBar()
        self.menu_style = chrome.menu_style()
        self.menu_bar.setStyle(self.menu_style)
        self.menu_bar.setFixedHeight(MENU_BAR_HEIGHT)
        self.build_menus()
        self.toolbar = self.build_standard_toolbar()
        self.logo_box = chrome.logo_box()
        known_pages = [HOME_PAGE] + [HOME_PAGE + (applet.name,) for applet in APPLETS if not applet.external_tool]
        self.address_bar = AddressBar(known_pages)
        self.address_bar.navigate.connect(self.navigate)
        self.header = QWidget()
        layout = QVBoxLayout(self.header)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        for band in (
            chrome.header_band(self.menu_bar, trailing=self.logo_box),
            chrome.header_band(self.toolbar, TOOLBAR_HEIGHT),
            chrome.header_band(self.address_bar),
            chrome.header_band(None, 0, grip=False),
        ):
            layout.addWidget(band)
        self.setMenuWidget(self.header)

    def build_menus(self):
        menu_bar = self.menu_bar
        for title in ("&File", "&Edit"):
            menu_bar.addMenu(title)
        self.view_menu = menu_bar.addMenu("&View")
        view_choices = QActionGroup(self)
        for name, mode in VIEW_MODES.items():
            choice = self.view_menu.addAction(mode.menu_text)
            choice.setCheckable(True)
            choice.setChecked(name == "Large Icons")
            choice.triggered.connect(lambda _checked=False, name=name: self.set_view(name))
            view_choices.addAction(choice)
        for title in ("&Go", "F&avorites", "&Help"):
            menu_bar.addMenu(title)

    def build_standard_toolbar(self):
        toolbar = QWidget()
        toolbar.setFixedHeight(TOOLBAR_HEIGHT)
        layout = QHBoxLayout(toolbar)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        self.back_action = QAction(QIcon.fromTheme("go-previous"), "Back", self)
        self.forward_action = QAction(QIcon.fromTheme("go-next"), "Forward", self)
        self.up_action = QAction(QIcon.fromTheme("go-up"), "Up", self)
        views_action = QAction(QIcon.fromTheme("view-list-icons"), "Views", self)
        views_action.setMenu(self.view_menu)
        self.back_action.triggered.connect(lambda: self.jump(-1))
        self.forward_action.triggered.connect(lambda: self.jump(1))
        self.up_action.triggered.connect(lambda: self.navigate(parent_location(self.history.current)))
        self.toolbar_buttons = {}
        for action, has_menu in ((self.back_action, True), (self.forward_action, True), (self.up_action, False)):
            self.toolbar_buttons[action.text()] = window_chrome().toolbar_button(action, has_menu)
            layout.addWidget(self.toolbar_buttons[action.text()])
        separator = QFrame()
        separator.setFrameStyle(QFrame.VLine | QFrame.Sunken)
        separator.setFixedWidth(6)
        layout.addWidget(separator)
        self.toolbar_buttons["Views"] = window_chrome().toolbar_button(views_action, has_menu=True)
        layout.addWidget(self.toolbar_buttons["Views"])
        layout.addStretch(1)
        return toolbar

    def set_view(self, name):
        view = VIEW_MODES[name]
        self.icon_view.setViewMode(view.mode)
        self.icon_view.setFlow(view.flow)
        self.icon_view.setWrapping(view.wrapping)
        self.icon_view.setIconSize(QSize(view.icon_size, view.icon_size))
        self.icon_view.setGridSize(view.grid)
        for row in range(self.icon_view.count()):
            item = self.icon_view.item(row)
            applet = item.data(Qt.UserRole)
            item.setText(
                f"{applet.name}{DETAILS_SEPARATOR}{applet.description}" if view.shows_description else applet.name
            )

    def show_selection(self):
        selected = self.icon_view.selectedItems()
        self.status_message.setText(
            selected[0].data(Qt.UserRole).description if selected else f"{self.icon_view.count()} object(s)"
        )

    def show_again(self, page_slug):
        """A later launch asked for the window: its page, if named, then the window up and in front."""
        if page_slug in PAGE_SLUGS:
            self.open_applet(PAGE_SLUGS[page_slug])
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def open_applet(self, name):
        applet = APPLET_BY_NAME[name]
        if applet.external_tool:
            self.actions.start_process(tool_path(applet.external_tool), [])
            return
        if applet.own_window:
            self.open_window(name)
            return
        self.navigate(HOME_PAGE + (name,))

    def open_window(self, applet_name):
        if applet_name not in self.applet_windows:
            self.applet_windows[applet_name] = PropertySheetWindow(self.build_sheet(applet_name), self)
        sheet = self.applet_windows[applet_name]
        sheet.show()
        sheet.raise_()
        sheet.activateWindow()

    def applet_sheet(self, applet_name):
        """An opened applet's property sheet: in its own window, or a page of this one."""
        window = self.applet_windows.get(applet_name)
        return window.page if window is not None else self.page_for(applet_name)

    def build_sheet(self, applet_name):
        settings = read_settings(self.settings_path)
        tabs = [
            (tab_name, build_tab(applet_name, tab_name, settings, self.actions)) for tab_name in PAGE_TABS[applet_name]
        ]
        return PropertiesPage(applet_name, tabs, self.apply_changes)

    def navigate(self, page):
        if not self.may_go_to(page):
            return
        self.history.visit(page)
        self.show_page(page)

    def jump(self, steps):
        pages = self.history.pages_before if steps < 0 else self.history.pages_after
        if not self.may_go_to(pages[abs(steps) - 1]):
            return
        step = self.history.back if steps < 0 else self.history.forward
        for _ in range(abs(steps)):
            step()
        self.show_page(self.history.current)

    def current_applet_page(self):
        page = self.pages.currentWidget()
        return page if isinstance(page, PropertiesPage) else None

    def may_go_to(self, target):
        """Leaving an applet's page with changes not applied asks first; moving between its tabs does not."""
        page = self.current_applet_page()
        staying = page is not None and len(target) > 1 and target[1] == page.title
        return page is None or staying or self.can_leave(page)

    def can_leave(self, page):
        if not page.changed_values():
            return True
        answer = self.actions.ask_to_apply(self)
        if answer == "cancel":
            return False
        if answer == "yes":
            return page.apply()
        page.discard_changes()
        return True

    def closeEvent(self, event):
        page = self.current_applet_page()
        if page is None or self.can_leave(page):
            event.accept()
        else:
            event.ignore()

    def page_for(self, applet_name):
        if applet_name not in self.applet_pages:
            page = self.build_sheet(applet_name)
            page.finished.connect(lambda: self.navigate(HOME_PAGE))
            page.tabs.currentChanged.connect(lambda index, name=applet_name: self.tab_changed(name, index))
            self.applet_pages[applet_name] = page
            self.pages.addWidget(page)
        return self.applet_pages[applet_name]

    def show_page(self, page):
        self.showing_page = True
        if len(page) == 1:
            self.pages.setCurrentWidget(self.icon_view)
            self.show_selection()
        else:
            applet_page = self.page_for(page[1])
            applet_page.tabs.setCurrentIndex(applet_page.tab_names().index(page[2]) if len(page) > 2 else 0)
            self.pages.setCurrentWidget(applet_page)
            self.resize(self.size().expandedTo(self.minimumSizeHint()))
            self.status_message.clear()
        self.showing_page = False
        self.refresh_navigation()

    def apply_changes(self, changes):
        live = {key: changes[key] for key in LIVE_KEYS if key in changes}
        changes = {key: value for key, value in changes.items() if key not in LIVE_KEYS}
        if live.get("SCREEN_AREA"):
            self.change_screen_area(live["SCREEN_AREA"])
        if not changes:
            return True
        settings = read_settings(self.settings_path)
        settings.update(changes)
        write_settings(self.settings_path, settings)
        repo = settings.get("REPO", "")
        if not repo or not Path(repo, "install.sh").is_file():
            self.actions.show_message(
                self,
                "Setup files not found",
                "The Chicago95 Plasma folder is not known. Run install.sh once from it, then try again.",
            )
            return False
        components = components_for(changes)
        if components:
            self.actions.run_setup(self, setup_command(repo, self.settings_path, components))
        return True

    def change_screen_area(self, area):
        """A new size for the screen, kept only when confirmed in time; otherwise the old size and its slider return."""
        screen = self.actions.current_screen()
        if screen is None or area not in screen.modes:
            return
        self.actions.set_screen_mode(screen.output, screen.modes[area])
        if self.actions.keep_screen_mode(self):
            return
        self.actions.set_screen_mode(screen.output, screen.modes[screen.current])
        for sheet in [window.page for window in self.applet_windows.values()] + list(self.applet_pages.values()):
            for tab in sheet.settings_tabs:
                if hasattr(tab, "screen_area"):
                    tab.screen_area.set_value(screen.current)

    def tab_changed(self, applet_name, index):
        if self.showing_page:
            return
        self.history.visit(page_location(applet_name, index))
        self.refresh_navigation()

    def refresh_navigation(self):
        current = self.history.current
        self.address_bar.show_page(current)
        self.back_action.setEnabled(self.history.can_go_back)
        self.forward_action.setEnabled(self.history.can_go_forward)
        self.up_action.setEnabled(parent_location(current) != current)
        self.back_action.setMenu(self.history_menu(self.history.pages_before, -1))
        self.forward_action.setMenu(self.history_menu(self.history.pages_after, 1))

    def history_menu(self, pages, direction):
        if not pages:
            return None
        menu = QMenu(self)
        for distance, page in enumerate(pages, start=1):
            menu.addAction(breadcrumb_text(page)).triggered.connect(
                lambda _checked=False, steps=direction * distance: self.jump(steps)
            )
        return menu


INSTANCE_NAME = "chicago95-control-panel"


def main():
    parser = argparse.ArgumentParser(description="Chicago95 Control Panel")
    parser.add_argument("--page", choices=sorted(PAGE_SLUGS), help="open this applet's page")
    parser.add_argument("--screenshot", metavar="PNG", help="save a picture of the window and exit")
    arguments = parser.parse_args()
    app = chicago95ui.make_app("Control Panel")
    # One window: a later launch (Properties on the taskbar) hands its page to the open one, which comes back up.
    if not arguments.screenshot and chicago95ui.send_to_running(INSTANCE_NAME, arguments.page or ""):
        return 0
    window = ControlPanel()
    if arguments.page:
        window.open_applet(PAGE_SLUGS[arguments.page])
    if arguments.screenshot:
        return 0 if window.grab().save(arguments.screenshot) else 1
    instance = chicago95ui.SingleInstance(INSTANCE_NAME, window.show_again)  # noqa: F841  kept alive with the window
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
