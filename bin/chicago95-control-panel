UPDATE_STATUS = {
    "available": "A newer version is available.",
    "current": "You have the latest version.",
    "unchecked": "Not checked yet.",
}


class UpdatesTab(SettingsTab):
    """The installed and the published version (lib/chicago95update.py), Check now, Install update."""

    def __init__(self, settings, actions):
        super().__init__(settings, actions)
        self.check = None
        self.group("Chicago95 for Plasma")
        self.installed_label, self.latest_label, self.checked_label, self.status_label = (
            QLabel(),
            QLabel(),
            QLabel(),
            QLabel(),
        )
        self.form.addRow("Installed version:", self.installed_label)
        self.form.addRow("Latest version:", self.latest_label)
        self.form.addRow("Last checked:", self.checked_label)
        self.form.addRow(self.status_label)
        self.check_button = chicago95ui.dialog_button("Check now")
        self.install_button = chicago95ui.dialog_button("Install update", enabled=False)
        self.check_button.clicked.connect(self.check_now)
        self.install_button.clicked.connect(self.install_update)
        buttons = QHBoxLayout()
        buttons.addWidget(self.check_button)
        buttons.addWidget(self.install_button)
        buttons.addStretch(1)
        self.form.addRow(buttons)
        self.show_result(chicago95update.read_cache(chicago95update.CACHE_FILE))

    def check_now(self):
        self.check = chicago95update.UpdateCheck(self.saved, chicago95update.CACHE_FILE, parent=self)
        self.check.finished.connect(self.checked)
        self.check_button.setEnabled(False)
        self.status_label.setText("Checking...")
        self.check.start()

    def checked(self, result):
        self.check.deleteLater()
        self.check = None
        self.check_button.setEnabled(True)
        self.show_result(result)

    def show_result(self, result):
        self.installed_label.setText(chicago95update.short_version(self.saved.get("COMMIT", "")))
        self.latest_label.setText(chicago95update.short_version(result.get("latest", "")))
        self.checked_label.setText(result.get("checked", "")[:16].replace("T", " ") or "never")
        if result.get("error"):
            status = f"Could not check: {result['error']}"
        else:
            status = UPDATE_STATUS[
                "available" if result.get("available") else "current" if result.get("latest") else "unchecked"
            ]
        self.status_label.setText(status)
        self.install_button.setEnabled(bool(result.get("available")))

    def install_update(self):
        repo = self.saved.get("REPO", "")
        components = components_for(self.saved) or ["look"]
        self.actions.run_setup(self, update_command(repo, SETTINGS_FILE, components))
        self.saved = read_settings(SETTINGS_FILE)
        self.show_result(chicago95update.read_cache(chicago95update.CACHE_FILE))


@tab_builder("Updates", "Updates")
def updates_tab(settings, actions):
    return UpdatesTab(settings, actions)


