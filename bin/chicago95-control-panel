ICON_SETS = [("Chicago95 (1995)", "chicago95"), ("SE98 (1998)", "se98"), ("ClassicOS 2000", "classicos2000")]
COLOR_FIELDS = (
    ("TITLE_ACTIVE", "Active title bar:"),
    ("TITLE_INACTIVE", "Inactive title bar:"),
    ("BANNER_BG", "Start menu banner:"),
    ("BANNER_FG", "Banner text:"),
)


@tab_builder("Display", "Appearance")
def appearance_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    start = LOOK_PRESETS["1995"]
    tab.group("Scheme")
    tab.scheme = tab.choice(
        "LOOK",
        "Scheme:",
        [("Windows 95", "1995"), ("Windows 98", "1998"), ("Windows 2000", "2000"), ("Custom", "custom")],
        default="1995",
    )
    tab.color_edits = {
        key: tab.color(key, label, default=start[key], most=8 if key == "BANNER_BG" else 2, stops=key == "BANNER_BG")
        for key, label in COLOR_FIELDS
    }
    tab.preview = TitleBarPreview(start["TITLE_ACTIVE"], start["TITLE_INACTIVE"])
    tab.form.addRow("", tab.preview)
    tab.group("Icons")
    tab.icons = tab.choice("ICONS", "Icon set:", ICON_SETS, default=start["ICONS"])
    state = {"applying": False}

    def settling():
        return tab.loading or state["applying"]

    def scheme_changed():
        preset = LOOK_PRESETS.get(tab.scheme.currentData())
        if settling() or preset is None:
            return
        state["applying"] = True
        for key, field in tab.color_edits.items():
            field.set_value(preset[key])
        tab.icons.setCurrentIndex(tab.icons.findData(preset["ICONS"]))
        state["applying"] = False

    def refresh_preview():
        tab.preview.show_colors(tab.color_edits["TITLE_ACTIVE"].value(), tab.color_edits["TITLE_INACTIVE"].value())

    def colour_edited():
        refresh_preview()
        if settling():
            return
        state["applying"] = True
        tab.scheme.setCurrentIndex(tab.scheme.findData("custom"))
        state["applying"] = False

    tab.scheme.currentIndexChanged.connect(scheme_changed)
    for field in tab.color_edits.values():
        field.changed.connect(colour_edited)
    refresh_preview()
    return tab


