@tab_builder("Taskbar", "Taskbar Options")
def taskbar_options_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    tab.group("Taskbar")
    tab.number("PANEL", "Taskbar height:", 22, 64, default=28, suffix=" pixels")
    width = ButtonWidthField(settings.get("LOOK", "1995"))
    tab.register("TASK_BUTTON_WIDTH", "Taskbar button width:", width, width.value, width.set_value, "0", width.changed)
    tab.choice(
        "QUICK_LAUNCH",
        "Quick Launch:",
        [("From the look (1998 on)", "auto"), ("Always", "yes"), ("Never", "no")],
        default="auto",
    )
    tab.flag("TASKBAR_AUTOHIDE", "Auto hide", default="no")
    tab.flag("TASKBAR_ON_TOP", "Always on top", default="yes")
    tab.group("Clock")
    tab.flag("CLOCK_SHOW", "Show clock", default="yes")
    tab.choice(
        "CLOCK_HOURS",
        "Clock shows:",
        [("Hours as my language does", "locale"), ("12 hours", "12"), ("24 hours", "24")],
        default="locale",
    )
    return tab


@tab_builder("Taskbar", "Quick Launch")
def quick_launch_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    live = actions.current_launchers()
    initial = ",".join(live if live is not None else default_launchers(DEFAULT_LAUNCHER_FILES))
    field = LauncherList(lambda parent, title, name_filter: actions.choose_file(parent, title, name_filter))
    tab.register("LAUNCHERS", "", field, field.value, field.set_value, initial, field.changed)
    return tab


