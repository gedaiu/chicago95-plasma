@tab_builder("Distro Setup", "Names and Logos")
def distro_setup_tab(settings, actions):
    """Every name, text and logo the screens show, in one place, with each screen beside them. The pages they
    come from keep their fields; this one names the system once. "Use this computer's system" fills them from
    the running distribution, as Setup's --branding=distro does; "Windows names" puts the look's back."""
    tab = SettingsTab(settings, actions)
    fields = {}
    for title, keys in DISTRO_FIELDS.items():
        tab.group(title)
        for key, label in keys:
            fields[key] = branding_field(tab, key, label, settings)
    branding = {"value": "windows"}
    tab.track("BRANDING", lambda: branding["value"], lambda value: branding.update(value=value or "windows"), "windows")

    def fill(found, chosen):
        for key, value in found.items():
            tab.fields[key][1](value)
        branding["value"] = chosen
        tab.notify()

    tab.group("Names from")
    tab.distro_button = chicago95ui.dialog_button("Use this computer's system")
    tab.distro_button.clicked.connect(lambda: fill(detected_branding(), "distro"))
    tab.windows_button = chicago95ui.dialog_button("Windows names")
    for button in (tab.distro_button, tab.windows_button):  # wider than OK and Cancel: their captions are longer
        button.setFixedWidth(max(button.width(), button.sizeHint().width()))
    keys = chicago95distro.BRANDING_KEYS
    tab.windows_button.clicked.connect(
        lambda: fill({key: branding_defaults(tab.saved)[key] for key in keys}, "windows")
    )
    row = QWidget()
    buttons = QHBoxLayout(row)
    buttons.setContentsMargins(0, 0, 0, 0)
    buttons.addWidget(tab.distro_button)
    buttons.addWidget(tab.windows_button)
    buttons.addStretch(1)
    tab.form.addRow(row)
    tab.group("Preview")
    for caption, preview_class in DISTRO_PREVIEWS:
        tab.form.addRow(QLabel(caption))
        tab.preview(preview_class())
    return tab


ICON_SETS = [
    ("Chicago95 (1995)", "chicago95"),
    ("SE98 (1998)", "se98"),
    ("ClassicOS 2000", "classicos2000"),
    ("Windows XP", "windowsxp"),
    ("Windows 7", "windows7"),
]
# The Appearance tab's items (Windows 98 lists every part of the screen; these are the ones this desktop
# colours): its setting, and how many colours it takes (stops: the banner's base colour and its glows).
APPEARANCE_ITEMS = (
    ("Active Title Bar", "TITLE_ACTIVE", 2, False),
    ("Controls", "WIDGET_STYLE", 0, False),
    ("Desktop", "BACKGROUND_COLOR", 1, False),
    ("Icon", "ICONS", 0, False),
    ("Inactive Title Bar", "TITLE_INACTIVE", 2, False),
    ("Start Menu Banner", "BANNER_BG", 8, True),
    ("Start Menu Banner Text", "BANNER_FG", 1, False),
    ("Window Frames", "DECORATION", 0, False),
)


def appearance_column(caption, widget, width):
    column = QVBoxLayout()
    column.setSpacing(3)
    label = buddy_label(caption, widget)
    label.setEnabled(widget.isEnabled())
    column.addWidget(label, 0, Qt.AlignLeft)
    widget.setFixedWidth(width)
    column.addWidget(widget)
    return column


def disabled_appearance_combo():
    combo = chicago95ui.classic_combo(QComboBox())
    combo.setEnabled(False)
    return combo


def classic_desktop_controls(colour, second_colour):
    row = QHBoxLayout()
    row.setSpacing(7)
    size = chicago95ui.plain_disabled_text(QSpinBox())
    size.setSpecialValueText(" ")
    size.setEnabled(False)
    row.addLayout(appearance_column("Size:", size, 60))
    row.addLayout(appearance_column("Color:", colour, 44))
    if second_colour:
        row.addLayout(appearance_column("Color 2:", disabled_appearance_combo(), 44))
    else:
        row.addStretch()
    return row


@tab_builder("Display", "Appearance")
def appearance_tab(settings, actions, *, luna_sheet=False):
    """Windows 98's Appearance tab (the tech2u Display Properties picture): the sample windows in the scheme's
    colours, Scheme with Save As and Delete, and Item with the chosen part's settings."""
    tab = SettingsTab(settings, actions)
    classic_sheet = is_classic_display(settings) and settings.get("LOOK") != "2001"
    tab.outer.setContentsMargins(*(14, 8, 13, 8) if classic_sheet else (12, PAGE_INSETS[1], 12, PAGE_INSETS[3]))
    if classic_sheet:
        tab.outer.setSpacing(9)
        tab.form.setVerticalSpacing(5)
    start = LOOK_PRESETS["1995"]
    tab.preview = AppearanceSwitch(classic_sheet, luna_sheet=luna_sheet)
    tab.previews.append(tab.preview)
    tab.outer.insertWidget(0, tab.preview)
    tab.scheme = chicago95ui.classic_combo(QComboBox())
    for label, value in [*START_MENU_STYLES, ("Custom", "custom")]:
        tab.scheme.addItem(label, value)
    tab.save_as_button = chicago95ui.dialog_button("Sa&ve As...", enabled=False)
    tab.delete_button = chicago95ui.dialog_button("&Delete", enabled=False)
    tab.items = chicago95ui.classic_combo(QComboBox())
    tab.item_editors = CurrentPageStack()
    tab.color_edits = {}
    component_combos = {}
    for label, key, most, stops in APPEARANCE_ITEMS:
        editor = QWidget()
        form = QFormLayout(editor)
        form.setContentsMargins(0, 0, 0, 0)
        if key == "ICONS":
            tab.icons = chicago95ui.classic_combo(QComboBox())
            for icon_label, value in ICON_SETS:
                tab.icons.addItem(icon_label, value)
            form.addRow("Icon set:", tab.icons)
        elif key in ("DECORATION", "WIDGET_STYLE"):
            component_combos[key] = chicago95ui.classic_combo(QComboBox())
            for style_label, value in DECORATION_STYLES if key == "DECORATION" else COMPONENT_STYLES:
                component_combos[key].addItem(style_label, value)
            form.addRow("Style:", component_combos[key])
        else:
            tab.color_edits[key] = ColorListField(lambda current: actions.choose_color(tab, current), most, stops)
            if stops:
                dialog = QDialog(editor)
                dialog.setWindowTitle("Start menu banner colours")
                layout = QVBoxLayout(dialog)
                layout.addWidget(tab.color_edits[key])
                close = chicago95ui.dialog_button("Close")
                close.clicked.connect(dialog.close)
                layout.addWidget(close, 0, Qt.AlignRight)
                edit = chicago95ui.dialog_button("Edit gradient…")
                edit.clicked.connect(dialog.show)
                form.addRow("Color:", edit)
            elif classic_sheet and key == "BACKGROUND_COLOR":
                form.addRow(classic_desktop_controls(tab.color_edits[key], settings.get("LOOK") != "1995"))
            else:
                form.addRow("Color:", tab.color_edits[key])
        tab.items.addItem(label, key)
        tab.item_editors.addWidget(editor)
    tab.items.currentIndexChanged.connect(tab.item_editors.setCurrentIndex)
    tab.items.setCurrentIndex(tab.items.findText("Desktop"))
    scheme_row = QHBoxLayout()
    if classic_sheet:
        scheme_row.setSpacing(0)
        tab.save_as_button.setFixedSize(80, 22)
        tab.delete_button.setFixedSize(80, 22)
    scheme_row.addWidget(tab.scheme, 1)
    if classic_sheet:
        scheme_row.addSpacing(7)
    scheme_row.addWidget(tab.save_as_button)
    if classic_sheet:
        scheme_row.addSpacing(5)
    scheme_row.addWidget(tab.delete_button)
    item_row = QHBoxLayout()
    if classic_sheet:
        item_row.setSpacing(7)
    tab.form.addRow(buddy_label("&Scheme:", tab.scheme))
    tab.form.addRow(scheme_row)
    if classic_sheet:
        item_row.setContentsMargins(0, 5, 0, 0)
        item_row.addLayout(appearance_column("&Item:", tab.items, 208))
        item_row.addWidget(tab.item_editors, 1, Qt.AlignBottom)
    else:
        tab.form.addRow(buddy_label("&Item:", tab.items))
        item_row.addWidget(tab.items, 1)
        item_row.addWidget(tab.item_editors, 1)
    tab.form.addRow(item_row)
    font_row = QHBoxLayout()  # the original's Font line, greyed out as for the Desktop: fonts are the Fonts applet's
    font = chicago95ui.classic_combo(QComboBox())
    font.setEnabled(False)
    if classic_sheet:
        font_row.setContentsMargins(0, 6, 0, 0)
        font_row.setSpacing(7)
        font_row.addLayout(appearance_column("&Font:", font, 208))
        font_row.addLayout(appearance_column("Size:", disabled_appearance_combo(), 60))
        font_row.addLayout(appearance_column("Color:", disabled_appearance_combo(), 44))
        style_row = QHBoxLayout()
        style_row.setSpacing(2)
        font_row.addLayout(style_row)
        font_row.setAlignment(style_row, Qt.AlignBottom)
    else:
        font.addItem(chicago95ui.ui_font().family())
        font_row.addWidget(font, 1)
        tab.form.addRow(buddy_label("&Font:", font))
        style_row = font_row
    for caption in ("B", "I"):
        style_button = QPushButton(caption)
        style_button.setFixedSize(20, 21)
        style_button.setEnabled(False)
        style_row.addWidget(style_button)
    tab.form.addRow(font_row)
    tab.track(
        "LOOK",
        tab.scheme.currentData,
        lambda value: tab.scheme.setCurrentIndex(max(tab.scheme.findData(value), 0)),
        "1995",
        tab.scheme.currentIndexChanged,
    )
    for key, field in tab.color_edits.items():
        tab.track(key, field.value, field.set_value, start[key], field.changed)
    tab.track(
        "ICONS",
        tab.icons.currentData,
        lambda value: tab.icons.setCurrentIndex(max(tab.icons.findData(value), 0)),
        start["ICONS"],
        tab.icons.currentIndexChanged,
    )
    saved_look = LOOK_PRESETS.get(settings.get("LOOK"), start)
    for key, combo in component_combos.items():
        tab.track(
            key,
            combo.currentData,
            lambda value, combo=combo: combo.setCurrentIndex(max(combo.findData(value), 0)),
            saved_look[key],
            combo.currentIndexChanged,
        )
    unseen_components = {key: saved_look[key] for key in UNSEEN_COMPONENT_KEYS}
    for key in UNSEEN_COMPONENT_KEYS:
        tab.track(
            key,
            lambda key=key: unseen_components[key],
            lambda value, key=key: unseen_components.update({key: value}),
            saved_look[key],
        )
    state = {"applying": False}

    def settling():
        return tab.loading or state["applying"]

    def scheme_changed():
        preset = LOOK_PRESETS.get(tab.scheme.currentData())
        if settling() or preset is None:
            return
        state["applying"] = True
        for key, field in tab.color_edits.items():
            field.set_value(preset[key])
        tab.icons.setCurrentIndex(tab.icons.findData(preset["ICONS"]))
        for key, combo in component_combos.items():
            combo.setCurrentIndex(combo.findData(preset[key]))
        unseen_components.update({key: preset[key] for key in UNSEEN_COMPONENT_KEYS})
        state["applying"] = False
        refresh_preview()

    def refresh_preview():
        tab.preview.show_colors(
            tab.color_edits["TITLE_ACTIVE"].value(),
            tab.color_edits["TITLE_INACTIVE"].value(),
            tab.color_edits["BACKGROUND_COLOR"].value(),
            tab.scheme.currentData(),
        )

    def colour_edited():
        refresh_preview()
        if settling():
            return
        state["applying"] = True
        tab.scheme.setCurrentIndex(tab.scheme.findData("custom"))
        state["applying"] = False

    tab.scheme.currentIndexChanged.connect(scheme_changed)
    for field in tab.color_edits.values():
        field.changed.connect(colour_edited)
    for combo in component_combos.values():
        combo.currentIndexChanged.connect(lambda *_: colour_edited())
    if luna_sheet:
        arrange_luna_appearance(tab, component_combos["WIDGET_STYLE"])
    refresh_preview()
    return tab


def arrange_luna_appearance(tab, controls):
    """Show XP's everyday choices and keep the component editors under Advanced."""
    advanced = QDialog(tab)
    advanced.setWindowTitle("Advanced Appearance")
    tab.outer.removeItem(tab.form)
    advanced.setLayout(tab.form)
    buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
    buttons.accepted.connect(advanced.accept)
    buttons.rejected.connect(advanced.reject)
    tab.form.addRow(buttons)

    def edit_advanced():
        before = tab.values()
        if advanced.exec() != QDialog.Accepted:
            tab.load(before)
        tab.notify()

    tab.outer.setContentsMargins(14, 8, 13, 13)
    tab.outer.setSpacing(12)
    tab.windows_style = chicago95ui.classic_combo(QComboBox())
    for label, value in (("Windows Classic style", "classic"), ("Windows XP style", "luna"), ("Windows 7 style", "aero")):
        tab.windows_style.addItem(label, value)
    tab.windows_style.setCurrentIndex(controls.currentIndex())
    controls.currentIndexChanged.connect(tab.windows_style.setCurrentIndex)
    tab.windows_style.currentIndexChanged.connect(controls.setCurrentIndex)

    colours = chicago95ui.classic_combo(QComboBox())
    colours.addItem("Default (blue)")
    tab.windows_style.currentIndexChanged.connect(
        lambda: colours.setItemText(0, "Default (blue)" if tab.windows_style.currentData() == "luna" else "Default")
    )
    if tab.windows_style.currentData() != "luna":
        colours.setItemText(0, "Default")
    sizes = chicago95ui.classic_combo(QComboBox())
    sizes.addItem("Normal")

    choices = QVBoxLayout()
    choices.setSpacing(11)
    for caption, combo in (("&Windows and buttons:", tab.windows_style), ("&Color scheme:", colours), ("&Font size:", sizes)):
        combo.setFixedHeight(19)
        choices.addLayout(appearance_column(caption, combo, 210))
    buttons = QVBoxLayout()
    buttons.setSpacing(8)
    buttons.addStretch(1)
    tab.effects_button = chicago95ui.dialog_button("&Effects...")
    tab.advanced_button = chicago95ui.dialog_button("Ad&vanced")
    tab.advanced_button.clicked.connect(edit_advanced)
    for button in (tab.effects_button, tab.advanced_button):
        button.setFixedSize(87, 21)
        buttons.addWidget(button)
    row = QHBoxLayout()
    row.addLayout(choices)
    row.addStretch(1)
    row.addLayout(buttons)
    tab.outer.insertLayout(1, row)
    tab.setFocusProxy(tab.windows_style)


MONITOR_SCREEN = (152, 112)  # the Screen Saver tab's monitor (tests/references/win98screensaver.png)


def cover_rect(picture, screen):
    """Where a picture that covers the screen goes: scaled to reach both edges, keeping its shape, centred."""
    scale = max(screen.width() / picture.width(), screen.height() / picture.height())
    size = QSize(round(picture.width() * scale), round(picture.height() * scale))
    left = screen.left() + int((screen.width() - size.width()) / 2)
    top = screen.top() + int((screen.height() - size.height()) / 2)
    return QRect(QPoint(left, top), size)


class MonitorPreview(QWidget):
    """The monitor drawn at the top of the Screen Saver tab: its screen shows the chosen screensaver's picture,
    or the desktop colour."""

    def __init__(self, desktop_colour, *, luna=False):
        super().__init__()
        self.desktop_colour = QColor(desktop_colour)
        self.luna = luna
        self.art = control_panel_art("luna-preview-monitor.svg" if luna else "display-monitor.svg")
        self.case = QSvgRenderer(self)
        self.case_shadow = None
        self.picture = QPixmap()
        self.pattern, self.wallpaper, self.fill = None, QPixmap(), "center"
        self.setFixedSize(*(141, 127) if luna else (184, 169))

    def show_desktop(self, colour, pattern, wallpaper, fill):
        """The desktop as the Background tab sets it: its colour, an 8 by 8 pattern over it, or a wallpaper."""
        self.desktop_colour = QColor(colour)
        self.pattern = pattern
        self.wallpaper = QPixmap(str(wallpaper)) if wallpaper and Path(wallpaper).exists() else QPixmap()
        self.fill = fill
        self.update()

    def paint_desktop(self, painter):
        screen = self.screen_rect()
        painter.save()
        painter.setClipRect(screen)
        for row, bits in enumerate(self.pattern or []):
            for column in range(8):
                if bits & (0x80 >> column):
                    for x in range(screen.left() + column, screen.right() + 1, 8):
                        for y in range(screen.top() + row, screen.bottom() + 1, 8):
                            painter.fillRect(x, y, 1, 1, Qt.black)
        if not self.wallpaper.isNull():
            self.paint_wallpaper(painter, screen)
        painter.restore()

    def paint_wallpaper(self, painter, screen):
        if self.fill == "stretch":
            painter.drawPixmap(screen, self.wallpaper)
            return
        if self.fill == "cover":
            painter.drawPixmap(cover_rect(self.wallpaper.size(), screen), self.wallpaper)
            return
        # The screen in the picture stands for the real one: the wallpaper shrinks by as much.
        real = QGuiApplication.primaryScreen().size() if QGuiApplication.primaryScreen() else QSize(1024, 768)
        size = self.wallpaper.size() * (screen.width() / max(1, real.width()))
        size = QSize(max(1, size.width()), max(1, size.height()))
        if self.fill == "tile":
            for x in range(screen.left(), screen.right() + 1, size.width()):
                for y in range(screen.top(), screen.bottom() + 1, size.height()):
                    painter.drawPixmap(QRect(QPoint(x, y), size), self.wallpaper)
            return
        painter.drawPixmap(QRect(screen.center() - QPoint(size.width() // 2, size.height() // 2), size), self.wallpaper)

    def show_picture(self, path):
        self.picture = QPixmap(str(path)) if path is not None and Path(path).exists() else QPixmap()
        self.update()

    def screen_rect(self):
        if self.luna:
            return QRect(9, 12, 121, 90)
        return QRect(16, 17, *MONITOR_SCREEN)

    def paintEvent(self, _event):
        painter = QPainter(self)
        shadow = self.palette().dark().color().name()
        if shadow != self.case_shadow:
            self.case.load(self.art.replace(b"#808080", shadow.encode("ascii")))
            self.case_shadow = shadow
        if not self.luna:
            painter.fillRect(self.rect(), self.palette().window())
        self.case.render(painter)
        painter.fillRect(self.screen_rect(), self.desktop_colour)
        self.paint_desktop(painter)
        if not self.picture.isNull():
            painter.drawPixmap(self.screen_rect(), self.picture)


def desktop_colour(settings):
    return (
        settings.get("BACKGROUND_COLOR", "#008080") if valid_colors(settings.get("BACKGROUND_COLOR", "")) else "#008080"
    )


@tab_builder("Display", "Settings")
def display_settings_tab(settings, actions):
    """Display Settings with a monitor preview, resolution slider, and access to advanced settings."""
    tab = SettingsTab(settings, actions)
    luna = chicago95ui.luna_widgets()
    xp = luna or (is_classic_display(settings) and settings.get("LOOK") == "2001")
    if xp:
        tab.outer.setContentsMargins(14, 32, 14, 6 if luna else 9)
        tab.monitor = QSvgWidget()
        desktop = desktop_colour(settings).split(",")[0]
        art = control_panel_art("xp-display-monitor.svg").replace(b"#3a6ea5", desktop.encode("ascii"))
        tab.monitor.load(art)
        tab.monitor.setFixedSize(141, 127)
    else:
        tab.monitor = MonitorPreview(desktop_colour(settings))
    tab.outer.insertWidget(0, tab.monitor, 0, Qt.AlignHCenter)
    screen = actions.current_screen()
    tab.display_name = QLabel(screen.output if screen else "Unknown monitor")
    colours, area = (
        QGroupBox("Color quality" if xp else "Colors"),
        QGroupBox("Screen resolution" if xp else "Screen area"),
    )
    colour_layout = QVBoxLayout(colours)
    colour_combo = chicago95ui.classic_combo(QComboBox())
    if xp and screen is not None:
        depth = actions.display_depth(screen.output)
        if depth == 16:
            colour_combo.addItem("Medium (16 bit)")
        elif depth == 24:
            colour_combo.addItem("Highest (24 bit)")
        elif depth == 32:
            colour_combo.addItem("Highest (32 bit)")
        elif depth > 0:
            colour_combo.addItem(f"{depth} bit")
    if colour_combo.count() == 0:
        colour_combo.addItem("Unknown" if xp else "True Color (32 bit)")
    colour_layout.addWidget(colour_combo)
    if xp:
        tab.outer.insertSpacing(1, 32 if luna else 35)
        tab.form.setVerticalSpacing(3)
        tab.form.addRow(QLabel("Display:"))
        tab.form.addRow(tab.display_name)
        spectrum = QSvgWidget(str(control_panel_asset("xp-display-colour.svg")))
        spectrum.setFixedHeight(14 if luna else 15)
        if luna:
            colour_combo.setFixedHeight(19)
        colour_layout.setContentsMargins(9, 2, 9, 9)
        colour_layout.addWidget(spectrum)
    else:
        tab.form.addRow("Display:", tab.display_name)
    tab.screen_area = ScreenAreaField(screen.sizes if screen else [], luna=luna)
    tab.screen_area.setEnabled(screen is not None)
    area_layout = QVBoxLayout(area)
    area_layout.addWidget(tab.screen_area)
    row = QHBoxLayout()
    row.addWidget(area if xp else colours, 1)
    row.addWidget(colours if xp else area, 1)
    if xp:
        tab.outer.insertSpacing(tab.outer.count() - 1, 6 if luna else 11)
        area_layout.setContentsMargins(7 if luna else 9, 2, 9, 9)
        tab.screen_area.slider.setTickPosition(QSlider.TicksBelow)
    tab.outer.insertLayout(tab.outer.count() - 1, row)
    if screen is not None:
        tab.fields["SCREEN_AREA"] = (tab.screen_area.value, tab.screen_area.set_value, screen.current)
        tab.screen_area.set_value(screen.current)
        tab.screen_area.changed.connect(tab.notify)
    tab.advanced_button = chicago95ui.dialog_button("Ad&vanced...")
    tab.advanced_button.clicked.connect(lambda: actions.start_process("kcmshell6", ["kcm_kscreen"]))
    buttons = QHBoxLayout()
    buttons.addStretch(1)
    if xp:
        troubleshoot = chicago95ui.dialog_button("&Troubleshoot...")
        troubleshoot.setFixedWidth(94)
        troubleshoot.clicked.connect(
            lambda: actions.show_message(
                tab,
                "Display Troubleshooter",
                "If the display becomes unreadable after applying a resolution, wait for the previous size to return. "
                "Use Advanced to check connected displays and their supported modes.",
            )
        )
        buttons.addWidget(troubleshoot)
        tab.advanced_button.setText("Ad&vanced")
        tab.advanced_button.setFixedWidth(90)
        if luna:
            troubleshoot.setFixedHeight(21)
            tab.advanced_button.setFixedHeight(21)
    buttons.addWidget(tab.advanced_button)
    tab.outer.insertLayout(tab.outer.count() - 1, buttons)
    return tab


@tab_builder("Display", "Screen Saver")
def screen_saver_tab(settings, actions):
    tab = SettingsTab(settings, actions)
    luna = chicago95ui.luna_widgets()
    tab.monitor = MonitorPreview(desktop_colour(settings), luna=luna)
    tab.outer.insertWidget(0, tab.monitor, 0, Qt.AlignHCenter)
    if luna:
        tab.outer.setContentsMargins(14, 31, 14, 6)
        tab.outer.setSpacing(2)
        tab.outer.insertSpacing(1, 10)
    tab.group("Screen saver" if luna else "Screen Saver")
    savers = actions.list_screensavers()
    preview = chicago95ui.dialog_button("Preview", enabled=bool(savers))
    controls = preview
    if luna:
        controls = QWidget()
        buttons = QHBoxLayout(controls)
        buttons.setContentsMargins(0, 0, 0, 0)
        tab.saver_settings = chicago95ui.dialog_button("&Settings", enabled=bool(savers))
        for button in (tab.saver_settings, preview):
            button.setFixedSize(78, 21)
            buttons.addWidget(button)
        tab.form.setContentsMargins(6, 8, 13, 8)
        tab.form.setVerticalSpacing(7)
    tab.saver_combo = saver = tab.choice(
        "SAVER",
        "",
        [(label, name) for name, label in savers] or [("Deep Stars", "deepstars")],
        default="deepstars",
        beside=controls,
    )
    pictures = actions.screensaver_pictures()

    def show_picture():
        tab.monitor.show_picture(pictures / f"{saver.currentData()}.png")

    saver.currentIndexChanged.connect(show_picture)
    show_picture()
    wait = tab.number("IDLE_MIN", "Wait:", 1, 60, default=5, suffix=" minutes")
    if luna:
        saver.setFixedHeight(20)
        saver.setProperty("lunaSelectionOnFocus", True)
        wait.setFixedSize(53, 19)
        wait.setAlignment(Qt.AlignRight)
        tab.saver_settings.clicked.connect(
            lambda: actions.show_message(
                tab,
                "Blank Screen Saver" if saver.currentData() == "blank" else "Screen Saver Settings",
                "This screen saver has no options that you can set.",
            )
        )
    preview.clicked.connect(
        lambda: actions.start_process(tool_path("chicago95-screensaver"), ["--hack", saver.currentData()])
    )
    lock_minutes = actions.lock_timeout_minutes()
    tab.lock_warning = QLabel(f"Your screen locks after {lock_minutes} minutes, before the screen saver starts.")
    tab.lock_warning.setWordWrap(True)
    if luna:
        tab.group("Monitor power")
        tab.form.setContentsMargins(9, 3, 13, 6)
        description = QLabel("To adjust monitor power settings and save energy, click Power.")
        description.setContentsMargins(91, 0, 0, 0)
        description.setWordWrap(True)
        tab.form.addRow(description)
        tab.form.addRow(tab.lock_warning)
        power = chicago95ui.dialog_button("Po&wer...")
        power.setFixedSize(78, 21)
        tab.form.addRow(power)
        tab.form.setAlignment(power, Qt.AlignRight)
        program, *arguments = POWER_SETTINGS
        power.clicked.connect(lambda: actions.start_process(program, arguments))
    else:
        tab.form.addRow("", tab.lock_warning)

    def show_warning():
        warning = screensaver_hidden_by_lock(wait.value(), lock_minutes)
        tab.lock_warning.setVisible(warning)
        if luna:
            description.setVisible(not warning)

    wait.valueChanged.connect(show_warning)
    show_warning()
    return tab


