#!/usr/bin/env python3
"""Windows 95 style screensaver for Plasma Wayland.

Polls the session idle time, starts an XScreenSaver hack full-screen after
IDLE_SECONDS, and stops it the moment the idle counter resets (any input).
Plasma's own lock still takes over at its configured time.
"""
import os
import subprocess
import sys
import time

HACK = os.environ.get("CHICAGO95_SAVER", "pipes")
IDLE_SECONDS = int(os.environ.get("CHICAGO95_SAVER_IDLE", "300"))
HACK_DIR = next((d for d in ("/usr/libexec/xscreensaver", "/usr/lib/xscreensaver", "/usr/lib64/xscreensaver",
                             "/usr/lib/x86_64-linux-gnu/xscreensaver") if os.path.isdir(d)), "/usr/libexec/xscreensaver")
HACK_ARGS = {"pipes": [], "flyingtoasters": [], "maze": [], "starfield": [], "bsod": []}


def idle_ms():
    out = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.ScreenSaver",
                          "--object-path", "/ScreenSaver", "--method", "org.freedesktop.ScreenSaver.GetSessionIdleTime"],
                         capture_output=True, text=True).stdout
    digits = "".join(ch for ch in out if ch.isdigit())
    return int(digits) if digits else 0


def screen_size():
    out = subprocess.run(["xdpyinfo"], capture_output=True, text=True, env=dict(os.environ, DISPLAY=os.environ.get("DISPLAY", ":0"))).stdout
    for line in out.splitlines():
        if "dimensions:" in line:
            return line.split()[1]
    return "1920x1080"


def start_hack():
    env = dict(os.environ, QT_QPA_PLATFORM="xcb", GDK_BACKEND="x11")
    args = [f"{HACK_DIR}/{HACK}", "-geometry", screen_size() + "+0+0"] + HACK_ARGS.get(HACK, [])
    proc = subprocess.Popen(args, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Ask KWin to make the hack window fullscreen once it appears.
    script = ("const ws = workspace.windowList ? workspace.windowList() : workspace.clientList();"
              "for (const w of ws) { if (w.pid === %d) { w.fullScreen = true; w.keepAbove = true; workspace.activeWindow = w; } }") % proc.pid
    script_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "chicago95-saver-fullscreen.js")
    with open(script_path, "w") as handle:
        handle.write(script)
    for _ in range(6):
        time.sleep(0.5)
        out = subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path", "/Scripting",
                              "--method", "org.kde.kwin.Scripting.loadScript", script_path], capture_output=True, text=True).stdout
        digits = "".join(ch for ch in out if ch.isdigit() or ch == "-")
        if digits and int(digits) >= 0:
            subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path", f"/Scripting/Script{int(digits)}",
                            "--method", "org.kde.kwin.Script.run"], capture_output=True)
            subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path", f"/Scripting/Script{int(digits)}",
                            "--method", "org.kde.kwin.Script.stop"], capture_output=True)
    return proc


def main():
    if "--test" in sys.argv:
        proc = start_hack(); time.sleep(float(sys.argv[sys.argv.index("--test") + 1]) if len(sys.argv) > sys.argv.index("--test") + 1 else 5); proc.terminate(); return
    running = None
    while True:
        idle = idle_ms() // 1000
        if running is None and idle >= IDLE_SECONDS:
            running = start_hack()
        elif running is not None and idle < 2:
            running.terminate()
            running = None
        time.sleep(1 if running else 5)


if __name__ == "__main__":
    main()
