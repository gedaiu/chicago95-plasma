#!/usr/bin/env python3
"""Chicago95 style screensaver for Plasma.

Plasma's power management starts this after the idle time chosen in Setup
(powerdevilrc, [AC][RunScript] and [Battery][RunScript]); Wayland gives no
idle time to ordinary clients, so it cannot poll for itself. It shows an
XScreenSaver hack full screen with a transparent window on top that catches
input: any key, click or mouse movement closes both.

    chicago95-screensaver --hack pipes    run one now (also how Setup previews it)
    chicago95-screensaver --list          installed savers, one "name<TAB>label" per line
"""

import os
import sys

sys.path[:0] = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
    os.path.expanduser("~/.local/lib/chicago95"),
]
import argparse
import subprocess
from pathlib import Path

import chicago95ui  # noqa: E401,E702
from PySide6.QtCore import Qt, QTimer
from PySide6.QtWidgets import QWidget

# The classic savers and their closest XScreenSaver hack, in the order Setup lists them.
CATALOG = {
    "deepstars": "Starfield Simulation",
    "pipes": "3D Pipes",
    "maze3d": "3D Maze",
    "fliptext": "3D Text",
    "qix": "Mystify Your Mind",
    "flyingtoasters": "Flying Toasters",
    "flurry": "Flurry",
    "glmatrix": "Matrix",
    "bsod": "Blue Screen",
}
DEFAULT_HACK = "deepstars"
HACK_DIRS = (
    "/usr/libexec/xscreensaver",
    "/usr/lib/xscreensaver",
    "/usr/lib64/xscreensaver",
    "/usr/lib/x86_64-linux-gnu/xscreensaver",
)
MOUSE_SLACK_PX = 4
INPUT_GRACE_MS = 1000
PID_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "chicago95-screensaver.pid"


def hack_dir():
    return next((Path(directory) for directory in HACK_DIRS if os.path.isdir(directory)), None)


def installed_savers(directory):
    if directory is None:
        return {}
    return {name: label for name, label in CATALOG.items() if (directory / name).exists()}


def already_running():
    try:
        os.kill(int(PID_FILE.read_text()), 0)
    except (OSError, ValueError):
        return False
    return True


def kwin_script(hack_pid, own_pid):
    # Both above the taskbar (a normal-layer hack would sit under it) and out of it; this transparent
    # window is activated last so it stays on top of the hack and gets the input.
    return (
        "for (const window of workspace.windowList()) {"
        f"  if (window.pid === {hack_pid} || window.pid === {own_pid}) {{"
        "    window.fullScreen = true; window.keepAbove = true; window.skipTaskbar = true; window.skipSwitcher = true;"
        "  }"
        "}"
        "for (const window of workspace.windowList()) {"
        f"  if (window.pid === {own_pid}) workspace.activeWindow = window;"
        "}"
    )


def run_kwin_script(source):
    path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "chicago95-screensaver-kwin.js"
    path.write_text(source)
    name = f"chicago95-screensaver-{os.getpid()}"
    kwin = ["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path"]
    subprocess.run(kwin + ["/Scripting", "--method", "org.kde.kwin.Scripting.unloadScript", name], capture_output=True)
    subprocess.run(
        kwin + ["/Scripting", "--method", "org.kde.kwin.Scripting.loadScript", str(path), name], capture_output=True
    )
    subprocess.run(kwin + ["/Scripting", "--method", "org.kde.kwin.Scripting.start"], capture_output=True)


class InputCatcher(QWidget):
    """Transparent full-screen window over the hack; the first real input ends the screensaver."""

    def __init__(self, on_input):
        super().__init__()
        self.on_input = on_input
        self.armed = False
        self.first_position = None
        self.setWindowTitle("chicago95-screensaver")
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setCursor(Qt.BlankCursor)
        self.setMouseTracking(True)
        QTimer.singleShot(INPUT_GRACE_MS, self.arm)

    def arm(self):
        self.armed = True

    def finish(self):
        if self.armed:
            self.on_input()

    def keyPressEvent(self, event):
        self.finish()

    def mousePressEvent(self, event):
        self.finish()

    def wheelEvent(self, event):
        self.finish()

    def mouseMoveEvent(self, event):
        position = event.globalPosition().toPoint()
        if self.first_position is None or not self.armed:
            self.first_position = position
            return
        if (position - self.first_position).manhattanLength() > MOUSE_SLACK_PX:
            self.finish()


def run_saver(app, hack_path):
    hack = subprocess.Popen(
        [str(hack_path)],
        env=dict(os.environ, QT_QPA_PLATFORM="xcb", GDK_BACKEND="x11"),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    def stop():
        hack.terminate()
        app.quit()

    catcher = InputCatcher(stop)
    catcher.showFullScreen()
    # The hack's window appears a moment after the process starts; repeat until KWin has placed both.
    placements = QTimer()
    placements.timeout.connect(lambda: run_kwin_script(kwin_script(hack.pid, os.getpid())))
    placements.start(400)
    QTimer.singleShot(4000, placements.stop)
    exited = QTimer()
    exited.timeout.connect(lambda: hack.poll() is not None and app.quit())
    exited.start(500)
    wakeup = chicago95ui.quit_on_signals(app)  # noqa: F841  kept alive for the event loop
    code = app.exec()
    hack.terminate()
    return code


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--hack", default=DEFAULT_HACK, help="XScreenSaver hack to show (default %(default)s)")
    parser.add_argument("--list", action="store_true", help="print the installed savers and exit")
    args = parser.parse_args()

    savers = installed_savers(hack_dir())
    if args.list:
        for name, label in savers.items():
            print(f"{name}\t{label}")
        return 0
    if args.hack not in savers:
        print(f"{args.hack} is not installed; installed: {', '.join(savers) or 'none'}", file=sys.stderr)
        return 1
    if already_running():
        return 0
    PID_FILE.write_text(str(os.getpid()))
    try:
        app = chicago95ui.make_app("chicago95-screensaver")
        return run_saver(app, hack_dir() / args.hack)
    finally:
        PID_FILE.unlink(missing_ok=True)


if __name__ == "__main__":
    sys.exit(main())
