#!/usr/bin/env python3
"""Office Assistant for Chicago95: a top-right paperclip that never shuts up."""
import os, sys; sys.path.insert(0, os.path.expanduser("~/.local/lib/chicago95")); import win95ui  # noqa: E401,E702

import argparse
import base64
import json
import random
import re
import shutil
import signal
import subprocess
from dataclasses import dataclass, field
from pathlib import Path

from PySide6.QtCore import QPoint, QRect, QSize, Qt, QTimer
from PySide6.QtGui import QColor, QImage, QPainter, QPainterPath, QPen, QPixmap, QPolygon
from PySide6.QtWidgets import QMenu, QPushButton, QWidget

ASSET_DIR = Path.home() / ".local/share/chicago95/clippy"
SOUND_CACHE_DIR = Path.home() / ".cache/chicago95-clippy"
PID_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "chicago95-clippy.pid"

SCALE = 1
SCREEN_MARGIN = 24
HIDE_MINUTES = 10
IDLE_INTERVAL_SECONDS = (8, 20)
TIP_INTERVAL_SECONDS = (90, 240)
BALLOON_TIMEOUT_MS = 20_000
BALLOON_TEXT_WIDTH = 260
BALLOON_PADDING = 10
BALLOON_RADIUS = 8
BALLOON_FILL = QColor("#FFFFCC")
TAIL_HEIGHT = 18

TIP_ANIMATIONS = ["GetAttention", "Explain", "Thinking", "Searching", "Writing", "Alert", "Congratulate", "LookRight"]

