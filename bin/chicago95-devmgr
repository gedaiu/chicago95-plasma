#!/usr/bin/env python3
"""Device Manager: the computer's hardware as the classic Device Manager listed it, by type or by connection,
to look at only. The inventory is lshw's (no root needed; details it hides without root stay "Not available");
a device's Properties show its General, Driver and Resources pages, the resources read from sysfs.

    chicago95-devmgr                  the window
    chicago95-devmgr --screenshot PNG  a picture of the window, for the docs and the tests
"""

import os
import sys

sys.path[:0] = [
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
    os.path.expanduser("~/.local/lib/chicago95"),
]
import json
import subprocess
from dataclasses import dataclass, field
from pathlib import Path

import chicago95ui  # noqa: E702
from PySide6.QtCore import QPoint, QSize, Qt
from PySide6.QtGui import QColor, QIcon, QPainter, QPen, QPolygon
from PySide6.QtWidgets import (
    QApplication,
    QButtonGroup,
    QCheckBox,
    QDialog,
    QFormLayout,
    QGroupBox,
    QHBoxLayout,
    QLabel,
    QRadioButton,
    QTabWidget,
    QTreeWidget,
    QTreeWidgetItem,
    QTreeWidgetItemIterator,
    QVBoxLayout,
    QWidget,
)

LSHW_TIMEOUT_SECONDS = 90
ICON_SIZE = 16
ITEM_ROLE = Qt.UserRole
SYSFS_PCI = Path("/sys/bus/pci/devices")
IO_RESOURCE, MEMORY_RESOURCE = 0x100, 0x200  # IORESOURCE_IO and IORESOURCE_MEM in a sysfs "resource" line's flags
WORKING = "This device is working properly."
NO_DRIVER = "The drivers for this device are not installed. (Code 28)"

# The classic Device Manager's classes, in its order, with the icon each one shows.
CATEGORIES = {
    "CDROM": "media-optical",
    "Disk drives": "drive-harddisk",
    "Display adapters": "video-display",
    "Floppy disk controllers": "media-floppy",
    "Hard disk controllers": "drive-harddisk",
    "Human Interface Devices": "input-gaming",
    "Keyboard": "input-keyboard",
    "Modem": "modem",
    "Monitors": "video-display",
    "Mouse": "input-mouse",
    "Network adapters": "network-wired",
    "Other devices": "dialog-question",
    "Ports (COM & LPT)": "modem",
    "Sound, video and game controllers": "audio-card",
    "System devices": "computer",
    "Universal Serial Bus controllers": "drive-removable-media-usb",
}
POINTING_WORDS = ("mouse", "pointer", "pointing", "touchpad", "trackpad", "pen", "pad", "trackball")
AUDIO_JACK_WORDS = ("pcm", "hda", "hd-audio", "mic", "line", "headphone", "speaker")


@dataclass
class Device:
    name: str
    category: str
    kind: str
    manufacturer: str = ""
    version: str = ""
    driver: str = ""
    bus_info: str = ""
    logical_name: str = ""
    claimed: bool = True
    children: list = field(default_factory=list)
    details: list = field(default_factory=list)  # (name, value) for everything else lshw reported

    @property
    def status(self):
        return WORKING if self.claimed else NO_DRIVER

    @property
    def working(self):
        return self.claimed


@dataclass
class Snapshot:
    computer: Device
    devices: list
    error: str = ""


def logical_names(node):
    names = node.get("logicalname", "")
    return " ".join(names) if isinstance(names, list) else str(names)


def node_text(node):
    texts = [str(node.get(key, "")) for key in ("product", "description", "id")]
    return " ".join([*texts, logical_names(node)]).lower()


def categorise(node):
    """The classic class an lshw node belongs to, or None for the parts the Device Manager never listed."""
    kind, identifier, text = node.get("class", ""), str(node.get("id", "")), node_text(node)
    if kind in ("system", "memory", "volume", "printer", "power") or identifier.startswith("cache"):
        return None
    if kind == "input":
        if any(word in text for word in AUDIO_JACK_WORDS):
            return None
        if "keyboard" in text:
            return "Keyboard"
        if any(word in text.split() for word in POINTING_WORDS) or "mouse" in text:
            return "Mouse"
        return "System devices" if "button" in text else "Human Interface Devices"
    if kind == "disk":
        return "CDROM" if any(word in text for word in ("cdrom", "cd-rom", "dvd", "optical")) else "Disk drives"
    if kind == "bus":
        return "Universal Serial Bus controllers" if identifier.startswith("usb") or "usb" in text else "System devices"
    if kind == "communication":
        return "Modem" if "modem" in text else "Ports (COM & LPT)"
    if kind == "generic":
        return "System devices" if node.get("claimed") or "iommu" in text else "Other devices"
    return {
        "display": "Display adapters",
        "multimedia": "Sound, video and game controllers",
        "network": "Network adapters",
        "storage": "Hard disk controllers",
        "processor": "System devices",
        "bridge": "System devices",
    }.get(kind, "Other devices")


def device_name(node):
    return str(node.get("product") or node.get("description") or node.get("id", "Unknown device")).strip()


DETAIL_LABELS = {
    "businfo": "Bus information",
    "handle": "Handle",
    "physid": "Physical ID",
    "serial": "Serial number",
    "slot": "Slot",
    "size": "Size",
    "capacity": "Capacity",
    "clock": "Clock",
    "width": "Width",
    "units": "Units",
    "dev": "Device node",
    "date": "Date",
}
UNIT_FIELDS = {"size", "capacity", "clock"}


def readable(name, value, units):
    """A number with its unit as the Device Manager would print it: 1073741824 bytes -> 1 GB, 33000000 Hz -> 33 MHz."""
    if not isinstance(value, (int, float)) or name not in UNIT_FIELDS:
        return str(value)
    unit = units or ("Hz" if name == "clock" else "bytes")
    steps = ["", "K", "M", "G", "T"] if unit != "bytes" else ["bytes", "KB", "MB", "GB", "TB"]
    amount, index = float(value), 0
    while amount >= 1000 and index < len(steps) - 1:
        amount, index = amount / (1024 if unit == "bytes" else 1000), index + 1
    text = f"{amount:.0f}" if amount == int(amount) or amount >= 100 else f"{amount:.1f}"
    return f"{text} {steps[index]}" + ("" if unit == "bytes" else unit)


def details_of(node):
    """Every other fact lshw gives about the node, as (name, value) rows: its fields, configuration and capabilities."""
    rows = []
    for key, label in DETAIL_LABELS.items():
        if key in node and node[key] not in ("", None):
            rows.append((label, readable(key, node[key], node.get("units"))))
    for key, value in node.get("configuration", {}).items():
        rows.append((f"Configuration: {key}", str(value)))
    for key, value in node.get("capabilities", {}).items():
        rows.append((f"Capability: {key}", value if isinstance(value, str) else key))
    return rows


def device_of(node, category):
    configuration = node.get("configuration", {})
    return Device(
        name=device_name(node),
        category=category,
        kind=node.get("class", ""),
        manufacturer=str(node.get("vendor", "")),
        version=str(node.get("version", "")),
        driver=str(configuration.get("driver", "")),
        bus_info=str(node.get("businfo", "")),
        logical_name=logical_names(node),
        details=details_of(node),
        claimed=bool(node.get("claimed", False))
        or node.get("class") in ("processor", "bridge", "bus")
        or "iommu" in node_text(node),
    )


def devices_from(node, parent):
    """Adds the listed devices under node to parent's children (keeping lshw's nesting); returns every device."""
    found = []
    for child in node.get("children", []):
        category = categorise(child)
        if category is None:
            found += devices_from(child, parent)
            continue
        device = device_of(child, category)
        parent.children.append(device)
        found.append(device)
        found += devices_from(child, device)
    return found


def snapshot_from(document):
    root = document[0] if isinstance(document, list) else document
    computer = Device(
        name=device_name(root) if root.get("class") == "system" else "Computer", category="", kind="system"
    )
    computer.name = "Computer" if not root.get("product") else str(root["product"])
    return Snapshot(computer, devices_from(root, computer))


def by_type(devices):
    """{category: devices sorted by name}, categories in the classic order, only the ones with something in them."""
    grouped = {}
    for category in CATEGORIES:
        members = sorted(
            (device for device in devices if device.category == category), key=lambda device: device.name.lower()
        )
        if members:
            grouped[category] = members
    return grouped


def load_snapshot(run=subprocess.run):
    try:
        output = run(
            ["lshw", "-json", "-quiet"], capture_output=True, text=True, timeout=LSHW_TIMEOUT_SECONDS, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return Snapshot(Device("Computer", "", "system"), [], f"lshw could not run: {error}")
    if output.returncode != 0 or not output.stdout.strip():
        return Snapshot(Device("Computer", "", "system"), [], "lshw found nothing (is it installed?)")
    return snapshot_from(json.loads(output.stdout))


def pci_address(bus_info):
    """ "pci@0000:07:00.0" -> "0000:07:00.0"; "" for anything that is not a PCI device."""
    return bus_info[len("pci@") :] if bus_info.startswith("pci@") else ""


def pci_resources(sysfs_directory):
    """(resource type, setting) rows from a PCI device's sysfs folder: its interrupt and its address ranges."""
    directory = Path(sysfs_directory)
    rows = []
    irq = (directory / "irq").read_text().strip() if (directory / "irq").exists() else ""
    if irq and irq != "0":
        rows.append(("Interrupt Request", irq))
    if (directory / "resource").exists():
        for line in (directory / "resource").read_text().splitlines():
            start, end, flags = (int(part, 16) for part in line.split()[:3])
            if end <= start:
                continue
            if flags & IO_RESOURCE:
                rows.append(("Input/Output Range", f"{start:04X} - {end:04X}"))
            elif flags & MEMORY_RESOURCE:
                rows.append(("Memory Range", f"{start:08X} - {end:08X}"))
    return rows


def resources_of(device, sysfs_root=SYSFS_PCI):
    address = pci_address(device.bus_info)
    return pci_resources(Path(sysfs_root) / address) if address and (Path(sysfs_root) / address).exists() else []


def general_fields(device):
    return [
        ("Device type:", device.category),
        ("Manufacturer:", device.manufacturer or "(Standard system devices)"),
        ("Hardware version:", device.version or "Not available"),
    ]


def driver_fields(device):
    return [
        ("Provider:", "Linux kernel" if device.driver else "Not available"),
        ("Driver:", device.driver or "No driver files are required or have been loaded for this device."),
        ("Device:", device.logical_name or device.bus_info or "Not available"),
        ("Serial number:", next((value for name, value in device.details if name == "Serial number"), "Not available")),
    ]


_icon_cache = {}


def paint_bang(pixmap):
    painter = QPainter(pixmap)
    painter.setPen(QPen(Qt.black, 1))
    painter.setBrush(QColor("#FFFF00"))
    painter.drawPolygon(QPolygon([QPoint(5, 15), QPoint(14, 15), QPoint(9, 6)]))
    painter.setPen(QPen(Qt.black, 2))
    painter.drawLine(9, 9, 9, 12)
    painter.drawPoint(9, 14)
    painter.end()


def themed_icon(name, badged=False):
    key = (name, badged)
    if key not in _icon_cache:
        pixmap = QIcon.fromTheme(name).pixmap(QSize(ICON_SIZE, ICON_SIZE))
        if badged:
            pixmap = pixmap.copy()
            paint_bang(pixmap)
        _icon_cache[key] = QIcon(pixmap)
    return _icon_cache[key]


def tree_item(text, icon_name, device=None, badged=False):
    item = QTreeWidgetItem([text])
    item.setIcon(0, themed_icon(icon_name, badged))
    item.setData(0, ITEM_ROLE, device)
    return item


def device_item(device):
    return tree_item(device.name, CATEGORIES.get(device.category, "dialog-question"), device, badged=not device.working)


def connection_items(device):
    item = device_item(device)
    for child in device.children:
        item.addChild(connection_items(child))
    return item


def build_tree(tree, snapshot, by_connection):
    tree.clear()
    root = tree_item(snapshot.computer.name, "computer")
    if by_connection:
        for child in snapshot.computer.children:
            root.addChild(connection_items(child))
    else:
        for category, members in by_type(snapshot.devices).items():
            branch = tree_item(category, CATEGORIES[category])
            for device in members:
                branch.addChild(device_item(device))
            root.addChild(branch)
    tree.addTopLevelItem(root)
    root.setExpanded(True)
    for index in range(root.childCount()):  # a class with a device in trouble starts open, as the original's did
        branch = root.child(index)
        branch.setExpanded(any(not branch.child(row).data(0, ITEM_ROLE).working for row in range(branch.childCount())))
    return root


def summary_text(snapshot):
    if snapshot.error:
        return snapshot.error
    broken = sum(1 for device in snapshot.devices if not device.working)
    return f"{len(snapshot.devices)} devices" + (f", {broken} without a driver" if broken else "")


def field_rows(layout, rows):
    for label, value in rows:
        value_label = QLabel(value)
        value_label.setWordWrap(True)
        layout.addRow(label, value_label)


class PropertiesDialog(QDialog):
    """The device's property sheet: General, Driver and Resources, as the original's, to look at only."""

    def __init__(self, device, icon, parent=None, sysfs_root=SYSFS_PCI):
        super().__init__(parent)
        self.setWindowTitle(f"{device.name} Properties")
        self.tabs = QTabWidget()
        self.tabs.addTab(self.general_page(device, icon), "General")
        self.tabs.addTab(self.driver_page(device), "Driver")
        self.tabs.addTab(self.resources_page(resources_of(device, sysfs_root)), "Resources")
        self.tabs.addTab(self.details_page(device), "Details")
        ok_button = chicago95ui.dialog_button("OK")
        cancel_button = chicago95ui.dialog_button("Cancel")
        ok_button.clicked.connect(self.accept)
        cancel_button.clicked.connect(self.reject)
        buttons = QHBoxLayout()
        buttons.addStretch(1)
        buttons.addWidget(ok_button)
        buttons.addWidget(cancel_button)
        layout = QVBoxLayout(self)
        layout.addWidget(self.tabs)
        layout.addLayout(buttons)
        self.resize(400, 440)

    def general_page(self, device, icon):
        page = QWidget()
        layout = QVBoxLayout(page)
        heading = QHBoxLayout()
        picture = QLabel()
        picture.setPixmap(icon.pixmap(32, 32))
        heading.addWidget(picture)
        heading.addWidget(QLabel(device.name), 1)
        layout.addLayout(heading)
        fields = QFormLayout()
        field_rows(fields, general_fields(device))
        layout.addLayout(fields)
        status = QGroupBox("Device status")
        status_text = QLabel(device.status)
        status_text.setWordWrap(True)
        QVBoxLayout(status).addWidget(status_text)
        layout.addWidget(status)
        usage = QGroupBox("Device usage")
        disable = QCheckBox("Disable in this hardware profile")
        disable.setEnabled(False)
        exists = QCheckBox("Exists in all hardware profiles")
        exists.setChecked(True)
        exists.setEnabled(False)
        usage_layout = QVBoxLayout(usage)
        usage_layout.addWidget(disable)
        usage_layout.addWidget(exists)
        layout.addWidget(usage)
        layout.addStretch(1)
        return page

    def driver_page(self, device):
        page = QWidget()
        fields = QFormLayout(page)
        field_rows(fields, driver_fields(device))
        return page

    def details_page(self, device):
        """Everything lshw reported about the device, as a Property / Value list."""
        page = QWidget()
        layout = QVBoxLayout(page)
        self.details = QTreeWidget()
        self.details.setHeaderLabels(["Property", "Value"])
        self.details.setRootIsDecorated(False)
        rows = [
            ("Device type", device.category),
            ("Manufacturer", device.manufacturer or "Not available"),
            ("Hardware version", device.version or "Not available"),
            ("Driver", device.driver or "None"),
            ("Logical name", device.logical_name or "Not available"),
            ("Class (lshw)", device.kind),
            ("Status", device.status),
            *device.details,
        ]
        for name, value in rows:
            self.details.addTopLevelItem(QTreeWidgetItem([name, value]))
        self.details.resizeColumnToContents(0)
        layout.addWidget(self.details, 1)
        return page

    def resources_page(self, rows):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.addWidget(QLabel("Resource settings:"))
        self.resources = QTreeWidget()
        self.resources.setHeaderLabels(["Resource type", "Setting"])
        self.resources.setRootIsDecorated(False)
        for resource_type, setting in rows:
            self.resources.addTopLevelItem(QTreeWidgetItem([resource_type, setting]))
        if not rows:
            self.resources.addTopLevelItem(
                QTreeWidgetItem(
                    [
                        "No resources: not a PCI device, or its resources are not readable.",
                        "",
                    ]
                )
            )
        layout.addWidget(self.resources, 1)
        return page


class DeviceManagerWindow(QWidget):
    def __init__(self, load=load_snapshot):
        super().__init__()
        self.load = load
        self.setWindowTitle("Device Manager")
        self.setWindowIcon(QIcon.fromTheme("computer"))
        self.resize(420, 480)
        self.snapshot = None
        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(6)
        self.by_type_radio = QRadioButton("View devices by &type")
        self.by_connection_radio = QRadioButton("View devices by &connection")
        self.by_type_radio.setChecked(True)
        radios = QButtonGroup(self)
        radios.addButton(self.by_type_radio)
        radios.addButton(self.by_connection_radio)
        radio_row = QHBoxLayout()
        radio_row.addWidget(self.by_type_radio)
        radio_row.addWidget(self.by_connection_radio)
        radio_row.addStretch()
        layout.addLayout(radio_row)
        self.by_type_radio.toggled.connect(self.rebuild_tree)
        self.status_label = QLabel("Searching for devices...")
        layout.addWidget(self.status_label)
        panel = chicago95ui.sunken_panel()
        panel_layout = QVBoxLayout(panel)
        panel_layout.setContentsMargins(0, 0, 0, 0)
        self.tree = QTreeWidget()
        self.tree.setHeaderHidden(True)
        self.tree.setIconSize(QSize(ICON_SIZE, ICON_SIZE))
        self.tree.setIndentation(20)
        self.tree.setFrameShape(QTreeWidget.NoFrame)
        self.tree.itemDoubleClicked.connect(lambda _item, _column: self.show_properties())
        self.tree.itemSelectionChanged.connect(self.update_buttons)
        panel_layout.addWidget(self.tree)
        layout.addWidget(panel, 1)
        self.properties_button = chicago95ui.dialog_button("P&roperties...")
        self.properties_button.clicked.connect(self.show_properties)
        refresh_button = chicago95ui.dialog_button("Re&fresh")
        refresh_button.clicked.connect(self.refresh)
        action_row = QHBoxLayout()
        for button in (
            self.properties_button,
            refresh_button,
            chicago95ui.dialog_button("R&emove", enabled=False),
            chicago95ui.dialog_button("Pri&nt...", enabled=False),
        ):
            action_row.addWidget(button)
        layout.addLayout(action_row)
        ok_button = chicago95ui.dialog_button("OK")
        ok_button.setDefault(True)
        ok_button.clicked.connect(self.close)
        cancel_button = chicago95ui.dialog_button("Cancel")
        cancel_button.clicked.connect(self.close)
        dialog_row = QHBoxLayout()
        dialog_row.addStretch()
        dialog_row.addWidget(ok_button)
        dialog_row.addWidget(cancel_button)
        layout.addLayout(dialog_row)
        self.update_buttons()

    def refresh(self):
        self.status_label.setText("Searching for devices...")
        QApplication.processEvents()
        self.snapshot = self.load()
        self.rebuild_tree()

    def rebuild_tree(self):
        if self.snapshot is None:
            return
        build_tree(self.tree, self.snapshot, self.by_connection_radio.isChecked())
        self.status_label.setText(summary_text(self.snapshot))
        self.update_buttons()

    def selected_device(self):
        selected = self.tree.currentItem()
        return selected.data(0, ITEM_ROLE) if selected is not None else None

    def update_buttons(self):
        self.properties_button.setEnabled(self.selected_device() is not None)

    def show_properties(self):
        device = self.selected_device()
        if device is not None:
            PropertiesDialog(device, self.tree.currentItem().icon(0), self).exec()

    def item_texts(self):
        """Every row's text, indented by depth: what the tree shows."""
        rows = []
        iterator = QTreeWidgetItemIterator(self.tree)
        while iterator.value():
            item = iterator.value()
            depth = -1
            while item is not None:
                item, depth = item.parent(), depth + 1
            rows.append("  " * depth + iterator.value().text(0))
            iterator += 1
        return rows


def main():
    screenshot_path = sys.argv[sys.argv.index("--screenshot") + 1] if "--screenshot" in sys.argv else None
    app = chicago95ui.make_app("Device Manager")
    window = DeviceManagerWindow()
    window.refresh()
    if screenshot_path:
        return 0 if window.grab().save(screenshot_path) else 1
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
