QMenu {
    background: #f0f0f0;
    color: #111111;
    border: 1px solid #979797;
    padding: 2px;
}
QMenu::item:selected {
    background: #d9eafa;
    color: #111111;
}
QMenu::item:disabled {
    color: #808080;
}
QMenu::separator {
    height: 1px;
    background: #d4d4d4;
    margin: 3px 2px 3px 28px;
}
