QMenu {
    background: #f0f0f0;
    background-image: url("@HOME@/.local/share/chicago95/images/aero-menu-gutter.svg");
    background-repeat: repeat-y;
    background-position: left top;
    background-origin: content;
    background-clip: padding;
    color: #111111;
    border: 1px solid #979797;
    padding: 2px;
}
QMenu::item {
    height: 22px;
    border-width: 0 4px;
    border-style: solid;
    border-color: transparent;
    padding: 0 11px 0 6px;
}
QMenu::icon {
    left: 3px;
}
QMenu::item:selected {
    border-image: url("@HOME@/.local/share/chicago95/images/aero-menu-selection.svg") 0 4 0 4 stretch stretch;
    color: #111111;
}
QMenu::item:disabled {
    color: #808080;
}
QMenu::right-arrow {
    image: url("@HOME@/.local/share/chicago95/images/aero-menu-arrow.svg");
    width: 4px;
    height: 7px;
    right: 5px;
    top: -1px;
}
QMenu::separator {
    height: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e0e0e0, stop:0.5 #e0e0e0, stop:0.501 #ffffff, stop:1 #ffffff);
    margin: 3px 0 2px 28px;
}
