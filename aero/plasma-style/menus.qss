QMenu {
    background: #f0f0f0;
    color: #111111;
    border: 1px solid #979797;
    padding: 2px;
}
QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #aecff7, stop:0.023 #aecff7, stop:0.068 #f7f7f9,
        stop:0.114 #f2f4f6, stop:0.886 #e6edf6, stop:0.932 #eef3f9,
        stop:0.977 #aecff7, stop:1 #aecff7);
    color: #111111;
}
QMenu::item:disabled {
    color: #808080;
}
QMenu::separator {
    height: 1px;
    background: #d4d4d4;
    margin: 3px 2px 3px 28px;
}
