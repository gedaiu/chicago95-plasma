 uniform float aeroColorBalance;
 uniform float aeroAfterglowBalance;
 uniform float aeroBlurBalance;
+uniform vec2 captionGeometry;
 
 uniform mat4 colorMatrix;
 
 in vec2 uv;
 
 out vec4 fragColor;
+
+// The upper reflection and the blue afterglow have different strengths
+// on dark and light glass. Fit broad ramps from the two neutral VM mattes.
+vec3 captionTint(float backdropLuma)
+{
+    if (captionGeometry.x <= 0.0)
+        return vec3(0.0);
+
+    float y = (1.0 - uv.y) * captionGeometry.x + captionGeometry.y;
+    float upper = clamp((y - 2.5) / 4.67, 0.0, 1.0);
+    float middle = clamp((y - 7.17) / 8.0, 0.0, 1.0);
+    float lower = clamp((y - 15.17) / 6.0, 0.0, 1.0);
+    vec3 dark = vec3(3.0, 6.0, 7.0)
+        - upper * vec3(3.0, 3.0, 3.0)
+        - middle * vec3(4.0, 4.0, 4.0)
+        - lower * vec3(2.0, 3.0, 3.0);
+    vec3 light = vec3(10.0, 11.0, 13.0)
+        - upper * vec3(2.0, 2.0, 2.0)
+        - middle * vec3(3.0, 2.0, 2.0)
+        - lower * vec3(1.0, 1.0, 1.0);
+    float brightness = clamp((backdropLuma * 255.0 - 24.0) / 208.0, 0.0, 1.0);
+    return mix(dark, light, brightness) * (1.0 - smoothstep(21.17, 28.0, y)) / 255.0;
+}
 
