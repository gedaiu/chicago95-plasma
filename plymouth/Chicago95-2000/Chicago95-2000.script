# The 2000 start-up screen: screen.png is the loading screen Setup rendered (splash/Splash.qml at stage 0),
# laid out in the original's 640x480 and scaled to the screen height; the progress bar's 18 navy blocks
# (8x8, 9 apart, from 274,437 in that layout) fill in with the boot progress.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
unit = screen_height / 480;
layout_x = (screen_width - 640 * unit) / 2;

booting = Plymouth.GetMode() != "shutdown" && Plymouth.GetMode() != "reboot";
picture = Image("screen.png");
if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot")
  picture = Image("shutdown.png");
background = Sprite(picture.Scale(screen_width, screen_height));
background.SetPosition(0, 0, 0);

animate_strip = 0;
strip_tick = 0;
strip_phase = 0;
if (booting && animate_strip)
  {
    for (i = 0; i < 160; i++)
      strips[i] = Image("strip-" + i + ".png");
    strip_width = Math.Max(1, Math.Int(640 * unit));
    strip_height = Math.Max(1, Math.Int(10 * unit));
    strip = Sprite(strips[0].Scale(strip_width, strip_height));
    strip.SetPosition(layout_x, Math.Int(416 * unit), 1);
  }

block_image = Image("block.png").Scale(Math.Int(8 * unit), Math.Int(8 * unit));
for (i = 0; i < 18; i++)
  {
    blocks[i] = Sprite(block_image);
    blocks[i].SetPosition(Math.Int(layout_x + (274 + 9 * i) * unit), Math.Int(437 * unit), 1);
    blocks[i].SetOpacity(0);
  }

# Rehearse the original loader before revealing the graphical boot screen.
# This timer never delays boot completion; Plymouth may quit at any point.
loader_tick = 0;
if (booting)
  {
    loader_unit = Math.Min(screen_width / 640, screen_height / 480);
    loader_x = (screen_width - 640 * loader_unit) / 2;
    loader_y = (screen_height - 480 * loader_unit) / 2;
    loader = Sprite(Image("loader.png").Scale(screen_width, screen_height));
    loader.SetPosition(0, 0, 2);
    loader_block = Image("loader-block.png").Scale(Math.Max(1, Math.Int(9 * loader_unit)), Math.Max(1, Math.Int(16 * loader_unit)));
    for (i = 0; i < 72; i++)
      {
        loader_blocks[i] = Sprite(loader_block);
        if (i == 71)
          loader_blocks[i].SetImage(Image("loader-block.png").Scale(Math.Max(1, Math.Int(loader_unit)), Math.Max(1, Math.Int(16 * loader_unit))));
        loader_blocks[i].SetPosition(loader_x + i * 9 * loader_unit, loader_y + 384 * loader_unit, 3);
        loader_blocks[i].SetOpacity(0);
      }
  }
fun hide_loader()
  {
    if (booting)
      {
        loader.SetOpacity(0);
        for (i = 0; i < 72; i++)
          loader_blocks[i].SetOpacity(0);
      }
  }
fun refresh_callback()
  {
    if (booting && loader_tick < 80)
      {
        global.loader_tick++;
        if (loader_tick >= 80)
          hide_loader();
        else
          for (i = 0; i < 72; i++)
            if (i < Math.Int(loader_tick * 72 / 80))
              loader_blocks[i].SetOpacity(1);
      }
    else if (booting && animate_strip)
      {
        global.strip_tick++;
        # Let the graphical screen settle before moving the strip.
        if (strip_tick >= 12)
          {
            global.strip_tick = 10;
            global.strip_phase++;
            if (strip_phase >= 160)
              global.strip_phase = 0;
            strip.SetImage(strips[strip_phase].Scale(strip_width, strip_height));
          }
      }
  }
Plymouth.SetRefreshRate(32);
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress)
  {
    shown = Math.Int(progress * 18);
    if (!booting) shown = 0;
    for (i = 0; i < 18; i++)
      if (i < shown)
        blocks[i].SetOpacity(1);
      else
        blocks[i].SetOpacity(0);
  }
Plymouth.SetBootProgressFunction(progress_callback);

fun quit_callback()
  {
    hide_loader();
    for (i = 0; i < 18; i++)
      blocks[i].SetOpacity(booting);
  }
Plymouth.SetQuitFunction(quit_callback);
