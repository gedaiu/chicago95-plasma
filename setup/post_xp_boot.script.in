# Generated from PostXpBoot.qml. Background and animation remain separate; only
# the active animation rectangle is stored for each frame.
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
scale = Math.Min(screen_width / @WIDTH@, screen_height / @HEIGHT@);
left = (screen_width - @WIDTH@ * scale) / 2;
top = (screen_height - @HEIGHT@ * scale) / 2;
Window.SetBackgroundTopColor(@BACKGROUND@);
Window.SetBackgroundBottomColor(@BACKGROUND@);
image_name = "background.png";
prefix = "frame-";
frame_count = @FRAMES@;
loop_start = @LOOP_START@;
fps = @FPS@;
ax = @AX@; ay = @AY@; aw = @AW@; ah = @AH@;
if (@SEVEN@ && (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot"))
  {
    image_name = "shutdown.png";
    prefix = "shutdown-";
    frame_count = 18;
    loop_start = 0;
    # This rate reproduced the SP1 spinner cycle (0.83 s) on the Plymouth display.
    fps = 21;
    ax = @SX@; ay = @SY@; aw = @SW@; ah = @SH@;
  }
background = Sprite(Image(image_name).Scale(Math.Int(@WIDTH@ * scale), Math.Int(@HEIGHT@ * scale)));
background.SetPosition(left, top, 0);
for (i = 0; i < frame_count; i++)
  frames[i] = Image(prefix + i + ".png").Scale(Math.Max(1, Math.Int(aw * scale)), Math.Max(1, Math.Int(ah * scale)));
animation = Sprite(frames[0]);
animation.SetPosition(left + ax * scale, top + ay * scale, 1);
frame = 0;
prompting = 0;
fun refresh_callback()
  {
    if (!prompting)
      {
        frame++;
        if (frame >= frame_count)
          frame = loop_start;
        animation.SetImage(frames[frame]);
      }
  }
Plymouth.SetRefreshRate(fps);
Plymouth.SetRefreshFunction(refresh_callback);

# Keep encrypted-disk and interactive prompts usable over every theme.
prompt_panel = Sprite(Image("prompt-background.png").Scale(Math.Int(screen_width * 0.9), Math.Int(screen_height * 0.14)));
prompt_panel.SetPosition(screen_width * 0.05, screen_height * 0.86, 9);
prompt_panel.SetOpacity(0);
prompt_sprite = Sprite();
entry_sprite = Sprite();
fun show_prompt(prompt, value)
  {
    global.prompting = 1;
    prompt_panel.SetOpacity(1);
    prompt_image = Image.Text(prompt, 1, 1, 1);
    entry_image = Image.Text(value, 1, 1, 1);
    prompt_sprite.SetImage(prompt_image);
    entry_sprite.SetImage(entry_image);
    prompt_sprite.SetPosition((screen_width - prompt_image.GetWidth()) / 2, screen_height * 0.88, 10);
    entry_sprite.SetPosition((screen_width - entry_image.GetWidth()) / 2, screen_height * 0.93, 10);
    prompt_sprite.SetOpacity(1);
    entry_sprite.SetOpacity(1);
  }
fun password_callback(prompt, bullets)
  {
    password = "";
    for (i = 0; i < bullets; i++)
      password += "*";
    show_prompt(prompt, password);
  }
fun question_callback(prompt, entry)
  {
    show_prompt(prompt, entry);
  }
fun normal_callback()
  {
    global.prompting = 0;
    prompt_panel.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
  }
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
