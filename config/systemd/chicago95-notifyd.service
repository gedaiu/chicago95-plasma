[Unit]
Description=Chicago95 Windows 95 notification popups
PartOf=graphical-session.target
After=plasma-kwin_wayland.service
Before=plasma-plasmashell.service

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/chicago95-notifyd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=plasma-workspace.target
