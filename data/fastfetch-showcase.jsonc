// Chicago95 screenshot preset: no logo (the DOS terminal font has no block glyphs),
// anonymised title, root disk only, no local IP.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "modules": [
    { "type": "title", "format": "user@personal-computer" },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    { "type": "disk", "folders": "/" },
    "locale",
    "break",
    "colors",
  ],
}
